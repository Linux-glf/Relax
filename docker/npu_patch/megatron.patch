+        ctx.lens = lens
+        ctx.cp_group = cp_group
+        return out
+
+    @staticmethod
+    def backward(ctx, d_out):
+        cp_group, lens = ctx.cp_group, ctx.lens
+        cp_size = cp_group.size()
+        s_w = [s // cp_size for s in lens]
