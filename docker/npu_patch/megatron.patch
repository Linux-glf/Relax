+            [
+                # cat the per-source shares along hidden (row i of every share)
+                # then reshape — NOT a row concat (per-seq _all_to_all_hp2cp).
+                torch.cat(parts, dim=-1).reshape(s // cp_size, b_in, -1)
+                for s, parts in zip(lens, seq_parts)
+            ],
+            dim=0,
+        )
