+# Ascend HCCL's all_to_all_single drops to about 1/6 bandwidth when a per-peer
+# shard is not a multiple of _A2A_ALIGN_BYTES: measured on 4 ranks with a 30 MB
+# payload (back-to-back) -- 20.3 GB/s at 16 B, 119.8 GB/s at 512 B, 116.9 GB/s
+# at 8192 B. Both layout conversions below produce per-peer shards of
+# (h_in / cp_size) * 2 * rows_per_block, and h_in / cp_size is often an odd
+# multiple of 8 (e.g. 772 = 4 * 193), i.e. only 8 B aligned; pad each shard up
+# to the grain. Set 0 to disable and return to the original behavior.
+_A2A_ALIGN_BYTES = int(os.environ.get("MEGATRON_CP_A2A_ALIGN_BYTES", "512"))
+
+
+def _aligned_all_to_all(input_: torch.Tensor, group: torch.distributed.ProcessGroup) -> torch.Tensor:
+    """Even all_to_all with every per-peer shard padded to `_A2A_ALIGN_BYTES`.
+
+    Padding must be appended inside each block (one block per world_size rows),
+    not to the whole tensor: the even split cuts along dim 0, so moving a block
+    boundary changes the exchange. After the exchange, take the first
+    chunk_rows rows of each block; values and autograd are unchanged (the
+    padding's gradient is discarded).
+    """
+    if _A2A_ALIGN_BYTES <= 0:
+        return all_to_all(group, input_)
+    world_size = group.size()
+    rows, cols = input_.shape
+    chunk_rows = rows // world_size
+    gran = _A2A_ALIGN_BYTES // math.gcd(cols * input_.element_size(), _A2A_ALIGN_BYTES)
+    pad = (-chunk_rows) % gran
+    if pad == 0:
+        return all_to_all(group, input_)
+    blocks = input_.reshape(world_size, chunk_rows, cols)
+    blocks = torch.cat([blocks, blocks.new_zeros(world_size, pad, cols)], dim=1)
+    output = all_to_all(group, blocks.reshape(-1, cols))
+    return output.reshape(world_size, chunk_rows + pad, cols)[:, :chunk_rows].reshape(-1, cols)
+
+
