+# Merged per-batch all-to-all for THD (correct per-sequence undo/redo)
+####################
+def _thd_chunk_sizes(s, cp_size):
+    """torch.chunk(s, 2*cp_size) chunk size distribution (PyTorch semantics).
+
+    Mirrors ATen: chunk_size = ceil(s / n); each chunk takes chunk_size rows
+    except the last one, and a trailing empty chunk is dropped (which is why
+    the per-seq path raises IndexError when s % ceil(s/(2c)) == 0
+    and s < (2c-1)*ceil(s/(2c))). Returns None when a chunk would be empty.
+    """
+    n = 2 * cp_size
+    chunk_size = (s + n - 1) // n
+    sizes = []
+    start = 0
+    for _ in range(n):
+        sz = min(chunk_size, s - start)
+        if sz <= 0:
+            return None
+        sizes.append(sz)
+        start += sz
+    return sizes
+
+
+def _thd_undo_chunks(x, cp_size):
+    """Per-sequence undo (THD path, cp2hp). Mirrors the non-packed branch of
+    ``_undo_attention_load_balancing`` exactly: chunk into 2*cp_size chunks
+    and reorder [c0, c2, ..., c_{2c-2}, c_{2c-1}, c_{2c-3}, ..., c1] (order
+    [0, 2, 3, 1] for cp=2). NOT the identity permutation — skipping it changes
+    the forward (see the 2026-08-25 loss regression). Same kernels
+    (torch.chunk + cat) as the per-seq path, so empty chunks raise the same
+    IndexError.
+    """
+    n = 2 * cp_size
+    chunks = torch.chunk(x, n, dim=0)
+    order = [2 * i for i in range(cp_size)] + [n - 2 * i - 1 for i in range(cp_size)]
+    return torch.cat([chunks[i] for i in order], dim=0)
+
+
+def _thd_redo_chunks(x, cp_size):
+    """Per-sequence redo (THD path, hp2cp). Mirrors the non-packed branch of
+    ``_redo_attention_load_balancing`` exactly: chunk into 2*cp_size chunks
+    and reorder [c0, c_{2c-1}, c1, c_{2c-2}, ...] (order [0, 3, 1, 2] for
+    cp=2). NOT the identity permutation for cp > 1. Same kernels as the
+    per-seq path, so empty chunks raise the same IndexError.
+    """
+    n = 2 * cp_size
+    chunks = torch.chunk(x, n, dim=0)
+    order = [None] * n
+    order[::2] = range(cp_size)
+    order[1::2] = reversed(range(cp_size, n))
+    return torch.cat([chunks[i] for i in order], dim=0)
+
+
+class _MergedA2aCp2hp(torch.autograd.Function):
+    """Merged CP-to-HP all-to-all with the per-sequence undo semantics.
+
+    One all-to-all replaces the per-sequence loop. The prep (section split +
+    per-rank concatenation) and the exchange are row-wise/linear, so the
+    merged result equals the per-sequence a2a results concatenated. The
+    load-balancing undo is NOT skipped (it is a non-identity row permutation;
+    skipping it broke training, see the 2026-08-25 loss regression): it is
+    applied per sequence with the exact ``_undo_attention_load_balancing``
+    chunk order, and the hand-written backward inverts it with views + cats
+    (no zeros_like/copy per slice — the ZL+TM+Add storms in the profile).
+    """
+
+    @staticmethod
+    def forward(ctx, tensor, lens, cp_group, split_sections):
+        cp_size = cp_group.size()
+        s_in, b_in, h_in = tensor.shape
+        num_sec = len(split_sections)
+        sect = h_in // num_sec if num_sec and h_in % num_sec == 0 else -1
+        vec = (
+            sect > 0
+            and sect % cp_size == 0
+            and all(sz == sect for sz in split_sections)
+        )
+        if vec:
+            # Vectorized section split: hidden is [num_sec, cp_size, sect//cp].
+            flat = tensor.reshape(s_in, b_in, num_sec, cp_size, sect // cp_size)
+            per_rank = flat.permute(3, 0, 1, 2, 4).contiguous()
+            concat_tensor = per_rank.reshape(s_in * cp_size, b_in, h_in // cp_size)
+        else:
+            # Unequal sections: per-section split + per-rank concatenation.
+            flat = tensor.reshape(-1, h_in)
+            sections = torch.split(flat, split_sections, dim=1)
+            concat_tensor = torch.cat(
+                [
+                    torch.cat(
+                        [torch.split(sec, sec.shape[1] // cp_size, dim=1)[i] for sec in sections],
+                        dim=1,
+                    )
+                    for i in range(cp_size)
+                ],
+                dim=0,
+            )
+        exchanged = all_to_all(cp_group, concat_tensor).reshape(
+            s_in * cp_size, b_in, h_in // cp_size
+        )
+
+        # Unpack received blocks into per-sequence rows (identical to the
+        # per-seq loop): each source block is [seq1 share, seq2 share, ...],
+        # so sequence k's post-exchange rows are its s_k rows split across the
+        # cp source blocks.
+        s_w = [s // cp_size for s in lens]
+        blocks = torch.split(exchanged, sum(s_w), dim=0)
+        seq_parts = [[] for _ in lens]
+        off = 0
+        for k, sw in enumerate(s_w):
+            for blk in blocks:
+                seq_parts[k].append(blk[off : off + sw])
+            off += sw
+        # Per-sequence undo (mirrors per-seq tensor_a2a_cp2hp(undo=True)).
+        out_parts = []
+        for k, s in enumerate(lens):
+            seq_rows = torch.cat(seq_parts[k], dim=0)
+            out_parts.append(_thd_undo_chunks(seq_rows, cp_size))
+        out = torch.cat(out_parts, dim=0)
+
+        ctx.vec = vec
+        ctx.lens = lens
+        ctx.cp_group = cp_group
+        ctx.split_sections = split_sections
+        ctx.s_in, ctx.b_in, ctx.h_in = s_in, b_in, h_in
+        return out
+
+    @staticmethod
+    def backward(ctx, d_out):
+        cp_group, lens = ctx.cp_group, ctx.lens
+        cp_size = cp_group.size()
+        b_in, h_in = ctx.b_in, ctx.h_in
+        s_w = [s // cp_size for s in lens]
+        n = 2 * cp_size
+
+        # --- undo backward (per sequence) ---
+        # out = cat over seqs of undo(seq_rows); undo = chunk(2c) + cat in
+        # undo order, so d_seq_rows = cat of the d_out chunks in natural
+        # order (views + one cat — the inverse permutation).
+        d_seq_outs = torch.split(d_out, [s_w[k] * cp_size for k in range(len(lens))], dim=0)
+        d_seq_rows = []
+        for k, s in enumerate(lens):
+            cs = _thd_chunk_sizes(s, cp_size)
+            if cs is None:
+                raise IndexError(f"empty chunk for seq len {s} cp {cp_size}")
+            order = [2 * i for i in range(cp_size)] + [n - 2 * i - 1 for i in range(cp_size)]
+            d_blocks = torch.split(d_seq_outs[k], [cs[o] for o in order], dim=0)
+            pos = [0] * n
+            for i, o in enumerate(order):
+                pos[o] = i
+            d_seq_rows.append(torch.cat([d_blocks[pos[j]] for j in range(n)], dim=0))
+
+        # --- unpack backward ---
+        # out = cat over seqs; per-seq rows partition each received block, so
+        # each block's grad is a cat of the (contiguous) per-seq grad rows.
+        d_blocks = []
+        for j in range(cp_size):
+            d_blocks.append(
+                torch.cat(
+                    [d_seq_rows[k][j * s_w[k] : (j + 1) * s_w[k]] for k in range(len(lens))],
+                    dim=0,
+                )
+            )
+        d_exchanged = torch.cat(d_blocks, dim=0)
+
+        # --- all-to-all backward (reverse comm, equal split) ---
+        d_concat = all_to_all(cp_group, d_exchanged)
+
+        # --- prep backward ---
+        if ctx.vec:
+            d_per_rank = d_concat.reshape(
+                cp_size,
+                ctx.s_in,
+                b_in,
+                len(ctx.split_sections),
+                ctx.h_in // cp_size // len(ctx.split_sections),
+            )
+            d_flat = d_per_rank.permute(1, 2, 3, 0, 4)
+            return d_flat.reshape(ctx.s_in, b_in, h_in), None, None, None
+        # Unequal sections: concat rows = [rank0 block, rank1 ...]; each rank
+        # block = sections concatenated along hidden. The section grad is the
+        # rank pieces in hidden order — one cat of views.
+        d_flat_parts = []
+        for j, sec_w in enumerate(ctx.split_sections):
+            for i in range(cp_size):
+                # d_concat is 3D [S, b, H/cp] (the backward a2a is called on
+                # the 3D d_exchanged), so rank block i = rows [i*s_in : ...].
+                d_rank = d_concat[i * ctx.s_in : (i + 1) * ctx.s_in]
+                h_off = sum(sw // cp_size for sw in ctx.split_sections[:j])
+                d_flat_parts.append(d_rank[:, :, h_off : h_off + sec_w // cp_size])
+        d_flat = torch.cat(d_flat_parts, dim=-1)
+        return d_flat.reshape(ctx.s_in, b_in, h_in), None, None, None
+
+
+class _MergedA2aHp2cp(torch.autograd.Function):
+    """Merged HP-to-CP all-to-all with the per-sequence redo semantics.
+
+    One all-to-all replaces the per-sequence loop. Every rank must end up
