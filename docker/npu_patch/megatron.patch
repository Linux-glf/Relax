+def _packed_cu_seqlens_equal(packed_seq_params, cu_seqlens_q, cu_seqlens_kv) -> bool:
+    """Cache the per-layer cu_seqlens equality check per microbatch."""
+    key = (
+        id(cu_seqlens_q),
+        cu_seqlens_q.data_ptr(),
+        _tensor_version(cu_seqlens_q),
+        id(cu_seqlens_kv),
+        cu_seqlens_kv.data_ptr(),
+        _tensor_version(cu_seqlens_kv),
