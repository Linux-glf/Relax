@@ -0,0 +1,29 @@
+# Copyright (c) 2026, Huawei Technologies Co., Ltd. All rights reserved.
+
+from megatron_adaptor.features_manager.mindspeed_feature import MindSpeedFeature
+
+
+class FusedSwigluFeature(MindSpeedFeature):
+    """Route Megatron's SwiGLU activation through the NPU fused kernel.
+
+    Mirrors MindSpeed's ``FusedSwigluFeature``: the feature name and the
+    ``optimization_level=0`` default keep it always-on, so no CLI flag is
+    needed. ``--no-bias-swiglu-fusion`` still falls back to Megatron's
+    unfused activation branch.
+    """
+
+    def __init__(self):
+        super().__init__('use-swiglu', optimization_level=0)
+
+    def register_patches(self, patch_manager, args):
+        from megatron_adaptor.patches.megatron.fused_bias_swiglu import (
+            BiasSwiGLUFunction,
+            SwiGLUFunction,
+        )
+
+        patch_manager.register_patch(
+            'megatron.core.fusions.fused_bias_swiglu.SwiGLUFunction', SwiGLUFunction
+        )
+        patch_manager.register_patch(
+            'megatron.core.fusions.fused_bias_swiglu.BiasSwiGLUFunction', BiasSwiGLUFunction
+        )
diff --git a/megatron_adaptor/patches/megatron/fused_bias_swiglu.py b/megatron_adaptor/patches/megatron/fused_bias_swiglu.py
new file mode 100644
index 0000000..b38f1dd
--- /dev/null
+++ b/megatron_adaptor/patches/megatron/fused_bias_swiglu.py
@@ -0,0 +1,43 @@
+# Copyright (c) 2026, Huawei Technologies Co., Ltd. All rights reserved.
+"""NPU kernels replacing Megatron's SwiGLU autograd functions.
+
+Ported from MindSpeed (``mindspeed/core/fusions/fused_bias_swiglu.py``).
+Megatron's reference implementation splits the input with ``torch.chunk`` and
+applies ``F.silu`` in eager mode (``jit_fuser``/``torch.compile`` is disabled
+on NPU), so the two drop-ins below route the same computation through
+``torch_npu.npu_swiglu`` instead.
+
+``FusedSwigluFeature`` registers them on
+``megatron.core.fusions.fused_bias_swiglu.SwiGLUFunction`` and
+``BiasSwiGLUFunction``, which ``bias_swiglu_impl`` resolves from module globals
+at call time, covering the ``--swiglu --bias-activation-fusion`` MLP path.
+
+Both ``apply`` signatures accept Megatron's trailing
+``fp8_input_store``/``cpu_offload_input`` arguments but ignore them: FP8
+activation storage and activation CPU offloading are not applied on this path,
+and backward runs through ``npu_swiglu``'s own autograd rather than the saved
+forward state. ``weighted_bias_swiglu_impl`` (per-token scaling, used by MoE)
+keeps the native implementation.
+"""
+
+import torch_npu
+
+
+def fused_swiglu(x):
+    return torch_npu.npu_swiglu(x, dim=-1)
+
+
+class SwiGLUFunction:
+    """Drop-in for ``megatron.core.fusions.fused_bias_swiglu.SwiGLUFunction``."""
+
+    @staticmethod
+    def apply(x, *args):
+        return fused_swiglu(x)
+
+
+class BiasSwiGLUFunction:
+    """Drop-in for ``megatron.core.fusions.fused_bias_swiglu.BiasSwiGLUFunction``."""
+
+    @staticmethod
+    def apply(x, bias, *args):
+        return fused_swiglu(x + bias)
