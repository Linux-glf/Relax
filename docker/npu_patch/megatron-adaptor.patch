+def _add_argument(group, parser: ArgumentParser, *args, **kwargs):
+    """Register one option unless the host parser already defines it.
+
+    Hosts extend Megatron's parser with profiler flags of their own (e.g. Relax
+    defines ``--profile-with-stack``/``--profile-with-memory`` for its torch
+    profiler). Registering the same option twice raises
+    ``argparse.ArgumentError``, and the host definition already provides the
+    destination this feature reads.
+    """
+    if any(option in parser._option_string_actions for option in args):
+        return
+    group.add_argument(*args, **kwargs)
+
+
