+        ref_v = v.detach().float().cpu().requires_grad_(True)
+        _sparse_attention_reference(ref_q, ref_k, ref_v, indices, scale).sum().backward()
+        for name, got, want in (('dq', qg.grad, ref_q.grad), ('dk', kg.grad, ref_k.grad), ('dv', vg.grad, ref_v.grad)):
+            cos_g = _cosine(got, want)
+            print(f'   {name}: cosine vs fp32 autograd reference = {cos_g:.6f} ({"OK" if cos_g >= 0.99 else "TOO LOW"})')
+            ok &= cos_g >= 0.99
+    except Exception:
+        print('backward RAISED:')
+        traceback.print_exc(file=sys.stdout)
+        ok = False
+
+    print(f'test 5: {"PASS" if ok else "FAIL"}')
