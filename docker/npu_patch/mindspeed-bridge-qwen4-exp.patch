@@ -0,0 +1,470 @@
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""GPT model for Qwen3.8-Flash-Next (``qwen4_exp``).
+
+Stock ``GPTModel`` builds its decoder and its MTP block from hard-coded classes,
+and neither of them knows about this architecture's gated hyper-connections.
+Both are rebuilt here with the plugin's own classes; everything else -- the
+embedding, the output layer, pre/post processing -- is inherited, so the two
+models stay comparable module by module.
+
+The one piece of glue that has to live at this level is the hand-off of the
+backbone's pre-contraction multi-stream to the MTP head (see ``block.py``): the
+decoder returns ``(contracted, multi_stream)`` and ``_postprocess`` splits the
+pair, sending the contracted tensor to the output layer and the multi-stream to
+the MTP block through ``extra_block_kwargs``.
+"""
+
+from __future__ import annotations
+
+from typing import Literal, Optional
+
+import torch
+from torch import Tensor
+
+from megatron.core import tensor_parallel
+from megatron.core.models.gpt.gpt_model import GPTModel
+from megatron.core.process_groups_config import ProcessGroupCollection
+from megatron.core.transformer.spec_utils import ModuleSpec
+from megatron.core.transformer.transformer_config import TransformerConfig
+
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.block import Qwen4ExpTransformerBlock
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.mtp import (
+    Qwen4ExpMultiTokenPredictionBlock,
+)
+
+
+def undivided_boundaries(packed_seq_params):
+    """Per-sample boundaries of a thd batch whose sequence is not split.
+
+    Two flavours of the same thing arrive here, and both describe a stream the
+    caller is holding in full:
+
+    * the packed batch Relax builds on the host for a CP == 1 run, whose
+      ``cu_seqlens_q_cpu`` are the global boundaries (see
+      ``relax/backends/megatron/data.py``);
+    * the undivided VL batch of a CP > 1 run, which
+      :class:`~mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.vl_model.Qwen4ExpVLModel`
+      first flattens back into one stream (``cp_split.flat_ids``) and only then
+      splits -- ``cu_seqlens_q_padded`` are the per-sample boundaries of exactly
+      that flattened stream.
+
+    A *split* batch (a CP rank holding only its slice) never gets here: the
+    model slices the positions together with the tokens, so by the time the
+    positions are built the sequence is whole again.
+    """
+    for attribute in ('cu_seqlens_q_cpu', 'cu_seqlens_q_padded'):
+        boundaries = getattr(packed_seq_params, attribute, None)
+        if boundaries is not None:
+            return boundaries
+    raise NotImplementedError(
+        'per-sample positions need the undivided boundaries of a packed batch (its `cu_seqlens_q_cpu`, or the '
+        f'`cu_seqlens_q_padded` of a batch this model flattened itself); got a {type(packed_seq_params).__name__} '
+        'without either.'
+    )
+
+
+def _roll_loss_mask_right_cp(mask: Tensor, packed_seq_params, cp_group) -> Tensor:
+    """Right-roll the MTP loss mask by one token in the CP zig-zag layout.
+
+    ``process_mtp_loss`` runs on the ``labels is None`` path, where it left-rolls
+    the loss mask inside every local chunk and fills each chunk's last position
+    from the neighbouring rank (see MCore's ``roll_tensor``). This is the exact
+    inverse, and the halo is its mirror image:
+
+    * a front chunk start needs the value at the previous global position, i.e.
+      the last token of the previous rank's front chunk (rank 0: nothing -- the
+      value is the zero every sample's mask ends on);
+    * a mirrored chunk start needs the last token of the *next* rank's mirrored
+      chunk (the last rank: its own front chunk's last token).
+
+    The local stream holds two chunks per sample, ``[L/(2*cp), L/(2*cp)]``, so
+    the roll is done over the whole stream and only each chunk's first position
+    is overwritten with the exchanged boundary value. ``packed_seq_params`` must
+    carry the *global* per-sample boundaries of the stream this rank was handed
+    a slice of (``cu_seqlens_q_padded``, falling back to ``cu_seqlens_q``), the
+    same convention MCore's roll divides by ``cp_size``.
+    """
+    physical = getattr(packed_seq_params, 'cu_seqlens_q_padded', None)
+    if physical is None:
+        physical = getattr(packed_seq_params, 'cu_seqlens_q', None)
+    if physical is None:
+        raise RuntimeError(
+            'MTP under context parallelism needs the packed per-sample boundaries '
+            '(packed_seq_params.cu_seqlens_q[_padded]) to locate each chunk start.'
+        )
+
+    cp_size = cp_group.size()
+    rank = torch.distributed.get_rank(group=cp_group)
+    ranks = torch.distributed.get_process_group_ranks(group=cp_group)
+    next_rank = ranks[(rank + 1) % cp_size]
+    prev_rank = ranks[(rank - 1) % cp_size]
+
+    boundaries = [int(value) for value in physical.reshape(-1).tolist()]
+    local_starts = [boundary // cp_size for boundary in boundaries]
+
+    rolled = torch.empty_like(mask)
+    rolled[..., 1:] = mask[..., :-1]
+    rolled[..., :1] = 0
+
+    # One boundary pair per non-empty sample. Every CP rank of the group holds
+    # the same samples, so the exchange stays symmetric.
+    chunks: list[tuple[int, int]] = []
+    front_lasts: list[Tensor] = []
+    mirrored_lasts: list[Tensor] = []
+    for index in range(len(local_starts) - 1):
+        start, end = local_starts[index], local_starts[index + 1]
+        chunk = (end - start) // 2
+        if chunk == 0:
+            continue
+        chunks.append((start, chunk))
+        front_lasts.append(mask[..., start + chunk - 1])
+        mirrored_lasts.append(mask[..., end - 1])
+
+    if chunks:
+        front_send = torch.stack(front_lasts, dim=0)
+        mirrored_send = torch.stack(mirrored_lasts, dim=0)
+        front_recv = torch.empty_like(front_send)
+        mirrored_recv = torch.empty_like(mirrored_send)
+        ops = []
+        if rank > 0:
+            ops.append(torch.distributed.P2POp(torch.distributed.irecv, front_recv, prev_rank, group=cp_group))
+        if rank < cp_size - 1:
+            ops.append(torch.distributed.P2POp(torch.distributed.isend, front_send, next_rank, group=cp_group))
+            ops.append(torch.distributed.P2POp(torch.distributed.irecv, mirrored_recv, next_rank, group=cp_group))
+        if rank > 0:
+            ops.append(torch.distributed.P2POp(torch.distributed.isend, mirrored_send, prev_rank, group=cp_group))
+        for request in torch.distributed.batch_isend_irecv(ops):
+            request.wait()
+
+        for position, (start, chunk) in enumerate(chunks):
+            rolled[..., start] = front_recv[position] if rank > 0 else 0
+            # The last rank's mirrored chunk starts right after its own front
+            # chunk (there is no next rank to ask).
+            rolled[..., start + chunk] = (
+                mirrored_recv[position] if rank < cp_size - 1 else front_send[position]
+            )
+    return rolled
+
+
+class Qwen4ExpModel(GPTModel):
+    """``GPTModel`` with gated hyper-connections and Qwen3.8-Flash-Next's MTP head."""
+
+    def __init__(
+        self,
+        config: TransformerConfig,
+        transformer_layer_spec: ModuleSpec,
+        vocab_size: int,
+        max_sequence_length: int,
+        pre_process: bool = True,
+        post_process: bool = True,
+        fp16_lm_cross_entropy: bool = False,
+        parallel_output: bool = True,
+        share_embeddings_and_output_weights: bool = False,
+        position_embedding_type: Literal['learned_absolute', 'rope', 'mrope', 'yarn', 'none'] = 'learned_absolute',
+        rotary_percent: float = 1.0,
+        rotary_base: int = 10000,
+        rope_scaling: bool = False,
+        rope_scaling_factor: float = 8.0,
+        scatter_embedding_sequence_parallel: bool = True,
+        seq_len_interpolation_factor: Optional[float] = None,
+        mtp_block_spec: Optional[ModuleSpec] = None,
+        pg_collection: Optional[ProcessGroupCollection] = None,
+        vp_stage: Optional[int] = None,
+    ) -> None:
+        # `GPTModel.__init__` builds a decoder of its own, which the last lines of
+        # this constructor replace with the port's (`Qwen4ExpTransformerBlock`,
+        # for the hyper-connection wiring). Everything that decoder builds is
+        # thrown away with it -- and the PLE branch is the one part of it that
+        # throwing away does *not* undo: its n-gram table is a pinned host buffer,
+        # and this platform charges a pinned allocation as the next power of two of
+        # its payload and never gives the block back to the node when the tensor is
+        # freed. Measured on the 4-layer checkpoint: one rank at tp_size=1 costs
+        # 129 GiB for the table alone, and building the decoder twice costs 259 GiB,
+        # of which 129 stays charged for the life of the process. Per rank, so a
+        # 16-die run pays for the table twice at whatever its TP is: 512 GiB at
+        # tp_size=4 (16 x 32 GiB, which is what the alignment harness showed as
+        # 65 GiB per rank at model construction) and 1 TiB at tp_size=2.
+        #
+        # The branch is selected purely by `config.ple_layer_ids` (see
+        # `Qwen4ExpLayer.__init__`), so it is cleared for the discarded build and
+        # restored for the real one. `ple_enabled` stays as it is: it is only read
+        # *inside* the `layer_number in ple_layer_ids` check.
+        ple_layer_ids = getattr(config, 'ple_layer_ids', None)
+        try:
+            config.ple_layer_ids = []
+            super().__init__(
+                config=config,
+                transformer_layer_spec=transformer_layer_spec,
+                vocab_size=vocab_size,
+                max_sequence_length=max_sequence_length,
+                pre_process=pre_process,
+                post_process=post_process,
+                fp16_lm_cross_entropy=fp16_lm_cross_entropy,
+                parallel_output=parallel_output,
+                share_embeddings_and_output_weights=share_embeddings_and_output_weights,
+                position_embedding_type=position_embedding_type,
+                rotary_percent=rotary_percent,
+                rotary_base=rotary_base,
+                rope_scaling=rope_scaling,
+                rope_scaling_factor=rope_scaling_factor,
+                scatter_embedding_sequence_parallel=scatter_embedding_sequence_parallel,
+                seq_len_interpolation_factor=seq_len_interpolation_factor,
+                mtp_block_spec=mtp_block_spec,
+                pg_collection=pg_collection,
+                vp_stage=vp_stage,
+            )
+        finally:
+            config.ple_layer_ids = ple_layer_ids
+
+        # Rebuild the mRoPE module. Megatron's own `MultimodalRotaryEmbedding`
+        # lays the three position components out in chunks and hands the result
+        # to `apply_rotary_pos_emb`, which is not what this checkpoint was
+        # trained with: Qwen3.8-Flash-Next interleaves T/H/W per frequency
+        # (`apply_interleaved_mrope`) and rotates with the absolute form of the
+        # frequencies. `Qwen3VLMultimodalRotaryEmbedding` implements both and is
+        # the module the Qwen3.5-VL plugin already runs on NPU, so the text
+        # tower reuses it -- its attention spec is `Qwen3VLSelfAttention`, which
+        # knows how to consume the (cos, sin) pair it returns.
+        # Imported here rather than at module level: the module lives in
+        # `megatron.bridge`, and this module has to stay importable without it
+        # (the plugin is loaded during registration, before the model families
+        # it plugs into exist).
+        from megatron.bridge.models.qwen_vl.modelling_qwen3_vl.rope import (
+            Qwen3VLMultimodalRotaryEmbedding,
+        )
+
+        self.rotary_pos_emb = Qwen3VLMultimodalRotaryEmbedding(
+            kv_channels=self.config.kv_channels,
+            rotary_percent=rotary_percent,
+            rotary_interleaved=self.config.rotary_interleaved,
+            seq_len_interpolation_factor=seq_len_interpolation_factor,
+            rotary_base=rotary_base,
+            cp_group=self.pg_collection.cp,
+        )
+        self.mrope_section = self.config.mrope_section
+        assert self.mrope_section is not None, (
+            'Qwen4Exp requires config.mrope_section (the checkpoint has [11, 11, 10]).'
+        )
+        # The rope module above lays the three position components out
+        # interleaved per frequency, which is what the checkpoint was trained
+        # with. The chunked layout is not implemented, so refuse a checkpoint
+        # that asks for it rather than silently rotating the wrong axes.
+        assert getattr(self.config, 'mrope_interleaved', True), (
+            'Qwen4Exp only supports interleaved mRoPE (config.mrope_interleaved=True).'
+        )
+
+        # PLE (per-layer embedding) layers hash token ids, so they need the batch's
+        # ids in the layout the decoder's activations end up in. See
+        # `_attach_ple_input_ids`; an empty list here means the checkpoint has no
+        # PLE layer and nothing is attached.
+        self.ple_layer_ids = [int(layer_id) for layer_id in (getattr(config, 'ple_layer_ids', None) or [])]
+        # Whether this model's embedding scatters itself along the sequence
+        # dimension (the text tower's does; the multimodal one merges vision
+        # embeddings into the whole sequence first and scatters by hand).
+        self.scatter_embedding_sequence_parallel = scatter_embedding_sequence_parallel
+
+        # Rebuild the decoder: it expands the embedding into the hc_count residual
+        # streams and contracts them again on the last stage.
+        self.decoder = Qwen4ExpTransformerBlock(
+            config=self.config,
+            spec=transformer_layer_spec,
+            pre_process=self.pre_process,
+            post_process=self.post_process,
+            pg_collection=self.pg_collection,
+            vp_stage=self.vp_stage,
+        )
+
+        # Rebuild the MTP block: it consumes the un-contracted multi-stream.
+        if self.mtp_process:
+            self.mtp = Qwen4ExpMultiTokenPredictionBlock(
+                config=self.config,
+                spec=mtp_block_spec,
+                vp_stage=self.vp_stage,
+                pg_collection=self.pg_collection,
+            )
+
+    def forward(
+        self,
+        input_ids: Tensor,
+        position_ids: Optional[Tensor],
+        attention_mask: Tensor,
+        *args,
+        **kwargs,
+    ):
+        """Materialise text-only mRoPE positions before ``GPTModel.forward`` runs.
+
+        The text tower has no multimodal step to derive them, and Relax's text
+        path always hands the model ``position_ids=None``. The rotary module
+        below cannot invent them: it lays the frequency table out per packed
+        token, and ``apply_rotary_pos_emb_thd_absolute`` then applies that table
+        row for row, ignoring ``cu_seqlens``. For text every mRoPE component of
+        a token is its position within its own sample, so the table is the
+        per-sample ``arange`` read out along the packed stream.
+        """
+        packed_seq_params = kwargs.get('packed_seq_params')
+        if position_ids is None:
+            position_ids = self._text_position_ids(input_ids, packed_seq_params)
+        # Unconditionally: these `input_ids` already are this rank's slice of the
+        # batch -- the ids are not sharded by TP -- so they are in the layout the
+        # activations end up in, which is what the PLE layers need.
+        # `scatter_embedding_sequence_parallel` is *not* the right gate for that:
+        # it says whether the embedding scatters its own output, while the text
+        # tower under SP=off needs the ids just as much (`_attach_ple_input_ids`
+        # scatters them itself when SP is on). The multimodal model, which owns
+        # its context-parallel split, attaches first and this call then steps
+        # aside -- see the guard in `_attach_ple_input_ids`.
+        self._attach_ple_input_ids(input_ids, packed_seq_params)
+        self._prepare_mtp_loss_mask(kwargs)
+        return super().forward(input_ids, position_ids, attention_mask, *args, **kwargs)
+
+    def _prepare_mtp_loss_mask(self, kwargs: dict) -> None:
+        """Absorb Relax's MTP forwarding argument and frame the loss mask MCore reads.
+
+        Two separate things, both about the same incoming ``kwargs``.
+
+        ``mtp_kwargs`` is a Relax-only parameter that stock ``GPTModel.forward``
+        has none of -- it needs the Megatron-LM patch carried in
+        ``relax/docker/klx_patch/megatron.patch``, which is not applied to the
+        tree this runs against, so leaving it in ``kwargs`` is a ``TypeError``.
+        Dropping it costs nothing here: the labels it carries are
+        ``batch["tokens"]``, and with ``labels is None`` ``process_mtp_loss``
+        rolls exactly those out of the ``input_ids`` this forward was handed (at
+        CP == 1 the two are the same tensor; see ``_attach_mtp_forward_kwargs``
+        in ``relax/backends/megatron/model.py``).
+
+        The mask frame is the part that is not free. Relax's
+        ``full_loss_masks`` is in *predictor* coordinates -- ``data.py`` shifted
+        it once (``align_loss_mask_for_sft``) so that ``mask[i]`` gates the
+        prediction made at position ``i`` -- and MCore reads it in those same
+        coordinates, except on the ``labels is None`` path, where it rolls the
+        mask one further left to stay in "lockstep" with the labels it just
+        fabricated. Both tensors are then rolled once per MTP depth, so the mask's
+        one-position lead over the labels never washes out: at every depth, the
+        position the mask gates is the one that predicts the token *before* the
+        supervised one. Rolling the mask back by one -- into the target frame the
+        pre-roll assumes -- cancels it exactly.
+
+        The roll is exact for a packed batch at CP == 1, where it is a per-sample
+        roll in disguise: every sample's mask ends on the zero left by
+        ``align_loss_mask_for_sft`` (or by the ``F.pad(..., value=0)`` branch in
+        ``data.py``), so the bit that rolls in at a sample's first position is
+        that zero. Under CP the local stream is the zig-zag layout (two chunks
+        per sample), so the value a chunk start needs lives on the neighbouring
+        rank -- ``_roll_loss_mask_right_cp`` fetches exactly those boundary
+        values with the mirror image of the halo exchange MCore's own
+        ``roll_tensor`` performs.
+        """
+        # Unconditional: `enable_mtp_training` alone makes Relax pass this, even
+        # with `--mtp-num-layers 0` and so no MTP to patch.
+        kwargs.pop('mtp_kwargs', None)
+
+        if not self.config.mtp_num_layers:
+            return
+        loss_mask = kwargs.get('loss_mask')
+        if loss_mask is None or kwargs.get('labels') is not None:
+            # No mask to frame, or a caller-supplied label set -- that path skips
+            # MCore's pre-roll, so the mask is already where it needs to be.
+            return
+        if self.pg_collection.cp.size() > 1:
+            kwargs['loss_mask'] = _roll_loss_mask_right_cp(
+                loss_mask, kwargs.get('packed_seq_params'), self.pg_collection.cp
+            )
+            return
+        kwargs['loss_mask'] = torch.cat(
+            [torch.zeros_like(loss_mask[..., :1]), loss_mask[..., :-1]], dim=-1
+        )
+
+    def _attach_ple_input_ids(self, input_ids: Tensor, packed_seq_params, index: Optional[Tensor] = None) -> None:
+        """Hand this rank's token ids to the PLE layers, alongside the batch.
+
+        The n-gram branch hashes token ids, so it has to see them where the
+        activations are: ``[tokens, batch]``, context-parallel split and
+        sequence-parallel scattered exactly like the embedding output. They ride
+        on ``packed_seq_params``, which is a fresh object per micro-batch and the
+        same one a layer sees when gradient checkpointing recomputes it -- so the
+        ids are there again in the backward, which an attribute set on the layer
+        before the forward would not guarantee.
+
+        The attach happens once per batch: a second call with the same
+        ``packed_seq_params`` -- the base model's, after the multimodal one
+        already attached this rank's slice -- leaves the ids it finds alone.
+
+        Args:
+            input_ids: ``[batch, seq]`` ids, undivided (the caller splits them).
+            packed_seq_params: The batch's packed parameters, or ``None`` when the
+                batch is not packed -- PLE then has nothing to ride on and the
+                layer refuses to run.
+            index: Positions of this rank's tokens in the undivided sequence, for
+                the multimodal model, which owns its context-parallel split.
+        """
+        if not self.ple_layer_ids or input_ids is None or packed_seq_params is None:
+            return
+        if getattr(packed_seq_params, 'ple_input_ids', None) is not None:
+            return
+        if index is not None:
+            input_ids = input_ids.index_select(1, index)
+        ids = input_ids.transpose(0, 1)
+        if self.config.sequence_parallel:
+            # The same split the embedding applies to its output (it is a pure
+            # slice either way, so it does not matter which of the two the
+            # embedding took).
+            ids = tensor_parallel.scatter_to_sequence_parallel_region(ids)
+        packed_seq_params.ple_input_ids = ids
+
+    def _text_position_ids(self, input_ids: Tensor, packed_seq_params, boundaries=None) -> Tensor:
+        """Zero-based per-sample positions of a text batch, packed or padded.
+
+        Returns ``[1, T]`` for a packed (thd) batch and ``[b, s]`` otherwise;
+        the rotary module broadcasts both to the three mRoPE components.
+
+        Args:
+            boundaries: Per-sample boundaries of the packed stream, when the
+                caller already has them on the host (a CP run reads them off the
+                batch once for the whole layout). Read off ``packed_seq_params``
+                otherwise.
+        """
+        if packed_seq_params is None or packed_seq_params.qkv_format != 'thd':
+            return torch.arange(input_ids.size(1), device=input_ids.device).unsqueeze(0).expand(input_ids.size(0), -1)
+
+        # The boundaries are the global (unsharded) ones -- either the host-side
+        # copy Relax puts on the batch, or the padded ones of a batch this model
+        # flattened itself. Either way they line up with `input_ids` because the
+        # caller splits the positions together with the tokens.
+        if boundaries is None:
+            boundaries = undivided_boundaries(packed_seq_params)
+        total = int(boundaries[-1])
+        assert total == input_ids.numel(), (
+            f'packed length {total} does not match the {input_ids.numel()} tokens on this rank: '
+            'per-sample mRoPE positions are only defined for an undivided sequence.'
+        )
+        boundaries = torch.as_tensor(boundaries, dtype=torch.long, device=input_ids.device)
+        starts = boundaries[:-1]
+        lengths = boundaries[1:] - starts
+        positions = torch.arange(total, device=input_ids.device) - torch.repeat_interleave(starts, lengths)
+        return positions.unsqueeze(0)
+
+    def _postprocess(
+        self,
+        hidden_states: Tensor,
+        *args,
+        **kwargs,
+    ):
+        """Route the decoder's two outputs to their consumers.
+
+        ``Qwen4ExpTransformerBlock`` returns ``(hidden_states, multi_stream)`` when
+        MTP is enabled: the contracted tensor is what the output layer (and, in
+        inference, the caller) expects, while the MTP head needs the multi-stream.
+        """
+        multi_stream = None
+        if isinstance(hidden_states, tuple):
+            hidden_states, multi_stream = hidden_states
+        if multi_stream is not None:
+            # Read by `Qwen4ExpMultiTokenPredictionBlock.forward`. Copied rather
+            # than mutated: the same dict is also handed to the decoder, which has
+            # already run by the time we get here.
+            extra_block_kwargs = dict(kwargs.get('extra_block_kwargs') or {})
+            extra_block_kwargs['mtp_multistream'] = multi_stream
+            kwargs['extra_block_kwargs'] = extra_block_kwargs
+        return super()._postprocess(hidden_states, *args, **kwargs)
