@@ -0,0 +1,345 @@
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Decoder layer for Qwen3.8-Flash-Next (``qwen4_exp``).
+
+Three things make this layer different from a stock Megatron decoder layer, and
+all three are why ``forward`` is fully overridden rather than inherited:
+
+1. **Gated hyper-connections replace the residual stream.** The layer input is
+   ``hc_count * hidden_size`` wide; each sub-block mixes those streams down to
+   ``hidden_size``, runs, then injects its output back into all streams with
+   per-stream weights.
+2. **No layernorms.** ``input_layernorm`` / ``pre_mlp_layernorm`` are
+   ``IdentityOp`` in the spec -- the hyper-connection norms inside (1) do the
+   normalizing.
+3. **QSA sparse attention** on full-attention layers: an indexer picks the top
+   key blocks per query, and either a bool mask (sbhd, CP=1), an int32 block-start
+   carrier (packed) or int64 token indices (CP>1) are handed to attention.
+"""
+
+from __future__ import annotations
+
+import copy
+import logging
+from contextlib import contextmanager
+from typing import Optional
+
+import torch
+from megatron.core.models.gpt.experimental_attention_variant_module_specs import (
+    get_linear_attention_pattern,
+)
+from megatron.core.packed_seq_params import PackedSeqParams
+from megatron.core.tensor_parallel import gather_from_sequence_parallel_region
+from megatron.core.transformer.enums import AttnMaskType
+from megatron.core.transformer.transformer_layer import TransformerLayer
+
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.hyper_connection import (
+    Qwen4ExpTextGatedResidual,
+)
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.ple import (
+    Qwen4ExpTextPLELayer,
+)
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.qsa import (
+    QSAIndexer,
+    QSASparseCoreAttention,
+    QSA_SPARSE_KERNEL_ENV,
+    qsa_sparse_supported,
+    use_qsa_sparse_kernel,
+)
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.qsa.cp_utils import (
+    normalize_cu_seqlens,
+    reconstruct_tensor_cp,
+)
+
+logger = logging.getLogger(__name__)
+
+
+class Qwen4ExpLayer(TransformerLayer):
+    """Decoder layer with gated hyper-connections and optional QSA selection."""
+
+    def __init__(self, config, submodules, layer_number: int = 1, **kwargs):
+        super().__init__(config, submodules, layer_number, **kwargs)
+
+        # ---- PLE (per-layer embedding) -------------------------------------
+        # The checkpoint carries the n-gram branch of layer 1 (0-based), i.e. the
+        # second layer, and `ple_layer_ids` is what says so. Build it when the
+        # config asks for it and refuse to run a PLE layer without it: the branch
+        # is 51.2B of the checkpoint's parameters, so silently skipping it would
+        # leave most of the weights unused and the numbers quietly wrong.
+        self.ple = None
+        ple_layer_ids = [int(layer_id) for layer_id in (getattr(config, 'ple_layer_ids', None) or [])]
+        if self.layer_number in ple_layer_ids:
+            if not getattr(config, 'ple_enabled', False):
+                raise RuntimeError(
+                    f'Layer {self.layer_number} is a PLE layer (config.ple_layer_ids={ple_layer_ids}) but PLE is '
+                    'disabled (config.ple_enabled=False). Run with a checkpoint whose ple_layer_ids is empty '
+                    '(e.g. a truncation built without --keep-ple), or enable the branch.'
+                )
+            self.ple = Qwen4ExpTextPLELayer(
+                config,
+                layer_number=self.layer_number,
+                ple_layer_index=ple_layer_ids.index(self.layer_number),
+                pg_collection=getattr(self, 'pg_collection', None),
+            )
+
+        # ---- QSA indexer + sparse core attention ---------------------------
+        is_linear_attention = self._resolve_is_linear_attention(config)
+        if self.ple is not None and not is_linear_attention:
+            # The reference validates the same thing (`_validate_ple_layers`): the
+            # PLE output rides the hyper-connection stream into the attention
+            # sub-block, which only the linear-attention layers were trained to
+            # expect it in.
+            raise ValueError(
+                f'PLE is only defined on linear-attention layers, but layer {self.layer_number} is a '
+                f'full-attention one (config.ple_layer_ids={ple_layer_ids}).'
+            )
+        if not is_linear_attention and getattr(config, 'indexer_n_heads', None):
+            self.self_attention.indexer = QSAIndexer(config, tp_group=self.tp_group)
+            if qsa_sparse_supported(config.kv_channels):
+                attn = self.self_attention
+                attn.core_attention = QSASparseCoreAttention(
+                    attn.core_attention, config, softmax_scale=config.softmax_scale
+                )
+
+        # ---- gated hyper-connections ---------------------------------------
+        self.attn_hyper_connection = Qwen4ExpTextGatedResidual(config)
+        self.mlp_hyper_connection = Qwen4ExpTextGatedResidual(config)
+
+    def _resolve_is_linear_attention(self, config) -> bool:
+        """Whether this layer is a GDN layer; overridden by the MTP inner layer.
+
+        Asked of Megatron rather than read off ``config.linear_attention_freq``
+        directly: that field is either an interval (``4`` = one full-attention
+        layer every four) or an explicit per-layer list, and
+        ``get_linear_attention_pattern`` is what normalises them. It is also
+        what ``spec.py`` uses to pick the layer's spec, so going through it is
+        what keeps this layer's opinion and its submodules' in agreement.
+        """
+        pattern = get_linear_attention_pattern(config)
+        return bool(pattern[self.layer_number - 1])
+
+    def forward(self, hidden_states: torch.Tensor, **kwargs):
+        attention_mask = kwargs.get('attention_mask')
+        packed_seq_params: PackedSeqParams = kwargs.get('packed_seq_params')
+        attn_kwargs = dict(
+            attention_mask=attention_mask,
+            inference_context=kwargs.get('inference_context'),
+            rotary_pos_emb=kwargs.get('rotary_pos_emb'),
+            rotary_pos_cos=kwargs.get('rotary_pos_cos'),
+            rotary_pos_sin=kwargs.get('rotary_pos_sin'),
+            attention_bias=kwargs.get('attention_bias'),
+            packed_seq_params=packed_seq_params,
+            sequence_len_offset=kwargs.get('sequence_len_offset'),
+        )
+
+        # ---- PLE (per-layer embedding) -------------------------------------
+        # The reference adds the n-gram branch to the layer input before the
+        # attention sub-block, on the expanded `hc_count * hidden_size` stream --
+        # which is what the block has already handed us (the `repeat` happens
+        # there, once per block rather than once per layer).
+        if self.ple is not None:
+            ple_input_ids = getattr(packed_seq_params, 'ple_input_ids', None)
+            if ple_input_ids is None:
+                raise RuntimeError(
+                    f'layer {self.layer_number} carries the PLE branch but no token ids travelled with the batch. '
+                    'The model attaches them to `packed_seq_params` when it knows the layout of this rank; a stage '
+                    'that owns the layer without owning the embedding (a later pipeline stage) cannot run it.'
+                )
+            hidden_states = hidden_states + self.ple(hidden_states, ple_input_ids, packed_seq_params)
+
+        # ---- attention sub-block (mirrors transformers Qwen4ExpTextDecoderLayer) ----
+        hidden_states, hyper_input, injection_weights = self.attn_hyper_connection(hidden_states)
+        qsa_selection, sparse = self._qsa_select(hidden_states, attn_kwargs, kwargs.get('position_ids'))
+        if qsa_selection is not None:
+            # sparse: the block-start carrier (int32, thd) or token indices (int64,
+            # CP>1 sbhd) consumed by QSASparseCoreAttention; mask fallback: bool mask
+            # consumed by the backend under attn_mask_type=arbitrary.
+            attn_kwargs = dict(attn_kwargs, attention_mask=qsa_selection)
+        # `arbitrary` mask type is only needed for the bool-mask path; the sparse
+        # kernel reads the indices and ignores attn_mask_type.
+        with self._qsa_arbitrary_mask(qsa_selection is not None and not sparse):
+            hidden_states, _ = self.self_attention(hidden_states=hidden_states, **attn_kwargs)
+        injection = hidden_states.unsqueeze(-2) * injection_weights.unsqueeze(-1)
+        hidden_states = hyper_input + injection.flatten(-2)
+
+        # ---- mlp sub-block -------------------------------------------------
+        hidden_states, hyper_input, injection_weights = self.mlp_hyper_connection(hidden_states)
+        hidden_states = self.mlp(hidden_states)
+        if isinstance(hidden_states, tuple):
+            hidden_states = hidden_states[0]
+        injection = hidden_states.unsqueeze(-2) * injection_weights.unsqueeze(-1)
+        hidden_states = hyper_input + injection.flatten(-2)
+        return hidden_states, None
+
+    @contextmanager
+    def _qsa_arbitrary_mask(self, enabled: bool):
+        """Temporarily switch the attention to the ``arbitrary`` mask type.
+
+        ``Attention.forward`` takes no ``attn_mask_type`` argument -- it reads
+        ``self.attn_mask_type`` (and core_attention's) -- so a custom mask is
+        silently ignored unless the type is flipped. Restored in ``finally`` so a
+        raising forward cannot leave the layer stuck in the slower unfused mode.
+        """
+        if not enabled:
+            yield
+            return
+        attn = self.self_attention
+        targets = [attn]
+        core = getattr(attn, 'core_attention', None)
+        if core is not None:
+            targets.append(core)
+        saved = [(t, t.attn_mask_type) for t in targets if hasattr(t, 'attn_mask_type')]
+        for t, _ in saved:
+            t.attn_mask_type = AttnMaskType.arbitrary
+        try:
+            yield
+        finally:
+            for t, old in saved:
+                t.attn_mask_type = old
+
+    def _qsa_select(self, hidden_states, attn_kwargs, position_ids=None):
+        """Choose the QSA selection representation for this forward.
+
+        Returns ``(selection, is_sparse)``. ``is_sparse`` means ``selection`` is the
+        tensor consumed by ``QSASparseCoreAttention`` -- the int32 block-start
+        carrier for thd, int64 token indices for sbhd under CP; otherwise it is the
+        bool mask, or ``None`` for full attention. CP needs the all_gather comm type
+        (the selection has to see every key before attention runs; ring/p2p cannot
+        provide that).
+        """
+        indexer = getattr(self.self_attention, 'indexer', None)
+        sparse_ok = isinstance(getattr(self.self_attention, 'core_attention', None), QSASparseCoreAttention)
+        if indexer is None:
+            return None, False
+        packed_seq_params: PackedSeqParams = attn_kwargs.get('packed_seq_params')
+        is_thd = packed_seq_params is not None and packed_seq_params.qkv_format == 'thd'
+        cp_size = self.config.context_parallel_size
+        needs_kernel = is_thd or cp_size > 1
+
+        # sbhd with CP==1 -- the mask path is exact and stays on the fused backend.
+        if not needs_kernel:
+            return self._qsa_select_mask(hidden_states, attn_kwargs), False
+
+        # From here the mask path is not an option, so by default a failure raises
+        # instead of silently degrading to dense attention. An explicit opt-out
+        # via the env var is the one sanctioned fallback.
+        if not sparse_ok:
+            if not use_qsa_sparse_kernel():
+                logger.warning(
+                    'QSA sparse kernel is disabled via %s=0; falling back to full attention (%s).',
+                    QSA_SPARSE_KERNEL_ENV,
+                    'packing/thd' if is_thd else f'CP={cp_size}',
+                )
+                return None, False
+            raise RuntimeError(
+                f'QSA needs the sparse kernel here ({"packing/thd" if is_thd else f"CP={cp_size}"}), but '
+                'QSASparseCoreAttention was not installed -- triton is missing or kv_channels='
+                f'{getattr(self.config, "kv_channels", None)} is not a power of two. Use --padding-free false '
+                f'with context_parallel_size 1 to take the bool-mask path, or set {QSA_SPARSE_KERNEL_ENV}=0 to '
+                'fall back to full attention.'
+            )
+        if cp_size > 1 and getattr(self.config, 'cp_comm_type', None) != 'all_gather':
+            raise RuntimeError(
+                f'QSA sparse selection with context_parallel_size={cp_size} requires '
+                "cp_comm_type='all_gather' (got "
+                f'{getattr(self.config, "cp_comm_type", None)!r}): the selection has to see every '
+                'key before attention runs, which ring/p2p cannot provide.'
+            )
+        rotary_pos_emb = attn_kwargs.get('rotary_pos_emb')
+        if rotary_pos_emb is None:
+            raise RuntimeError(
+                'QSA sparse selection needs rotary_pos_emb (blocks rotate at their first token '
+                'position) but it was not passed to the layer.'
+            )
+        if is_thd:
+            indices = self._qsa_select_indices_thd(hidden_states, rotary_pos_emb, packed_seq_params, position_ids)
+        else:
+            indices = self._qsa_select_indices_sbhd(hidden_states, rotary_pos_emb)
+        return indices, True
+
+    def _qsa_select_indices_sbhd(self, hidden_states, rotary_pos_emb):
+        if self.config.sequence_parallel and self.config.tensor_model_parallel_size > 1:
+            hidden_states = gather_from_sequence_parallel_region(hidden_states, tensor_parallel_output_grad=False)
+        if self.config.context_parallel_size > 1:
+            hidden_states = reconstruct_tensor_cp(hidden_states, None, dim=0)
+            rotary_pos_emb = reconstruct_tensor_cp(rotary_pos_emb, None, dim=0)
+        return self.self_attention.indexer.selection_as_token_indices(hidden_states, rotary_pos_emb)
+
+    def _qsa_select_indices_thd(self, hidden_states, rotary_pos_emb, packed_seq_params, position_ids=None):
+        if self.config.sequence_parallel and self.config.tensor_model_parallel_size > 1:
+            hidden_states = gather_from_sequence_parallel_region(hidden_states, tensor_parallel_output_grad=False)
+        psp_for_cp = None
+        if self.config.context_parallel_size > 1:
+            # The CP partition helpers require int32 cu; the training pipeline
+            # produces int32, but normalize callers that hand us int64.
+            if packed_seq_params.cu_seqlens_q is not None and packed_seq_params.cu_seqlens_q.dtype != torch.int32:
+                psp_for_cp = copy.copy(packed_seq_params)
+                psp_for_cp.cu_seqlens_q = packed_seq_params.cu_seqlens_q.to(torch.int32)
+                if packed_seq_params.cu_seqlens_q_padded is not None:
+                    psp_for_cp.cu_seqlens_q_padded = packed_seq_params.cu_seqlens_q_padded.to(torch.int32)
+            else:
+                psp_for_cp = packed_seq_params
+            local_len = hidden_states.shape[0]
+            hidden_states = reconstruct_tensor_cp(hidden_states, psp_for_cp, dim=0)
+        # Per-token rotary angles. Without rope fusion the model already indexes
+        # the freq table by position_ids, so what arrives is per-token (zigzag
+        # sharded under CP -- undo it like hidden_states).
+        freqs = rotary_pos_emb
+        if self.config.context_parallel_size > 1:
+            fused_table = self.config.position_embedding_type != 'mrope' and (
+                self.config.apply_rope_fusion or freqs.shape[0] != local_len
+            )
+            if fused_table:
+                if position_ids is None:
+                    raise RuntimeError(
+                        'QSA thd selection under CP needs position_ids to index the fused rotary '
+                        'table (apply_rope_fusion=true hands over the raw table, not per-token '
+                        'freqs). Pass position_ids, or set --apply-rope-fusion false.'
+                    )
+                pos = reconstruct_tensor_cp(position_ids, psp_for_cp, dim=1)
+                freqs = freqs[pos.reshape(-1)]
+            else:
+                freqs = reconstruct_tensor_cp(freqs, psp_for_cp, dim=0)
+        else:
+            fused_table = freqs.shape[0] != hidden_states.shape[0]
+            if fused_table:
+                raise RuntimeError(
+                    f'QSA thd selection got a fused rotary table ({freqs.shape[0]} rows for '
+                    f'{hidden_states.shape[0]} tokens): apply_rope_fusion=true hands over the raw '
+                    'table rather than per-token freqs. Set --apply-rope-fusion false.'
+                )
+        # the CP reconstruct works in the padded pack space, so align against the
+        # padded cu when present
+        cu = packed_seq_params.cu_seqlens_q_padded
+        if cu is None:
+            cu = packed_seq_params.cu_seqlens_q
+        if cu is None:
+            raise RuntimeError(
+                'QSA thd selection needs packed_seq_params.cu_seqlens_q to find document boundaries, but it is missing.'
+            )
+        cu = normalize_cu_seqlens(cu, hidden_states.shape[0])
+        hidden_tok = hidden_states.reshape(hidden_states.shape[0], -1)
+        return self.self_attention.indexer.select_block_starts_thd(
+            hidden_tok, freqs, cu, force_materialize=self.config.context_parallel_size > 1
+        )
+
+    def _qsa_select_mask(self, hidden_states, attn_kwargs):
+        # Bool-mask QSA on the backend's `arbitrary` mask. Only reached for sbhd
+        # with CP==1 -- thd and CP>1 are routed to the kernel, because an
+        # arbitrary mask is rejected under packing and this path never gathers
+        # keys across CP ranks. Returning None means full attention, which here
+        # only happens when the sequence is short enough that selection is a
+        # no-op anyway (selection_as_mask short-circuits at max_blocks <= block_topk).
+        indexer = self.self_attention.indexer
+        if indexer is None:
+            return None
+        rotary_pos_emb = attn_kwargs.get('rotary_pos_emb')
+        if rotary_pos_emb is None:
+            raise RuntimeError(
+                'QSA bool-mask selection needs rotary_pos_emb (blocks rotate at their first '
+                'token position) but it was not passed to the layer.'
+            )
+        if self.config.sequence_parallel and self.config.tensor_model_parallel_size > 1:
+            hidden_states = gather_from_sequence_parallel_region(hidden_states, tensor_parallel_output_grad=False)
+        return indexer.selection_as_mask(hidden_states, rotary_pos_emb)
