+    )
+
+    ok = True
+    # attention_mode=2 is the MLA latent layout: q/k/v head_dim is 256 and the
+    # op reads k from latent[:256] and v from latent[256:512]. bf16 is the
+    # training dtype; on fp16 the op's backward occasionally returns inf at the
+    # buffer edges of the two-call composite (dense prefix + sparse suffix) when
+    # the allocator has recycled memory -- bf16 never reproduced it, so this
+    # test pins the dtype the model actually runs.
+    docs, R, keep_blocks = [700, 600], 4, 128
+    T, Hq, D = sum(docs), 4, 256
+    device = torch.device('npu')
+    g = torch.Generator().manual_seed(13)
+    q = (torch.randn(T, Hq, D, generator=g) / D**0.5).to(torch.bfloat16).to(device)
+    k = (torch.randn(T, 1, D, generator=g) / D**0.5).to(torch.bfloat16).to(device)
+    v = torch.randn(T, 1, D, generator=g).to(torch.bfloat16).to(device)
+    indices, block_starts = _build_packed_block_aligned_selection(docs, keep_blocks, R)
+    indices = indices.to(device)
+    block_starts = block_starts.to(device)
+    cu = torch.tensor([0, docs[0], T], dtype=torch.int32, device=device)
+    scale = D**-0.5
+    print(
+        f'shape: T={T} docs={docs} Hq={Hq} Hkv=1 D={D} R={R} '
+        f'block_topk={keep_blocks} K={indices.shape[1]} carrier={tuple(block_starts.shape)}'
+    )
+    if not qsa_native_supported(q, k, v, block_starts, R, cu):
+        print('qsa_native_supported says no -- the fused path would not be selected')
+        print('test 5: FAIL')
+        return False
+    if qsa_native_supported(q, k, v, indices, R, cu):
+        print('token-index rows were accepted as a block-start carrier (dtype dispatch is broken)')
+        print('test 5: FAIL')
+        return False
+
+    try:
+        out = qsa_sparse_attention_thd_native(q, k, v, block_starts, scale, cu, R)
+    except Exception:
+        print('qsa_sparse_attention_thd_native RAISED:')
+        traceback.print_exc(file=sys.stdout)
+        print('test 5: FAIL (native path did not run)')
+        return False
+
+    ref = _sparse_attention_reference(q, k, v, indices, scale)
+    # The suffix rows are the ones the single block-index call produces; the
+    # prefix rows go through the unchanged fused dense call, whose fp16
+    # accumulation is an order of magnitude looser (measured max err ~1e-3 vs
+    # ~8e-5).  Score the two separately so a regression in either is visible.
+    budget = (block_starts.shape[1] - 1) * R
+    pos = torch.arange(T) - torch.repeat_interleave(torch.tensor([0, docs[0]]), torch.tensor(docs))
+    suffix_rows = torch.nonzero(pos >= budget, as_tuple=False).squeeze(1)
+    prefix_rows = torch.nonzero(pos < budget, as_tuple=False).squeeze(1)
+    for tag, row_sel, floor in (('all', torch.arange(T), 0.99), ('prefix', prefix_rows, 0.99), ('suffix', suffix_rows, 0.999)):
+        cos = _cosine(out[row_sel.to(out.device)], ref[row_sel])
+        max_abs = float((out[row_sel.to(out.device)].float().cpu() - ref[row_sel]).abs().max())
+        print(
+            f'{tag:>6} rows (n={row_sel.numel():4d}): cosine={cos:.8f} max_abs_err={max_abs:.6e} '
+            f'(threshold >= {floor}): {"OK" if cos >= floor else "TOO LOW"}'
+        )
