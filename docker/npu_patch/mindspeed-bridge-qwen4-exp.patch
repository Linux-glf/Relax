+    is_pp_first_stage,
+    is_pp_last_stage,
+    is_vp_first_stage,
+    is_vp_last_stage,
+)
+from megatron.core.transformer.spec_utils import ModuleSpec
+
+from megatron.bridge.models.gpt_provider import GPTModelProvider
+from megatron.bridge.utils.vocab_utils import calculate_padded_vocab_size
+
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.gdn import (
+    fix_gdn_out_norm_zero_centered,
+)
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.model import Qwen4ExpModel
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.spec import (
+    get_qwen4_exp_block_spec,
+    get_qwen4_exp_local_layer_ids,
+    get_qwen4_exp_mtp_block_spec,
+)
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass
+class Qwen4ExpModelProvider(GPTModelProvider):
+    """Provider of the Qwen3.8-Flash-Next text tower.
+
+    ``transformer_layer_spec`` is the plugin's block builder, so a model built
+    from this provider has the gated hyper-connections, the hybrid attention
+    pattern and the MoE experts of the checkpoint; ``provide()`` additionally
+    builds the MTP spec and applies the two post-build fixes the architecture
+    needs.
+    """
+
+    # =========================================================================
+    # Gated hyper-connections
+    # =========================================================================
+    # `hc_count` residual streams per token; the low-rank mixers of the
+    # attention/MLP hyper-connections and of the two block-level mixers have rank
+    # `hc_lowrank` (checkpoint: 4 streams of 2560, rank 320).
+    hc_count: int = 4
+    hc_lowrank: int = 320
+
+    # =========================================================================
+    # Hybrid attention
+    # =========================================================================
+    transformer_layer_spec: ModuleSpec | Callable[["GPTModelProvider"], ModuleSpec] = get_qwen4_exp_block_spec
+    experimental_attention_variant: str = "gated_delta_net"
+    linear_attention_freq: int | List[int] = 4
+
+    # --- Gated DeltaNet ---
+    linear_conv_kernel_dim: int = 4
+    linear_key_head_dim: int = 128
+    linear_value_head_dim: int = 128
+    linear_num_key_heads: int = 16
+    linear_num_value_heads: int = 48
+
+    # --- QSA indexer (full-attention layers) ---
+    # The indexer scores key blocks of `indexer_compress_ratio` tokens with
+    # `indexer_n_heads` query heads and keeps `indexer_budget` tokens per query.
+    indexer_n_heads: int = 4
+    indexer_kv_heads: int = 1
+    indexer_head_dim: int = 128
+    indexer_compress_ratio: int = 4
+    indexer_budget: int = 2048
+
+    # =========================================================================
+    # Common language model parameters
+    # =========================================================================
+    normalization: str = "RMSNorm"
+    gated_linear_unit: bool = True
+    add_bias_linear: bool = False
+    add_qkv_bias: bool = False
+    qk_layernorm: bool = True
+    # The checkpoint packs the output gate into `q_proj`, so the HF -> Megatron
+    # QKV merge has to know that q is twice as wide as the query heads need.
+    attention_output_gate: bool = True
+    kv_channels: int | None = 256
+    num_query_groups: int = 2
+    hidden_dropout: float = 0.0
+    attention_dropout: float = 0.0
+    attention_softmax_in_fp32: bool = True
+    # The gated attention of this model scales the softmax by the plain
+    # `1 / sqrt(head_dim)` (`attention_scaling` is the indexer's RoPE mscale).
+    attention_scaling: float = 1.0
+    # The sigmoid gate of the attention output and of the GDN output norm.
+    output_gate_type: str = "sigmoid"
+    apply_rotary_pos_emb_in_fp32: bool = False
+    rotary_base: float = 10000000.0
+    rotary_percent: float = 0.25
+    # Megatron's own interleaved convention (adjacent frequency pairs). The
+    # checkpoint's flag of the almost-same name -- `mrope_interleaved` -- means
+    # something else entirely (see below) and must not be routed here.
+    rotary_interleaved: bool = False
+    position_embedding_type: str = "mrope"
+    mrope_section: List[int] = field(default_factory=lambda: [11, 11, 10])
+    # The checkpoint's `mrope_interleaved`: the T/H/W sections are interleaved
+    # per frequency (`[THTWTHTW...]`) rather than laid out in chunks
+    # (`[TTT...HHH...WWW]`). `Qwen3VLMultimodalRotaryEmbedding` implements the
+    # interleaved layout only, so the off value is rejected at build time.
+    mrope_interleaved: bool = True
+    seq_length: int = 262144
+
+    # =========================================================================
+    # MoE
+    # =========================================================================
+    num_moe_experts: int = 512
+    moe_ffn_hidden_size: int = 640
+    moe_router_topk: int = 10
+    moe_shared_expert_intermediate_size: int = 640
+    moe_shared_expert_gate: bool = True
+    moe_grouped_gemm: bool = True
+    moe_router_dtype: str = "fp32"
+    moe_router_load_balancing_type: str = "global_aux_loss"
+    moe_router_pre_softmax: bool = False
+    moe_token_dispatcher_type: str = "alltoall"
+    moe_permute_fusion: bool = False
+    # The checkpoint is trained without a router aux loss (`output_router_logits`
+    # is false and the router is a plain top-k + softmax over the selected
+    # experts), so the coefficient is zero even though the load-balancing type is
+    # the aux-loss one -- that combination is what makes Megatron's router
+    # reproduce the checkpoint's routing exactly.
+    moe_aux_loss_coeff: float = 0.0
+
+    # =========================================================================
+    # PLE (per-layer embeddings): the hashed n-gram lookup of
+    # `modelling_qwen4_exp/ple.py`, injected into the hyper-connection stream of
+    # the layers `ple_layer_ids` names (one-based, and only linear-attention
+    # layers -- the reference validates the same thing).
+    #
+    # The 95 GiB n-gram table is kept off the device as one pinned host buffer per
+    # rank -- this rank's rows of it, the way a vocabulary is sharded (`ple.py`) --
+    # and it is part of this model's state dict like any other weight. It is *read*
+    # a shard at a time from the checkpoint's own files, so `ple_table_dir` names
+    # the checkpoint the shards come from; the bridge fills it from the checkpoint
+    # it converts, and the conversion itself hands the shards over when it has them.
+    # `split_ngram_parts` is how the checkpoint cut the table up, which is what the
+    # load and the export put it back together with.
+    # =========================================================================
+    ple_enabled: bool = False
+    ple_layer_ids: List[int] = field(default_factory=list)
+    ple_table_dir: Optional[str] = None
+    ngram_size: int = 3
+    heads_per_ngram: int = 8
+    ple_embed_dim: int = 2560
+    ple_conv_kernel_size: int = 4
+    ngram_vocab_size_base: int = 20_000_000
+    make_ngram_vocab_size_divisible_by: int = 128
+    split_ngram_parts: int = 128
+    ple_seed: int = 1234
+
+    # =========================================================================
+    # Performance / checkpointing
+    # =========================================================================
+    bias_activation_fusion: bool = True
+    hetereogenous_dist_checkpoint: bool = True
+    mtp_num_layers: Optional[int] = None
+    mtp_loss_scaling_factor: float = 0.1
+    # Keep the stock behaviour: the embedding scatters to the sequence-parallel
+    # layout itself. The VL models set this False and scatter by hand after they
+    # merge the vision embeddings into the sequence; the text tower has no merge
+    # step, and every layer here is written against the scattered layout -- the
+    # GDN scales its sequence length by `sp_size`, the QSA indexer gathers the
+    # input back to the full sequence to run selection, and the MTP head gathers
+    # and re-scatters around its own projections. Left False, layer 0 would be
+    # handed the full sequence, the column-parallel projections would gather it
+    # to `sp_size * T`, and the GDN's reshape would fail.
+    scatter_embedding_sequence_parallel: bool = True
+
+    def _model_class(self) -> type:
+        """Class ``provide()`` builds; the VL provider swaps in the multimodal model."""
+        return Qwen4ExpModel
+
+    def _model_extra_kwargs(self) -> dict:
+        """Constructor arguments of ``_model_class()`` that this provider adds."""
+        return {}
+
+    # =========================================================================
+    # Context parallelism
+    # =========================================================================
+    def finalize(self) -> None:
+        """Declare the context-parallel communication contract before mcore validates the config.
+
+        A context-parallel run of this model is an *all-gather* one: the QSA
+        sparse selection and the GatedDeltaNet both rebuild the whole sequence
+        before they read it (``layer.py`` refuses to run the selection under
+        ``CP > 1`` unless the config says so), which ring point-to-point
+        communication cannot provide. The declaration has to be made here,
+        because nothing upstream makes it: ``TransformerConfig`` leaves
+        ``cp_comm_type`` at ``None``, Megatron-Bridge providers carry it as a
+        constant field (Qwen3.5-VL pins ``"p2p"``), and Relax's bridge path does
+        not forward ``--cp-comm-type`` -- the parsed value is a per-layer *list*
+        that mcore would then require to have one entry per layer.
+
+        Only a run that actually has a CP group gets the declaration: a
+        ``CP == 1`` configuration keeps the ``None`` its baselines were measured
+        with.
+        """
+        # ``cp_comm_type`` is a ``TransformerConfig`` field, so it is defined
+        # outside this class: pylint reads the check below as a use before
+        # definition and the write as an outside-init assignment.
+        # pylint: disable=access-member-before-definition, attribute-defined-outside-init
+        if self.context_parallel_size > 1 and self.cp_comm_type is None:
+            self.cp_comm_type = 'all_gather'
+            logger.info(
+                "Qwen4Exp: context_parallel_size=%d without a cp_comm_type declaration; "
+                "using 'all_gather' (the sparse selection and the GatedDeltaNet both need the "
+                'whole sequence).',
+                self.context_parallel_size,
+            )
+        super().finalize()
+
+    def provide(self, pre_process=None, post_process=None, vp_stage=None) -> GPTModel:
+        """Build one pipeline stage of the text model.
+
+        Mirrors ``GPTModelProvider.provide`` (same argument handling, same
+        padded-vocab and meta-device behaviour) but builds the plugin's model
+        class and its two specs, then applies the post-build fix the architecture
+        needs.
+        """
+        if self.transformer_impl != "transformer_engine":
+            # The layer specs resolve their linears through the backend spec
+            # provider, which is only wired up for the TE (Ascend) implementation.
+            raise NotImplementedError(f"Qwen4Exp does not support transformer_impl={self.transformer_impl!r}.")
+
+        if self.ple_layer_ids and not self.ple_enabled:
+            raise ValueError(
+                f'ple_layer_ids={self.ple_layer_ids} but ple_enabled is False: the checkpoint carries the n-gram '
+                'branch, and building the layers without it would leave 51.2B of its parameters unused and the '
+                'numbers quietly wrong. The bridge sets ple_enabled from the checkpoint config.'
+            )
+        if self.ple_enabled and not self.ple_layer_ids:
+            raise ValueError('ple_enabled is True but ple_layer_ids is empty: no layer would carry the branch.')
+        if self.ple_enabled and self.init_model_with_meta_device:
+            # The three hash-index buffers of the PLE module are derived from the
+            # config *at build time* and have no bridge mapping (they are not
+            # weights -- `ple.py` explains why), so a build on the meta device
+            # would leave them as empty meta tensors and the hash would then read
+            # whatever the lookup makes of that: quietly wrong numbers, with only
+            # the alignment harness to catch them. Map the buffers in
+            # `qwen4_exp_bridge.py` before lifting this.
+            raise NotImplementedError(
+                'PLE does not support init_model_with_meta_device: its index buffers would stay meta tensors.'
+            )
+
+        block_spec = get_qwen4_exp_block_spec(self, vp_stage=vp_stage)
+        mtp_spec = get_qwen4_exp_mtp_block_spec(self, vp_stage=vp_stage)
+
+        assert self.vocab_size is not None, "vocab_size must be configured before calling provide()"
+        if self.should_pad_vocab:
+            padded_vocab_size = calculate_padded_vocab_size(
+                self.vocab_size, self.make_vocab_size_divisible_by, self.tensor_model_parallel_size
+            )
+        else:
+            padded_vocab_size = self.vocab_size
+
+        # Defaults, as in the stock provider: a stage is an input stage when it
+        # is the first stage of the first pipeline rank, and an output stage when
+        # it is the last stage of the last rank.
+        pg_collection = self._pg_collection
+        if pre_process is None:
+            pre_process = is_vp_first_stage(
+                vp_stage=vp_stage, vp_size=self.virtual_pipeline_model_parallel_size
+            ) and is_pp_first_stage(pg_collection.pp)
+        if post_process is None:
+            post_process = is_vp_last_stage(
+                vp_stage=vp_stage, vp_size=self.virtual_pipeline_model_parallel_size
+            ) and is_pp_last_stage(pg_collection.pp)
+
+        # Read by the TE layers and by `Qwen4ExpTransformerBlock` to resolve
+        # their own offsets without touching legacy globals.
+        self._vp_stage = vp_stage  # pylint: disable=attribute-defined-outside-init
+
+        with model_init_device_context(self.init_model_with_meta_device):
+            model = self._model_class()(
+                config=self,
+                transformer_layer_spec=block_spec,
+                vocab_size=padded_vocab_size,
+                max_sequence_length=self.seq_length,
+                fp16_lm_cross_entropy=self.fp16_lm_cross_entropy,
+                parallel_output=self.parallel_output,
+                share_embeddings_and_output_weights=self.share_embeddings_and_output_weights,
+                position_embedding_type=self.position_embedding_type,
+                rotary_percent=self.rotary_percent,
+                rotary_base=self.rotary_base,
+                rope_scaling=self.rope_scaling,
+                rope_scaling_factor=self.rope_scaling_factor,
+                seq_len_interpolation_factor=self.seq_len_interpolation_factor,
+                pre_process=pre_process,
+                post_process=post_process,
+                scatter_embedding_sequence_parallel=self.scatter_embedding_sequence_parallel,
+                mtp_block_spec=mtp_spec,
+                pg_collection=pg_collection,
+                vp_stage=vp_stage,
+                **self._model_extra_kwargs(),
+            )
+
+        # The checkpoint's GDN output norm is ones-style while every other norm
+        # of the model is zero-centered, and the flag is read from the (shared)
+        # transformer config, so the layers have to be patched after the build.
+        patched = fix_gdn_out_norm_zero_centered(model.decoder.layers)
+        expected = sum(
+            get_linear_attention_pattern(config=self)[layer_id]
+            for layer_id in get_qwen4_exp_local_layer_ids(self, vp_stage=vp_stage)
+        )
+        assert patched == expected, (
+            f"patched {patched} GDN output norms on this stage, expected {expected}: "
+            "the layer layout and the attention pattern disagree."
+        )
+
+        return model
+
+
+def model_init_device_context(use_meta_device: bool):
+    """Context manager that makes module buffers/params initialise on ``meta``."""
+    return partial(torch.device, device="meta")() if use_meta_device else contextlib.nullcontext()
