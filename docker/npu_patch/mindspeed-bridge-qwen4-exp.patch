+    print(f'layout: T={T} docs={docs} R={R} k={keep_blocks} NB={layout.NB}')
+
+    # A document-local selection with holes (dropped slots in the middle), the case
+    # that separates "column j holds block order[j]" from "blocks are left-packed".
+    g = torch.Generator().manual_seed(21)
+    order = torch.zeros(T, keep_blocks, dtype=torch.long)
+    picked = torch.zeros(T, keep_blocks, dtype=torch.bool)
+    for t in range(T):
+        n = int(layout.q_nblocks[t])
+        take = min(keep_blocks, n)
+        if take:
+            chosen = torch.randperm(n, generator=g)[:take]
+            slots = torch.randperm(keep_blocks, generator=g)[:take].sort().values
+            order[t, slots] = chosen
+            picked[t, slots] = True
+
+    carrier = _block_start_carrier(order, picked, layout)
