+# config
+# --------------------------------------------------------------------------------------
+
+
+class QSAIndexerTestConfig:
+    """Minimal stand-in for the Megatron ``TransformerConfig`` the indexer reads.
+
+    Only the attributes ``QSAIndexer`` / ``QSASparseCoreAttention`` actually touch.
+    """
+
+    def __init__(
+        self,
+        hidden_size: int = 256,
+        indexer_n_heads: int = 4,
+        indexer_kv_heads: int = 1,
+        indexer_head_dim: int = 32,
+        indexer_compress_ratio: int = 4,
+        indexer_budget: int = 64,
+        layernorm_epsilon: float = 1e-6,
+        params_dtype: torch.dtype = torch.float32,
+        sequence_parallel: bool = False,
+        attention_scaling: float = 1.0,
+        context_parallel_size: int = 1,
+    ):
+        self.hidden_size = hidden_size
+        self.indexer_n_heads = indexer_n_heads
+        self.indexer_kv_heads = indexer_kv_heads
+        self.indexer_head_dim = indexer_head_dim
+        self.indexer_compress_ratio = indexer_compress_ratio
+        self.indexer_budget = indexer_budget
+        self.layernorm_epsilon = layernorm_epsilon
+        self.params_dtype = params_dtype
+        self.sequence_parallel = sequence_parallel
+        self.attention_scaling = attention_scaling
+        self.context_parallel_size = context_parallel_size
+        self.perform_initialization = True
+        # mcore initializer signature: init_method(tensor).
+        self.init_method = lambda w: torch.nn.init.normal_(w, mean=0.0, std=0.02)
+
+
+@contextmanager
+def _cpu_build_device():
+    """Let ``ReplicatedLinear`` allocate on CPU.
+
+    It hardcodes ``torch.cuda.current_device()`` for its parameter device; on a CPU-only
+    torch build (which is what this machine has -- the accelerator comes from
+    ``torch_npu``) that call raises, while under MindSpeed's Ascend runtime
+    ``transfer_to_npu`` has already aliased ``torch.cuda`` onto the NPU. Patching the
+    device lookup keeps this test free of any NPU/triton dependency and does not change
+    a single number the indexer computes.
+    """
+    original = torch.cuda.current_device
+    torch.cuda.current_device = lambda: 'cpu'
+    try:
+        yield
+    finally:
+        torch.cuda.current_device = original
+
+
+def _build_indexer(cfg):
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.qsa import QSAIndexer
+
+    with _cpu_build_device():
+        indexer = QSAIndexer(cfg)
+    # Small random weights: the checkpoint init is all-zero, which would make every score
+    # tie and hide any error in the scoring path.
+    torch.manual_seed(0)
+    with torch.no_grad():
+        indexer.index_qk_proj.weight.normal_(0.0, 0.05)
+        indexer.q_layernorm.weight.normal_(0.0, 0.05)
+        indexer.k_layernorm.weight.normal_(0.0, 0.05)
+    indexer.eval()
+    return indexer
+
+
+def _build_hidden_freqs(cfg, s: int, b: int, rot: int, seed: int = 1234):
+    """``hidden`` [s, b, hidden], ``freqs`` [s, 1, 1, rot] (mcore angles, plain RoPE)."""
+    g = torch.Generator().manual_seed(seed)
+    hidden = torch.randn(s, b, cfg.hidden_size, generator=g)
+    # Angles in [-pi, pi): a real RoPE table rather than noise, so a wrong cos/sin
+    # convention shows up as a mismatched selection instead of hiding in the noise.
+    freqs = (torch.rand(s, 1, 1, rot, generator=g) * 2 - 1) * math.pi
+    return hidden, freqs
+
+
+# --------------------------------------------------------------------------------------
+# key-set encodings
+# --------------------------------------------------------------------------------------
+
+
+def _allowed_keys_from_mask(mask_out: torch.Tensor) -> list:
+    """``[b, 1, s, s]`` bool (True == blocked) -> ``[[{key}, ...], ...]`` per sample/query."""
+    allowed = ~mask_out[:, 0]  # [b, s, s]
+    out = []
+    for sample in range(allowed.shape[0]):
+        rows = []
+        for query in range(allowed.shape[1]):
+            rows.append(set(torch.nonzero(allowed[sample, query], as_tuple=False).flatten().tolist()))
+        out.append(rows)
+    return out
+
+
+def _allowed_keys_from_indices(indices: torch.Tensor) -> list:
+    """``[b, s, K]`` int64 (-1 == unused) -> ``[[{key}, ...], ...]`` per sample/query."""
+    out = []
+    for sample in range(indices.shape[0]):
+        rows = []
+        for query in range(indices.shape[1]):
+            rows.append({int(v) for v in indices[sample, query].tolist() if v >= 0})
+        out.append(rows)
+    return out
+
+
+def _diff_key_sets(lhs: list, rhs: list, limit: int = 4) -> list:
+    """Report the first few (sample, query, missing_on_left, extra_on_left) differences."""
+    diffs = []
+    for sample, (l_rows, r_rows) in enumerate(zip(lhs, rhs)):
+        for query, (l_set, r_set) in enumerate(zip(l_rows, r_rows)):
+            if l_set != r_set:
+                diffs.append((sample, query, sorted(r_set - l_set), sorted(l_set - r_set)))
+                if len(diffs) >= limit:
+                    return diffs
+    return diffs
+
