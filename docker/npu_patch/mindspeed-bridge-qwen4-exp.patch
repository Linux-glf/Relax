+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Multimodal-rope position ids of Qwen3.8-Flash-Next (``qwen4_exp``).
+
+The text tower needs no help here -- every mRoPE component of a text token is
+its position inside its own sample, which ``Qwen4ExpModel._text_position_ids``
+already produces. As soon as an image is in the batch the three components
+differ: inside an image block the temporal and the two spatial coordinates are
+read off the image grid, and the text that follows continues from the largest
+coordinate the image consumed.
+
+:func:`get_rope_index` is a port of the reference implementation
+(``Qwen4ExpPreTrainedModel.get_rope_index`` of
+``transformers.models.qwen4_exp.modeling_qwen4_exp``), with two adaptations to
+how Megatron runs this model:
+
+* the reference walks a ``[batch, seq]`` tensor and asks the processor for
+  ``mm_token_type_ids``; a Megatron batch is one *packed* sequence (thd) whose
+  samples are delimited by ``cu_seqlens``, and Relax never forwards
+  ``mm_token_type_ids`` (the tensor cannot be packed by concatenation -- its
+  per-sample rows have different lengths -- and no Megatron model reads it).
+  The token type is recovered from the ids instead: the processor marks exactly
+  the ``<|image_pad|>``/``<|video_pad|>`` tokens, i.e. ``input_ids ==
+  image_token_id`` / ``video_token_id``, which is what the reference's
+  run-length grouping then operates on;
+* positions are therefore computed **per sample**, so each sample restarts at
+  position 0 the way the reference's per-batch-row loop does.
+"""
+
+from __future__ import annotations
+
+from typing import List, Optional, Sequence, Tuple, Union
+
+import torch
+from torch import Tensor
+
+
+def get_vision_position_ids(
+    start_position: int,
+    grid_thw: Union[Sequence[int], Tensor],
+    temp_merge_size: int = 1,
+    spatial_merge_size: int = 1,
+    time_interval: int = 1,
+    device: Optional[torch.device] = None,
+) -> Tensor:
+    """Three-component positions of one image/video block, in raster order.
+
+    Args:
+        start_position: Offset added to every component (the position the block
+            starts at in the sequence).
+        grid_thw: ``(T, H, W)`` of the block in patches.
+        temp_merge_size: Temporal downscale applied by the vision tower.
+        spatial_merge_size: Spatial downscale applied by the vision tower.
+        time_interval: Spacing between consecutive temporal indices.
+        device: Device of the result.
+
+    Returns:
+        ``[3, T * H * W]`` positions (``[temporal, height, width]``) with the
+        merged grid sizes and the raster (``t``, then ``h``, then ``w``) order of
+        ``transformers.vision_utils``.
+    """
+    llm_grid_t = int(grid_thw[0]) // temp_merge_size
+    llm_grid_h = int(grid_thw[1]) // spatial_merge_size
+    llm_grid_w = int(grid_thw[2]) // spatial_merge_size
+
+    position_temporal = torch.arange(llm_grid_t, device=device) * time_interval
+    position_height = torch.arange(llm_grid_h, device=device) + start_position
+    position_width = torch.arange(llm_grid_w, device=device) + start_position
+
+    t_grid, h_grid, w_grid = torch.meshgrid(position_temporal, position_height, position_width, indexing="ij")
+    vision_position_ids = torch.stack([t_grid, h_grid, w_grid], dim=0).reshape(3, -1)
+    # After the `time_interval` multiply, exactly like the reference.
+    vision_position_ids[0] += start_position
+    return vision_position_ids
+
+
+def _token_types(input_ids: Tensor, image_token_id: int, video_token_id: int) -> Tensor:
+    """Modality of every token: 0 text, 1 image, 2 video.
+
+    The reference gets this from the processor's ``mm_token_type_ids``; the
+    processor only marks the placeholder tokens themselves, so the ids carry the
+    same information (see the module docstring).
+    """
+    token_types = torch.zeros_like(input_ids)
+    token_types[input_ids == image_token_id] = 1
+    token_types[input_ids == video_token_id] = 2
+    return token_types
+
+
+def _type_groups(token_types: Tensor) -> List[Tuple[int, int, int]]:
+    """``(modality, start, end)`` of every run of equal token types, in order."""
+    groups: List[Tuple[int, int, int]] = []
+    values = token_types.tolist()
+    start = 0
+    for index in range(1, len(values) + 1):
+        if index == len(values) or values[index] != values[start]:
+            groups.append((values[start], start, index))
+            start = index
+    return groups
+
+
+def _sample_boundaries(input_ids: Tensor, cu_seqlens: Optional[Sequence[int]]) -> List[int]:
+    """Offsets of the sample boundaries of a packed (thd) or plain batch."""
+    if cu_seqlens is not None:
+        return [int(offset) for offset in cu_seqlens]
+    if input_ids.dim() == 1:
+        return [0, input_ids.numel()]
+    row = input_ids.size(-1)
+    return [index * row for index in range(input_ids.size(0) + 1)]
+
+
+def get_rope_index(
+    spatial_merge_size: int,
+    input_ids: Tensor,
+    image_token_id: int,
+    video_token_id: int,
+    image_grid_thw: Optional[Tensor] = None,
+    video_grid_thw: Optional[Tensor] = None,
+    cu_seqlens: Optional[Sequence[int]] = None,
+) -> Tensor:
+    """Interleaved-mRoPE position ids of a (possibly packed) multimodal batch.
+
+    Args:
+        spatial_merge_size: ``vision_config.spatial_merge_size``.
+        input_ids: ``[1, T]`` for a packed (thd) batch, ``[b, s]`` otherwise. The
+            placeholders must already be expanded to one ``image_token_id`` per
+            merged vision token, which is what the HF processor produces.
+        image_token_id: ``<|image_pad|>``.
+        video_token_id: ``<|video_pad|>``.
+        image_grid_thw: ``[num_images, 3]`` in the order the image blocks appear
+            in the sequence.
+        video_grid_thw: ``[num_videos, 3]``, same ordering.
+        cu_seqlens: Sample boundaries of a packed batch (the host-side copy
+            Megatron keeps on ``PackedSeqParams.cu_seqlens_q_cpu``). Every
+            segment -- including the padding segment Relax appends to the
+            micro-batch -- is treated as one sample.
+
+    Returns:
+        ``[3, 1, T]`` (packed) or ``[3, b, s]`` position ids, ready for
+        ``Qwen3VLMultimodalRotaryEmbedding``.
+    """
+    device = input_ids.device
+    # A video is stored as ``t`` frames of one image; the positions are built
+    # per frame, exactly like the reference.
+    if video_grid_thw is not None and video_grid_thw.numel() > 0:
+        video_grid_thw = torch.repeat_interleave(video_grid_thw, video_grid_thw[:, 0], dim=0)
+        video_grid_thw = video_grid_thw.clone()
+        video_grid_thw[:, 0] = 1
+
+    boundaries = _sample_boundaries(input_ids, cu_seqlens)
+    # The grid tensors are consumed in sequence order, across samples: the image
+    # blocks of sample 0 come first, then those of sample 1, and so on.
+    grid_by_modality = {1: image_grid_thw, 2: video_grid_thw}
+    grid_cursor = {1: 0, 2: 0}
+
+    flat = input_ids.reshape(-1)
+    per_sample_positions = []
+    for start, end in zip(boundaries[:-1], boundaries[1:]):
+        sample_positions = []
+        current_pos = 0
+        for modality, group_start, group_end in _type_groups(
+            _token_types(flat[start:end], image_token_id, video_token_id)
+        ):
+            if modality == 0:
+                text_len = group_end - group_start
+                sample_positions.append(torch.arange(text_len, device=device).view(1, -1).expand(3, -1) + current_pos)
+                current_pos += text_len
+                continue
+
+            grids = grid_by_modality[modality]
+            if grids is None:
+                raise ValueError(
+                    f'input_ids carry {("image", "video")[modality - 1]} tokens but the '
+                    f'grid of that modality was not passed to the model.'
+                )
+            index = grid_cursor[modality]
+            if index >= grids.shape[0]:
+                raise ValueError(
+                    f'input_ids carry more {("image", "video")[modality - 1]} blocks than the '
+                    f'{grids.shape[0]} grids the batch carries.'
+                )
+            grid_cursor[modality] = index + 1
+
+            grid_thw = grids[index]
+            sample_positions.append(
+                get_vision_position_ids(current_pos, grid_thw, 1, spatial_merge_size, device=device)
+            )
+            # The block advances the sequence by its larger merged side, not by
+            # the number of tokens it holds.
+            current_pos += max(int(grid_thw[1]), int(grid_thw[2])) // spatial_merge_size
+
+        if not sample_positions:
+            per_sample_positions.append(torch.zeros(3, end - start, dtype=input_ids.dtype, device=device))
+            continue
+        per_sample_positions.append(torch.cat(sample_positions, dim=1))
+
+    positions = torch.cat(per_sample_positions, dim=1)
+    if cu_seqlens is not None or input_ids.dim() == 1:
+        return positions.unsqueeze(1)
+    return positions.view(3, input_ids.size(0), input_ids.size(-1))
