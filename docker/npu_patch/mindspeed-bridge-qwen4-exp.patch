+def _import_vision():
+    """Import ``vision.py`` (package import first, file loading as a fallback)."""
+    import importlib
+
+    try:
+        return importlib.import_module("mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.vision")
+    except Exception as exc:
+        print(f"[setup] package import failed ({exc}); loading vision.py by path")
+        import importlib.util
+
+        path = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "vision.py")
+        spec = importlib.util.spec_from_file_location("qwen4_exp_vision", path)
+        module = importlib.util.module_from_spec(spec)
+        # ``@dataclass`` looks up ``cls.__module__`` in ``sys.modules``, so the module
+        # has to be registered before it is executed.
+        sys.modules[spec.name] = module
+        try:
+            spec.loader.exec_module(module)
+        except Exception:
+            sys.modules.pop(spec.name, None)
+            raise
+        return module
+
+
+def _visual_tensor_shapes(ckpt_dir: str) -> Dict[str, Tuple[int, ...]]:
+    """Shapes of every ``model.visual.*`` tensor (metadata only, no tensor data read)."""
+    with open(os.path.join(ckpt_dir, "model.safetensors.index.json"), encoding="utf-8") as fp:
+        weight_map = json.load(fp)["weight_map"]
+    keys = [key for key in weight_map if key.startswith(VISION_PREFIX)]
+
+    from safetensors import safe_open
+
+    shapes: Dict[str, Tuple[int, ...]] = {}
+    for shard in sorted({weight_map[key] for key in keys}):
+        with safe_open(os.path.join(ckpt_dir, shard), framework="pt") as fp:
+            for key in keys:
+                if weight_map[key] == shard:
+                    shapes[key] = tuple(fp.get_slice(key).get_shape())
+    return shapes
+
+
+def _load_visual_state_dict(ckpt_dir: str) -> Dict[str, torch.Tensor]:
+    """Read only the ``model.visual.*`` tensors of the checkpoint (partial read by shard)."""
+    with open(os.path.join(ckpt_dir, "model.safetensors.index.json"), encoding="utf-8") as fp:
+        weight_map = json.load(fp)["weight_map"]
+
+    keys = [key for key in weight_map if key.startswith(VISION_PREFIX)]
+    shards = sorted({weight_map[key] for key in keys})
+    print(f"[ckpt] {len(keys)} {VISION_PREFIX}* tensors live in shard(s) {shards}")
+
+    from safetensors import safe_open
+
+    state: Dict[str, torch.Tensor] = {}
+    for shard in shards:
+        with safe_open(os.path.join(ckpt_dir, shard), framework="pt") as fp:
+            for key in keys:
+                if weight_map[key] == shard:
+                    state[key[len(VISION_PREFIX) :]] = fp.get_tensor(key)
+
+    size_gib = sum(t.numel() * t.element_size() for t in state.values()) / 2**30
+    print(f"[ckpt] loaded {len(state)} tensors ({size_gib:.2f} GiB) with safetensors.safe_open")
+    return state
+
+
+def _hf_to_megatron_name(name: str) -> str:
+    """Map one ``model.visual.``-stripped HF parameter name to its Megatron name."""
+    if name.startswith("blocks."):
+        _, index, rest = name.split(".", 2)
+        rest = rest.replace("norm1.", "input_layernorm.").replace("norm2.", "pre_mlp_layernorm.")
+        rest = rest.replace("attn.qkv.", "self_attention.linear_qkv.").replace(
+            "attn.proj.", "self_attention.linear_proj."
+        )
+        return f"decoder.layers.{index}.{rest}"
+    if name.startswith("merger.norm."):
+        return name.replace("merger.norm.", "merger.patch_norm.")
+    return name
+
+
+def _hf_qkv_to_megatron(tensor: torch.Tensor, num_heads: int, head_dim: int) -> torch.Tensor:
+    """Convert a fused QKV weight/bias between the HF and the mcore row layouts.
+
+    HF stores the rows as ``[all q | all k | all v]``; Megatron's ``linear_qkv``
+    expects ``[q k v]`` inside every query group (so that a tensor-parallel shard
+    holds complete q/k/v triples). This is the same conversion the bridge does
+    with ``ConcatenatedQKVMapping`` for ``model.visual.blocks.*.attn.qkv.*``.
+    """
+    rest = tensor.shape[1:]
+    grouped = tensor.reshape(3, num_heads, head_dim, *rest)
+    return grouped.permute(1, 0, 2, *range(3, 3 + len(rest))).reshape(tensor.shape)
+
+
+def _to_megatron_param(hf_name: str, tensor: torch.Tensor, vision_config) -> Tuple[str, torch.Tensor]:
+    """Map one HF ``model.visual.*`` tensor to ``(megatron_name, tensor)``."""
+    megatron_name = _hf_to_megatron_name(hf_name)
+    if hf_name.endswith((".attn.qkv.weight", ".attn.qkv.bias")):
+        head_dim = vision_config.hidden_size // vision_config.num_heads
+        tensor = _hf_qkv_to_megatron(tensor, vision_config.num_heads, head_dim)
+    return megatron_name, tensor
+
+
+def _mapping_sort_key(hf_name: str):
+    stripped = hf_name[len(VISION_PREFIX) :]
+    if stripped.startswith("blocks."):
+        parts = stripped.split(".")
+        return (1, int(parts[1]), ".".join(parts[2:]))
+    if stripped.startswith("merger."):
+        return (2, 0, stripped)
+    return (0, 0, stripped)
+
+
+def _get_fixture(vision_module, dtype: torch.dtype) -> Dict[str, Any]:
+    """Build (and cache) the HF and Megatron towers for ``dtype``."""
+    from megatron.core.transformer.spec_utils import build_module
+
+    if _FIXTURE.get("dtype") != dtype:
+        _FIXTURE.clear()
+        gc.collect()
+        _FIXTURE["dtype"] = dtype
+
+    if "state_dict" not in _FIXTURE:
+        _FIXTURE["state_dict"] = _load_visual_state_dict(CKPT_DIR)
+    if "vision_config" not in _FIXTURE:
+        from transformers import AutoConfig
+
+        _FIXTURE["vision_config"] = AutoConfig.from_pretrained(CKPT_DIR).vision_config
+
+    vision_config = _FIXTURE["vision_config"]
+    state_dict = _FIXTURE["state_dict"]
+
+    if "hf" not in _FIXTURE:
+        _FIXTURE["hf"] = _build_hf_tower(vision_config, state_dict, dtype)
+
+    if "megatron" not in _FIXTURE:
+        spec = vision_module.get_qwen4_exp_vision_spec(vision_config)
+        megatron_model = build_module(spec)
+        megatron_model = _load_megatron_weights(vision_module, megatron_model, state_dict, vision_config, dtype)
+        _FIXTURE["megatron"] = megatron_model
+
+    return _FIXTURE
+
+
+def _build_hf_tower(vision_config, state_dict, dtype: torch.dtype):
+    """HF reference tower with the checkpoint's ``model.visual.*`` weights."""
+    from transformers.models.qwen4_exp.modeling_qwen4_exp import Qwen4ExpVisionModel
+
+    hf_model = Qwen4ExpVisionModel(vision_config)
+    hf_model.load_state_dict(state_dict, strict=True)
+    # Explicit CPU: mcore's tensor-parallel linears are created on the accelerator
+    # device, and ``torch_npu.contrib.transfer_to_npu`` makes that the NPU here.
+    return hf_model.to(device=CPU_DEVICE, dtype=dtype).requires_grad_(False)
+
+
+def _load_megatron_weights(vision_module, model, state_dict, vision_config, dtype: torch.dtype):
+    """Map the ``model.visual.*`` tensors onto ``model`` and load them strictly."""
+    mapped = dict(_to_megatron_param(key, value, vision_config) for key, value in state_dict.items())
+    module_keys = set(model.state_dict())
+    # mcore registers an empty ``_extra_state`` (TE quantization metadata) on every
+    # tensor-parallel linear; it carries no tensor, so it is filled with ``None``.
+    extra_state = {key for key in module_keys if key.endswith("_extra_state")}
+    mapped.update({key: None for key in extra_state})
+    missing = sorted(module_keys - set(mapped))
+    unexpected = sorted(set(mapped) - module_keys)
+    assert not missing and not unexpected, f"unmapped params: missing={missing} unexpected={unexpected}"
+    model.load_state_dict(mapped, strict=True)
+    return model.to(device=CPU_DEVICE, dtype=dtype).requires_grad_(False)
+
+
+def _rebuild_megatron_tower(vision_module, dtype: torch.dtype, **config_overrides):
+    """Second Megatron tower with the same checkpoint weights but other config fields.
+
+    Used to exercise alternatives of the tower itself (e.g. another
+    ``vit_attn_impl``) without touching the cached fixture.
+    """
+    fixture = _get_fixture(vision_module, dtype)
+    vision_config = fixture["vision_config"]
+    megatron_config = vision_module.get_qwen4_exp_vision_config(vision_config)
+    for key, value in config_overrides.items():
+        if not hasattr(megatron_config, key):
+            raise AttributeError(f"unknown vision config field: {key}")
+        setattr(megatron_config, key, value)
+    model = vision_module.Qwen4ExpVisionModel(
+        megatron_config,
+        transformer_layer_spec=vision_module.get_qwen4_exp_vision_layer_spec(megatron_config),
+        patch_merger_spec=vision_module.get_qwen4_exp_patch_merger_spec(megatron_config),
+    )
+    return _load_megatron_weights(vision_module, model, fixture["state_dict"], vision_config, dtype)
+
+
+def _input_for(grid_thw: torch.Tensor, vision_config, dtype: torch.dtype, seed: int = 0) -> torch.Tensor:
+    """Synthetic ``pixel_values`` for ``grid_thw`` (patches in spatial-merge-block order)."""
+    num_patches = int((grid_thw[:, 0] * grid_thw[:, 1] * grid_thw[:, 2]).sum().item())
+    patch_dim = vision_config.in_channels * vision_config.temporal_patch_size * vision_config.patch_size**2
+    generator = torch.Generator().manual_seed(seed)
+    return torch.randn(num_patches, patch_dim, generator=generator).to(dtype)
+
+
+def _compare(tag: str, hf_tensor: torch.Tensor, meg_tensor: torch.Tensor) -> Tuple[float, float]:
+    """Print and return ``(cosine similarity, max abs diff)`` of two tensors."""
+    if hf_tensor.shape != meg_tensor.shape:
+        raise AssertionError(f"{tag}: shape mismatch {tuple(hf_tensor.shape)} vs {tuple(meg_tensor.shape)}")
+    a = hf_tensor.detach().float().flatten()
+    b = meg_tensor.detach().float().flatten()
+    cosine = F.cosine_similarity(a, b, dim=0).item()
+    max_abs_diff = (a - b).abs().max().item()
+    # Scale-relative metrics: ``max_abs_diff`` alone is hard to read when the
+    # residual stream is unbounded (no final norm before the merger).
+    scale = a.abs().max().item()
+    rel = max_abs_diff / scale if scale > 0 else max_abs_diff
+    rms = (a - b).pow(2).mean().sqrt().item() / (a.pow(2).mean().sqrt().item() + 1e-12)
+    print(f"   {tag:<34} cosine={cosine:.8f}  max_abs_diff={max_abs_diff:.3e}  rel_max={rel:.3e}  rms_rel={rms:.3e}")
+    return cosine, max_abs_diff
+
+
+@torch.no_grad()
+def _forward_pair(hf_model, megatron_model, pixel_values, grid_thw):
+    """Run both towers and capture the pre-merger hidden states of the Megatron one."""
+    captured: Dict[str, torch.Tensor] = {}
+
+    def _hook(_module, _inputs, output):
+        captured["hidden"] = output[0] if isinstance(output, tuple) else output
+
+    handle = megatron_model.decoder.register_forward_hook(_hook)
+    try:
+        hf_out = hf_model(pixel_values, grid_thw)
+        meg_out, deepstack = megatron_model(pixel_values, grid_thw)
+    finally:
+        handle.remove()
+    return hf_out, meg_out, captured["hidden"], deepstack
+
+
+# --------------------------------------------------------------------------------------
+# 1. spec / interface smoke test + checkpoint parameter table
+# --------------------------------------------------------------------------------------
+def test_spec_smoke(vision_module) -> bool:
+    print("test 1: spec / interface smoke + checkpoint <-> module parameter table")
+    from megatron.core.transformer.spec_utils import build_module
+    from transformers import AutoConfig
+
+    vision_config = AutoConfig.from_pretrained(CKPT_DIR).vision_config
+    spec = vision_module.get_qwen4_exp_vision_spec(vision_config)
+    megatron_config = vision_module.get_qwen4_exp_vision_config(vision_config)
+
+    ok = True
+    print(
+        f"   vision config: depth={vision_config.depth} hidden={vision_config.hidden_size} "
+        f"heads={vision_config.num_heads} ffn={vision_config.intermediate_size} "
+        f"patch={vision_config.patch_size} merge={vision_config.spatial_merge_size} "
+        f"pos={vision_config.num_position_embeddings} out={vision_config.out_hidden_size} "
+        f"act={vision_config.hidden_act}"
+    )
+    print(
+        f"   deepstack_visual_indexes: hf={getattr(vision_config, 'deepstack_visual_indexes', None)} "
+        f"megatron={megatron_config.deepstack_visual_indexes}"
+    )
+    if megatron_config.deepstack_visual_indexes:
+        print("   deepstack list must be empty for qwen4_exp: FAIL")
+        ok = False
+
+    model = build_module(spec)
+    num_params = sum(p.numel() for p in model.parameters())
+    print(f"   built {type(model).__name__}: {num_params / 1e6:.3f} M params")
+    if spec.module is not vision_module.Qwen4ExpVisionModel:
+        print(f"   spec.module is {spec.module}: FAIL")
+        ok = False
+
+    expected = {
+        "patch_embed.proj.weight",
+        "patch_embed.proj.bias",
+        "pos_embed.weight",
+        "merger.patch_norm.weight",
+        "merger.patch_norm.bias",
+        "merger.linear_fc1.weight",
+        "merger.linear_fc1.bias",
+        "merger.linear_fc2.weight",
+        "merger.linear_fc2.bias",
+    }
+    for index in range(vision_config.depth):
+        prefix = f"decoder.layers.{index}"
+        for norm in ("input_layernorm", "pre_mlp_layernorm"):
+            expected |= {f"{prefix}.{norm}.weight", f"{prefix}.{norm}.bias"}
+        for linear in (
+            "self_attention.linear_qkv",
+            "self_attention.linear_proj",
+            "mlp.linear_fc1",
+            "mlp.linear_fc2",
+        ):
+            expected |= {f"{prefix}.{linear}.weight", f"{prefix}.{linear}.bias"}
+
+    state = model.state_dict()
+    extra_state = {key for key in state if key.endswith("_extra_state")}
+    print(
+        f"   module entries: {len(state)} = {len(state) - len(extra_state)} parameters + "
+        f"{len(extra_state)} empty mcore `_extra_state` hooks (TE quantization metadata, not tensors)"
+    )
+    state = {key: value for key, value in state.items() if key not in extra_state}
+    if set(state) != expected:
+        print(f"   unexpected parameter names: {sorted(set(state) - expected)}")
+        print(f"   missing parameter names:    {sorted(expected - set(state))}")
+        ok = False
+    print(f"   parameter count: {len(state)} (expected {len(expected)})")
+    print(f"   deepstack attribute on the tower: {model.deepstack_visual_indexes}")
+
+    shapes = _visual_tensor_shapes(CKPT_DIR)
+    print(f"   checkpoint tensors: {len(shapes)} {VISION_PREFIX}* entries <-> {len(state)} module parameters")
+    for hf_name in sorted(shapes, key=_mapping_sort_key):
+        meg_name = _hf_to_megatron_name(hf_name[len(VISION_PREFIX) :])
+        got = tuple(state[meg_name].shape) if meg_name in state else None
+        flag = "" if got == shapes[hf_name] else "   <== MISMATCH"
+        if got != shapes[hf_name]:
+            ok = False
+        print(f"   {hf_name:<58} -> {meg_name:<60} {str(shapes[hf_name]):<18}{flag}")
+    if len(shapes) != len(state):
+        print("   checkpoint tensor count differs from the module parameter count: FAIL")
+        ok = False
+
+    print(f"test 1: {'PASS' if ok else 'FAIL'}")
+    return ok
