+# --------------------------------------------------------------------------------------
+# 2. equivalence with the HF reference helpers
+# --------------------------------------------------------------------------------------
+def test_hf_helpers(vision_module) -> bool:
+    print("test 2: equivalence with transformers.vision_utils helpers")
+    from transformers.models.qwen4_exp.configuration_qwen4_exp import Qwen4ExpVisionConfig
+    from transformers.vision_utils import (
+        get_vision_attention_seqlens,
+        get_vision_interpolation_indices_and_weights,
+        get_vision_position_ids,
+    )
+
+    # A small tower is enough: the helpers only touch pos_embed / rotary_pos_emb.
+    vision_config = Qwen4ExpVisionConfig(depth=2, hidden_size=64, num_heads=4, intermediate_size=128)
+    tower = vision_module.Qwen4ExpVisionModel(vision_module.get_qwen4_exp_vision_config(vision_config))
+    tower = tower.to(device=CPU_DEVICE)
+    tower.requires_grad_(False)
+
+    ok = True
+    for grid_thw in (GRID_THW, GRID_THW_MIXED):
+        print(f"   grid_thw={grid_thw.tolist()}  merge_size={tower.spatial_merge_size}")
+
+        # 2-D rotary embedding: the tower's own rot_pos_emb against the HF helpers.
+        ref_position_ids = get_vision_position_ids(grid_thw, tower.spatial_merge_size)
+        ref_rope = tower.rotary_pos_emb(ref_position_ids.float())
+        emb = torch.cat((ref_rope, ref_rope), dim=-1)
+        cos, sin = tower.rot_pos_emb(grid_thw)
+        cos_ok, cos_diff = _compare("rot_pos_emb cos", emb.cos(), cos.reshape(emb.shape))
+        sin_ok, sin_diff = _compare("rot_pos_emb sin", emb.sin(), sin.reshape(emb.shape))
+        ok &= cos_diff == 0.0 and sin_diff == 0.0 and cos_ok > 0.999999 and sin_ok > 0.999999
+
+        # Interpolation of the learned position grid.
+        ref_indices, ref_weights = get_vision_interpolation_indices_and_weights(
+            grid_thw,
+            num_grid_per_side=tower.num_grid_per_side,
+            mode="bilinear",
+            align_corners=True,
+            spatial_merge_size=tower.spatial_merge_size,
+        )
+        ref_pos_embeds = (tower.pos_embed(ref_indices) * ref_weights[:, :, None]).sum(1)
+        meg_pos_embeds = tower.fast_pos_embed_interpolate(grid_thw)
+        pos_ok, pos_diff = _compare("pos_embed interpolate", ref_pos_embeds, meg_pos_embeds)
+        # Bit-exact vs. HF's fp32 ``.sum(1)`` when the taps are accumulated in order.
+        pos_rel = pos_diff / ref_pos_embeds.abs().max().item()
+        print(f"   pos_embed relative diff={pos_rel:.3e} (fp32 tap order vs HF .sum(1))")
+        ok &= pos_rel <= 1e-6 and pos_ok > 0.999999
+
+        # Packed attention lengths.
+        ref_cu_seqlens, ref_max_seqlen = get_vision_attention_seqlens(grid_thw, vision_config, kwargs=None)
+        packed = tower.build_packed_seq_params(grid_thw)
+        cu_ok = torch.equal(ref_cu_seqlens.to(torch.int32), packed.cu_seqlens_q.to(torch.int32))
+        # ``get_max_seqlen`` returns None outside the flash-attention path.
+        max_ok = ref_max_seqlen is None or int(ref_max_seqlen) == int(packed.max_seqlen_q)
+        print(
+            f"   cu_seqlens={packed.cu_seqlens_q.tolist()} (ref={ref_cu_seqlens.tolist()}) equal: {cu_ok}; "
+            f"max_seqlen={int(packed.max_seqlen_q)} (ref={ref_max_seqlen}) equal: {max_ok}"
+        )
+        ok &= cu_ok and max_ok
+
+    print(f"test 2: {'PASS' if ok else 'FAIL'}")
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+# 3. numerical alignment on the real checkpoint weights
+# --------------------------------------------------------------------------------------
+def test_alignment(vision_module, dtype: torch.dtype) -> bool:
+    tag = str(dtype).replace("torch.", "")
+    print(f"test 3: numerical alignment vs HF Qwen4ExpVisionModel ({tag})")
+    fixture = _get_fixture(vision_module, dtype)
+    hf_model, megatron_model = fixture["hf"], fixture["megatron"]
+
+    if hf_model.rotary_pos_emb.inv_freq.dtype != torch.float32:
+        # ``Qwen4ExpVisionRotaryEmbedding.inv_freq`` is a non-persistent buffer, so the
+        # dtype conversion also quantizes the RoPE table. The Megatron tower keeps it in
+        # fp32, like HF does when the module is built in fp32 (the default) -- which is
+        # the case before any ``torch_dtype`` conversion.
+        print(
+            f"   note: HF inv_freq became {hf_model.rotary_pos_emb.inv_freq.dtype} through the dtype "
+            "conversion; restoring fp32 angles (fp32-equivalent math on both sides)"
+        )
+        with torch.no_grad():
+            hf_model.rotary_pos_emb.inv_freq = torch.nn.Buffer(
+                hf_model.rotary_pos_emb.inv_freq.float(), persistent=False
+            )
+
+    pixel_values = _input_for(GRID_THW, fixture["vision_config"], dtype)
+    hf_out, meg_out, meg_hidden, deepstack = _forward_pair(hf_model, megatron_model, pixel_values, GRID_THW)
+
+    print(f"   pixel_values{tuple(pixel_values.shape)} dtype={pixel_values.dtype} grid_thw={GRID_THW.tolist()}")
+    hidden_cos, hidden_diff = _compare("pre-merger hidden states", hf_out.last_hidden_state, meg_hidden.squeeze(1))
+    pooled_cos, pooled_diff = _compare("tower output (pooler_output)", hf_out.pooler_output, meg_out)
+    print(f"   megatron output shape={tuple(meg_out.shape)} first value={meg_out.flatten()[0].item():.6f}")
+    print(f"   deepstack feature lists returned: {len(deepstack)} (must be 0)")
+
+    # Second input: one image plus a 2-frame video -> several packed attention
+    # segments and t > 1 (exercises the per-segment kernel and the seqlens).
+    pixel_values_mixed = _input_for(GRID_THW_MIXED, fixture["vision_config"], dtype)
+    hf_mixed, meg_mixed, meg_hidden_mixed, deepstack_mixed = _forward_pair(
+        hf_model, megatron_model, pixel_values_mixed, GRID_THW_MIXED
+    )
+    print(f"   grid_thw={GRID_THW_MIXED.tolist()} pixel_values{tuple(pixel_values_mixed.shape)}")
+    mixed_hidden_cos, _ = _compare(
+        "pre-merger hidden states (mixed)", hf_mixed.last_hidden_state, meg_hidden_mixed.squeeze(1)
+    )
+    mixed_pooled_cos, _ = _compare("tower output (mixed grid_thw)", hf_mixed.pooler_output, meg_mixed)
+    print(f"   mixed output shape={tuple(meg_mixed.shape)} deepstack lists: {len(deepstack_mixed)} (must be 0)")
+
+    # The tower has no final norm on the residual stream (values reach ~1e2 in bf16),
+    # so bf16 rounding *alone* moves the output. Measure that noise floor with the
+    # reference implementation itself (same weights/input, fp32 vs bf16) and require
+    # the cross-implementation bf16 gap to stay within it.
+    threshold = 0.999
+    if dtype != torch.float32:
+        hf_fp32 = _build_hf_tower(fixture["vision_config"], fixture["state_dict"], torch.float32)
+        with torch.no_grad():
+            hf_fp32_out = hf_fp32(pixel_values.float(), GRID_THW)
+        control_cos, _ = _compare(
+            "bf16 noise floor (HF bf16 vs HF fp32)", hf_fp32_out.pooler_output, hf_out.pooler_output
+        )
+        print(
+            f"   -> cross-implementation bf16 gap is not larger than HF's own bf16 rounding: {pooled_cos >= control_cos}"
+        )
+        del hf_fp32
+        gc.collect()
+        threshold = min(threshold, control_cos)
+
+    ok = (
+        pooled_cos >= threshold
+        and hidden_cos >= threshold
+        and mixed_pooled_cos >= threshold
+        and mixed_hidden_cos >= threshold
+        and len(deepstack) == 0
+        and len(deepstack_mixed) == 0
+    )
+    print(f"test 3 ({tag}): {'PASS' if ok else 'FAIL'}  [cosine >= {threshold:.8f}]")
+
+    _FIXTURE.pop("hf", None)
+    _FIXTURE.pop("megatron", None)
+    gc.collect()
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+# 4. freeze / unfreeze toggle
+# --------------------------------------------------------------------------------------
+def test_freeze_toggle(vision_module) -> bool:
+    print("test 4: freeze_vision_tower toggle")
+    # Random small tower: this checks the freeze API (and the wrapper attribute
+    # discovery), not the weights, so no checkpoint is needed.
+    from transformers import Qwen4ExpVisionConfig
+
+    vision_config = Qwen4ExpVisionConfig(depth=2, hidden_size=64, num_heads=4, intermediate_size=128)
+    tower = vision_module.Qwen4ExpVisionModel(vision_module.get_qwen4_exp_vision_config(vision_config))
+    tower = tower.to(device=CPU_DEVICE)
+
+    class _Wrapper(torch.nn.Module):
+        """Stand-in for the multimodal model, which exposes the tower as an attribute."""
+
+        def __init__(self, vision_model):
+            super().__init__()
+            self.vision_model = vision_model
+
+    wrapper = _Wrapper(tower)
+    ok = True
+    for tag, target in (("tower", tower), ("wrapper.vision_model", wrapper)):
+        vision_module.freeze_vision_tower(target, freeze=True)
+        frozen = [p.requires_grad for p in tower.parameters()]
+        print(f"   after freeze ({tag:<18}): {sum(frozen)}/{len(frozen)} parameters with requires_grad=True")
+        ok &= not any(frozen)
+
+        vision_module.freeze_vision_tower(target, freeze=False)
+        thawed = [p.requires_grad for p in tower.parameters()]
+        print(f"   after unfreeze ({tag:<16}): {sum(thawed)}/{len(thawed)} parameters with requires_grad=True")
+        ok &= all(thawed)
+
+    print(f"test 4: {'PASS' if ok else 'FAIL'}")
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+# 5. NPU forward
+# --------------------------------------------------------------------------------------
+def test_npu_forward(vision_module) -> bool:
+    print("test 5: NPU forward")
+    if not (hasattr(torch, "npu") and torch.npu.is_available()):
+        print("   torch.npu is not available: SKIP")
+        return True
+
+    device = "npu:0"
+    fixture = _get_fixture(vision_module, torch.float32)
+    model = fixture["megatron"]
+
+    with torch.no_grad():
+        pixel_values = _input_for(GRID_THW, fixture["vision_config"], torch.float32)
+        cpu_out, cpu_deepstack = model(pixel_values, GRID_THW)
+
+        model.to(device)
+        npu_out, npu_deepstack = model(pixel_values.to(device), GRID_THW.to(device))
+        cosine, _ = _compare("npu fp32 vs cpu fp32", cpu_out, npu_out.cpu())
+        print(
+            f"   device={npu_out.device} shape={tuple(npu_out.shape)} dtype={npu_out.dtype} "
+            f"finite={bool(torch.isfinite(npu_out).all())} deepstack={len(npu_deepstack)}"
+        )
+
+        # bf16 is the dtype the frozen tower runs in during training.
+        model.to(dtype=torch.bfloat16)
+        bf16_out, _ = model(pixel_values.to(device=device, dtype=torch.bfloat16), GRID_THW.to(device))
+        bf16_cosine, bf16_diff = _compare("npu bf16 vs npu fp32", npu_out, bf16_out)
+        print(f"   npu bf16 finite={bool(torch.isfinite(bf16_out).all())} max_abs_diff={bf16_diff:.3e}")
+        model.to(dtype=torch.float32, device="cpu")
+        del model
+        gc.collect()
+
+        # The explicit fp32-softmax reference math first, then every
+        # implementation the tower can resolve to, each on the NPU. The fixture
+        # tower asks for "auto" (what `get_qwen4_exp_vision_config` sets), so the
+        # legs are named explicitly rather than inferred from it.
+        eager_model = _rebuild_megatron_tower(vision_module, torch.float32, vit_attn_impl="eager").to(device)
+        with torch.no_grad():
+            eager_out, _ = eager_model(pixel_values.to(device), GRID_THW.to(device))
+        print(f"   npu eager reference finite={bool(torch.isfinite(eager_out).all())} device={eager_out.device}")
+        eager_model.to(device="cpu")
+        del eager_model
+        gc.collect()
+
+        impls = ["sdpa"]
+        if vision_module._npu_fusion_attention() is not None:
+            impls.append("npu_fusion")
+        impl_cosines = {}
+        for impl in impls:
+            impl_model = _rebuild_megatron_tower(vision_module, torch.float32, vit_attn_impl=impl).to(device)
+            with torch.no_grad():
+                impl_out, _ = impl_model(pixel_values.to(device), GRID_THW.to(device))
+            impl_cosines[impl], _ = _compare(f"npu {impl} vs npu eager", impl_out.cpu(), eager_out.cpu())
+            print(
+                f"   vit_attn_impl={impl:<11} cosine vs eager={impl_cosines[impl]:.9f} "
+                f"finite={bool(torch.isfinite(impl_out).all())}"
+            )
+            impl_model.to(device="cpu")
+            del impl_model
+            gc.collect()
+        print(f"   fixture tower resolved 'auto' to {vision_module._resolve_vit_attn_impl('auto')!r}")
+
+    ok = (
+        bool(torch.isfinite(npu_out).all())
+        and cosine >= 0.999999
+        and bf16_cosine >= 0.999
+        and len(impl_cosines) == len(impls)
+        and all(cosine_i >= 0.99999 for cosine_i in impl_cosines.values())
+        and len(npu_deepstack) == 0
+        and len(cpu_deepstack) == 0
+    )
+    print(f"test 5: {'PASS' if ok else 'FAIL'}")
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+def main(argv: Optional[List[str]] = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--no-weights", action="store_true", help="skip the checkpoint-based alignment tests")
+    parser.add_argument("--cpu-only", action="store_true", help="skip the NPU test")
+    parser.add_argument("--dtype", default="both", choices=("fp32", "bf16", "both"))
+    parser.add_argument(
+        "--only", default=None, help="comma separated subset of test names (spec,helpers,fp32,bf16,freeze,npu)"
+    )
+    args = parser.parse_args(argv)
+
+    _bootstrap()
+    vision_module = _import_vision()
+
+    tests = [
+        ("spec smoke", lambda: test_spec_smoke(vision_module)),
+        # The helper equivalence test builds its own small tower; it needs no weights.
+        ("hf helpers", lambda: test_hf_helpers(vision_module)),
+    ]
+    if not args.no_weights:
+        if args.dtype in ("fp32", "both"):
+            tests.append(("alignment fp32", lambda: test_alignment(vision_module, torch.float32)))
+        if args.dtype in ("bf16", "both"):
+            tests.append(("alignment bf16", lambda: test_alignment(vision_module, torch.bfloat16)))
+    tests.append(("freeze toggle", lambda: test_freeze_toggle(vision_module)))
+    if not args.cpu_only:
+        tests.append(("npu forward", lambda: test_npu_forward(vision_module)))
+
+    if args.only:
+        aliases = {
+            "spec": "spec smoke",
+            "helpers": "hf helpers",
+            "fp32": "alignment fp32",
+            "bf16": "alignment bf16",
+            "freeze": "freeze toggle",
+            "npu": "npu forward",
+        }
+        wanted = {aliases.get(name.strip(), name.strip()) for name in args.only.split(",") if name.strip()}
+        tests = [item for item in tests if item[0] in wanted]
+
+    results = []
+    for name, fn in tests:
+        print()
+        try:
+            results.append((name, bool(fn())))
+        except Exception:
+            print(f'test "{name}" RAISED:')
+            traceback.print_exc(file=sys.stdout)
+            results.append((name, False))
+
+    print()
+    print("== summary ==")
+    for name, passed in results:
+        print(f"{name}: {'PASS' if passed else 'FAIL'}")
+    return 0 if all(passed for _, passed in results) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
