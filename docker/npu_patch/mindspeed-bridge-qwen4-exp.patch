+++ b/mindspeed_bridge/models/qwen4_exp/modelling_qwen4_exp/spec.py
@@ -0,0 +1,282 @@
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Layer specs for Qwen3.8-Flash-Next (``qwen4_exp``).
+
+A Qwen4Exp decoder layer is a stock Megatron ``TransformerLayer`` holding two
+sub-blocks, but every surrounding detail differs from the GPT default, so the
+specs are built here rather than derived from
+``get_gpt_layer_with_transformer_engine_spec``:
+
+* **no layernorms** -- ``input_layernorm`` and ``pre_mlp_layernorm`` are
+  ``IdentityOp``. The checkpoint has no per-layer norms at all: the gated
+  hyper-connections inside ``Qwen4ExpLayer`` normalize the wide residual stream.
+  This is also why ``linear_qkv``/``in_proj`` use the *plain* column-parallel
+  linear: the layer-norm-fused variant would quietly insert a norm the
+  architecture does not have.
+* **hybrid attention** -- layers where ``config.linear_attention_freq`` is 1 run
+  Gated DeltaNet, the rest run full attention with a QSA indexer.
+* **mRoPE** -- full-attention layers use ``Qwen3VLSelfAttention``, which applies
+  the interleaved T/H/W frequencies in the absolute form the checkpoint was
+  trained with (see ``model.py``).
+* **every layer is MoE** -- dense layers do not exist in this model.
+
+The MTP spec is built separately because the checkpoint's MTP head is
+``residual_linear_shared`` rather than Megatron's fused ``eh_proj``: see
+``mtp.py`` for what the layer does with the slots defined here.
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+from megatron.core.fusions.fused_bias_dropout import get_bias_dropout_add
+from megatron.core.models.backends import BackendSpecProvider
+from megatron.core.models.gpt.experimental_attention_variant_module_specs import (
+    _get_backend_spec_provider,
+    _get_moe_module_spec,
+    get_linear_attention_pattern,
+)
+from megatron.core.transformer.attention import SelfAttentionSubmodules
+from megatron.core.transformer.enums import AttnMaskType, LayerType
+from megatron.core.transformer.identity_op import IdentityOp
+from megatron.core.transformer.multi_token_prediction import (
+    MultiTokenPredictionBlockSubmodules,
+    MultiTokenPredictionLayerSubmodules,
+    get_mtp_layer_offset,
+    get_mtp_num_layers_to_build,
+)
+from megatron.core.transformer.spec_utils import ModuleSpec
+from megatron.core.transformer.transformer_block import (
+    TransformerBlockSubmodules,
+    get_num_layers_to_build,
+)
+from megatron.core.transformer.transformer_config import TransformerConfig
+from megatron.core.transformer.transformer_layer import (
+    TransformerLayerSubmodules,
+    get_transformer_layer_offset,
+)
+
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.gdn import get_qwen4_exp_gdn_spec
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.layer import Qwen4ExpLayer
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.mtp import (
+    Qwen4ExpMTPEmbeddingNorm,
+    Qwen4ExpMTPInnerLayer,
+    Qwen4ExpMTPStreamNorm,
+    Qwen4ExpMultiTokenPredictionLayer,
+)
+
+
+def _full_attention_module():
+    """The attention class used by the full-attention layers.
+
+    ``Qwen3VLSelfAttention`` is the Qwen3.5-VL attention port: it applies mRoPE
+    with ``apply_rotary_pos_emb_absolute`` instead of Megatron's fused/split
+    rotary helper, which is numerically what this checkpoint needs, and it reads
+    the per-head output gate. It is already the module the Qwen3.5-VL family
+    trains with on NPU.
+
+    Imported lazily: the module lives in ``megatron.bridge``, which is present
+    whenever a model is actually built (the Bridge builds it) but not in a bare
+    interpreter -- and the lazy import keeps this module importable for spec
+    introspection either way.
+    """
+    from megatron.bridge.models.qwen_vl.modelling_qwen3_vl.attention import (
+        Qwen3VLSelfAttention,
+    )
+
+    return Qwen3VLSelfAttention
+
+
+def _full_attention_submodules(config: TransformerConfig, backend: BackendSpecProvider) -> SelfAttentionSubmodules:
+    """Submodules of a full-attention decoder layer.
+
+    ``linear_qkv`` is deliberately the plain column-parallel linear: this
+    architecture has no input layernorm for the fused variant to absorb, and the
+    fused module would apply one anyway. ``q_layernorm``/``k_layernorm`` are the
+    same non-fused norm the stock GPT spec picks for QK, which is also the one
+    that honours ``layernorm_zero_centered_gamma`` (the checkpoint stores
+    zero-centered q/k norms).
+    """
+    rms_norm = config.normalization == "RMSNorm"
+    qk_norm = backend.layer_norm(rms_norm=rms_norm, for_qk=True) if config.qk_layernorm else IdentityOp
+    return SelfAttentionSubmodules(
+        linear_qkv=backend.column_parallel_linear(),
+        core_attention=backend.core_attention(),
+        linear_proj=backend.row_parallel_linear(),
+        q_layernorm=qk_norm,
+        k_layernorm=qk_norm,
+    )
+
+
+def _moe_module_spec(config: TransformerConfig, backend: BackendSpecProvider):
+    """The MoE module for one decoder layer.
+
+    ``_get_moe_module_spec`` returns ``(spec, fuse_layernorm_pre_moe)``, not a
+    bare spec; handing the pair straight to ``mlp=`` is what produced
+    ``TypeError: 'tuple' object is not callable`` out of
+    ``TransformerLayer.__init__``. The flag says whether the MLP module applies
+    the pre-MLP layernorm itself, which it only does when the caller asked for a
+    real norm there -- this architecture never does (the gated hyper-connections
+    normalize), so ``pre_mlp_layernorm`` stays ``IdentityOp`` and the flag is
+    only checked, not propagated.
+    """
+    moe_spec, fuse_pre_mlp_layernorm = _get_moe_module_spec(config=config, backend=backend)
+    if fuse_pre_mlp_layernorm:
+        raise RuntimeError(
+            'The MoE spec wants to own the pre-MLP layernorm, but Qwen4Exp layers carry no '
+            'per-layer norms (the gated hyper-connections do the normalizing). Refusing to build '
+            'a layer that would silently insert one.'
+        )
+    return moe_spec
+
+
+def get_qwen4_exp_attention_spec(
+    config: TransformerConfig, backend: Optional[BackendSpecProvider] = None
+) -> ModuleSpec:
+    """Spec of one full-attention (QSA) decoder layer's attention."""
+    if backend is None:
+        backend = _get_backend_spec_provider(config=config)
+    return ModuleSpec(
+        module=_full_attention_module(),
+        # Read by `MultiTokenPredictionLayer.__init__` when this spec is reused
+        # for the MTP inner layer, and by the backend when it picks a kernel.
+        params={"attn_mask_type": AttnMaskType.causal},
+        submodules=_full_attention_submodules(config, backend),
+    )
+
+
+def get_qwen4_exp_local_layer_ids(
+    config: TransformerConfig,
+    vp_stage: Optional[int] = None,
+    pp_rank: Optional[int] = None,
+) -> list[int]:
+    """Global indices of the decoder layers this pipeline stage builds.
+
+    Shared by the spec builders (which have to slice their per-layer specs by it)
+    and by the provider (which checks the post-build fixes against it), so both
+    sides always agree on what "this stage's layers" means.
+    """
+    if config.pipeline_model_parallel_layout is not None:
+        return list(
+            config.pipeline_model_parallel_layout.get_layer_id_list(
+                layer_type=LayerType.decoder, vp_stage=vp_stage, pp_rank=pp_rank
+            )
+        )
+    offset = get_transformer_layer_offset(config, vp_stage=vp_stage, pp_rank=pp_rank)
+    num_layers_to_build = get_num_layers_to_build(config, vp_stage=vp_stage, pp_rank=pp_rank)
+    return list(range(offset, offset + num_layers_to_build))
+
+
+def get_qwen4_exp_block_spec(
+    config: TransformerConfig,
+    vp_stage: Optional[int] = None,
+    pp_rank: Optional[int] = None,
+) -> TransformerBlockSubmodules:
+    """Build the decoder block spec of the current pipeline stage.
+
+    The attention pattern comes from ``config.linear_attention_freq`` (1 = Gated
+    DeltaNet, 0 = full attention), and every layer is MoE, so only the attention
+    side is heterogeneous.
+    """
+    backend = _get_backend_spec_provider(config=config)
+
+    attention_pattern = get_linear_attention_pattern(config=config)
+    gdn_spec = get_qwen4_exp_gdn_spec(config, backend) if 1 in attention_pattern else None
+    full_attention_spec = get_qwen4_exp_attention_spec(config, backend) if 0 in attention_pattern else None
+    moe_spec = _moe_module_spec(config=config, backend=backend)
+
+    layer_specs = []
+    for layer_number in range(config.num_layers):
+        attention = gdn_spec if attention_pattern[layer_number] == 1 else full_attention_spec
+        layer_specs.append(
+            ModuleSpec(
+                module=Qwen4ExpLayer,
+                submodules=TransformerLayerSubmodules(
+                    # The gated hyper-connections normalize the layer input, so
+                    # there is nothing for a per-layer norm to do here.
+                    input_layernorm=IdentityOp,
+                    self_attention=attention,
+                    self_attn_bda=get_bias_dropout_add,
+                    pre_mlp_layernorm=IdentityOp,
+                    mlp=moe_spec,
+                    mlp_bda=get_bias_dropout_add,
+                ),
+            )
+        )
+
+    # Keep only the layers this pipeline stage builds.
+    local_layer_ids = get_qwen4_exp_local_layer_ids(config, vp_stage=vp_stage, pp_rank=pp_rank)
+
+    return TransformerBlockSubmodules(
+        layer_specs=[layer_specs[layer_id] for layer_id in local_layer_ids],
+        # Truthy on purpose: `Qwen4ExpTransformerBlock` never applies it (the
+        # hyper-connection contraction replaces it) but uses
+        # `has_final_layernorm_in_this_stage()` to find the stage that owns the
+        # last decoder layer, i.e. the one that has to contract.
+        layer_norm=IdentityOp,
+    )
+
+
+def get_qwen4_exp_mtp_block_spec(
+    config: TransformerConfig,
+    vp_stage: Optional[int] = None,
+    pp_rank: Optional[int] = None,
+) -> Optional[MultiTokenPredictionBlockSubmodules]:
+    """Build the MTP block spec of the current pipeline stage.
+
+    Compiled by hand rather than through ``get_gpt_mtp_block_spec`` because
+    ``eh_proj`` is not a fused ``2H -> H`` projection here: the checkpoint keeps
+    ``fc_embedding``/``fc_hidden`` as two ``H -> H`` projections
+    (``e_proj``/``h_proj`` in ``Qwen4ExpMultiTokenPredictionLayer``) and adds the
+    embedding residual to every hyper-connection stream. The spec still has to
+    declare a projection slot for Megatron 0.16's mandatory build step, so it is
+    ``IdentityOp`` -- no weights, nothing to load, nothing to drop.
+    """
+    num_layers_to_build = get_mtp_num_layers_to_build(config, vp_stage=vp_stage, pp_rank=pp_rank)
+    if num_layers_to_build == 0:
+        return None
+
+    backend = _get_backend_spec_provider(config=config)
+    mtp_layer_spec = ModuleSpec(
+        module=Qwen4ExpMultiTokenPredictionLayer,
+        submodules=MultiTokenPredictionLayerSubmodules(
+            # `pre_fc_norm_embedding`: over the embedding width.
+            enorm=Qwen4ExpMTPEmbeddingNorm,
+            # `pre_fc_norm_hidden`: over the whole multi-stream (hc_count * H).
+            hnorm=Qwen4ExpMTPStreamNorm,
+            eh_proj=IdentityOp,
+            # `mtp_model_layer`, not `transformer_layer`: the latter is what this
+            # field used to be called and handing it over now raises
+            # `TypeError: MultiTokenPredictionLayerSubmodules.__init__() got an
+            # unexpected keyword argument 'transformer_layer'`.
+            mtp_model_layer=ModuleSpec(
+                module=Qwen4ExpMTPInnerLayer,
+                submodules=TransformerLayerSubmodules(
+                    input_layernorm=IdentityOp,
+                    # The MTP head's own layer is always full attention: the
+                    # checkpoint's `mtp.layer_types` is ["full_attention"], and
+                    # `Qwen4ExpMTPInnerLayer` pins that independently of the
+                    # backbone's pattern.
+                    self_attention=get_qwen4_exp_attention_spec(config, backend),
+                    self_attn_bda=get_bias_dropout_add,
+                    pre_mlp_layernorm=IdentityOp,
+                    mlp=_moe_module_spec(config=config, backend=backend),
+                    mlp_bda=get_bias_dropout_add,
+                ),
+            ),
+            # Unused: `_postprocess` contracts the multi-stream with the head's
+            # own mixer. Identity keeps Megatron's mandatory build step happy.
+            layer_norm=IdentityOp,
+        ),
+    )
+
+    mtp_num_layers = config.mtp_num_layers if config.mtp_num_layers else 0
+    offset = get_mtp_layer_offset(config, vp_stage=vp_stage)
+    mtp_layer_specs = ([mtp_layer_spec] * mtp_num_layers)[offset : offset + num_layers_to_build]
+    if not mtp_layer_specs:
+        return None
+    assert len(mtp_layer_specs) == config.mtp_num_layers, (
+        f'all MTP layers must live in the same pipeline stage, got {len(mtp_layer_specs)} of {config.mtp_num_layers}.'
+    )
+    return MultiTokenPredictionBlockSubmodules(layer_specs=mtp_layer_specs)
