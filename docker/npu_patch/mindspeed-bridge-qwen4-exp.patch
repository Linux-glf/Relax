+# pylint: disable=attribute-defined-outside-init, unexpected-keyword-arg, too-many-lines
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+# The disables mirror ``models/qwen_vl/modelling_qwen3_vl/transformer_config.py``:
+# the vision config is a dataclass over mcore's ``TransformerConfig`` whose fields
+# are filled in after construction (the MindSpeed-validated constructor kwargs are
+# the only ones that may be passed there), which pylint reads as both
+# attribute-defined-outside-init and an unknown constructor keyword. The file is
+# one tower -- patches, merger, blocks and the config -- kept in one place.
+"""Megatron-Core vision tower of Qwen3.8-Flash-Next (``qwen4_exp``).
+
+The tower is numerically equivalent to the HF reference
+``transformers/models/qwen4_exp/modeling_qwen4_exp.py``
+(``Qwen4ExpVisionModel``) and keeps the module / parameter layout of the
+Qwen3.5-VL vision tower of this repository
+(``models/qwen_vl/modelling_qwen3_vl/vision_model.py``), so the existing bridge
+mapping style (``vision_model.*`` <-> ``model.visual.*``) carries over:
+
+    vision_model.patch_embed.proj.*          <-> model.visual.patch_embed.proj.*
+    vision_model.pos_embed.weight            <-> model.visual.pos_embed.weight
+    vision_model.decoder.layers.N.input_layernorm.*      <-> model.visual.blocks.N.norm1.*
+    vision_model.decoder.layers.N.self_attention.linear_qkv.*  <-> model.visual.blocks.N.attn.qkv.*
+    vision_model.decoder.layers.N.self_attention.linear_proj.* <-> model.visual.blocks.N.attn.proj.*
+    vision_model.decoder.layers.N.pre_mlp_layernorm.*    <-> model.visual.blocks.N.norm2.*
+    vision_model.decoder.layers.N.mlp.linear_fc1.*       <-> model.visual.blocks.N.mlp.linear_fc1.*
+    vision_model.decoder.layers.N.mlp.linear_fc2.*       <-> model.visual.blocks.N.mlp.linear_fc2.*
+    vision_model.merger.patch_norm.*         <-> model.visual.merger.norm.*
+    vision_model.merger.linear_fc1.*         <-> model.visual.merger.linear_fc1.*
+    vision_model.merger.linear_fc2.*         <-> model.visual.merger.linear_fc2.*
+
+Notes on the reference:
+
+* ``qwen4_exp`` has no deepstack mergers -- HF's ``Qwen4ExpVisionModel`` returns
+  ``last_hidden_state``/``pooler_output`` only and the multimodal model consumes
+  ``pooler_output`` (:meth:`Qwen4ExpModel.get_image_features`). This tower
+  therefore never builds deepstack features and returns an empty list of them.
+* The vision attention has no causal mask: every image/frame is an independent
+  segment of the packed (``thd``) sequence. HF runs one SDPA call per segment;
+  this implementation does the same (see :class:`Qwen4ExpVisionSelfAttention`).
+* RoPE is 2-D (height/width) and is applied in fp32, exactly as HF does in
+  ``apply_rotary_pos_emb_vision``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from functools import partial
+from typing import Any, Callable, List, Optional, Tuple, Union
+
+import torch
+import torch.nn.functional as F
+from megatron.core.fusions.fused_bias_dropout import get_bias_dropout_add
+from megatron.core.models.backends import BackendSpecProvider, LocalSpecProvider
+from megatron.core.models.common.vision_module.vision_module import VisionModule
+from megatron.core.packed_seq_params import PackedSeqParams
+from megatron.core.process_groups_config import ProcessGroupCollection
+from megatron.core.transformer.enums import AttnMaskType, ModelType
+from megatron.core.transformer.mlp import MLP, MLPSubmodules
+from megatron.core.transformer.module import MegatronModule
+from megatron.core.transformer.spec_utils import ModuleSpec, build_module
+from megatron.core.transformer.transformer_block import TransformerBlock
+from megatron.core.transformer.transformer_config import TransformerConfig
+from megatron.core.transformer.transformer_layer import (
+    TransformerLayer,
+    TransformerLayerSubmodules,
+)
+from megatron.core.utils import divide, get_pg_size
+from torch import nn
+
+# Vision attention implementations understood by the tower. All of them run the
+# same block-diagonal (per-segment) attention:
+#   "sdpa"       -- ``torch.nn.functional.scaled_dot_product_attention`` per segment
+#   "eager"      -- the reference math of
+#                   ``transformers.modeling_utils.eager_attention_forward``
+#   "npu_fusion" -- one ``torch_npu.npu_fusion_attention`` call over the whole
+#                   packed sequence, in TND layout, with the segment boundaries
+#                   handed over as ``actual_seq_qlen``
+# "auto" picks the best of those the running device offers.
+_SUPPORTED_VIT_ATTN_IMPLS = ("sdpa", "eager", "auto", "npu_fusion")
+
+# Resolved on first use: ``None`` means "not looked yet", ``False`` means "not
+# available here".
+_FUSION_ATTN: Optional[Callable] = None
+
+
+def _npu_fusion_attention() -> Optional[Callable]:
+    """``torch_npu.npu_fusion_attention``, or ``None`` where it is unavailable.
+
+    Imported lazily rather than at module scope: this module is imported on hosts
+    without the Ascend runtime (its tests do exactly that), and importing
+    ``torch_npu`` inside a module that has not itself imported the backend risks
+    being the process's first backend import, which changes how torch autoloads
+    the backend in child processes.
+    """
+    global _FUSION_ATTN
+    if _FUSION_ATTN is None:
+        try:
+            import torch_npu
+
+            _FUSION_ATTN = torch_npu.npu_fusion_attention
+        except ImportError:
+            _FUSION_ATTN = False
+    return _FUSION_ATTN or None
+
+
+def _resolve_vit_attn_impl(name: str) -> str:
+    """Map a configured ``vit_attn_impl`` onto the kernel that will actually run.
+
+    ``"auto"`` becomes ``"npu_fusion"`` where the fused Ascend kernel exists and
+    ``"sdpa"`` everywhere else; every explicit name is returned unchanged.
+    """
+    if name == "auto":
+        return "npu_fusion" if _npu_fusion_attention() is not None else "sdpa"
+    return name
+
+
+def _get_vision_backend(config: TransformerConfig) -> BackendSpecProvider:
+    """Return the TE spec provider when transformer-engine is installed, else the local one.
+
+    Mirrors the backend selection of the Qwen3.5-VL tower: TE linears/norms are
+    used on NPU/GPU when available (they shard over TP the same way), and the
+    plain mcore ``ColumnParallelLinear``/``RowParallelLinear``/``WrappedTorchNorm``
+    pair is used otherwise.
+    """
+    try:
+        import transformer_engine.pytorch  # noqa: F401  # pylint: disable=unused-import
+    except ImportError:
+        return LocalSpecProvider()
+    from megatron.core.extensions.transformer_engine_spec_provider import (  # pylint: disable=import-outside-toplevel
+        TESpecProvider,
+    )
+
+    return TESpecProvider()
+
+
+@dataclass
+class Qwen4ExpVisionTransformerConfig(TransformerConfig):
+    """Transformer config of the Qwen3.8-Flash-Next vision tower.
+
+    Extra (non language-model) fields follow
+    :class:`Qwen3VLTransformerConfig` of the Qwen3.5-VL tower.
+    """
+
+    patch_size: int = 16
+    temporal_patch_size: int = 2
+    in_channels: int = 3
+    spatial_merge_size: int = 2
+    num_position_embeddings: int = 2304
+    out_hidden_size: int = 3584
+    # ``qwen4_exp`` has no deepstack mergers. The knob exists for interface
+    # parity with the Qwen3.5-VL tower but only an empty list is supported.
+    deepstack_visual_indexes: List[int] = field(default_factory=list)
+    # Activation of the patch merger. HF uses ``nn.GELU()`` (exact erf GELU),
+    # which differs from the ``gelu_pytorch_tanh`` of the block MLPs.
+    merger_activation_func: Callable = F.gelu
+    # Vision attention implementation: "sdpa"
+    # (``torch.nn.functional.scaled_dot_product_attention`` per segment),
+    # "eager" (explicit fp32-softmax reference math), "npu_fusion" (one fused
+    # ``torch_npu.npu_fusion_attention`` call over the packed sequence), or
+    # "auto" (the best of those the device offers -- see
+    # ``_resolve_vit_attn_impl"). All compute the same block-diagonal attention
+    # (see ``Qwen4ExpVisionSelfAttention``).
+    vit_attn_impl: str = "sdpa"
+
+
+def get_qwen4_exp_vision_config(
+    vision_config: Any,
+    megatron_config: Optional[TransformerConfig] = None,
+) -> Qwen4ExpVisionTransformerConfig:
+    """Build the Megatron config of the vision tower from the HF vision config.
+
+    Args:
+        vision_config: HF ``Qwen4ExpVisionConfig`` (or an already built
+            :class:`Qwen4ExpVisionTransformerConfig`, which is returned as is).
+        megatron_config: Optional language-model config; when given, the
+            tensor/pipeline/context-parallel sizes, the recompute settings and
+            the parameter dtype are inherited from it (like the Qwen3.5-VL tower).
+
+    Returns:
+        The vision tower configuration.
+    """
+    if isinstance(vision_config, TransformerConfig):
+        return vision_config
+
+    if getattr(vision_config, "deepstack_visual_indexes", None):
+        raise NotImplementedError(
+            "qwen4_exp vision tower has no deepstack mergers "
+            f"(got deepstack_visual_indexes={vision_config.deepstack_visual_indexes})."
+        )
+
+    num_heads = getattr(vision_config, "num_heads", None)
+    if num_heads is None:
+        num_heads = getattr(vision_config, "num_attention_heads")
+
+    config = Qwen4ExpVisionTransformerConfig(
+        num_layers=vision_config.depth,
+        hidden_size=vision_config.hidden_size,
+        num_attention_heads=num_heads,
+        ffn_hidden_size=vision_config.intermediate_size,
+        add_bias_linear=True,
+        add_qkv_bias=True,
+        # The tower has no MoE at all, so MindSpeed's permute fusion stays off.
+        # `moe_permute_fusion` is an mcore field (`transformer_config.py`) and
+        # every consumer reads it back off a config object, so it belongs in the
+        # constructor.
+        moe_permute_fusion=False,
+    )
+    # The other half of that toggle is a MindSpeed *args* knob
+    # (`get_args().use_fused_moe_token_permute_and_unpermute`), never read back
+    # off a config object, so this is interface parity rather than a live
+    # switch. It is set on the instance instead of passed to `__init__` because
+    # whether it exists as a dataclass field depends on import order: MindSpeed-
+    # style field injection into `TransformerConfig.__dataclass_fields__` (see
+    # `features/megatron_bridge/common/npu_profiling.py`) only lands first if
+    # that feature registers before this module is imported. Passing it happens
+    # to work in one ordering and raises
+    # `TypeError: Qwen4ExpVisionTransformerConfig.__init__() got an unexpected
+    # keyword argument` in the other, so it must not be a constructor kwarg.
+    config.use_fused_moe_token_permute_and_unpermute = False
+
+    config.num_moe_experts = None
+    config.expert_model_parallel_size = 1
+    config.moe_ffn_hidden_size = None
+
+    config.hidden_dropout = 0.0
+    config.attention_dropout = 0.0
+    config.layernorm_epsilon = 1e-6
+    # HF applies the vision RoPE in fp32 (``apply_rotary_pos_emb_vision``).
+    config.apply_rotary_pos_emb_in_fp32 = True
+    config.apply_rope_fusion = False
+
+    config.patch_size = vision_config.patch_size
+    config.temporal_patch_size = getattr(vision_config, "temporal_patch_size", 2)
+    config.in_channels = vision_config.in_channels
+    config.spatial_merge_size = getattr(vision_config, "spatial_merge_size", 2)
+    config.num_position_embeddings = vision_config.num_position_embeddings
+    config.out_hidden_size = vision_config.out_hidden_size
+    config.deepstack_visual_indexes = list(getattr(vision_config, "deepstack_visual_indexes", []) or [])
+
+    hidden_act = getattr(vision_config, "hidden_act", "gelu_pytorch_tanh")
+    if hidden_act == "gelu_pytorch_tanh":
+        config.activation_func = partial(F.gelu, approximate="tanh")
+    elif hidden_act == "gelu":
+        config.activation_func = F.gelu
+    elif hidden_act == "silu":
+        config.activation_func = F.silu
+    else:
+        raise NotImplementedError(f"Unsupported vision hidden_act: {hidden_act}")
+
+    config.gated_linear_unit = False  # the vision MLP is not gated
+    config.kv_channels = config.hidden_size // config.num_attention_heads
+    config.num_query_groups = config.num_attention_heads  # the vision attention has no GQA
+    config.layernorm_zero_centered_gamma = False
+    config.normalization = "LayerNorm"
+    config.apply_query_key_layer_scaling = False
+    config.bias_activation_fusion = False
+    config.bias_dropout_fusion = False
+    config.attention_softmax_in_fp32 = True
+    # "auto" resolves to the fused Ascend kernel where it exists and to "sdpa"
+    # elsewhere, so a tower built from an HF config gets the fast path on NPU
+    # without the caller having to know which device it is on. The dataclass
+    # default stays "sdpa" so a hand-built config keeps the literal meaning.
+    config.vit_attn_impl = "auto"
+
+    config.tp_comm_overlap = False
+    config.sequence_parallel = False
+    config.context_parallel_size = 1
+    config.pipeline_model_parallel_size = 1
+    config.virtual_pipeline_model_parallel_size = None
+    config.num_layers_in_first_pipeline_stage = None
+    config.num_layers_in_last_pipeline_stage = None
+    config.pipeline_model_parallel_layout = None
+    config.account_for_embedding_in_pipeline_split = None
+    config.account_for_loss_in_pipeline_split = None
+
+    if megatron_config is not None:
+        config.tensor_model_parallel_size = megatron_config.tensor_model_parallel_size
+        config.params_dtype = megatron_config.params_dtype
+        config.recompute_granularity = megatron_config.recompute_granularity
+        config.recompute_method = megatron_config.recompute_method
+        config.recompute_num_layers = megatron_config.recompute_num_layers
+
+    return config
+
+
+# ---------------------------------------------------------------------------
+# Vision modules (HF parity)
+# ---------------------------------------------------------------------------
+class Qwen4ExpVisionRotaryEmbedding(nn.Module):
+    """2-D (height/width) rotary embedding of the vision tower.
+
+    ``forward`` takes the ``(total_tokens, 2)`` position ids produced for a
+    ``grid_thw`` and returns the per-token rotary angles
+    ``(total_tokens, head_dim // 2)`` -- the same layout as the HF reference
+    (the angles are *not* duplicated over the head dim here; the caller does
+    that when it builds ``cos``/``sin``).
+
+    Args:
+        dim: Rotary dimension, i.e. ``head_dim // 2``.
+        theta: RoPE base.
+    """
+
+    def __init__(self, dim: int, theta: float = 10000.0, device=None) -> None:
+        super().__init__()
+        self.dim = dim
+        self.theta = theta
+        inv_freq = 1.0 / (theta ** (torch.arange(0, dim, 2, dtype=torch.float, device=device) / dim))
+        # fp32 on purpose: HF computes the vision angles in fp32.
+        self.register_buffer("inv_freq", inv_freq, persistent=False)
+
+    def forward(self, position_ids: torch.Tensor) -> torch.Tensor:
+        return (position_ids.unsqueeze(-1) * self.inv_freq).flatten(1)
+
+
+class Qwen4ExpVisionPatchEmbed(nn.Module):
+    """Patch embedding of the vision tower (``Conv3d`` over ``[t, ps, ps]`` patches).
+
+    Unlike the Qwen3.5-VL tower, ``qwen4_exp`` convolves a single temporal frame
+    (the ``temporal_patch_size`` depth is folded into the input channels by the
+    processor), so the projection is a 3-D convolution with ``bias=True``.
+    """
+
+    def __init__(self, config: Qwen4ExpVisionTransformerConfig) -> None:
+        super().__init__()
+        self.patch_size = config.patch_size
+        self.temporal_patch_size = config.temporal_patch_size
+        self.in_channels = config.in_channels
+        self.embed_dim = config.hidden_size
+
+        kernel_size = [self.temporal_patch_size, self.patch_size, self.patch_size]
+        self.proj = nn.Conv3d(
+            self.in_channels,
+            self.embed_dim,
+            kernel_size=kernel_size,
+            stride=kernel_size,
+            bias=True,
+        )
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        target_dtype = self.proj.weight.dtype
+        hidden_states = hidden_states.view(
+            -1,
+            self.in_channels,
+            self.temporal_patch_size,
+            self.patch_size,
+            self.patch_size,
+        )
+        hidden_states = self.proj(hidden_states.to(dtype=target_dtype)).view(-1, self.embed_dim)
+        return hidden_states
+
+
+@dataclass
+class PatchMergerSubmodules:
+    """Submodules of the vision patch merger (same fields as the Qwen3.5-VL tower)."""
+
+    patch_norm: Union[ModuleSpec, type] = None
+    linear_fc1: Union[ModuleSpec, type] = None
+    linear_fc2: Union[ModuleSpec, type] = None
+
+
+class Qwen4ExpVisionPatchMerger(MegatronModule):
+    """Patch merger: LayerNorm -> ``merge_size**2`` tokens concatenated -> MLP.
+
+    Args:
+        config: Vision tower config.
+        submodules: :class:`PatchMergerSubmodules` (norm + two TP linears).
+        use_postshuffle_norm: Keep ``False`` for ``qwen4_exp`` (matching HF).
+    """
+
+    def __init__(
+        self,
+        config: Qwen4ExpVisionTransformerConfig,
+        submodules: PatchMergerSubmodules,
+        use_postshuffle_norm: bool = False,
+    ):
+        super().__init__(config=config)
+
+        self.hidden_size = config.hidden_size * (config.spatial_merge_size**2)
+        self.use_postshuffle_norm = use_postshuffle_norm
+        self.input_size = config.hidden_size
+        if self.use_postshuffle_norm:
+            self.input_size = self.hidden_size
+
+        self.patch_norm = build_module(
+            submodules.patch_norm,
+            config=self.config,
+            hidden_size=self.input_size,
+            eps=self.config.layernorm_epsilon,
+        )
+
+        self.linear_fc1 = build_module(
+            submodules.linear_fc1,
+            self.hidden_size,
+            self.hidden_size,
+            config=self.config,
+            init_method=self.config.init_method,
+            gather_output=False,
+            bias=self.config.add_bias_linear,
+            skip_bias_add=False,
+            is_expert=False,
+            tp_comm_buffer_name="patch_fc1",
+        )
+
+        self.activation_func = self.config.merger_activation_func
+
+        self.linear_fc2 = build_module(
+            submodules.linear_fc2,
+            self.hidden_size,
+            self.config.out_hidden_size,
+            config=self.config,
+            init_method=self.config.output_layer_init_method,
+            bias=self.config.add_bias_linear,
+            input_is_parallel=True,
+            skip_bias_add=False,
+            is_expert=False,
+            tp_comm_buffer_name="patch_fc2",
+        )
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        if self.use_postshuffle_norm:
+            hidden_states = hidden_states.view(-1, self.hidden_size)
+        hidden_states = self.patch_norm(hidden_states)
+        hidden_states = hidden_states.view(-1, self.hidden_size)
+
+        hidden_states, _ = self.linear_fc1(hidden_states)
+        hidden_states = self.activation_func(hidden_states)
+        output, _ = self.linear_fc2(hidden_states)
+
+        return output
+
+
+def _rotate_half(x: torch.Tensor) -> torch.Tensor:
+    """``[-x2, x1]`` of a half-split tensor (HF ``rotate_half``)."""
+    x1, x2 = x.chunk(2, dim=-1)
+    return torch.cat((-x2, x1), dim=-1)
+
+
+def _apply_vision_rotary_pos_emb(
+    t: torch.Tensor,
+    cos: torch.Tensor,
+    sin: torch.Tensor,
+) -> torch.Tensor:
+    """Apply the vision RoPE in fp32, as the HF reference does.
+
+    Args:
+        t: ``[seq, batch, heads, head_dim]`` query or key.
+        cos: ``[seq, 1, 1, head_dim]`` cosine (head-dim duplicated angles).
+        sin: ``[seq, 1, 1, head_dim]`` sine.
+
+    Returns:
+        The rotated tensor, cast back to the input dtype.
+    """
+    orig_dtype = t.dtype
+    t = t.float()
+    out = (t * cos.float()) + (_rotate_half(t) * sin.float())
+    return out.to(orig_dtype)
+
+
+@dataclass
+class Qwen4ExpVisionAttentionSubmodules:
+    """Submodules of the vision self-attention."""
+
+    linear_qkv: Union[ModuleSpec, type] = None
+    linear_proj: Union[ModuleSpec, type] = None
+
+
+class Qwen4ExpVisionSelfAttention(MegatronModule):
+    """Non-causal self-attention of the vision tower.
+
+    The vision encoder is *block diagonal*: every image/frame is an independent
+    segment of the packed (``thd``) sequence, so attention never crosses a
+    segment boundary. HF implements this by splitting the packed sequence with
+    ``cu_seqlens`` and running one ``scaled_dot_product_attention`` per segment
+    (:class:`Qwen4ExpVisionAttention`); this module does the same, which is also
+    the only implementation available without flash-attention / TE varlen
+    kernels (mcore's ``DotProductAttention`` has no ``thd`` support). The
+    per-segment kernel is chosen by ``vit_attn_impl`` (see
+    :meth:`Qwen4ExpVisionSelfAttention._segment_attention`).
+
+    Args:
+        config: Vision tower config.
+        submodules: :class:`Qwen4ExpVisionAttentionSubmodules` (fused QKV and
+            output projection; the QKV bias is folded into the linear).
+        layer_number: 1-based layer index (unused, kept for mcore parity).
+        attn_mask_type: Unused; the tower always uses ``no_mask``.
+    """
+
+    def __init__(
+        self,
+        config: Qwen4ExpVisionTransformerConfig,
+        submodules: Qwen4ExpVisionAttentionSubmodules,
+        layer_number: Optional[int] = None,
+        attn_mask_type: Optional[AttnMaskType] = None,
+        pg_collection: Optional[ProcessGroupCollection] = None,
+        **kwargs,
+    ):
+        super().__init__(config=config)
+
+        if config.vit_attn_impl not in _SUPPORTED_VIT_ATTN_IMPLS:
+            raise NotImplementedError(
+                f"vit_attn_impl={config.vit_attn_impl!r} is not supported by the Megatron vision tower; "
+                f"supported values are {_SUPPORTED_VIT_ATTN_IMPLS}."
+            )
+        self.vit_attn_impl = _resolve_vit_attn_impl(config.vit_attn_impl)
+
+        self.layer_number = layer_number
+        self.attn_mask_type = attn_mask_type or AttnMaskType.no_mask
+        self.softmax_scale = self.config.kv_channels**-0.5
+
+        tp_world_size = get_pg_size(pg_collection.tp if pg_collection is not None else None)
+        self.num_attention_heads_per_partition = divide(config.num_attention_heads, tp_world_size)
+        self.num_query_groups_per_partition = divide(config.num_query_groups, tp_world_size)
+        self.hidden_size_per_attention_head = divide(config.hidden_size, config.num_attention_heads)
+        self.hidden_size_per_partition = divide(config.hidden_size, tp_world_size)
+        if self.num_attention_heads_per_partition % self.num_query_groups_per_partition != 0:
+            raise ValueError(
+                "num_attention_heads must be divisible by num_query_groups "
+                f"(got {self.num_attention_heads_per_partition} and {self.num_query_groups_per_partition})."
+            )
+        self.num_attention_heads_per_group = (
+            self.num_attention_heads_per_partition // self.num_query_groups_per_partition
+        )
+
+        self.linear_qkv = build_module(
+            submodules.linear_qkv,
+            self.config.hidden_size,
+            self.config.hidden_size + 2 * self.config.kv_channels * self.config.num_query_groups,
+            config=self.config,
+            init_method=self.config.init_method,
+            gather_output=False,
+            # The bias must be added before the QKV split (HF uses nn.Linear(..., bias=True)).
+            bias=self.config.add_bias_linear or self.config.add_qkv_bias,
+            skip_bias_add=False,
+            is_expert=False,
+            tp_comm_buffer_name="qkv",
+        )
+
+        self.linear_proj = build_module(
+            submodules.linear_proj,
+            self.config.hidden_size,
+            self.config.hidden_size,
+            config=self.config,
+            init_method=self.config.output_layer_init_method,
+            bias=self.config.add_bias_linear,
+            input_is_parallel=True,
+            skip_bias_add=True,
+            is_expert=False,
+            tp_comm_buffer_name="proj",
+        )
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        attention_mask: Optional[torch.Tensor] = None,
+        key_value_states: Optional[torch.Tensor] = None,
+        inference_context: Optional[Any] = None,
+        rotary_pos_emb: Optional[torch.Tensor] = None,
+        rotary_pos_cos: Optional[torch.Tensor] = None,
+        rotary_pos_sin: Optional[torch.Tensor] = None,
+        attention_bias: Optional[torch.Tensor] = None,
+        packed_seq_params: Optional[PackedSeqParams] = None,
+        sequence_len_offset: Optional[int] = None,
+        **kwargs,
+    ) -> Tuple[torch.Tensor, Optional[torch.Tensor]]:
+        """Forward pass.
+
+        Args:
+            hidden_states: ``[seq, batch, hidden]`` hidden states (``batch`` is 1 here).
+            attention_mask: Unused; attention is block diagonal over the packed segments.
+            key_value_states: Unused (self attention only).
+            inference_context: Unused (the tower is training/inference-stateless here).
+            rotary_pos_emb: cosine and sine concatenated along the head dim,
+                ``[seq, 1, 1, 2 * head_dim]``.
+            rotary_pos_cos: Unused.
+            rotary_pos_sin: Unused.
+            attention_bias: Unused.
+            packed_seq_params: Packed sequence metadata; ``cu_seqlens_q`` defines the
+                image/frame segments of the block-diagonal attention.
+            sequence_len_offset: Unused.
+
+        Returns:
+            ``(attention_output, proj_bias)``; the bias is applied by the caller's
+            bias-dropout-add, matching the mcore convention.
+        """
+        assert key_value_states is None, "Qwen4Exp vision attention is self-attention only."
+        assert inference_context is None, "Qwen4Exp vision attention has no inference path."
+        assert attention_bias is None, "Qwen4Exp vision attention does not support attention bias."
+        del attention_mask, rotary_pos_cos, rotary_pos_sin, sequence_len_offset, kwargs
+
+        seq_len, batch, _ = hidden_states.shape
+
+        mixed_qkv, _ = self.linear_qkv(hidden_states)
+        # [seq, batch, hidden] -> [seq, batch, ng, np/ng + 2, hn] -> 3 x [seq, batch, ng, np/ng, hn]
+        mixed_qkv = mixed_qkv.view(
+            seq_len,
+            batch,
+            self.num_query_groups_per_partition,
+            self.num_attention_heads_per_group + 2,
+            self.hidden_size_per_attention_head,
+        )
+        query, key, value = mixed_qkv.unbind(dim=3)
+        # [seq, batch, ng, np / ng * hn] -> [seq, batch, np, hn]
+        query = query.reshape(seq_len, batch, self.num_attention_heads_per_partition, -1)
+        key = key.reshape(seq_len, batch, self.num_query_groups_per_partition, -1)
+        value = value.reshape(seq_len, batch, self.num_query_groups_per_partition, -1)
+
+        if rotary_pos_emb is not None:
+            # `[seq, 1, 1, 2 * head_dim]`: cosine and sine concatenated along the
+            # head dim (see Qwen4ExpVisionModel.forward for why they travel as one
+            # tensor).
+            cos, sin = rotary_pos_emb.chunk(2, dim=-1)
+            query = _apply_vision_rotary_pos_emb(query, cos, sin)
+            key = _apply_vision_rotary_pos_emb(key, cos, sin)
+
+        dropout_p = self.config.attention_dropout if self.training else 0.0
+        cu_seqlens = None
+        if packed_seq_params is not None:
+            cu_seqlens = packed_seq_params.cu_seqlens_q
+        # The fused Ascend kernel takes the whole packed sequence at once, in
+        # ``[total_tokens, heads, head_dim]`` (TND) order, so it has to run
+        # before the layout is rearranged for the per-segment kernels below.
+        tnd_bounds = self._tnd_boundaries(cu_seqlens, seq_len, batch, dropout_p)
+        if tnd_bounds is not None:
+            # [total_tokens, heads, hn] -> [batch * heads, seq, hn]: the layout
+            # the shared tail below expects (``batch`` is 1 on this path).
+            core_attn_out = self._tnd_attention(query, key, value, tnd_bounds).transpose(0, 1)
+        else:
+            # [seq, batch, heads, hn] -> [batch * heads, seq, hn]
+            query = query.permute(1, 2, 0, 3).reshape(batch * self.num_attention_heads_per_partition, seq_len, -1)
+            key = key.permute(1, 2, 0, 3).reshape(batch * self.num_query_groups_per_partition, seq_len, -1)
+            value = value.permute(1, 2, 0, 3).reshape(batch * self.num_query_groups_per_partition, seq_len, -1)
+            if self.num_attention_heads_per_group > 1:
+                key = key.repeat_interleave(self.num_attention_heads_per_group, dim=0)
+                value = value.repeat_interleave(self.num_attention_heads_per_group, dim=0)
+
+            if cu_seqlens is not None:
+                segments = list(zip(cu_seqlens[:-1].tolist(), cu_seqlens[1:].tolist()))
+                if len(segments) == 1:
+                    core_attn_out = self._segment_attention(query, key, value, dropout_p)
+                else:
+                    core_attn_out = torch.cat(
+                        [
+                            self._segment_attention(
+                                query[:, start:end],
+                                key[:, start:end],
+                                value[:, start:end],
+                                dropout_p,
+                            )
+                            for start, end in segments
+                        ],
+                        dim=1,
+                    )
+            else:
+                core_attn_out = self._segment_attention(query, key, value, dropout_p)
+
+        # [batch * heads, seq, hn] -> [seq, batch, hidden]
+        core_attn_out = (
+            core_attn_out.reshape(batch, self.num_attention_heads_per_partition, seq_len, -1)
+            .permute(2, 0, 1, 3)
+            .reshape(seq_len, batch, self.hidden_size_per_partition)
+        )
+
+        output, bias = self.linear_proj(core_attn_out)
+        return output, bias
+
+    def _segment_attention(
+        self,
+        query: torch.Tensor,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        dropout_p: float,
+    ) -> torch.Tensor:
+        """Attention of one packed segment: ``[batch * heads, seq, head_dim]``.
+
+        ``vit_attn_impl="sdpa"`` uses ``torch.nn.functional.scaled_dot_product_attention``;
+        ``"eager"`` uses the reference math of
+        ``transformers.modeling_utils.eager_attention_forward`` (fp32 softmax,
+        cast back to the compute dtype). Both are non-causal and use
+        ``kv_channels ** -0.5`` as the softmax scale. ``"npu_fusion"`` does not
+        come through here -- it runs the whole packed sequence in one call, see
+        :meth:`_tnd_attention`.
+        """
+        if self.vit_attn_impl == "eager":
+            attn_weights = torch.matmul(query, key.transpose(-1, -2)) * self.softmax_scale
+            attn_weights = F.softmax(attn_weights, dim=-1, dtype=torch.float32).to(query.dtype)
+            attn_weights = F.dropout(attn_weights, p=dropout_p, training=self.training)
+            return torch.matmul(attn_weights, value)
+        return F.scaled_dot_product_attention(
+            query,
+            key,
+            value,
+            attn_mask=None,
+            dropout_p=dropout_p,
+            scale=self.softmax_scale,
+            is_causal=False,
+        )
+
+    def _tnd_boundaries(
+        self,
+        cu_seqlens: Optional[torch.Tensor],
+        seq_len: int,
+        batch: int,
+        dropout_p: float,
+    ) -> Optional[List[int]]:
+        """The segment boundaries if the fused TND kernel can run, else ``None``.
+
+        Returns the host-side ``cu_seqlens`` so the caller does not pay a second
+        device sync for it. The cheap conditions are tested first precisely so
+        that every other implementation (and every ``batch > 1`` case) returns
+        before the ``.tolist()``.
+
+        The kernel takes the boundaries itself -- that is what ``actual_seq_qlen``
+        is -- but it cannot express a few things the per-segment path can:
+
+        * ``batch > 1``: TND flattens batch into the token axis, whereas the
+          per-segment path keeps ``batch * heads`` independent head streams.
+          The tower is handed ``batch=1`` with the images packed along ``seq``.
+        * query groups: the kernel takes a single ``head_num``; the per-segment
+          path instead repeats ``key``/``value`` once per query group.
+        * dropout: the fused kernel draws from its own RNG, which would not match
+          ``F.dropout``'s stream. The tower runs at ``attention_dropout=0``, so
+          this only guards hand-built configs.
+
+        The boundaries must also span the packed sequence exactly: TND attaches
+        the tokens after the last boundary to no segment at all, while the
+        per-segment path would silently drop them.
+        """
+        if not (
+            self.vit_attn_impl == "npu_fusion"
+            and cu_seqlens is not None
+            and batch == 1
+            and self.num_attention_heads_per_group == 1
+            and dropout_p == 0.0
+        ):
+            return None
+        bounds = cu_seqlens.tolist() if torch.is_tensor(cu_seqlens) else list(cu_seqlens)
+        if not bounds or bounds[0] != 0 or bounds[-1] != seq_len:
+            return None
+        return bounds
+
+    def _tnd_attention(
+        self,
+        query: torch.Tensor,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        bounds: List[int],
+    ) -> torch.Tensor:
+        """One fused attention over the whole packed sequence.
+
+        ``query``/``key``/``value`` arrive as ``[seq, 1, heads, head_dim]`` (the
+        packed ``thd`` layout) and TND wants exactly ``[total_tokens, heads,
+        head_dim]``, so the batch axis -- a 1 by the time this runs -- is dropped.
+        TND is told the cumulative *ends* of the segments, i.e. ``bounds``
+        without its leading zero, and takes the block-diagonal structure from
+        that rather than from being handed one slice per segment.
+
+        Returns ``[total_tokens, heads, head_dim]``.
+        """
+        fusion = _npu_fusion_attention()
+        if fusion is None:
+            raise RuntimeError(
+                "vit_attn_impl resolved to 'npu_fusion' but torch_npu.npu_fusion_attention is not importable."
+            )
+        # One kernel call replaces one call per image segment. Measured on the
+        # 8L recipe's shapes (8 heads, 484 patches, head_dim 72): 4.73 ms -> 0.26
+        # ms forward, 18.37 -> 1.04 ms forward+backward per layer, with the same
+        # accuracy against an fp32 reference as the segmented path.
+        return fusion(
+            query.squeeze(1).contiguous(),
+            key.squeeze(1).contiguous(),
+            value.squeeze(1).contiguous(),
+            head_num=self.num_attention_heads_per_partition,
+            input_layout="TND",
+            scale=self.softmax_scale,
+            keep_prob=1.0,
+            actual_seq_qlen=bounds[1:],
+            actual_seq_kvlen=bounds[1:],
+        )[0]
+
+
+class Qwen4ExpVisionModel(VisionModule):
+    """Qwen3.8-Flash-Next vision tower (patch embed + ViT blocks + patch merger).
+
+    Args:
+        transformer_config: Vision tower config (:class:`Qwen4ExpVisionTransformerConfig`).
+        transformer_layer_spec: Spec of one vision transformer layer.
+        patch_merger_spec: Spec of the patch merger.
+        pre_process: Must be True (the tower is not pipeline-split).
+        post_process: Must be True (the merger lives on the same stage).
+        pg_collection: Process groups; defaults to the mpu process groups.
+        submodules: Optional :class:`Qwen4ExpVisionSubmodules`; used by
+            :func:`get_qwen4_exp_vision_spec` when the tower is built with
+            ``build_module``. Fields are overridden by the explicit arguments.
+        backend: Optional backend spec provider used when one of the specs is missing.
+    """
+
+    def __init__(
+        self,
+        transformer_config: Qwen4ExpVisionTransformerConfig,
+        transformer_layer_spec: Optional[Union[ModuleSpec, type]] = None,
+        patch_merger_spec: Optional[PatchMergerSubmodules] = None,
+        pre_process: bool = True,
+        post_process: bool = True,
+        pg_collection: Optional[ProcessGroupCollection] = None,
+        submodules: Optional["Qwen4ExpVisionSubmodules"] = None,
+        backend: Optional[BackendSpecProvider] = None,
+    ) -> None:
+        assert pre_process and post_process, "the qwen4_exp vision tower does not support pipeline parallelism"
+        super().__init__(config=transformer_config)
+
+        if submodules is not None:
+            transformer_layer_spec = transformer_layer_spec or submodules.transformer_layer_spec
+            patch_merger_spec = patch_merger_spec or submodules.patch_merger_spec
+        if transformer_layer_spec is None:
+            transformer_layer_spec = get_qwen4_exp_vision_layer_spec(transformer_config, backend=backend)
+        if patch_merger_spec is None:
+            patch_merger_spec = get_qwen4_exp_patch_merger_spec(transformer_config, backend=backend)
+
+        self.spatial_merge_size = transformer_config.spatial_merge_size
+        self.patch_size = transformer_config.patch_size
+        self.spatial_merge_unit = self.spatial_merge_size * self.spatial_merge_size
+
+        self.pg_collection = pg_collection
+        if pg_collection is None:
+            pg_collection = ProcessGroupCollection.use_mpu_process_groups()
+        self.tp_group = pg_collection.tp
+
+        assert transformer_config.context_parallel_size == 1, (
+            f"context_parallel_size should be 1 in the vision tower but got {transformer_config.context_parallel_size}"
+        )
+
+        self.patch_embed = Qwen4ExpVisionPatchEmbed(transformer_config)
+        self.pos_embed = nn.Embedding(transformer_config.num_position_embeddings, transformer_config.hidden_size)
+        self.num_grid_per_side = int(transformer_config.num_position_embeddings**0.5)
+
+        head_dim = transformer_config.hidden_size // transformer_config.num_attention_heads
+        self.rotary_pos_emb = Qwen4ExpVisionRotaryEmbedding(head_dim // 2)
+
+        self.model_type = ModelType.encoder_or_decoder
+        self.pre_process = pre_process
+        self.post_process = post_process
+
+        self.decoder = TransformerBlock(
+            config=transformer_config,
+            spec=transformer_layer_spec,
+            pre_process=pre_process,
+            post_process=post_process,
+            post_layer_norm=False,
+            pg_collection=pg_collection,
+        )
+
+        self.merger = Qwen4ExpVisionPatchMerger(
+            transformer_config,
+            patch_merger_spec,
+            use_postshuffle_norm=False,
+        )
+
+        self.input_tensor = None
+        # ``qwen4_exp`` has no deepstack mergers; kept for interface parity with
+        # the Qwen3.5-VL tower (which returns one feature list per index).
+        self.deepstack_visual_indexes: List[int] = list(transformer_config.deepstack_visual_indexes)
+
+    def set_input_tensor(self, input_tensor: torch.Tensor) -> None:
+        """Set the input tensor of the tower (not used; the tower is fed by ``forward``)."""
+        if self.pre_process:  # always True
+            self.input_tensor = input_tensor
+        else:
+            raise NotImplementedError()
+
+    def rot_pos_emb(self, grid_thw: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
+        """Rotary ``(cos, sin)`` for a packed grid, in spatial-merge-block token order.
+
+        Args:
+            grid_thw: ``[num_images_or_videos, 3]`` (temporal, height, width) in patches.
+
+        Returns:
+            ``(cos, sin)`` each ``[total_tokens, 1, 1, head_dim]``.
+        """
+        merge_size = self.spatial_merge_size
+        device = grid_thw.device
+        position_ids = []
+
+        for num_frames, height, width in grid_thw.tolist():
+            merged_h, merged_w = height // merge_size, width // merge_size
+            # Full-resolution (unmerged) h/w indices, reordered into merge blocks:
+            # [merged_h, merge, merged_w, merge] --transpose(1, 2)--> block-major
+            # (block_row, block_col, in_row, in_col), exactly like
+            # ``transformers.vision_utils.get_vision_position_ids``.
+            hpos = torch.arange(height, device=device).view(merged_h, merge_size, 1, 1)
+            wpos = torch.arange(width, device=device).view(1, 1, merged_w, merge_size)
+            block_shape = (merged_h, merge_size, merged_w, merge_size)
+            hpos = hpos.expand(*block_shape).transpose(1, 2).flatten()
+            wpos = wpos.expand(*block_shape).transpose(1, 2).flatten()
+            coords = torch.stack((hpos, wpos), dim=-1)
+            if num_frames > 1:
+                coords = coords.repeat(num_frames, 1)
+            position_ids.append(coords)
+
+        position_ids = torch.cat(position_ids, dim=0)
+        rotary_pos_emb = self.rotary_pos_emb(position_ids)  # [total, head_dim // 2]
+        emb = torch.cat((rotary_pos_emb, rotary_pos_emb), dim=-1).float()  # [total, head_dim]
+        seq_len = emb.shape[0]
+        cos = emb.cos().reshape(seq_len, 1, 1, -1)
+        sin = emb.sin().reshape(seq_len, 1, 1, -1)
+        return cos, sin
+
+    def fast_pos_embed_interpolate(self, grid_thw: torch.Tensor) -> torch.Tensor:
+        """Bilinear interpolation of the learned square position-embedding table.
+
+        Reproduces HF (``get_vision_interpolation_indices_and_weights`` with
+        ``mode='bilinear'`` / ``align_corners=True`` / ``padding='border'``, i.e. the
+        closed form ``src = index * (side - 1) / max(size - 1, 1)`` of
+        ``torch.linspace(0, side - 1, size)`` and its two linear-hat taps per axis)
+        and returns the embeddings in spatial-merge-block token order.
+
+        Args:
+            grid_thw: ``[num_images_or_videos, 3]`` (temporal, height, width) in patches.
+
+        Returns:
+            ``[total_tokens, hidden_size]`` interpolated position embeddings (fp32).
+        """
+        side = self.num_grid_per_side
+        merge_size = self.spatial_merge_size
+        device = self.pos_embed.weight.device
+        offsets = torch.arange(0, 2, device=device, dtype=torch.float32)  # floor, floor + 1
+        idx_list = [[] for _ in range(4)]
+        weight_list = [[] for _ in range(4)]
+
+        for _, height, width in grid_thw.tolist():
+            # Per-patch (raster order) source coordinates, as in
+            # ``transformers.vision_utils._interpolation_axis_taps_weights``.
+            h_src = torch.arange(height, device=device, dtype=torch.float32) * (side - 1) / max(height - 1, 1)
+            w_src = torch.arange(width, device=device, dtype=torch.float32) * (side - 1) / max(width - 1, 1)
+            h_src = h_src.view(height, 1).expand(height, width).reshape(-1)
+            w_src = w_src.view(1, width).expand(height, width).reshape(-1)
+
+            h_floor = torch.floor(h_src)
+            w_floor = torch.floor(w_src)
+            h_taps = (h_floor.long()[:, None] + offsets.long()).clamp(0, side - 1)
+            w_taps = (w_floor.long()[:, None] + offsets.long()).clamp(0, side - 1)
+            h_weights = (1 - (h_src[:, None] - h_floor[:, None] - offsets).abs()).clamp(min=0)
+            w_weights = (1 - (w_src[:, None] - w_floor[:, None] - offsets).abs()).clamp(min=0)
+
+            # Separable 2-D taps: (h_lo, w_lo), (h_lo, w_hi), (h_hi, w_lo), (h_hi, w_hi).
+            indices = (h_taps[:, :, None] * side + w_taps[:, None, :]).reshape(-1, 4)
+            weights = (h_weights[:, :, None] * w_weights[:, None, :]).reshape(-1, 4)
+            for tap in range(4):
+                idx_list[tap].extend(indices[:, tap].tolist())
+                weight_list[tap].extend(weights[:, tap].tolist())
+
+        idx_tensor = torch.tensor(idx_list, dtype=torch.long, device=device)
+        # fp32 weights: HF multiplies the (bf16/fp32) table by fp32 bilinear weights.
+        weight_tensor = torch.tensor(weight_list, dtype=torch.float32, device=device)
+        pos_embeds = self.pos_embed(idx_tensor) * weight_tensor[:, :, None]
+        patch_pos_embeds = pos_embeds[0] + pos_embeds[1] + pos_embeds[2] + pos_embeds[3]
+
+        # Raster order -> spatial-merge-block order, frame by frame.
+        patch_pos_embeds = patch_pos_embeds.split([h * w for h, w in grid_thw[:, 1:].tolist()])
+        patch_pos_embeds_permute = []
+        for pos_embed, t, h, w in zip(
+            patch_pos_embeds, grid_thw[:, 0].tolist(), grid_thw[:, 1].tolist(), grid_thw[:, 2].tolist()
+        ):
+            pos_embed = pos_embed.repeat(t, 1)
+            pos_embed = (
+                pos_embed.view(t, h // merge_size, merge_size, w // merge_size, merge_size, -1)
+                .permute(0, 1, 3, 2, 4, 5)
+                .flatten(0, 4)
+            )
+            patch_pos_embeds_permute.append(pos_embed)
+        return torch.cat(patch_pos_embeds_permute)
+
+    def build_packed_seq_params(self, grid_thw: torch.Tensor) -> PackedSeqParams:
+        """Packed sequence metadata: one segment per image/frame (HF ``get_vision_attention_seqlens``)."""
+        seqlens = torch.repeat_interleave(grid_thw[:, 1] * grid_thw[:, 2], grid_thw[:, 0])
+        cu_seqlens = seqlens.cumsum(dim=0)
+        cu_seqlens = F.pad(cu_seqlens, (1, 0), value=0).int()
+
+        max_seqlen_q = seqlens.max()
+        return PackedSeqParams(
+            cu_seqlens_q=cu_seqlens,
+            cu_seqlens_kv=cu_seqlens,
+            qkv_format="thd",
+            max_seqlen_q=max_seqlen_q,
+            max_seqlen_kv=max_seqlen_q,
+        )
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        grid_thw: torch.Tensor,
+        inference_params: Optional[Any] = None,
+        extra_block_kwargs: Optional[dict] = None,
+        **kwargs,
+    ) -> Tuple[torch.Tensor, List[torch.Tensor]]:
+        """Forward pass of the vision tower.
+
+        Args:
+            hidden_states: ``pixel_values`` of shape ``[total_patches, in_channels * temporal_patch_size *
+                patch_size ** 2]`` (patches in spatial-merge-block order).
+            grid_thw: ``[num_images_or_videos, 3]`` (temporal, height, width) in patches.
+            inference_params: Unused (always None).
+            extra_block_kwargs: Extra kwargs forwarded to the transformer block.
+            kwargs: Ignored; kept for HF ``**kwargs`` compatibility.
+
+        Returns:
+            ``(vision_embeddings, deepstack_feature_lists)`` where ``vision_embeddings`` has shape
+            ``[total_merged_tokens, out_hidden_size]`` and ``deepstack_feature_lists`` is always
+            empty (``qwen4_exp`` has no deepstack mergers).
+        """
+        assert grid_thw is not None
+        assert self.input_tensor is None
+        assert inference_params is None
+
+        hidden_states = self.patch_embed(hidden_states)
+
+        pos_embeds = self.fast_pos_embed_interpolate(grid_thw)
+        hidden_states = hidden_states + pos_embeds.to(hidden_states.dtype)
+
+        cos, sin = self.rot_pos_emb(grid_thw)
+        # The pair travels as one tensor: mcore's full-layer activation
+        # checkpointing saves its `rotary_pos_emb` argument with
+        # `save_for_backward`, which accepts tensors only, so the `(cos, sin)`
+        # tuple this used to pass raised "save_for_backward can only save
+        # variables, but argument 4 is of type tuple" at the first training step.
+        # The reference carries it the same way (``rotary_pos_emb`` of
+        # ``Qwen3VLVisionModel`` is one tensor, ``repeat(1, 1, 1, 2)`` of the
+        # table); `cat` here and `chunk` in the attention round-trip exactly.
+        rotary_pos_emb = torch.cat((cos, sin), dim=-1)
+        packed_seq_params = self.build_packed_seq_params(grid_thw)
+
+        hidden_states = hidden_states[:, None]  # [seq, 1, hidden]
+        decoder_output = self.decoder(
+            hidden_states=hidden_states,
+            attention_mask=None,
+            rotary_pos_emb=rotary_pos_emb,
+            packed_seq_params=packed_seq_params,
+            **(extra_block_kwargs or {}),
+        )
+        # mcore returns the hidden states (some versions return ``(hidden, context)``).
+        hidden_states = decoder_output[0] if isinstance(decoder_output, tuple) else decoder_output
+
+        hidden_states = self.merger(hidden_states)
+
+        # No deepstack mergers in qwen4_exp: the list stays empty so that callers
+        # using the Qwen3.5-VL tuple interface (embeddings, deepstack_list) work.
+        return hidden_states, []
+
+
+@dataclass
+class Qwen4ExpVisionSubmodules:
+    """Submodules carried by the vision tower :class:`ModuleSpec`."""
+
+    transformer_layer_spec: Union[ModuleSpec, type] = None
+    patch_merger_spec: Optional[PatchMergerSubmodules] = None
+
+
+def get_qwen4_exp_vision_layer_spec(
+    config: TransformerConfig,
+    backend: Optional[BackendSpecProvider] = None,
+) -> ModuleSpec:
+    """Spec of one vision transformer layer (pre-norm attention + pre-norm MLP).
+
+    Args:
+        config: Vision tower config.
+        backend: Optional backend spec provider (TE when available, local otherwise).
+
+    Returns:
+        A :class:`ModuleSpec` whose module is :class:`TransformerLayer`.
+    """
+    if backend is None:
+        backend = _get_vision_backend(config)
+
+    return ModuleSpec(
+        module=TransformerLayer,
+        submodules=TransformerLayerSubmodules(
+            input_layernorm=backend.layer_norm(rms_norm=False, for_qk=False),
+            self_attention=ModuleSpec(
+                module=Qwen4ExpVisionSelfAttention,
+                params={"attn_mask_type": AttnMaskType.no_mask},
+                submodules=Qwen4ExpVisionAttentionSubmodules(
+                    linear_qkv=backend.column_parallel_linear(),
+                    linear_proj=backend.row_parallel_linear(),
+                ),
+            ),
+            self_attn_bda=get_bias_dropout_add,
+            pre_mlp_layernorm=backend.layer_norm(rms_norm=False, for_qk=False),
+            mlp=ModuleSpec(
+                module=MLP,
+                submodules=MLPSubmodules(
+                    linear_fc1=backend.column_parallel_linear(),
+                    linear_fc2=backend.row_parallel_linear(),
+                ),
+            ),
+            mlp_bda=get_bias_dropout_add,
+        ),
+    )
+
+
+def get_qwen4_exp_patch_merger_spec(
+    config: TransformerConfig,
+    backend: Optional[BackendSpecProvider] = None,
+) -> PatchMergerSubmodules:
+    """Spec of the vision patch merger (LayerNorm + two TP linears)."""
+    if backend is None:
+        backend = _get_vision_backend(config)
+
+    return PatchMergerSubmodules(
+        patch_norm=backend.layer_norm(rms_norm=False, for_qk=False),
+        linear_fc1=backend.column_parallel_linear(),
+        linear_fc2=backend.row_parallel_linear(),
+    )
+
+
+def get_qwen4_exp_vision_spec(
+    vision_config: Any,
+    backend: Optional[BackendSpecProvider] = None,
+    megatron_config: Optional[TransformerConfig] = None,
+) -> ModuleSpec:
+    """Build the module spec of the ``qwen4_exp`` vision tower (no language model).
+
+    Args:
+        vision_config: HF ``Qwen4ExpVisionConfig`` (or an already built
+            :class:`Qwen4ExpVisionTransformerConfig`).
+        backend: Optional backend spec provider. Defaults to transformer-engine
+            when it is installed, otherwise to mcore's local layers.
+        megatron_config: Optional language-model config used to inherit the
+            parallel sizes / recompute settings / dtype.
+
+    Returns:
+        ``ModuleSpec(module=Qwen4ExpVisionModel, ...)``; it is directly usable with
+        ``build_module`` (e.g. ``build_module(spec, pg_collection=...)``).
+    """
+    config = get_qwen4_exp_vision_config(vision_config, megatron_config=megatron_config)
+    if backend is None:
+        backend = _get_vision_backend(config)
+
+    return ModuleSpec(
+        module=Qwen4ExpVisionModel,
+        params={
+            "transformer_config": config,
+            "pre_process": True,
+            "post_process": True,
+        },
+        submodules=Qwen4ExpVisionSubmodules(
+            transformer_layer_spec=get_qwen4_exp_vision_layer_spec(config, backend=backend),
+            patch_merger_spec=get_qwen4_exp_patch_merger_spec(config, backend=backend),
+        ),
+    )
+
+
+def freeze_vision_tower(model: Union[nn.Module, "Qwen4ExpVisionModel"], freeze: bool = True) -> None:
+    """Freeze (or unfreeze) every parameter of a vision tower.
+
+    Args:
+        model: The vision tower itself, or a multimodal wrapper that exposes it as
+            ``vision_model`` (MindSpeed-Bridge style) or ``visual`` (HF style).
+        freeze: ``True`` to set ``requires_grad=False`` on all parameters,
+            ``False`` to set it back to ``True``.
+    """
+    tower = model
+    for name in ("vision_model", "visual"):
+        candidate = getattr(model, name, None)
+        if isinstance(candidate, nn.Module):
+            tower = candidate
+            break
+
+    for param in tower.parameters():
+        param.requires_grad = not freeze
