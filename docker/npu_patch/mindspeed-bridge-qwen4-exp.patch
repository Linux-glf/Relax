+def _init_dist() -> None:
+    """One-rank hccl process group, so ``parallel_state`` and the RNG tracker exist."""
+    if torch.distributed.is_initialized():
+        return
+    port = _free_port()
+    os.environ.setdefault('MASTER_ADDR', '127.0.0.1')
+    os.environ['MASTER_PORT'] = str(port)
+    os.environ['RANK'] = '0'
+    os.environ['WORLD_SIZE'] = '1'
+    os.environ['LOCAL_RANK'] = '0'
+    torch.distributed.init_process_group(backend='hccl', world_size=1, rank=0, init_method=f'tcp://127.0.0.1:{port}')
+    from megatron.core import parallel_state
+
+    parallel_state.initialize_model_parallel(
+        tensor_model_parallel_size=1, pipeline_model_parallel_size=1, context_parallel_size=1
+    )
+    # The linears created below initialize inside `get_cuda_rng_tracker().fork()`,
+    # which the training entrypoint seeds.
+    from megatron.core.tensor_parallel import model_parallel_cuda_manual_seed
+
+    model_parallel_cuda_manual_seed(1234)
+    print(f'[setup] hccl world_size=1, model parallel initialized, device={torch.cuda.current_device()}')
