+#!/usr/bin/env python
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Self-tests for the Qwen3.8-Flash-Next GDN port (``qwen4_exp``).
+
+Sections, each runnable on its own with ``--stage``:
+
+1. ``import``  -- the package imports, the public API is complete, and
+   ``get_qwen4_exp_gdn_spec`` returns a spec with ``module=Qwen4ExpGDN`` and
+   ``metainfo['fuse_input_layernorm'] is False``;
+2. ``build``   -- one GDN layer is built and run on a single NPU, both with the
+   small test config (``hidden_size=512``) and with the real checkpoint geometry
+   (``hidden_size=2560``: 16x128 key heads / 48x128 value heads), checking the
+   output shape/dtype and that the ``in_proj`` / ``conv1d`` sharding split names
+   match the checkpoint;
+3. ``norm``    -- ``_apply_gated_norm`` against the manual formula for
+   ``output_gate_type`` in ``{sigmoid, silu}``, and the zero-centered on/off
+   difference before and after ``fix_gdn_out_norm_zero_centered``;
+4. ``kernel``  -- which gated-delta-rule kernel actually ran and whether the
+   triton and pure-torch paths agree (``--backend``).
+
+The two environment switches of the layer are exposed as flags (they are read
+when ``gdn.py`` is imported, which happens only inside the test functions, after
+``main`` has set them): ``--torch-conv`` sets
+``MINDSPEED_BRIDGE_GDN_USE_TORCH_CONV=1`` (``F.conv1d`` instead of the fused fla
+conv), ``--backend {triton,torch,ascendc}`` sets ``MINDSPEED_BRIDGE_GDN_BACKEND``.
+
+Usage::
+
+    python -m mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.tests.test_gdn
+    python -m mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.tests.test_gdn --stage norm
+    python -m mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.tests.test_gdn --backend torch
+    python -m mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.tests.test_gdn --torch-conv
+
+It never trains and never builds a multi-layer model.
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import socket
+import sys
+import traceback
+from types import SimpleNamespace
+from typing import Optional
+
+import torch
+
+
+# --------------------------------------------------------------------------------------
+# runtime setup
+# --------------------------------------------------------------------------------------
+def _free_port() -> int:
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
+        s.bind(('127.0.0.1', 0))
+        return s.getsockname()[1]
+
+
+def _setup_npu() -> None:
+    """Import torch_npu and apply MindSpeed's Megatron patches.
+
+    Order matters: ``mindspeed.megatron_adaptor`` replaces
+    ``megatron.core.extensions.transformer_engine.{TEColumnParallelLinear,
+    TERowParallelLinear,TENorm}`` with the Ascend implementations, and
+    ``get_qwen4_exp_gdn_spec`` resolves those classes through the backend spec
+    provider.
+    """
+    import torch_npu  # noqa: F401
+
+    import mindspeed.megatron_adaptor  # noqa: F401
+
+
+def _init_dist() -> None:
+    """One-rank hccl process group, so parallel_state has real groups."""
+    if torch.distributed.is_initialized():
+        return
+    os.environ.setdefault('MASTER_ADDR', '127.0.0.1')
+    os.environ.setdefault('MASTER_PORT', str(_free_port()))
+    os.environ['RANK'] = '0'
+    os.environ['WORLD_SIZE'] = '1'
+    os.environ['LOCAL_RANK'] = '0'
+    torch.distributed.init_process_group(
+        backend='hccl', world_size=1, rank=0, init_method='tcp://127.0.0.1:' + os.environ['MASTER_PORT']
+    )
+    from megatron.core import parallel_state
+
+    parallel_state.initialize_model_parallel(
+        tensor_model_parallel_size=1, pipeline_model_parallel_size=1, context_parallel_size=1
+    )
+    # The TP linears created below initialize their weights inside
+    # `get_cuda_rng_tracker().fork()`, which the training entrypoint seeds.
+    from megatron.core.tensor_parallel import model_parallel_cuda_manual_seed
+
+    model_parallel_cuda_manual_seed(1234)
+    print(f'[setup] hccl world_size=1, model parallel initialized, device={torch.cuda.current_device()}')
+
+
+def _pgc():
+    from megatron.core.process_groups_config import ProcessGroupCollection
+
+    return ProcessGroupCollection.use_mpu_process_groups()
+
+
+# --------------------------------------------------------------------------------------
+# layer under test
+# --------------------------------------------------------------------------------------
+# The real checkpoint geometry, derived from the layer-0 GDN tensors
+# (in_proj_qkv (10240, 2560), in_proj_z (6144, 2560), in_proj_b/a (48, 2560),
+# conv1d (10240, 1, 4), norm (128,), out_proj (2560, 6144)).
+REAL_GEOMETRY = dict(
+    hidden_size=2560,
+    linear_num_key_heads=16,
+    linear_key_head_dim=128,
+    linear_num_value_heads=48,
+    linear_value_head_dim=128,
+)
+SMALL_GEOMETRY = dict(
+    hidden_size=512, linear_num_key_heads=4, linear_key_head_dim=64, linear_num_value_heads=8, linear_value_head_dim=64
+)
+
+
+def make_config(params_dtype=torch.bfloat16, output_gate_type='sigmoid', **geometry):
+    """A minimal ``TransformerConfig`` carrying only what the GDN layer reads."""
+    import torch.nn.functional as F
+    from megatron.core.transformer import TransformerConfig
+
+    kwargs = dict(REAL_GEOMETRY)
+    kwargs.update(geometry)
+    config = TransformerConfig(
+        num_layers=1,
+        hidden_size=kwargs['hidden_size'],
+        num_attention_heads=4,
+        num_query_groups=1,
+        ffn_hidden_size=kwargs['hidden_size'] * 2,
+        normalization='RMSNorm',
+        activation_func=F.silu,
+        layernorm_epsilon=1e-6,
+        linear_conv_kernel_dim=4,
+        linear_key_head_dim=kwargs['linear_key_head_dim'],
+        linear_value_head_dim=kwargs['linear_value_head_dim'],
+        linear_num_key_heads=kwargs['linear_num_key_heads'],
+        linear_num_value_heads=kwargs['linear_num_value_heads'],
+        tensor_model_parallel_size=1,
+        pipeline_model_parallel_size=1,
+        context_parallel_size=1,
+        sequence_parallel=False,
+        params_dtype=params_dtype,
+        perform_initialization=True,
+        add_bias_linear=False,
+        gated_linear_unit=True,
+    )
+    # Not a TransformerConfig field in mcore 0.16.1; the HF config has it and the
+    # layer reads it with getattr.
+    config.output_gate_type = output_gate_type
+    return config
+
+
+def build_layer(config, pg_collection=None):
+    from megatron.core.transformer.spec_utils import build_module
+
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.gdn import (
+        get_qwen4_exp_gdn_spec,
+    )
+
+    spec = get_qwen4_exp_gdn_spec(config)
+    layer = build_module(spec, config=config, layer_number=1, pg_collection=pg_collection or _pgc())
+    # Same call the training entrypoint makes right after building the model
+    # (`megatron/training/training.py`: `model_module.cuda(torch.cuda.current_device())`).
+    # It is needed here because MindSpeed's RMSNorm creates its weight without a
+    # device (CPU) while everything else is born on the NPU.
+    layer.cuda(torch.cuda.current_device())
+    return layer, spec
+
+
+def _kernel_path(layer) -> str:
+    rule = layer.gated_delta_rule
+    return f'{getattr(rule, "__module__", "?")}.{getattr(rule, "__name__", rule)}'
+
+
+def _conv_path() -> str:
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp import gdn
+
+    return 'fla causal_conv1d' if gdn.causal_conv1d is not None else 'torch F.conv1d (fla_npu missing or forced)'
+
+
+def _check(cond, label, detail=''):
+    print(f'    [{"PASS" if cond else "FAIL"}] {label}' + (f' {detail}' if detail else ''))
+    return bool(cond)
+
+
+def _spec_type(spec):
+    """The class a spec resolves to.
+
+    Note: the backend spec providers return bare classes here, not ``ModuleSpec``
+    (``TESpecProvider.column_parallel_linear/layer_norm/row_parallel_linear`` all
+    end in ``return <Class>``), and ``nn.Module.type`` -- the legacy
+    parameter-casting method -- would shadow a naive ``getattr(spec, 'type')``.
+    """
+    from megatron.core.transformer.spec_utils import ModuleSpec
+
+    if isinstance(spec, ModuleSpec):
+        return getattr(spec, 'module', spec)
+    return spec
+
+
+def _name(cls) -> str:
+    return f'{getattr(cls, "__module__", "?")}.{getattr(cls, "__name__", cls)}'
+
+
+def describe(layer, spec) -> None:
+    print(f'    kernel path      : {_kernel_path(layer)}')
+    print(f'    conv path        : {_conv_path()}')
+    print(f'    in_proj          : {type(layer.in_proj).__module__}.{type(layer.in_proj).__name__}')
+    print(
+        f'    out_norm         : {type(layer.out_norm).__module__}.{type(layer.out_norm).__name__}'
+        f' weight={tuple(layer.out_norm.weight.shape)} {layer.out_norm.weight.dtype}'
+    )
+    print(f'    out_proj         : {type(layer.out_proj).__module__}.{type(layer.out_proj).__name__}')
+    print(
+        f'    in_proj_dim      : {layer.in_proj_dim}  '
+        f'(qk={layer.qk_dim} x2 + v={layer.v_dim} x2 + heads={layer.num_value_heads} x2)'
+    )
+    print(
+        f'    conv_dim         : {layer.conv_dim} kernel={layer.conv_kernel_dim} '
+        f'weight={tuple(layer.conv1d.weight.shape)}'
+    )
+    print(f'    A_log/dt_bias    : {tuple(layer.A_log.shape)} {tuple(layer.dt_bias.shape)}')
+    print(
+        f'    spec.submodules  : in_proj={_name(_spec_type(spec.submodules.in_proj))} '
+        f'out_norm={_name(_spec_type(spec.submodules.out_norm))} '
+        f'out_proj={_name(_spec_type(spec.submodules.out_proj))} metainfo={spec.metainfo}'
+    )
+
+
+# --------------------------------------------------------------------------------------
+# 1. import smoke
+# --------------------------------------------------------------------------------------
+def test_import_smoke() -> bool:
+    print('\n=== [1] import smoke ===')
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp import gdn
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.gdn import (
+        GatedDeltaNet,
+        Qwen4ExpGDN,
+        fix_gdn_out_norm_zero_centered,
+        get_qwen4_exp_gdn_spec,
+    )
+
+    ok = _check(issubclass(Qwen4ExpGDN, GatedDeltaNet), 'Qwen4ExpGDN subclasses the ported GatedDeltaNet')
+    ok &= _check(callable(get_qwen4_exp_gdn_spec), 'get_qwen4_exp_gdn_spec exists')
+    ok &= _check(callable(fix_gdn_out_norm_zero_centered), 'fix_gdn_out_norm_zero_centered exists')
+    ok &= _check(not hasattr(gdn, 'HAVE_FLA') or gdn.HAVE_TRITON_GDN is not None, 'kernel availability flag present')
+    print(f'    HAVE_TRITON_GDN  : {gdn.HAVE_TRITON_GDN} (chunk_gated_delta_rule={gdn.chunk_gated_delta_rule})')
+
+    config = make_config(**SMALL_GEOMETRY)
+    spec = get_qwen4_exp_gdn_spec(config)
+    ok &= _check(spec.module is Qwen4ExpGDN, 'spec.module is Qwen4ExpGDN')
+    ok &= _check(spec.metainfo == {'fuse_input_layernorm': False}, f'spec.metainfo={spec.metainfo}')
+    ok &= _check(
+        hasattr(spec.submodules, 'in_proj')
+        and hasattr(spec.submodules, 'out_norm')
+        and hasattr(spec.submodules, 'out_proj'),
+        'spec.submodules = in_proj/out_norm/out_proj',
+    )
+    print(
+        f'    spec submodule types: in_proj={_name(_spec_type(spec.submodules.in_proj))}, '
+        f'out_norm={_name(_spec_type(spec.submodules.out_norm))}, '
+        f'out_proj={_name(_spec_type(spec.submodules.out_proj))}'
+    )
+    out_norm_params = getattr(spec.submodules.out_norm, 'params', None)
+    if out_norm_params is None:
+        # TESpecProvider.layer_norm returns the class itself; TENorm.__new__ picks
+        # the norm from config.normalization.
+        ok &= _check(
+            config.normalization == 'RMSNorm',
+            f'out_norm backend class takes normalization from config ({config.normalization})',
+        )
+    else:
+        ok &= _check(
+            out_norm_params.get('rms_norm') is True,
+            f"out_norm rms_norm={out_norm_params.get('rms_norm')} (normalization={config.normalization})",
+        )
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+# 2. build + forward on one NPU
+# --------------------------------------------------------------------------------------
+def test_build_and_forward(geometry: dict, dtype=torch.bfloat16, s: int = 16, b: int = 1) -> bool:
+    name = 'small (hidden=512)' if geometry['hidden_size'] == 512 else f"real ({geometry})"
+    print(f'\n=== [2] build + forward: {name}, dtype={dtype}, input=[s={s}, b={b}, h={geometry["hidden_size"]}] ===')
+    config = make_config(params_dtype=dtype, **geometry)
+    layer, spec = build_layer(config)
+    describe(layer, spec)
+    layer.eval()
+
+    x = torch.randn(s, b, geometry['hidden_size'], dtype=dtype, device=torch.cuda.current_device())
+    layer.zero_grad(set_to_none=True)
+    with torch.no_grad():
+        out, out_bias = layer(x, attention_mask=None)
+
+    print(f'    output           : shape={tuple(out.shape)} dtype={out.dtype} device={out.device}')
+    print(
+        f'    output stats     : mean={out.float().mean().item():+.6f} std={out.float().std().item():.6f} '
+        f'absmax={out.float().abs().max().item():.6f} finite={bool(torch.isfinite(out.float()).all())}'
+    )
+    ok = _check(tuple(out.shape) == (s, b, geometry['hidden_size']), 'output shape == input shape')
+    ok &= _check(out.dtype == dtype, f'output dtype == {dtype}')
+    ok &= _check(bool(torch.isfinite(out.float()).all()), 'output is finite (no NaN/Inf)')
+
+    # The sharded split names are the checkpoint contract: in_proj -> q/k/v/z/beta/alpha,
+    # conv1d -> q/k/v.
+    sd = layer.sharded_state_dict()
+    in_proj_splits = [(t.key, tuple(t.data.shape)) for t in sd['in_proj.weight'].build()]
+    conv_splits = [(t.key, tuple(t.data.shape)) for t in sd['conv1d.weight'].build()]
+    print(f'    in_proj sharded  : key={sd["in_proj.weight"].key}')
+    for key, shape in in_proj_splits:
+        print(f'                       {key} {shape}')
+    print(
+        f'    conv1d sharded   : key={sd["conv1d.weight"].key} splits={[k.rsplit(".", 1)[-1] for k, _ in conv_splits]}'
+    )
+    nkh, khd = geometry['linear_num_key_heads'], geometry['linear_key_head_dim']
+    nvh, vhd = geometry['linear_num_value_heads'], geometry['linear_value_head_dim']
+    qk_dim, v_dim = nkh * khd, nvh * vhd
+    conv_dim = 2 * qk_dim + v_dim
+    expected = {'query': qk_dim, 'key': qk_dim, 'value': v_dim, 'z': v_dim, 'beta': nvh, 'alpha': nvh}
+    got = {k.rsplit('.', 1)[-1]: shape[0] for k, shape in in_proj_splits}
+    print(
+        f'    checkpoint check : in_proj_qkv rows {got.get("query", 0) + got.get("key", 0) + got.get("value", 0)}'
+        f' (q+k+v), in_proj_z rows {got.get("z")} (v_dim), in_proj_b/a rows {got.get("beta")}/{got.get("alpha")}'
+        f' (num_value_heads); conv1d rows {layer.conv_dim} (2*qk+v)'
+    )
+    ok &= _check(got == expected, 'in_proj split order/rows == checkpoint q,k,v,z,beta,alpha', f'{got}')
+    ok &= _check(sum(got.values()) == layer.in_proj_dim, f'in_proj rows == in_proj_dim ({layer.in_proj_dim})')
+    ok &= _check(layer.conv_dim == conv_dim, f'conv_dim == checkpoint conv1d rows ({conv_dim})')
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+# 3. gated norm numerics
+# --------------------------------------------------------------------------------------
+def _ref_gated_norm(x, weight, gate, eps, zero_centered, act):
+    xf = x.float()
+    xn = xf * torch.rsqrt(xf.pow(2).mean(-1, keepdim=True) + eps)
+    w = (1.0 + weight.float()) if zero_centered else weight.float()
+    return (xn * w * act(gate.float())).to(x.dtype)
+
+
+def test_gated_norm() -> bool:
+    print('\n=== [3] gated output norm numerics ===')
+    import torch.nn.functional as F
+
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.gdn import (
+        fix_gdn_out_norm_zero_centered,
+    )
+
+    config = make_config(params_dtype=torch.float32, output_gate_type='sigmoid', **SMALL_GEOMETRY)
+    layer, _ = build_layer(config)
+    layer.eval()
+    eps = config.layernorm_epsilon
+    device = torch.cuda.current_device()
+    n_heads = SMALL_GEOMETRY['linear_num_value_heads']
+    v_head = SMALL_GEOMETRY['linear_value_head_dim']
+
+    torch.manual_seed(0)
+    with torch.no_grad():
+        # ones-style (non-zero-centered) weights, as the checkpoint stores them
+        layer.out_norm.weight.fill_(1.0)
+    x = torch.randn(2, 8, n_heads, v_head, dtype=torch.float32, device=device)
+    gate = 3.0 * torch.randn(2, 8, n_heads, v_head, dtype=torch.float32, device=device)
+
+    def run_norm():
+        # the layer flattens to [b*s*heads, v_head] inside; compare in x's shape
+        with torch.no_grad():
+            return layer._apply_gated_norm(x, gate).reshape(x.shape)
+
+    print(
+        f'    out_norm.weight  : ones (checkpoint style), zero_centered_gamma flag = '
+        f'{getattr(layer.out_norm, "zero_centered_gamma", "<absent>")}, '
+        f'config.layernorm_zero_centered_gamma = {layer.out_norm.config.layernorm_zero_centered_gamma}, '
+        f'config.use_fused_rmsnorm = {layer.out_norm.config.use_fused_rmsnorm}'
+    )
+    ok = True
+    for act_name, act, gate_type in (('sigmoid', torch.sigmoid, 'sigmoid'), ('silu', F.silu, 'silu')):
+        config.output_gate_type = gate_type
+        ref = _ref_gated_norm(x, layer.out_norm.weight, gate, eps, False, act)
+        out = run_norm()
+        err = (out - ref).abs().max().item()
+        ok &= _check(
+            err < 1e-5, f'output_gate_type={act_name!r} matches manual {act_name}(gate)*rmsnorm', f'max|diff|={err:.3e}'
+        )
+
+    # Non-ones weight too: proves weight is applied, not just the gate.
+    config.output_gate_type = 'sigmoid'  # the loop above left it at 'silu'
+    with torch.no_grad():
+        layer.out_norm.weight.normal_(1.0, 0.5)
+    ref = _ref_gated_norm(x, layer.out_norm.weight, gate, eps, False, torch.sigmoid)
+    out = run_norm()
+    err = (out - ref).abs().max().item()
+    ok &= _check(err < 1e-5, 'random (non-ones) out_norm.weight still matches', f'max|diff|={err:.3e}')
+
+    # ---- zero-centered on/off ------------------------------------------------------
+    shared_config_flag_before = config.layernorm_zero_centered_gamma
+    with torch.no_grad():
+        layer.out_norm.weight.fill_(1.0)
+    ref_plain = _ref_gated_norm(x, layer.out_norm.weight, gate, eps, False, torch.sigmoid)
+
+    # as an unfixed model would have it (the backend builds the norm from the shared config)
+    layer.out_norm.config = __import__('copy').copy(config)
+    layer.out_norm.config.layernorm_zero_centered_gamma = True
+    out_zc = run_norm()
+    mask = ref_plain.abs() > 0.1
+    ratio = (out_zc[mask] / ref_plain[mask]).mean().item()
+    print(
+        f'    zero-centered ON  : mean(out_zc/out_plain) over {int(mask.sum())} elements with |ref|>0.1 = '
+        f'{ratio:.6f} (ones-style weight -> expected exactly 2.0)'
+    )
+    ok &= _check(
+        bool((out_zc - 2.0 * ref_plain).abs().max().item() < 1e-5),
+        'zero-centered ON doubles a ones-style weight (this is the checkpoint mismatch)',
+        f'max|diff|={(out_zc - 2.0 * ref_plain).abs().max().item():.3e}',
+    )
+    ok &= _check(
+        bool((out_zc - ref_plain).abs().max().item() > 1e-3), 'zero-centered ON is measurably different from OFF'
+    )
+
+    # now the fix
+    patched = fix_gdn_out_norm_zero_centered([SimpleNamespace(self_attention=layer)])
+    out_fixed = run_norm()
+    print(
+        f'    after fix        : patched {patched} layer(s); '
+        f'out_norm.zero_centered_gamma={layer.out_norm.zero_centered_gamma}, '
+        f'out_norm.config.layernorm_zero_centered_gamma={layer.out_norm.config.layernorm_zero_centered_gamma}, '
+        f'out_norm.config is shared config: {layer.out_norm.config is config}'
+    )
+    ok &= _check(patched == 1, 'fix_gdn_out_norm_zero_centered patched the layer')
+    ok &= _check(layer.out_norm.zero_centered_gamma is False, 'out_norm.zero_centered_gamma == False')
+    ok &= _check(
+        layer.out_norm.config.layernorm_zero_centered_gamma is False,
+        'out_norm.config.layernorm_zero_centered_gamma == False',
+    )
+    ok &= _check(layer.out_norm.config is not config, 'out_norm.config is a copy (shared config not mutated)')
+    ok &= _check(
+        config.layernorm_zero_centered_gamma == shared_config_flag_before,
+        f'shared config untouched ({shared_config_flag_before})',
+    )
+    err = (out_fixed - ref_plain).abs().max().item()
+    ok &= _check(err < 1e-5, 'after the fix the output is the checkpoint-faithful one', f'max|diff|={err:.3e}')
+
+    # a full-attention layer (no out_norm) must be skipped, not crash
+    skipped = fix_gdn_out_norm_zero_centered([SimpleNamespace(self_attention=SimpleNamespace())])
+    ok &= _check(skipped == 0, 'layers without out_norm are skipped')
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+# 4. kernel path
+# --------------------------------------------------------------------------------------
+def test_kernel_paths(geometry: dict, s: int = 16, b: int = 1) -> bool:
+    print(
+        f'\n=== [4] gated-delta-rule kernel path (MINDSPEED_BRIDGE_GDN_BACKEND='
+        f'{os.environ.get("MINDSPEED_BRIDGE_GDN_BACKEND", "triton")}) ==='
+    )
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp import gdn
+
+    config = make_config(params_dtype=torch.bfloat16, **geometry)
+    layer, _ = build_layer(config)
+    layer.eval()
+    print(f'    kernel path      : {_kernel_path(layer)}')
+    print(f'    conv path        : {_conv_path()}')
+
+    x = torch.randn(s, b, geometry['hidden_size'], dtype=torch.bfloat16, device=torch.cuda.current_device())
+    with torch.no_grad():
+        out, _ = layer(x, attention_mask=None)
+    ok = _check(
+        bool(torch.isfinite(out.float()).all()), f'forward through {_kernel_path(layer)} produced finite output'
+    )
+
+    rule = layer.gated_delta_rule
+    if rule is not gdn._torch_gated_delta_rule:
+        # Compare against the pure-torch rule on the very same weights.
+        layer.gated_delta_rule = gdn._torch_gated_delta_rule
+        with torch.no_grad():
+            ref, _ = layer(x, attention_mask=None)
+        layer.gated_delta_rule = rule
+        err = (out.float() - ref.float()).abs().max().item()
+        rel = err / ref.float().abs().max().clamp_min(1e-6).item()
+        print(f'    triton vs torch  : max|diff|={err:.6e} (rel {rel:.3e})')
+        ok &= _check(err < 5e-2, 'triton kernel and pure-torch rule agree (bf16)')
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+# main
+# --------------------------------------------------------------------------------------
+def main(argv: Optional[list] = None) -> int:
+    parser = argparse.ArgumentParser(description='Qwen4Exp GDN self-tests')
+    parser.add_argument('--stage', default='all', choices=['all', 'import', 'build', 'norm', 'kernel'])
+    parser.add_argument(
+        '--hidden-size', type=int, default=None, help='run the build/forward test for this hidden size (512 or 2560)'
+    )
+    parser.add_argument(
+        '--backend',
+        default=None,
+        choices=['triton', 'torch', 'ascendc'],
+        help='value for MINDSPEED_BRIDGE_GDN_BACKEND (read when gdn.py is imported)',
+    )
+    parser.add_argument(
+        '--torch-conv', action='store_true', help='set MINDSPEED_BRIDGE_GDN_USE_TORCH_CONV=1 (F.conv1d instead of fla)'
+    )
+    parser.add_argument('--seq-len', type=int, default=16)
+    parser.add_argument('--batch-size', type=int, default=1)
+    args = parser.parse_args(argv)
+
+    if args.backend:
+        os.environ['MINDSPEED_BRIDGE_GDN_BACKEND'] = args.backend
+    if args.torch_conv:
+        os.environ['MINDSPEED_BRIDGE_GDN_USE_TORCH_CONV'] = '1'
+    print(
+        f'[setup] MINDSPEED_BRIDGE_GDN_BACKEND={os.environ.get("MINDSPEED_BRIDGE_GDN_BACKEND", "<unset>")} '
+        f'MINDSPEED_BRIDGE_GDN_USE_TORCH_CONV={os.environ.get("MINDSPEED_BRIDGE_GDN_USE_TORCH_CONV", "<unset>")} '
+        f'torch={torch.__version__}'
+    )
+
+    _setup_npu()
+    _init_dist()
+
+    results = {}
+
+    def run(label, fn, *a, **kw):
+        try:
+            results[label] = fn(*a, **kw)
+        except BaseException as exc:  # noqa: BLE001 - self-test must report, not raise
+            results[label] = False
+            print(f'    [ERROR] {label}: {type(exc).__name__}: {exc}')
+            traceback.print_exc()
+
+    if args.stage in ('all', 'import'):
+        run('import smoke', test_import_smoke)
+    if args.stage in ('all', 'build'):
+        geometries = [SMALL_GEOMETRY, REAL_GEOMETRY]
+        if args.hidden_size == 512:
+            geometries = [SMALL_GEOMETRY]
+        elif args.hidden_size == 2560:
+            geometries = [REAL_GEOMETRY]
+        for geometry in geometries:
+            run(
+                f'build+forward h={geometry["hidden_size"]}',
+                test_build_and_forward,
+                geometry,
+                s=args.seq_len,
+                b=args.batch_size,
+            )
+    if args.stage in ('all', 'norm'):
+        run('gated norm', test_gated_norm)
+    if args.stage in ('all', 'kernel'):
+        run('kernel path', test_kernel_paths, REAL_GEOMETRY, s=args.seq_len, b=args.batch_size)
+
+    print('\n=== summary ===')
+    for label, ok in results.items():
+        print(f'  {"PASS" if ok else "FAIL"}  {label}')
+    failed = [k for k, v in results.items() if not v]
+    print(f'\n{len(results) - len(failed)}/{len(results)} passed' + (f'; FAILED: {failed}' if failed else ''))
+    return 1 if failed else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
