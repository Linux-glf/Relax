+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Self-tests for the Qwen3.8-Flash-Next vision tower (``vision.py``).
+
+Five layers, each runnable on its own:
+
+1. spec / interface smoke -- ``get_qwen4_exp_vision_spec`` builds a tower whose
+   parameter names and shapes are the ``vision_model.*`` ones the bridge maps to
+   ``model.visual.*``; the full checkpoint name <-> module parameter table is
+   printed (shapes read from the safetensors index, no tensor data loaded);
+2. HF helper equivalence -- the position-embedding interpolation, the 2-D
+   rotary embeddings and the packed attention lengths match
+   ``transformers.vision_utils`` (the helpers the HF reference calls) on
+   synthetic ``grid_thw`` values;
+3. numerical alignment (core) -- with the real ``model.visual.*`` weights of the
+   checkpoint, the Megatron tower against ``Qwen4ExpVisionModel`` on a synthetic
+   image (and on an image + 2-frame video, i.e. several packed segments), in fp32
+   and bf16: cosine similarity and max abs diff. bf16 is judged against the bf16
+   noise floor of the reference itself (HF bf16 vs HF fp32), because the tower has
+   no final norm on the residual stream;
+4. freeze/unfreeze toggle;
+5. NPU forward (fp32 and bf16), plus the default ``vit_attn_impl="sdpa"`` against
+   the explicit fp32-softmax reference math on the same device.
+
+Only ``model.visual.*`` tensors are read from the checkpoint (via
+``safetensors.safe_open`` and the shard that holds them); the 336 GB model is
+never loaded.
+
+Usage::
+
+    python -m mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.tests.test_vision
+    python .../tests/test_vision.py --no-weights      # skip the checkpoint tests
+    python .../tests/test_vision.py --cpu-only        # skip the NPU test
+
+The module import falls back to loading ``vision.py`` by file path when the
+package itself cannot be imported (e.g. a sibling module of ``qwen4_exp`` is
+mid-edit), so both invocations above always work.
+"""
+
+from __future__ import annotations
+
+import argparse
+import gc
+import json
+import os
+import sys
+import traceback
+from typing import Any, Dict, List, Optional, Tuple
+
+import torch
+import torch.nn.functional as F
+
+_REPO_ROOT = os.path.dirname(
+    os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))))
+)
+if _REPO_ROOT not in sys.path:
+    sys.path.insert(0, _REPO_ROOT)
+
+# The checkpoint root is deployment-specific (and must not be baked into a tracked
+# file); the tests that need it fail loud when it is unset.
+CKPT_DIR = os.environ.get("QWEN4_EXP_CKPT", "")
+VISION_PREFIX = "model.visual."
+CPU_DEVICE = torch.device("cpu")
+
+# Synthetic vision input: one 8x8-patch image (the shape asked for in the port spec).
+GRID_THW = torch.tensor([[1, 8, 8]], dtype=torch.long)
+# A mixed batch: an image plus a 2-frame video, to exercise the multi-segment path.
+GRID_THW_MIXED = torch.tensor([[1, 8, 8], [2, 4, 6]], dtype=torch.long)
+
+_FIXTURE: Dict[str, Any] = {}
+
+
+# --------------------------------------------------------------------------------------
+# setup helpers
+# --------------------------------------------------------------------------------------
+def _bootstrap() -> None:
+    """Make the mcore init path work on the current device and init the process groups."""
+    device = "cpu"
+    try:
+        # `torch_npu` + `mindspeed.megatron_adaptor`, in that order, rather than
+        # `torch_npu.contrib.transfer_to_npu` alone -- the same bootstrap the other
+        # harnesses here use, and training's. Two separate things need it:
+        #  * the adaptor is what installs the `transformer_engine_torch` stand-in,
+        #    so `import megatron.core` fails outright without it;
+        #  * the live tree's `megatron/core/ssm/ops/gdp/common.py` evaluates
+        #    `torch.cuda.get_device_name(0) or torch.cuda.get_device_capability()[0]`
+        #    at module level, and on Ascend the first is not "NVIDIA H..." and the
+        #    second is `None` -- `TypeError: 'NoneType' object is not subscriptable`,
+        #    raised from an import this file never asked for.
+        import torch_npu  # noqa: F401
+        import mindspeed.megatron_adaptor  # noqa: F401
+
+        device = "npu"
+        print(f"[setup] torch_npu + megatron_adaptor active (npu count={torch.npu.device_count()})")
+    except Exception as exc:  # pragma: no cover - non-Ascend host
+        print(f"[setup] torch_npu not available ({exc}); using plain torch cuda/cpu semantics")
+
+    import torch.distributed as dist
+    from megatron.core import parallel_state, tensor_parallel
+
+    if not dist.is_initialized():
+        os.environ.setdefault("MASTER_ADDR", "127.0.0.1")
+        os.environ.setdefault("MASTER_PORT", "29531")
+        backend = "hccl" if device == "npu" else "gloo"
+        try:
+            dist.init_process_group(backend=backend, rank=0, world_size=1)
+        except Exception as exc:
+            print(f"[setup] {backend} process group failed ({exc}); falling back to gloo")
+            backend = "gloo"
+            dist.init_process_group(backend=backend, rank=0, world_size=1)
+        print(f"[setup] process group initialized (backend={backend}, world_size=1)")
+
+    if not parallel_state.model_parallel_is_initialized():
+        parallel_state.initialize_model_parallel(1, 1)
+    tensor_parallel.model_parallel_cuda_manual_seed(1234)
+    print("[setup] mcore mpu initialized (tp=1, pp=1, cp=1), model-parallel seed=1234")
+
