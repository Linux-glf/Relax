+def _build_packed_block_aligned_selection(docs, keep_blocks, R, seed=7):
+    """Per-document ``_build_block_aligned_selection`` shifted into pack space."""
+    idx_parts, start_parts, off = [], [], 0
+    for i, L in enumerate(docs):
+        indices, starts = _build_block_aligned_selection(L, keep_blocks, R, seed + i)
+        idx_parts.append(torch.where(indices >= 0, indices + off, indices))
+        start_parts.append(torch.where(starts >= 0, starts + off, starts))
+        off += L
+    return torch.cat(idx_parts, 0), torch.cat(start_parts, 0)
+
+
+def _build_packed_block_aligned_indices(docs, keep_blocks, R, seed=7):
+    return _build_packed_block_aligned_selection(docs, keep_blocks, R, seed)[0]
