+def test_npu_lightning_selection() -> bool:
+    print()
+    print('== test 6: CANN LightningIndexerV2 packed selection vs local core ==')
+    if not _npu_available():
+        print('torch.npu is not available -- SKIPPED')
+        return True
+    try:
+        from cann_ops_transformer.ops import lightning_indexer  # noqa: F401
+    except Exception:
+        print('cann_ops_transformer is not importable -- SKIPPED')
+        return True
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.qsa import indexer as qsa_indexer
+
+    cfg = QSAIndexerTestConfig(
+        hidden_size=512,
+        indexer_n_heads=4,
+        indexer_kv_heads=1,
+        indexer_head_dim=128,
+        indexer_compress_ratio=4,
+        indexer_budget=2048,
+        params_dtype=torch.bfloat16,
+    )
+    indexer = _build_indexer(cfg).npu().eval()
+    device = torch.device('npu')
+    # Both documents hold far more complete blocks than block_topk. Within a
+    # document, the first rows whose causal prefix exceeds the budget (n_blocks
+    # 513..~562 here) have their top-k boundary inside the relu zero-score
+    # group: dozens of blocks tie at exactly 0.0 and topk may return any of
+    # them, so legacy and LightningIndexerV2 legitimately pick different sets
+    # there. Everywhere else the boundary score is strictly positive and the
+    # two engines must agree exactly; the test enforces that, and enforces the
+    # structural invariants (bounds, causality, slot counts, tail) on all rows.
+    docs = [4000, 3000]
+    T = sum(docs)
+    cu = torch.tensor([0, docs[0], T], dtype=torch.int32, device=device)
+    g = torch.Generator().manual_seed(1234)
+    hidden = torch.randn(T, cfg.hidden_size, generator=g).to(torch.bfloat16).to(device)
+    freqs = ((torch.rand(T, 1, 1, 64, generator=g) * 2 - 1) * math.pi).to(device)
+
+    prev = os.environ.get(qsa_indexer.QSA_INDEXER_IMPL_ENV)
+    try:
+        os.environ[qsa_indexer.QSA_INDEXER_IMPL_ENV] = 'legacy'
+        legacy = indexer.select_token_indices_thd(hidden, freqs, cu)
+        os.environ[qsa_indexer.QSA_INDEXER_IMPL_ENV] = 'lightning'
+        fused = indexer.select_token_indices_thd(hidden, freqs, cu)
+        torch.npu.synchronize()
+    finally:
+        if prev is None:
+            os.environ.pop(qsa_indexer.QSA_INDEXER_IMPL_ENV, None)
+        else:
+            os.environ[qsa_indexer.QSA_INDEXER_IMPL_ENV] = prev
+
+    if not qsa_indexer._LIGHTNING_OPS:
+        # Strict mode re-raises an operator failure, so reaching here with no
+        # cached ops means the static gate turned the fused path down.
+        print('the fused path was not selected (static gate or import failure) -- FAIL')
+        return False
+
+    R = cfg.indexer_compress_ratio
+    print(f'shape: T={T} docs={docs} legacy={tuple(legacy.shape)} fused={tuple(fused.shape)} '
+          f'dtypes={legacy.dtype}/{fused.dtype}')
+    ok = legacy.shape == fused.shape and legacy.dtype == fused.dtype
+    if not ok:
+        print('shape/dtype mismatch')
+        return False
+
+    a, b = legacy.long().cpu(), fused.long().cpu()
+    tail_same = bool(torch.equal(a[:, -R:], b[:, -R:]))
+    count_bad = int(((a >= 0).sum(-1) != (b >= 0).sum(-1)).sum())
+    doc = torch.repeat_interleave(torch.arange(len(docs)), torch.tensor(docs))
+    pos = torch.arange(T) - cu.cpu()[doc].long()
+
+    def violations(x):
+        starts = cu.cpu()[doc].long().unsqueeze(1)
+        ends = starts + torch.tensor(docs)[doc].unsqueeze(1)
+        xs = x.clamp_min(0)
+        valid = x >= 0
+        return int(((xs < starts) & valid).sum() + ((xs >= ends) & valid).sum()
+                   + ((xs - starts > pos.unsqueeze(1)) & valid).sum())
+
+    viol_a, viol_b = violations(a), violations(b)
+    # n_blocks >= 640 puts the boundary well above the zero-score group here
+    # (the group never exceeds ~1/16 of the candidates), so the selection is
+    # strict and both engines must return the same key set.
+    strict = ((pos + 1) // R) >= 640
+    set_diff = 0
+    tie_diff = 0
+    for t, x, y in zip(range(T), a.tolist(), b.tolist()):
+        same = set(v for v in x if v >= 0) == set(v for v in y if v >= 0)
+        if same:
+            continue
+        if strict[t]:
+            set_diff += 1
+        else:
+            tie_diff += 1
+    print(f'tail identical: {tail_same}')
+    print(f'rows with different selected count: {count_bad}/{T}')
+    print(f'doc/causal violations: legacy={viol_a} fused={viol_b}')
+    print(f'rows with different key sets above the tie window: {set_diff}/'
+          f'{int(strict.sum())} (strict)')
+    print(f'rows with different key sets inside the tie window: {tie_diff}/'
+          f'{int((~strict).sum())} (allowed: zero-score ties)')
+    ok &= tail_same and count_bad == 0 and viol_a == 0 and viol_b == 0 and set_diff == 0
+    print(f'test 6: {"PASS" if ok else "FAIL"}')
+    return ok
+
