@@ -0,0 +1,70 @@
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Model provider for the multimodal Qwen3.8-Flash-Next (``qwen4_exp``).
+
+The text tower is configured exactly as in
+:class:`~mindspeed_bridge.models.qwen4_exp.qwen4_exp_provider.Qwen4ExpModelProvider`;
+this provider adds the vision tower, the token ids that mark the vision
+placeholders in the sequence, and the two behaviours the merge step needs:
+
+* ``scatter_embedding_sequence_parallel=False`` -- the token embedding has to be
+  looked up *unscattered* so that the vision embeddings can be written into it;
+  :class:`Qwen4ExpVLModel` scatters the merged tensor itself (and repairs the
+  MTP head's own embedding lookup, which needs the scattered layout).
+* ``vision_config`` -- the HF vision config of the checkpoint, from which the
+  tower's Megatron config is derived at build time.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any
+
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.vl_model import Qwen4ExpVLModel
+from mindspeed_bridge.models.qwen4_exp.qwen4_exp_provider import Qwen4ExpModelProvider
+
+
+@dataclass
+class Qwen4ExpVLModelProvider(Qwen4ExpModelProvider):
+    """Provider of the Qwen3.8-Flash-Next vision-language model.
+
+    Only the fields the vision path reads are declared here; everything else --
+    the hybrid attention pattern, the MoE experts, the hyper-connections, the
+    MTP head -- is the text provider's, because it is the same checkpoint.
+    """
+
+    # =========================================================================
+    # Vision tower
+    # =========================================================================
+    # HF `Qwen4ExpVisionConfig` of the checkpoint. Required: the tower's shape
+    # (depth, width, patch/merge sizes, position table) is not derivable from
+    # the text config.
+    vision_config: Any = field(default=None)
+
+    # =========================================================================
+    # Vision placeholders in the sequence
+    # =========================================================================
+    # The ids the processor leaves in `input_ids` where the image/video
+    # embeddings have to be written. They are the tokenizer's, so they travel
+    # with the checkpoint rather than being constants of the architecture.
+    image_token_id: int = 248056
+    video_token_id: int = 248057
+    vision_start_token_id: int = 248053
+    vision_end_token_id: int = 248054
+    spatial_merge_size: int = 2
+
+    # The embedding must hand over the whole sequence so that the vision
+    # embeddings can be merged into it; the model scatters afterwards. See the
+    # module docstring, and the text provider for why the text model cannot do
+    # the same.
+    scatter_embedding_sequence_parallel: bool = False
+
+    def _model_class(self) -> type:
+        return Qwen4ExpVLModel
+
+    def _model_extra_kwargs(self) -> dict:
+        return {
+            'vision_config': self.vision_config,
+            'add_encoder': True,
+        }
