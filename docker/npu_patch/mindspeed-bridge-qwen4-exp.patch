@@ -0,0 +1,97 @@
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Gated hyper-connections for Qwen3.8-Flash-Next (``qwen4_exp``).
+
+Every sub-block (attention and MLP) of every layer carries ``hc_count`` residual
+streams instead of a single one, so the hidden state flowing through the decoder
+is ``hc_count * hidden_size`` wide. Two roles share this module:
+
+* layer-level (``use_combine=True``): mixes the streams into the sub-block input
+  and produces the per-stream injection weights that weight the sub-block output;
+* block-level (``use_combine=False``): the final contraction from ``hc_count``
+  streams back to ``hidden_size`` -- this replaces the final layernorm, which
+  this architecture does not have.
+
+Mirrors transformers ``Qwen4ExpTextGatedResidual``. The projections are
+replicated across TP (their widths -- ``hc_lowrank`` and ``hc_count`` -- are not
+TP-divisible), and every parameter carries the ``sequence_parallel`` flag so
+gradients are reduced across the TP group under sequence parallelism.
+"""
+
+from __future__ import annotations
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+from typing import Tuple
+
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.linear import ReplicatedLinear
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.norms import Qwen4ExpTextGroupedRMSNorm
+
+
+def _mix_elementwise(down_out: torch.Tensor, hc_count: int) -> torch.Tensor:
+    """``silu(down / hc)`` -- the pre-up-projection half of the gate chain."""
+    return F.silu(down_out / hc_count)
+
+
+def _mix_and_reduce(
+    up_out: torch.Tensor, hyper_input_normed: torch.Tensor, hc_count: int, hidden_size: int
+) -> torch.Tensor:
+    """``sigmoid -> unflatten -> multiply -> mean``, the post-up-projection half."""
+    w = torch.sigmoid(up_out).unflatten(-1, (hc_count, hidden_size))
+    return (w * hyper_input_normed.unflatten(-1, (hc_count, hidden_size))).mean(dim=-2)
+
+
+class Qwen4ExpTextGatedResidual(nn.Module):
+    """Gated hyper-connection mixer / residual injector.
+
+    Args:
+        config: Transformer config; uses ``hc_count``, ``hidden_size``,
+            ``hc_lowrank``, ``layernorm_epsilon`` and ``params_dtype``.
+        use_combine: True for the layer-level mixer (keeps
+            ``block_inject_weight`` and returns the 3-tuple the layer needs),
+            False for the model-level contraction (drops it and returns only the
+            mixed input).
+    """
+
+    def __init__(self, config, use_combine: bool = True):
+        super().__init__()
+        self.hc_count = config.hc_count
+        self.hidden_size = config.hidden_size
+        hc_hidden_size = self.hc_count * self.hidden_size
+        # HF: Qwen4ExpTextRMSNorm(hc_hidden_size, group_size=hidden_size,
+        # eps=config.rms_norm_eps); mcore's equivalent of rms_norm_eps is
+        # layernorm_epsilon.
+        self.hc_norm = Qwen4ExpTextGroupedRMSNorm(
+            hc_hidden_size, group_size=self.hidden_size, eps=config.layernorm_epsilon, dtype=config.params_dtype
+        )
+        self.input_mix_weight_down = ReplicatedLinear(
+            config, hc_hidden_size, config.hc_lowrank, bias=False, skip_bias_add=True
+        )
+        self.input_mix_weight_up = ReplicatedLinear(
+            config, config.hc_lowrank, hc_hidden_size, bias=False, skip_bias_add=True
+        )
+        self.block_inject_weight = (
+            ReplicatedLinear(config, hc_hidden_size, self.hc_count, bias=False, skip_bias_add=True)
+            if use_combine
+            else None
+        )
+        # Replicated weights still need TP grad reduction under SP.
+        for param in self.parameters():
+            setattr(param, 'sequence_parallel', config.sequence_parallel)
+
+    def forward(self, hyper_input: torch.Tensor) -> Tuple[torch.Tensor, ...]:
+        # Mirrors transformers `Qwen4ExpTextGatedResidual.forward` line by line.
+        if hyper_input.shape[-1] != self.hc_count * self.hidden_size:
+            raise ValueError(
+                f'Expected {self.hc_count * self.hidden_size} hyper-connection features, got {hyper_input.shape[-1]}.'
+            )
+        hyper_input_normed = self.hc_norm(hyper_input)
+        input_mix_weight = _mix_elementwise(self.input_mix_weight_down(hyper_input_normed)[0], self.hc_count)
+        input_mix_weight = self.input_mix_weight_up(input_mix_weight)[0]
+        mixed_input = _mix_and_reduce(input_mix_weight, hyper_input_normed, self.hc_count, self.hidden_size)
+        if self.block_inject_weight is None:
+            return mixed_input
+        injection_weights = 2 * torch.sigmoid(self.block_inject_weight(hyper_input_normed)[0] / self.hc_count)
+        return mixed_input, hyper_input, injection_weights
