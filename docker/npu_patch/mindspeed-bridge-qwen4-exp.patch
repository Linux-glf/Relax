+# --------------------------------------------------------------------------------------
+# a synthetic table, and the reference the module is measured against
+# --------------------------------------------------------------------------------------
+def write_synthetic_table(
+    root: str,
+    rows: int = TABLE_ROWS,
+    head_dim: int = TABLE_HEAD_DIM,
+    splits: int = TABLE_SPLITS,
+    with_index: bool = True,
+    dtype: torch.dtype = torch.float32,
+) -> torch.Tensor:
+    """Write a sharded n-gram table into ``root``; return the dense matrix it stores.
+
+    Float32 by default: the numeric stages compare the port against the reference
+    formula, and a dtype the two can both hold exactly leaves the arithmetic, not
+    the rounding, as the thing under test. The table stage asks for bf16 as well,
+    because that is what a checkpoint carries.
+    """
+    from safetensors.torch import save_file
+
+    generator = torch.Generator().manual_seed(20260929)
+    dense = torch.randn(rows, head_dim, generator=generator).to(dtype)
+    per_shard = rows // splits
+    weight_map = {}
+    for index in range(splits):
+        name = f'table-{index:05d}.safetensors'
+        shard = dense[index * per_shard : (index + 1) * per_shard].contiguous()
+        save_file({_shard_key(index): shard}, os.path.join(root, name))
+        weight_map[_shard_key(index)] = name
+    if with_index:
+        with open(os.path.join(root, 'model.safetensors.index.json'), 'w', encoding='utf-8') as handle:
+            json.dump({'metadata': {}, 'weight_map': weight_map}, handle)
+    return dense
+
+
+def write_unaligned_table(root: str) -> None:
+    """A hand-built safetensors file whose only shard starts on an odd byte."""
+    header = {
+        'prefix': {'dtype': 'U8', 'shape': [1], 'data_offsets': [0, 1]},
+        _shard_key(0): {'dtype': 'BF16', 'shape': [1, 2], 'data_offsets': [1, 5]},
+    }
+    blob = json.dumps(header).encode()
+    blob += b' ' * ((8 - len(blob) % 8) % 8)
+    with open(os.path.join(root, 'unaligned-00000.safetensors'), 'wb') as handle:
+        handle.write(struct.pack('<Q', len(blob)) + blob + b'\x00' * 5)
+
+
+def reference_shift_right_ignore_eos(token_ids: torch.Tensor, shift: int, eos_token_id: int) -> torch.Tensor:
+    """``transformers``' ``Qwen4ExpTextNGramEmbedding._shift_right_ignore_eos``, verbatim."""
+    if shift == 0:
+        return token_ids
+    batch_size, seq_len = token_ids.shape
+    positions = torch.arange(seq_len, device=token_ids.device, dtype=torch.long)
+    eos_positions = torch.where(token_ids == eos_token_id, positions, -1)
+    previous_eos_inclusive = torch.cummax(eos_positions, dim=1).values
+    previous_eos = torch.cat([eos_positions.new_full((batch_size, 1), -1), previous_eos_inclusive[:, :-1]], dim=1)
+    segment_start = previous_eos + 1
+    position_in_segment = positions.unsqueeze(0) - segment_start
+    source_positions = positions - shift
+    gather_positions = source_positions.clamp_min(0).unsqueeze(0).expand(batch_size, -1)
+    shifted = token_ids.gather(dim=1, index=gather_positions)
+    valid = (position_in_segment >= shift) & (source_positions.unsqueeze(0) >= 0)
+    return torch.where(valid, shifted, token_ids.new_full((), eos_token_id))
+
+
+def reference_ngram_ids(module, token_ids: torch.Tensor) -> torch.Tensor:
+    """``transformers``' ``Qwen4ExpTextNGramEmbedding.forward`` hash, verbatim.
+
+    ``module`` is the port's :class:`Qwen4ExpTextNGramEmbedding`: the reference reads the
+    config-derived fields off it (as the HF class does off its own ``self``) and the three
+    index buffers, so a divergence in either shows up as a mismatch.
+    """
+    input_ids = token_ids.long()
+    previous_context = input_ids.new_full((input_ids.shape[0], module.context_len), module.eos_token_id)
+    token_history = torch.cat([previous_context, input_ids], dim=-1)
+    shifted_tokens = [
+        reference_shift_right_ignore_eos(token_history, shift, module.eos_token_id)
+        for shift in range(module.ngram_size)
+    ]
+
+    blocks = []
+    for ngram in range(2, module.ngram_size + 1):
+        start_idx = (ngram - 2) * module.heads_per_ngram
+        end_idx = start_idx + module.heads_per_ngram
+        mixed_ids = shifted_tokens[0] * module.layer_multipliers[0]
+        for position in range(1, ngram):
+            mixed_ids = torch.bitwise_xor(mixed_ids, shifted_tokens[position] * module.layer_multipliers[position])
+        head_sizes = module.ngram_heads_vocab_sizes[start_idx:end_idx]
+        head_offsets = module.ngram_heads_offsets[start_idx:end_idx]
+        blocks.append(torch.remainder(mixed_ids.unsqueeze(-1), head_sizes.view(1, 1, -1)) + head_offsets.view(1, 1, -1))
+    return torch.cat(blocks, dim=-1)[:, -input_ids.shape[1] :]
+
+
+def reference_short_conv(layer, hidden_states: torch.Tensor) -> torch.Tensor:
+    """``transformers``' ``Qwen4ExpTextPLELayer._short_conv`` with no cache."""
+    seq_len = hidden_states.shape[1]
+    hidden_states = hidden_states.transpose(1, 2)
+    hidden_states = F.pad(hidden_states, (layer.short_conv_state_len, 0))
+    hidden_states = hidden_states[..., -(layer.short_conv_state_len + seq_len) :]
+    hidden_states = F.silu(layer.conv1d(hidden_states))
+    return hidden_states.transpose(1, 2)
+
+
+def reference_ple_forward(layer, hidden_states: torch.Tensor, input_ids: torch.Tensor, dense_table, conv_mask=None):
+    """``transformers``' ``Qwen4ExpTextPLELayer.forward``, verbatim, on a dense table.
+
+    ``hidden_states``/``input_ids`` are ``[batch, seq, ...]`` -- the layout the reference
+    works in -- and ``conv_mask`` is its ``[batch, seq]`` bool padding mask, applied to
+    both conv operands and to nothing else.
+    """
+    ids = reference_ngram_ids(layer.ple_embedding, input_ids)
+    embeddings = dense_table[ids].flatten(-2).to(hidden_states.dtype)
+    key_normed = layer.norm_key(layer.key_proj(embeddings)[0]).unflatten(-1, (layer.hc_count, layer.hidden_size))
+    value = layer.value_proj(embeddings)[0]
+    query_normed = layer.norm_query(hidden_states).unflatten(-1, (layer.hc_count, layer.hidden_size))
+    gate = (key_normed * query_normed).sum(dim=-1, keepdim=True) / math.sqrt(layer.hidden_size)
+    gate = gate.abs().clamp_min(1e-6).sqrt() * gate.sign()
+    gated_value = torch.sigmoid(gate) * value.unsqueeze(-2)
+    gated_value_normed = layer.norm_conv(gated_value.flatten(-2))
+    gated_value = gated_value.flatten(-2)
+    if conv_mask is not None:
+        gated_value = (gated_value * conv_mask[:, :, None]).to(gated_value.dtype)
+        gated_value_normed = (gated_value_normed * conv_mask[:, :, None]).to(gated_value_normed.dtype)
+    return gated_value + reference_short_conv(layer, gated_value_normed)
+
+
+# --------------------------------------------------------------------------------------
+# helpers
+# --------------------------------------------------------------------------------------
+def _check(cond, label, detail=''):
+    print(f'    [{"PASS" if cond else "FAIL"}] {label}' + (f' {detail}' if detail else ''))
+    return bool(cond)
+
+
+def _close(got: torch.Tensor, want: torch.Tensor, tol: float) -> Tuple[bool, str]:
+    diff = (got.float() - want.float()).abs().max().item()
+    scale = max(1.0, want.float().abs().max().item())
+    return diff <= tol * scale, f'max|diff|={diff:.3e} (tol {tol:.1e} x {scale:.3g})'
+
+
+def _lookup_table(table, weight: torch.Tensor, ids: torch.Tensor) -> torch.Tensor:
+    """This rank's rows of ``ids``, with zeros where the row belongs to another rank.
+
+    ``lookup_host`` returns the ownership mask separately so the caller can mask on
+    the device; the tests that only need the finished shard use this.
+    """
+    flat = ids.reshape(-1)
+    local = flat - table.start_row
+    owned = (local >= 0) & (local < table.rows_per_rank)
+    rows = weight.index_select(0, local.clamp_(0, table.rows_per_rank - 1)).view(*ids.shape, table.head_dim)
+    if table.tp_size == 1:
+        return rows
+    return rows.masked_fill(~owned.view(*ids.shape, 1), 0)
+
+
+def _packed(cu_seqlens_q, cu_seqlens_q_padded=None):
+    from megatron.core.packed_seq_params import PackedSeqParams
+
+    def tensor(values):
+        return torch.tensor(values, dtype=torch.int32) if values is not None else None
+
+    return PackedSeqParams(
+        qkv_format='thd',
+        cu_seqlens_q=tensor(cu_seqlens_q),
+        cu_seqlens_q_padded=tensor(cu_seqlens_q_padded),
+    )
+
+
+def _per_sample(fn, tensors, lengths, dim=1) -> torch.Tensor:
+    """``fn`` applied to each sample of a packed stream on its own, concatenated back.
+
+    This is how the reference computes a packed batch: one sample per row, so
+    nothing of a sample -- its tokens, its padding, its conv frames -- reaches any
+    other one. ``tensors`` are the full stream(s), in which sample ``i`` owns
+    ``[offset, offset + lengths[i])``.
+    """
+    pieces, offset = [], 0
+    for length in lengths:
+        pieces.append(fn(*[tensor.narrow(dim, offset, length) for tensor in tensors]))
+        offset += length
+    return torch.cat(pieces, dim=dim)
+
+
