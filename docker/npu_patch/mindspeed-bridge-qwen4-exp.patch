+++ b/mindspeed_bridge/models/qwen4_exp/modelling_qwen4_exp/tests/align_with_hf.py
@@ -0,0 +1,1976 @@
+#!/usr/bin/env python
+# pylint: disable=too-many-lines
+#
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Numeric alignment of the Qwen3.8-Flash-Next port against transformers.
+
+The acceptance criterion of the port is "it runs" *and* "it agrees with the
+reference implementation", so this script runs the same token sequence through
+both models and diffs the tensors stage by stage:
+
+* ``hf``       -- ``Qwen4ExpForConditionalGeneration`` (transformers 5.16.1,
+  the released checkpoint's own architecture) on one NPU, dumping the input
+  embedding, every decoder layer's multi-stream output, the contracted hidden
+  states and the logits;
+* ``megatron`` -- the Bridge-built model (``AutoBridge`` -> provider -> plugin
+  model) on ``tp * ep`` NPUs, replaying the same tokens as one packed (thd)
+  sequence, dumping the same tensors through forward hooks;
+* ``compare``  -- loads both dumps (CPU only) and prints per-tensor statistics.
+
+Why the megatron phase is configured the way it is:
+
+* **TP=1/SP=off/CP=1** -- no sharding, so every captured tensor is the whole
+  tensor and the diff is a plain elementwise comparison;
+* **EP=4** -- MindSpeed's grouped GEMM takes one weight tensor per *local*
+  expert and its kernel caps that list at 128 ("Length of tensorList should not
+  exceed 128"), so 512 experts cannot run on one die, and the bridge has no
+  mapping for the sequential (non-grouped) expert fallback. Four-way expert
+  parallelism leaves exactly 128 per rank and keeps the production code path;
+* **the TP ceiling is 8 for this model** -- the full-attention layers carry 24 q
+  heads over 2 kv heads, so for ``tp > 2`` each rank first computes all 12 q
+  heads of its kv group and then keeps ``12 // (tp // 2)`` of them
+  (``megatron/core/transformer/attention.py``, the ``num_query_groups <
+  world_size`` branch). ``tp=8`` keeps 3, ``tp=16`` divides 12 into 8 lanes and
+  *silently drops four heads* -- nothing asserts, and the index is
+  ``rank % (tp // groups)``, so ranks 8-15 would replay ranks 0-7's slice. The
+  die count does *not* bind here: the model and the expert layouts tile the same
+  dies independently (``world = tp * pp * cp * dp`` and ``world = et * ep * pp *
+  edp``), so 16 dies run ``tp=8, ep=16`` as readily as ``tp=4, ep=4``.
+  ``_check_parallel_layout`` runs before any rank is spawned and rejects every
+  combination that would not build -- or that would build and quietly lie;
+* **``mtp_num_layers=None``** -- the backbone only. ``Qwen4ExpForCausalLM`` /
+  ``ForConditionalGeneration`` do not implement the MTP head at all (they list
+  ``^mtp.*`` in ``_keys_to_ignore_on_load_unexpected``), so the head has no
+  reference to align against and is exercised by the training run instead.
+
+Both sides hold a full bfloat16 copy of the 4-layer checkpoint (~29 GiB), so each
+phase needs its own free die: ``--stage all`` runs them one after the other as
+subprocesses (one per die, launched by :func:`_spawn` -- ``torch.distributed.run``
+cannot be used on this host, its c10d store is addressed by a hostname that does
+not resolve here) and then compares. Run a phase on its own when the dies have to
+be picked differently, or to re-run one side against an existing dump::
+
+    python -m ...tests.align_with_hf --stage hf    --hf-device 12
+    python -m ...tests.align_with_hf --stage megatron --mg-devices 12,13,14,15
+    python -m ...tests.align_with_hf --stage megatron --feed-hf-merged   # control
+    python -m ...tests.align_with_hf --stage compare
+
+and the multimodal batches of ``--mm-rows``/``--mm-merge`` are the same command
+with the parquet, e.g. three single-image samples packed into one stream::
+
+    python -m ...tests.align_with_hf --mm-parquet <pokemon parquet> --mm-rows 3 --seq-len 1024
+
+or two samples of two images each (``--mm-merge 2``), which is both a multi-image
+and a multi-sample batch::
+
+    python -m ...tests.align_with_hf --mm-parquet <pokemon parquet> --mm-rows 4 --mm-merge 2 --seq-len 1024
+
+Every phase is read-only: nothing is written outside ``--work-dir``.
+
+Passing ``--mm-parquet`` (the pokemon SFT parquet) switches both phases to the
+vision-language model, and adds three tensors to the diff:
+
+* ``merged``     -- the embedding the text tower actually consumes, i.e. the token
+  embeddings with the ``<|image_pad|>`` rows replaced by the tower's output. This
+  is where a merge that writes the wrong rows, or the wrong rows in the wrong
+  order, shows up -- and it is checked for exactly that (the cosine); its numeric
+  gap is the tower's bf16 rounding on both sides, so it is not a numeric test;
+* ``positions``  -- the M-RoPE position ids. HF derives them in
+  ``compute_3d_position_ids`` from the processor's ``mm_token_type_ids``, the port
+  derives them from ``input_ids`` (``positions.py``); the two must agree, and both
+  sides carry the token ids to prove the derivation is equivalent;
+* ``vision``     -- the tower's output for the batch, before it is written into
+  the sequence (``test_vision.py`` covers the tower alone; this covers the tower
+  as the batch reaches it). It is compared against the *fp32* reference tower
+  (``vision_fp32``, the same checkpoint weights up-cast), not against HF's bf16
+  tower: this tower has no final norm and its residual stream reaches ~1e2, so
+  27 layers of bf16 rounding move its output by 6.2e-2 (max) / 4.2e-2 (rms
+  relative) -- HF drifts 3.1e-2 against *itself* from one run to the next, and
+  the cross-implementation gap in bf16 is 6.19e-2, i.e. exactly the floor. In
+  fp32 the port reproduces the reference to 7.1e-6 (rms relative 6.4e-6). Which
+  of the two the verdict applies is decided by the dtype the ``megatron`` phase
+  records in its sidecar, not assumed: `run_megatron` builds the provider at
+  ``params_dtype``, and judging a bf16 tower by the fp32 bar can only ever report
+  MISMATCH -- the reference's own bf16 tower misses that bar by two orders. At
+  bf16 the bar is the floor above, i.e. the port must keep the fp32 truth as
+  closely as the reference keeps it; the row prints which bar it used.
+
+Because the tower's bf16 rounding is real, the text towers of the two phases run
+on embeddings that differ by it, and their own diff (``layer*``/``final``/
+``logits``) inherits that gap: in this mode those tensors are therefore reported
+but not judged, and the run that judges them is ``--feed-hf-merged`` -- it hands
+the port the reference's ``merged`` embedding and compares the text tower on
+identical input. Positions stay live in that run too: the port still computes
+its own (feeding only the embedding), so a wrong M-RoPE would fail it twice.
+
+The batch is built the way the SFT data path builds it -- the checkpoint's own
+chat template renders the dataset's ``<image>`` placeholder into
+``<|vision_start|><|image_pad|><|vision_end|>`` and the checkpoint's processor
+expands the pads against the image grid (``relax/utils/data/processor_pool.py``
+runs exactly this call in a worker process, minus the bf16 downcast of
+``pixel_values`` that is repeated here because both phases have to see the same
+tensor).
+
+That batch holds one sample unless ``--mm-rows`` says otherwise: ``--mm-rows N``
+loads N consecutive rows of the parquet and ``--mm-merge M`` fuses every M of
+them into one conversation (its rows' conversations back to back, i.e. one turn
+per image -- what a multi-image SFT sample looks like). The two phases then run
+two *layouts* of the same tokens: the reference a padded ``[B, S]`` batch, the
+port the one packed (thd) stream the training path builds, whose samples are
+delimited by ``cu_seqlens``. That is the equivalence the SFT data path itself
+relies on -- under a correct attention mask the pad tokens contribute nothing to
+their row, so every row's valid region is what the packed stream computes for
+that sample. The reference's per-token dumps are reduced to the valid tokens
+before the comparison (:func:`_pack_padded`), which turns them into exactly the
+packed layout the port dumps, and the functional check drops the position that
+would predict across a sample boundary (a packed stream holds no such token).
+``--mm-rows 1 --mm-merge 1`` -- the default -- pads nothing and packs nothing, so
+the dumps are the single-sample ones this script always wrote.
+
+A checkpoint that carries the PLE branch (the truncation tool's ``--keep-ple``)
+adds two tensors to the diff, on the layer ``ple_layer_ids`` names:
+
+* ``ple_embed`` -- the hashed n-gram lookup, i.e. the rows the table hands the
+  gate. It is a pure function of the token ids (the hash, the per-head
+  vocabularies, the shard order), so it is expected to be **bit-exact**: a gap
+  there is the hash or the table, never bf16;
+* ``ple`` -- the contribution the branch adds to the layer's input. Its gate
+  reads the hidden states, so it is a numeric row like the others -- and in
+  multimodal mode it is reported but not judged, while ``ple_embed`` stays judged
+  (hence its entry in :data:`MM_JUDGED_KEYS`).
+
+The 95 GiB table is in the checkpoint as 128 ``ngram_embedding.shard_*`` tensors
+that no key of the module's own ``ngram_embedding.weight`` fills, so both phases
+have to assemble it themselves and keep it on the **host**
+(:func:`load_ngram_table`, :func:`shrunk_ngram_table`): the reference's forward
+looks the rows up on the weight's own device and moves them to the ids' device --
+the same host/device split the port runs, since the table never fits a die.
+
+What a residual gap means: the text dump is not bit-exact, and the first tensor
+that leaves the exact path is the gated-delta-net output (``attnpost``). That gap
+was audited against HF's ``Qwen4ExpTextGatedDeltaNet`` by ablating one component
+at a time into the reference (same weights, same inputs): the port's kernel
+choice, its l2-normalisation placement (outside the rule, in bf16, where HF
+normalises inside the kernel in fp32) and its fused output norm reproduce the
+observed max difference (8.789e-3, i.e. ~1.7 bf16 ulp, 35% of elements
+bit-identical) to the digit, and no ablation leaves a remainder. So the gap is
+bf16-vs-fp32 placement, not a difference in the math: it enters at 8e-3 (rms
+relative) at ``layer0`` and the four-layer residual stream amplifies it to 2.7e-2
+by ``final``, which is what ``--rtol`` (5%) brackets.
+
+The verdict therefore rests on three things, none of which is bit equality:
+
+* direction -- every judged tensor's float64 cosine stays above ``--min-cos``;
+* scale -- its rms relative error stays under ``--rtol`` (a wrong scale factor
+  moves this while leaving the cosine at 1);
+* prediction -- both dumps' logits are turned into a loss, an argmax agreement
+  and a KL divergence against the batch's own next tokens
+  (:func:`_functional_agreement`). The bf16 rounding cancels in that average, so
+  it is the sharpest of the three and the one a subtle routing error would move.
+
+Measured on this checkpoint: loss relative 4.9e-5 and KL 2.5e-4 nats/token on the
+math batch, 1.2e-4 and 4.0e-4 on the pokemon batch (fed control).
+"""
+
+from __future__ import annotations
+
+import argparse
+import contextlib
+import json
+import os
+import socket
+import subprocess
+import sys
+import time
+from types import SimpleNamespace
+from typing import Dict, List, Optional
+
+import torch
+
+
+# No path of this box's is baked in (the repos this harness ships in are scanned by
+# a secret/path linter), so the two convenience defaults come from the environment.
+# Explicit --ckpt / --data always win, which is how the documented runs below are
+# written anyway; with neither set the empty default fails loud in the phase that
+# needs it (`from_pretrained('')`, or "no text found in ...; pass --data ...")
+# instead of silently reading a path that only exists on one machine.
+DEFAULT_CKPT = os.environ.get('QWEN4_EXP_CKPT', '')
+DEFAULT_DATA = os.environ.get('QWEN4_EXP_DATA', '')
+
+# The tensors both phases dump, in the order they are produced.
+HF_KEYS = ('embed', 'layer0', 'layer1', 'layer2', 'layer3', 'final', 'logits')
+# Multimodal mode adds these (see the module docstring); both dumps carry them or
+# neither does, and `compare` picks up whatever the two dumps share.
+MM_KEYS = ('merged', 'positions', 'vision')
+# Of those, the ones that are judged even without the `--feed-hf-merged` control:
+# they do not depend on the text tower's input, so the tower's bf16 rounding
+# cannot excuse a gap in them (see the module docstring). The PLE's table lookup
+# is one of them -- it is a pure function of the token ids -- while the PLE
+# *contribution* is not: its gate reads the hidden states.
+MM_JUDGED_KEYS = ('embed', 'positions', 'vision', 'ple_embed')
+# The dataset's placeholder for an image inside a conversation turn. Relax
+# rewrites it into a content item and the checkpoint's chat template renders that
+# into the processor's placeholders (`relax/utils/data/data_utils.py`).
+MM_PLACEHOLDER = '<image>'
+# With --capture-inner, three more tensors per layer, chosen so the first
+# divergent one names the module at fault. Both implementations name these
+# submodules identically, so one capture routine serves both phases:
+#   hcmix{i}    -- attn_hyper_connection(hidden_states)[0]: a pure function of
+#                  the layer *input*, so it isolates the hyper-connection math;
+#   attnpost{i} -- the attention (or gated-delta-net) output, before the
+#                  injection folds it back;
+#   mlpmix{i}   -- mlp_hyper_connection(...)[0]: the state the MoE reads.
+INNER_PREFIXES = ('hcmix', 'attnpost', 'mlpmix')
+
+
+# --------------------------------------------------------------------------------------
+# runtime setup
+# --------------------------------------------------------------------------------------
+def _free_port() -> int:
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
+        s.bind(('127.0.0.1', 0))
+        return s.getsockname()[1]
+
+
+def _setup_npu(args) -> None:
+    """Import torch_npu and apply MindSpeed's Megatron patches.
+
+    Order matters: ``mindspeed.megatron_adaptor`` swaps the TE linears for the
+    Ascend implementations, and the plugin's specs resolve their classes through
+    the backend spec provider.
+    """
+    import torch_npu  # noqa: F401
+
+    import mindspeed.megatron_adaptor as _adaptor
+
+    if args.cp > 1:
+        # Third import-order trap, the same shape as the two below: the adaptor
+        # patches the features with `get_mindspeed_args()`, whose defaults say
+        # ``context_parallel_size=1``, so the context-parallel feature never runs
+        # its registration. What it leaves behind is the *kvallgather* attention
+        # class, while the same args still carry ``context_parallel_algo =
+        # 'megatron_cp_algo'`` -- and that class's factory raises on any other
+        # name, so the first full-attention layer of a CP run dies in its
+        # constructor. Training has no such gap: `initialize_megatron` parses the
+        # command line before the adaptor is imported. `repatch` is the adaptor's
+        # own way of redoing the registration for a new set of arguments (Relax
+        # calls it too), and only the fields this needs are overridden.
+        _adaptor.repatch(
+            SimpleNamespace(
+                context_parallel_size=args.cp,
+                tensor_model_parallel_size=args.tp,
+                pipeline_model_parallel_size=1,
+                expert_model_parallel_size=args.ep,
+                expert_tensor_parallel_size=args.et,
+            )
+        )
+
+    # Second import-order trap, one level deeper than the one above: MindSpeed only
+    # makes `transformer_engine` importable (as `mindspeed.dummy_module`) *while it is
+    # being imported*, so a module that imported `megatron.core.transformer.moe.moe_utils`
+    # any earlier is cached with `HAVE_TE = False` and no `te_general_gemm` bound -- the
+    # first MoE routing then dies with `NameError: name 'te_general_gemm' is not defined`.
+    # This file's own package chain does import it that early, and no later import can
+    # undo a cached module, so rebind what its module-level `try` would have set.
+    # Training needs none of this: it imports the adaptor before anything else.
+    import megatron.core.transformer.moe.moe_utils as _moe_utils
+
+    if not getattr(_moe_utils, 'HAVE_TE', False):
+        try:
+            from megatron.core.extensions.transformer_engine import te_general_gemm
+        except ImportError:  # pragma: no cover - no TE at all: leave the module as it was
+            pass
+        else:
+            _moe_utils.te_general_gemm = te_general_gemm
+            _moe_utils.HAVE_TE = True
+
+
+def _init_dist(args) -> None:
+    """One-rank hccl process group, so parallel_state has real groups."""
+    if torch.distributed.is_initialized():
+        return
+    os.environ.setdefault('MASTER_ADDR', '127.0.0.1')
+    os.environ.setdefault('MASTER_PORT', str(_free_port()))
+    world_size = int(os.environ.get('WORLD_SIZE', '1'))
+    rank = int(os.environ.get('RANK', '0'))
+    local_rank = int(os.environ.get('LOCAL_RANK', '0'))
+    # Each rank owns one die of ASCEND_RT_VISIBLE_DEVICES; without this every
+    # rank would build its parameters on die 0.
+    torch.npu.set_device(local_rank)
+    torch.distributed.init_process_group(
+        backend='hccl',
+        world_size=world_size,
+        rank=rank,
+        init_method='tcp://' + os.environ['MASTER_ADDR'] + ':' + os.environ['MASTER_PORT'],
+    )
+    from megatron.core import parallel_state
+
+    parallel_state.initialize_model_parallel(
+        tensor_model_parallel_size=args.tp,
+        pipeline_model_parallel_size=1,
+        context_parallel_size=args.cp,
+        expert_model_parallel_size=args.ep,
+        # Layer four of the layout, and the one a harness forgets: the expert
+        # linears shard themselves by `get_expert_tensor_parallel_group()`
+        # (`megatron/core/utils.py`, reached from `ColumnParallelLinear(is_expert=True)`),
+        # whose size is frozen *here* and defaults to the model TP. Setting
+        # `provider.expert_tensor_parallel_size` alone therefore still shards every
+        # expert `tp` ways, and the load dies with a target of `ffn / tp` rows --
+        # production has no such gap: `initialize.py` passes `args.expert_tensor_parallel_size`.
+        expert_tensor_parallel_size=args.et,
+    )
+    from megatron.core.tensor_parallel import model_parallel_cuda_manual_seed
+
+    model_parallel_cuda_manual_seed(1234)
+    if rank == 0:
+        print(
+            f'[setup] hccl world_size={world_size} tp={args.tp} cp={args.cp} ep={args.ep} '
+            f'et={args.et} device={torch.cuda.current_device()}'
+        )
+
+
+# --------------------------------------------------------------------------------------
+# the shared batch
+# --------------------------------------------------------------------------------------
+def build_inputs(args) -> Dict:
+    """The batch both phases run.
+
+    Returns a dict with the two layouts of the one token sequence:
+
+    * ``ids`` -- ``[1, T]`` packed (thd) stream, the layout the *port* runs;
+    * ``lengths`` -- per-sample lengths of that stream, i.e. the interior
+      boundaries the port is handed on ``cu_seqlens_q_cpu``;
+    * ``hf_ids`` / ``hf_attention_mask`` -- ``[B, S]`` padded batch for the
+      reference, one row per sample (``S == T`` and no mask when nothing pads);
+    * ``mm`` -- the processor's vision tensors, concatenated over the samples in
+      row order (empty for a text batch).
+
+    Text mode reads a real SFT jsonl row, multimodal mode (``--mm-parquet``) rows
+    of the pokemon parquet through the checkpoint's own chat template and
+    processor. A real sample rather than random ids: the MoE routing of random
+    tokens is degenerate (a handful of experts take everything), and the point of
+    the comparison is to exercise the routing the training run will see.
+    """
+    from transformers import AutoTokenizer
+
+    tokenizer = AutoTokenizer.from_pretrained(args.ckpt, trust_remote_code=True)
+    batch = _build_multimodal_inputs(args, tokenizer) if args.mm_parquet else _build_text_inputs(args, tokenizer)
+    source = args.mm_parquet or args.data
+    extra = ' '.join(f'{key}={tuple(value.shape)}' for key, value in batch['mm'].items() if key != 'mm_token_type_ids')
+    samples = ' '.join(str(length) for length in batch['lengths'])
+    print(
+        f'[data] {source}: T={batch["ids"].shape[1]} (first token id {int(batch["ids"][0, 0])}) '
+        f'{len(batch["lengths"])} sample(s) of {samples} token(s) '
+        f'(hf batch {tuple(batch["hf_ids"].shape)}) {extra}'
+    )
+    return batch
+
+
+def _build_text_inputs(args, tokenizer) -> Dict:
+    """``[1, T]`` token ids of a text SFT row, repeated/truncated to ``--seq-len``."""
+    text = ''
+    if os.path.exists(args.data):
+        with open(args.data, encoding='utf-8') as handle:
+            row = json.loads(handle.readline())
+        conversations = row.get('conversations') or row.get('messages') or []
+        parts = []
+        for turn in conversations:
+            content = turn.get('content') or turn.get('value') or ''
+            if isinstance(content, list):  # multimodal rows: keep the text parts
+                content = ' '.join(p.get('text', '') for p in content if isinstance(p, dict))
+            parts.append(str(content))
+        text = '\n'.join(parts)
+    if not text.strip():
+        raise RuntimeError(f'no text found in {args.data}; pass --data with a readable SFT jsonl')
+
+    ids = tokenizer(text, return_tensors='pt', add_special_tokens=False)['input_ids']
+    if ids.shape[1] < args.seq_len:
+        repeat = args.seq_len // ids.shape[1] + 1
+        ids = ids.repeat(1, repeat)
+    ids = ids[:, : args.seq_len].contiguous()
+    return {'ids': ids, 'lengths': [ids.shape[1]], 'hf_ids': ids, 'hf_attention_mask': None, 'mm': {}}
+
+
+def _conversation(rows, args):
+    """Messages and images of one sample: its rows' conversations, in order.
+
+    Every ``<image>`` of every turn pulls the next image of the sample -- the walk
+    Relax's data path makes over a row (``relax/utils/data/data_utils.py``), which
+    rejects a row that refers to more images than it holds or holds more than it
+    refers to. The images of a later row come after those of an earlier one, so
+    the placeholders of the concatenated conversation line up with the
+    concatenated image list.
+    """
+    import io
+
+    from PIL import Image
+
+    images = []
+    messages = []
+    for row in rows:
+        raw_images = list(row.get('images') or [])
+        decoded = [Image.open(io.BytesIO(image['bytes'])).convert('RGB') for image in raw_images]
+        if not decoded:
+            raise SystemExit(f'a row of {args.mm_parquet} holds no image; pick another --mm-index')
+        used = 0
+        for turn in row['conversations']:
+            role = {'human': 'user', 'gpt': 'assistant'}.get(turn['from'], turn['from'])
+            parts = str(turn['value']).split(MM_PLACEHOLDER)
+            content = []
+            for position, part in enumerate(parts):
+                if part:
+                    content.append({'type': 'text', 'text': part})
+                if position < len(parts) - 1:
+                    if used >= len(decoded):
+                        raise SystemExit(f'a row of {args.mm_parquet} refers to more images than it holds')
+                    content.append({'type': 'image', 'image': raw_images[used]})
+                    used += 1
+            messages.append({'role': role, 'content': content})
+        if used != len(decoded):
+            raise SystemExit(
+                f'a row of {args.mm_parquet} holds {len(decoded)} images but its conversation refers to {used}: '
+                'the SFT data path rejects such a row as well.'
+            )
+        images.extend(decoded)
+    return messages, images
+
+
+def _build_multimodal_inputs(args, tokenizer) -> Dict:
+    """The pokemon rows as the SFT data path turns them into a batch.
+
+    The dataset stores its images next to a conversation that refers to them with
+    ``<image>``; Relax splits the turn on that placeholder into content items,
+    the checkpoint's chat template renders an image item as
+    ``<|vision_start|><|image_pad|><|vision_end|>`` and the checkpoint's processor
+    expands each pad against its image's grid -- the three steps that decide what
+    the model actually sees. ``--mm-rows`` picks how many rows take part and
+    ``--mm-merge`` how many of them become one conversation, i.e. a multi-image
+    sample (see the module docstring).
+
+    Returns the dict of :func:`build_inputs`, with ``mm`` holding the processor's
+    tensors as ``process_sample_in_worker`` emits them: ``pixel_values`` downcast
+    to bf16 (the SFT path does that to halve the IPC payload, and both phases have
+    to see the same tensor) and the image grid.
+    """
+    import pyarrow.parquet as pq
+    from transformers import AutoProcessor
+
+    if args.mm_rows < 1 or args.mm_merge < 1:
+        raise SystemExit(f'--mm-rows and --mm-merge must be >= 1, got {args.mm_rows} and {args.mm_merge}')
+    processor = AutoProcessor.from_pretrained(args.ckpt, trust_remote_code=True)
+    table = pq.read_table(args.mm_parquet)
+    end = args.mm_index + args.mm_rows
+    if args.mm_index < 0 or end > table.num_rows:
+        raise SystemExit(f'rows {args.mm_index}..{end - 1} are outside {args.mm_parquet} ({table.num_rows} rows)')
+    rows = table.slice(args.mm_index, args.mm_rows).to_pylist()
+
+    image_token_id = tokenizer.convert_tokens_to_ids('<|image_pad|>')
+    sample_ids, sample_types, sample_mm, grids = [], [], [], []
+    for start in range(0, len(rows), args.mm_merge):
+        group = rows[start : start + args.mm_merge]
+        where = f'rows {args.mm_index + start}..{args.mm_index + start + len(group) - 1}'
+        messages, images = _conversation(group, args)
+        text = tokenizer.apply_chat_template(messages, tokenize=False)
+        out = processor(text=text, images=images)
+
+        ids = out['input_ids']
+        if not isinstance(ids, torch.Tensor):
+            ids = torch.tensor(ids, dtype=torch.long)
+        if ids.dim() == 1:
+            ids = ids.unsqueeze(0)
+        if ids.shape[1] > args.seq_len:
+            raise SystemExit(
+                f'{where} of {args.mm_parquet} is {ids.shape[1]} tokens, longer than --seq-len {args.seq_len}: '
+                'raising it is the only way to keep the image span intact (truncation would cut the pads).'
+            )
+
+        token_types = out['mm_token_type_ids']
+        if not isinstance(token_types, torch.Tensor):
+            token_types = torch.tensor(token_types, dtype=torch.long)
+
+        # The port reads the placeholder rows off `input_ids` instead of carrying
+        # the processor's token types into the model; positions.py is only correct
+        # while the two agree, so the equivalence is checked here rather than
+        # assumed.
+        derived = (ids == image_token_id).to(token_types.dtype)
+        if not torch.equal(derived.reshape(-1), token_types.reshape(-1)):
+            raise SystemExit(
+                f'the processor marks rows of {where} as image tokens that `input_ids == <|image_pad|>` does not '
+                '(or the other way round): the port would place M-RoPE positions for the wrong rows.'
+            )
+        print(
+            f'[data] {where}: {len(images)} image(s), {int(derived.sum())} pads, grid {out["image_grid_thw"].tolist()}'
+        )
+        sample_ids.append(ids)
+        sample_types.append(token_types)
+        sample_mm.append(out)
+        grids.append(out['image_grid_thw'].to(torch.long))
+
+    lengths = [int(ids.shape[1]) for ids in sample_ids]
+    # The reference runs one padded row per sample, the port the samples
+    # concatenated (see the module docstring); both carry the same tokens, and
+    # `mm_token_type_ids` follows the reference's `[B, S]` layout because that is
+    # the only consumer of it.
+    padded = max(lengths)
+    pad_token_id = tokenizer.pad_token_id
+    if pad_token_id is None:
+        raise SystemExit('the tokenizer has no pad token, so a multi-sample batch cannot be padded for the reference.')
+    hf_ids = torch.full((len(sample_ids), padded), pad_token_id, dtype=torch.long)
+    hf_types = torch.zeros_like(hf_ids)
+    hf_attention_mask = torch.zeros_like(hf_ids)
+    for row, (ids, token_types) in enumerate(zip(sample_ids, sample_types)):
+        length = ids.shape[1]
+        hf_ids[row, :length] = ids
+        hf_types[row, :length] = token_types
+        hf_attention_mask[row, :length] = 1
+
+    return {
+        'ids': torch.cat([ids.reshape(-1) for ids in sample_ids]).unsqueeze(0),
+        'lengths': lengths,
+        'hf_ids': hf_ids,
+        # A one-row batch that padded nothing needs no mask (and gets none: the
+        # single-sample dumps stay what they always were).
+        'hf_attention_mask': hf_attention_mask if (len(sample_ids) > 1 or padded != lengths[0]) else None,
+        'mm': {
+            'pixel_values': torch.cat([out['pixel_values'] for out in sample_mm]).to(torch.bfloat16),
+            'image_grid_thw': torch.cat(grids),
+            'mm_token_type_ids': hf_types,
+        },
+    }
+
+
+# --------------------------------------------------------------------------------------
+# phase 1: the transformers reference
+# --------------------------------------------------------------------------------------
+def _capture(module, name: str, store: Dict[str, torch.Tensor]) -> None:
+    """Hook ``module`` and stash a float32 CPU copy of its output."""
+
+    def hook(_module, _inputs, output):
+        tensor = output[0] if isinstance(output, tuple) else output
+        store[name] = tensor.detach().to(torch.float32).cpu()
+
+    module.register_forward_hook(hook)
+
+
+def _capture_vision(module, store: Dict[str, torch.Tensor]) -> None:
+    """Hook a vision tower and stash its output for the batch under ``vision``.
+
+    The two towers return their result in different shapes -- HF wraps it in a
+    ``BaseModelOutputWithPooling``, the port returns ``(embeddings,
+    deepstack_features)`` -- and both mean "the embeddings the merge writes into
+    the sequence", in batch order, before the per-image split.
+    """
+
+    def hook(_module, _inputs, output):
+        if isinstance(output, tuple):
+            tensor = output[0]
+        elif hasattr(output, 'pooler_output'):
+            tensor = output.pooler_output
+        else:
+            tensor = output
+        store['vision'] = tensor.detach().to(torch.float32).cpu()
+
+    module.register_forward_hook(hook)
+
+
+def _capture_inner(layer, index: int, attention, store: Dict[str, torch.Tensor]) -> None:
+    """The per-layer intermediates described at :data:`INNER_PREFIXES`."""
+    _capture(layer.attn_hyper_connection, f'hcmix{index}', store)
+    _capture(layer.mlp_hyper_connection, f'mlpmix{index}', store)
+    _capture(attention, f'attnpost{index}', store)
+
+
+def _pack_padded(store: Dict[str, torch.Tensor], lengths) -> None:
+    """Reduce a padded ``[B, S]`` dump to the packed stream the port dumps.
+
+    Every row's valid region is what the port computes for that sample (see the
+    module docstring), so the reference's tensors are indexed down to those
+    regions, in row order. ``positions`` is ``[3, B, S]`` while every other
+    captured tensor is ``[B, S, ...]``; the tower outputs are one row per *patch*
+    and are left untouched -- the two phases feed the tower the same patches.
+
+    The result stays batch-first with a single "row" holding the whole stream
+    (``[1, T, ...]`` / ``[3, 1, T]``), so the comparison's existing transpose
+    handles the sequence-first port dumps exactly as it does for a one-row batch.
+    """
+    lengths = [int(length) for length in lengths]
+    row = torch.repeat_interleave(torch.arange(len(lengths)), torch.tensor(lengths))
+    column = torch.cat([torch.arange(length) for length in lengths])
+    for key in list(store):
+        if key.startswith('vision'):
+            continue
+        tensor = store[key]
+        if key == 'positions':
+            store[key] = tensor[:, row, column].unsqueeze(1)
+        elif tensor.shape[0] == len(lengths):
+            store[key] = tensor[row, column].unsqueeze(0)
+        else:
+            raise RuntimeError(
+                f'{key} is {tuple(tensor.shape)}, which is neither a [B, S, ...] tensor of the '
+                f'{len(lengths)}-sample batch nor the [3, B, S] positions: it cannot be packed.'
+            )
+
+
+def ngram_embeddings(text) -> list:
+    """The reference's PLE table modules, one per entry of ``ple_layer_ids``."""
+    return [layer.ple.ple_embedding for layer in text.layers if getattr(layer, 'ple', None) is not None]
+
+
+@contextlib.contextmanager
+def shrunk_ngram_table():
+    """Load the reference with a 1-row PLE table instead of the real 95 GiB one.
+
+    The table is in the checkpoint, but under the 128 ``ngram_embedding.shard_*``
+    names no ``ngram_embedding.weight`` key ever fills, so a plain
+    ``from_pretrained`` builds a full 95 GiB table (on the host: fine; the
+    ``.npu()`` after it is not) that nothing then writes and that the reference
+    would look rows up in at random.
+
+    Shrinking the module *before* the load turns the checkpoint's table into a
+    shape mismatch, and transformers 5 re-initialises a mismatched key without
+    reading it (it does not slice it), so the 95 GiB are never read here;
+    ``ignore_mismatched_sizes`` is what keeps the loading report from raising.
+    The real table is hung underneath afterwards (:func:`load_ngram_table`), on
+    the host -- the same host/device split the port runs.
+
+    Only ``__init__`` is touched, and only for the duration of the load.
+    """
+    from transformers.models.qwen4_exp import modeling_qwen4_exp as reference
+
+    original = reference.Qwen4ExpTextNGramEmbedding.__init__
+
+    def tiny(self, *args, **kwargs):
+        original(self, *args, **kwargs)
+        self.ngram_embedding = torch.nn.Embedding(1, self.ngram_embedding.embedding_dim)
+
+    reference.Qwen4ExpTextNGramEmbedding.__init__ = tiny
+    try:
+        yield
+    finally:
+        reference.Qwen4ExpTextNGramEmbedding.__init__ = original
+
+
+def load_ngram_table(ckpt: str, module, rows: int) -> None:
+    """Concatenate the checkpoint's 128 table shards into ``module``'s weight, on the host.
+
+    Nothing in the reference reassembles them: ``Qwen4ExpTextNGramEmbedding`` is a
+    plain ``nn.Embedding`` and no key of the checkpoint fills its weight -- the
+    class even lists it in ``_no_placement_params`` -- while the checkpoint ships
+    the table as ``shard_{0..127}.weight`` instead. So the harness gathers the
+    shards itself, through ``safetensors``, i.e. *not* through the reader the port
+    uses: this is a second opinion on the shard layout, not a rehearsal of it.
+
+    The weight stays on the **host**. The reference looks a row up on the weight's
+    own device and moves the rows it read to the ids' device, so the 95 GiB never
+    have to fit on a die -- the same host/device split the port runs.
+    """
+    import safetensors.torch
+
+    index_path = os.path.join(ckpt, 'model.safetensors.index.json')
+    with open(index_path, encoding='utf-8') as handle:
+        weight_map = json.load(handle)['weight_map']
+    marker = 'ngram_embedding.shard_'
+    shards = {}
+    for name, path in weight_map.items():
+        if marker in name:
+            shards[int(name.split(marker, 1)[1].split('.')[0])] = (name, path)
+    if not shards:
+        raise SystemExit(
+            f'{ckpt} carries none of the `ngram_embedding.shard_*` tensors: point --ckpt at a checkpoint that has '
+            'the PLE tensors (the truncation tool keeps them with --keep-ple).'
+        )
+
+    ordered = [shards[index] for index in sorted(shards)]
+    table = None
+    loaded = 0
+    started = time.time()
+    for position, (name, path) in enumerate(ordered):
+        with safetensors.torch.safe_open(os.path.join(ckpt, path), framework='pt', device='cpu') as handle:
+            piece = handle.get_tensor(name)
+        if table is None:
+            table = torch.empty((rows, piece.shape[1]), dtype=piece.dtype)
+        if piece.shape[1] != table.shape[1]:
+            raise SystemExit(
+                f'{name} is {tuple(piece.shape)} while the first shard is {table.shape[1]} wide: the shards do not '
+                'tile one table.'
+            )
+        table.narrow(0, loaded, piece.shape[0]).copy_(piece)
+        loaded += piece.shape[0]
+        del piece
+        if (position + 1) % 16 == 0 or position + 1 == len(ordered):
+            print(
+                f'[hf] n-gram table: {position + 1}/{len(ordered)} shards, {loaded} rows, {time.time() - started:.0f}s',
+                flush=True,
+            )
+    if loaded != rows:
+        raise SystemExit(
+            f'the checkpoint\'s n-gram table has {loaded} rows, the module expects {rows}: the config and the '
+            'checkpoint disagree (a truncated checkpoint that kept the table?)'
+        )
+    if table.dtype != module.weight.dtype:
+        raise SystemExit(f'the table is {table.dtype} while the model was loaded as {module.weight.dtype}')
+    module.weight = torch.nn.Parameter(table, requires_grad=False)
+
+
+def run_hf(args) -> None:
+    import torch_npu  # noqa: F401  (registers the npu device)
+    from transformers.models.qwen4_exp import Qwen4ExpForConditionalGeneration
+
+    batch = build_inputs(args)
+    ids, mm, lengths = batch['ids'], batch['mm'], batch['lengths']
+    # Saved per batch (see `_input_path`): the port run and the comparison read
+    # them back and have to see the tokens this reference ran on, not whatever
+    # batch was built last.
+    torch.save(ids, _input_path(args, 'input_ids'))
+    torch.save(lengths, _input_path(args, 'lengths'))
+    torch.save(mm, _input_path(args, 'mm_inputs'))
+
+    started = time.time()
+    # The load runs against a 1-row PLE table so that the 95 GiB of it are neither
+    # built nor read (`shrunk_ngram_table`); the mismatched table it leaves behind
+    # is expected, hence the flag.
+    with shrunk_ngram_table():
+        model = Qwen4ExpForConditionalGeneration.from_pretrained(
+            args.ckpt,
+            dtype=torch.bfloat16,
+            attn_implementation=args.attn,
+            ignore_mismatched_sizes=True,
+        )
+    model.eval()
+    text = model.model.language_model
+    tables = ngram_embeddings(text)
+    model = model.npu()
+    print(f'[hf] loaded in {time.time() - started:.0f}s')
+    if tables:
+        config = model.config.text_config
+        divider = int(config.make_ngram_vocab_size_divisible_by)
+        rows = -(-tables[0].total_vocab_size // divider) * divider
+        for table in tables:
+            load_ngram_table(args.ckpt, table.ngram_embedding, rows)
+
+    # `Qwen4ExpForConditionalGeneration` is the checkpoint's own class (its key
+    # layout is `model.language_model.*` / `model.visual.*`, exactly the
+    # checkpoint's); the text tower is what the port implements.
+    store: Dict[str, torch.Tensor] = {}
+    for index, layer in enumerate(text.layers):
+        _capture(layer, f'layer{index}', store)
+        if getattr(layer, 'ple', None) is not None:
+            # The PLE branch: the contribution it adds to the layer's input, and
+            # the hashed table lookup that contribution starts from. The modulo of
+            # the lookup is the n-gram table read, so it is bit-exact when the
+            # hash, the shard layout and the per-head offsets all agree.
+            _capture(layer.ple, 'ple', store)
+            _capture(layer.ple.ple_embedding, 'ple_embed', store)
+        if args.capture_inner:
+            # `linear_attention` layers carry `linear_attn`, full ones `self_attn`.
+            attention = getattr(layer, 'self_attn', None) or getattr(layer, 'linear_attn', None)
+            _capture_inner(layer, index, attention, store)
+
+    def catch_final(_module, _inputs, output):
+        store['final'] = output.last_hidden_state.detach().to(torch.float32).cpu()
+
+    text.register_forward_hook(catch_final)
+
+    if mm:
+        # The text tower is called with the *merged* embedding and the M-RoPE
+        # positions the multimodal wrapper computed, so its call arguments are
+        # exactly the two tensors the port has to reproduce.
+        def catch_text_inputs(_module, _args, kwargs):
+            for key, name in (('inputs_embeds', 'merged'), ('position_ids', 'positions')):
+                if kwargs.get(key) is not None:
+                    store[name] = kwargs[key].detach().to(torch.float32).cpu()
+
+        text.register_forward_pre_hook(catch_text_inputs, with_kwargs=True)
+        _capture_vision(model.model.visual, store)
+
+    # The reference runs the padded `[B, S]` batch; the port runs the same
+    # samples as one packed stream, so the dumps are packed below before the
+    # comparison (see the module docstring).
+    mask = batch['hf_attention_mask']
+    hf_ids = batch['hf_ids']
+    with torch.no_grad():
+        if args.no_logits:
+            # The tower alone. The checkpoint's own class runs `lm_head` over the
+            # whole sequence -- `[T, vocab]` in bf16 plus its float32 cast is 49 GB
+            # at `--seq-len 32768`, which does not fit next to the weights.
+            text(
+                input_ids=hf_ids.npu(),
+                attention_mask=None if mask is None else mask.npu(),
+                use_cache=False,
+            )
+        else:
+            out = model(
+                input_ids=hf_ids.npu(),
+                attention_mask=None if mask is None else mask.npu(),
+                use_cache=False,
+                **{k: v.npu() for k, v in mm.items()},
+            )
+            store['logits'] = out.logits.detach().to(torch.float32).cpu()
+        store['embed'] = text.embed_tokens(hf_ids.npu()).detach().to(torch.float32).cpu()
+        if mm:
+            print('[hf] running the reference tower in fp32 (the yardstick for `vision`)')
+            store['vision_fp32'] = _hf_tower_fp32(args, mm)
+
+    if mask is not None:
+        _pack_padded(store, lengths)
+
+    _dump(args, 'hf', store)
+
+
+def _hf_tower_fp32(args, mm: Dict[str, torch.Tensor]) -> torch.Tensor:
+    """The reference tower in fp32, on the same batch (see the module docstring).
+
+    The fp32 weights are the checkpoint's bf16 weights up-cast -- the same state
+    dict ``test_vision`` aligns the port against -- so a gap here is the port's,
+    not the checkpoint's.
+    """
+    import gc
+
+    # `tests` is a namespace package (no `__init__.py`), which pylint only
+    # resolves when it imports the harness as a package; run on this file by
+    # path it reports the name as missing. The import works: the harness is
+    # always launched as `python -m ...tests.align_with_hf`.
+    from . import test_vision as tv  # pylint: disable=no-name-in-module
+
+    from transformers import AutoConfig
+
+    vision_config = AutoConfig.from_pretrained(args.ckpt).vision_config
+    tower = tv._build_hf_tower(vision_config, tv._load_visual_state_dict(args.ckpt), torch.float32)
+    tower = tower.npu().eval()
+    with torch.no_grad():
+        out = tower(mm['pixel_values'].to(device='npu', dtype=torch.float32), mm['image_grid_thw'].npu())
+    pooled = out.pooler_output.detach().float().cpu()
+    del tower, out
+    gc.collect()
+    torch.npu.empty_cache()
+    return pooled
+
+
+# --------------------------------------------------------------------------------------
+# phase 2: the Megatron port
+# --------------------------------------------------------------------------------------
+def build_megatron_model(args):
+    """The Bridge-built plugin model, unsharded in TP, expert-parallel as configured."""
+    _setup_npu(args)
+    _init_dist(args)
+
+    from megatron.bridge import AutoBridge
+
+    bridge = AutoBridge.from_hf_pretrained(args.ckpt, trust_remote_code=True)
+    provider = bridge.to_megatron_provider(load_weights=False)
+
+    provider.tensor_model_parallel_size = args.tp
+    provider.pipeline_model_parallel_size = 1
+    provider.context_parallel_size = args.cp
+    provider.expert_model_parallel_size = args.ep
+    # ET=1 is the whole point of the comparison: an expert's fused `gate_up` is one
+    # `[num_experts, 2 * ffn, hidden]` tensor on the HF side, and only ET=1 lets a rank
+    # hold it unsharded on the ffn axis (EP still splits the expert axis, which the
+    # mapping handles). ET must match `_init_dist`, where the *group* is built -- see
+    # the comment there; a mismatch is what fails the load with `ffn / tp` rows.
+    provider.expert_tensor_parallel_size = args.et
+    # TP=1 keeps every captured tensor whole; that is also why sequence
+    # parallelism is off (it would shard the sequence across TP ranks).
+    provider.sequence_parallel = False
+    provider.virtual_pipeline_model_parallel_size = None
+    provider.mtp_num_layers = None
+    provider.params_dtype = torch.bfloat16
+    provider.bf16 = True
+    provider.fp16 = False
+    provider.micro_batch_size = 1
+    provider.global_batch_size = 1
+    provider.cross_entropy_loss_fusion = False
+    provider.recompute_granularity = None
+    # Megatron-Bridge defaults this to `can_enable_gradient_accumulation_fusion()`,
+    # which only asks whether `fused_weight_gradient_mlp_cuda` imports -- and
+    # MindSpeed registers a *dummy* module of that name
+    # (`mindspeed/features_manager/megatron_basic/requirements_basic.py:84`), so the
+    # probe says yes while Megatron-LM's own `HAVE_APEX` check says no and
+    # `ColumnParallelLinear` raises. The training scripts pass the flag off
+    # (`gemm_gradient_accumulation_fusion` / `gradient_accumulation_fusion` in the
+    # run log), and an alignment harness should match training's numerics anyway.
+    provider.gradient_accumulation_fusion = False
+    # Mirrors `--use-flash-attn` in the training scripts. MindSpeed's
+    # DotProductAttention builds an explicit causal mask when it is handed none
+    # (`mindspeed/.../dot_product_attention.py`), and on the non-flash branch that
+    # mask is `seq_length x seq_length` -- here the checkpoint's 262144-token
+    # maximum, i.e. 64 GiB of bool, which OOMs the die before the first attention.
+    provider.use_flash_attn = True
+    provider.finalize()
+
+    model = provider.provide(pre_process=True, post_process=True)
+    # The plugin's hand-written norms allocate their weights with a bare
+    # `torch.zeros(...)` -- i.e. on the CPU -- while the TP linears put theirs on
+    # the current device. Megatron's trainer reconciles the two by moving every
+    # model chunk after building (`megatron/training/training.py`:
+    # `model_module.cuda(torch.cuda.current_device())`); without the same move the
+    # first norm to run dies on "Expected all tensors to be on the same device".
+    model = model.cuda(torch.cuda.current_device())
+    model.eval()
+    rank = torch.distributed.get_rank()
+    if rank == 0:
+        # Report the extremes rather than one sample: a mixed model is exactly the
+        # failure this move exists to prevent.
+        devices = {str(param.device) for param in model.parameters()}
+        print(f'[megatron] built, params on {sorted(devices)}, dtype={next(model.parameters()).dtype}')
+
+    started = time.time()
+    bridge.load_hf_weights([model])
+    if rank == 0:
+        print(f'[megatron] hf weights loaded in {time.time() - started:.0f}s')
+    return model
+
+
+def _input_path(args, name: str) -> str:
+    """Path of one dumped input file of the *current* batch (see :func:`_batch_tag`).
+
+    The inputs are written by the `hf` phase and read back by the `megatron`
+    phase and by `--stage compare`, all three of which have to work on the very
+    same tokens. Naming them per batch is what makes that a guarantee: a shared
+    `input_ids.pt` silently paired a `--stage megatron --mm-rows 3` run with
+    whatever batch happened to be built last (the batch of the *previous* case,
+    whose tag lives only in the dump file names).
+    """
+    return os.path.join(args.work_dir, f'{name}_{_batch_tag(args)}.pt')
+
+
+def _load_lengths(args, total: int):
+    """Per-sample lengths of the packed stream ``input_ids_<tag>.pt`` holds.
+
+    Written by the `hf` phase, which is also the phase that decides the layout
+    (see :func:`build_inputs`); a dump from before this existed is one sample.
+    """
+    path = _input_path(args, 'lengths')
+    if not os.path.exists(path):
+        print(f'[megatron] {os.path.basename(path)} is missing: treating the stream as one sample')
+        return [total]
+    lengths = [int(length) for length in torch.load(path, weights_only=True)]
+    if sum(lengths) != total:
+        raise SystemExit(
+            f'{os.path.basename(path)} ({lengths}) does not add up to the {total}-token stream of '
+            f'{os.path.basename(_input_path(args, "input_ids"))}'
+        )
+    return lengths
+
+
+def _cp_inputs(args, ids: torch.Tensor, lengths, boundaries: List[int]):
+    """The undivided batch a CP > 1 run is handed.
+
+    Relax's data path hands the model one padded row per sample, a *global*
+    ``cu_seqlens_q_padded`` (every sample padded up to a multiple of
+    ``tp * cp * 2``) and no ``cu_seqlens_q_cpu``; the split into zigzag chunks is
+    the model's own job (`modelling_qwen4_exp/cp_split.py`). Reproduced here from
+    the same recipe -- `relax/backends/megatron/data.py`, the
+    ``needs_unsplit_input and cp_size > 1`` branch -- so the megatron phase sees
+    byte for byte what a CP training step sees.
+    """
+    from megatron.core.packed_seq_params import PackedSeqParams
+
+    align = args.tp * args.cp * 2
+    seqlens = [int(length) for length in lengths]
+    padded = [(length + align - 1) // align * align for length in seqlens]
+    max_padded = max(padded)
+    unsplit = ids.new_zeros((len(seqlens), max_padded))
+    mask = torch.zeros((len(seqlens), max_padded), dtype=torch.bool)
+    for index, (start, end, length) in enumerate(zip(boundaries, boundaries[1:], seqlens)):
+        unsplit[index, :length] = ids[0, start:end]
+        mask[index, :length] = True
+    # On the device, like `data.py` builds them: the GDN's triton kernels take
+    # `cu_seqlens` as a pointer argument and refuse a host tensor.
+    cu_seqlens = torch.zeros(len(seqlens) + 1, dtype=torch.int32, device='npu')
+    cu_seqlens[1:] = torch.tensor(padded, dtype=torch.int32, device='npu').cumsum(0)
+    packed_seq_params = PackedSeqParams(
+        cu_seqlens_q=cu_seqlens,
+        cu_seqlens_kv=cu_seqlens,
+        max_seqlen_q=max_padded,
+        max_seqlen_kv=max_padded,
+        qkv_format='thd',
+        cu_seqlens_q_padded=cu_seqlens,
+        cu_seqlens_kv_padded=cu_seqlens,
+    )
+    print(
+        f'[megatron] CP={args.cp}: undivided batch {tuple(unsplit.shape)} '
+        f'({len(seqlens)} sample(s) of {seqlens} padded to {padded}, align tp*cp*2={align})'
+    )
+    return unsplit.npu(), mask.npu(), packed_seq_params
+
+
+def _checkpoint_text_config(args) -> Dict:
+    """The checkpoint's ``text_config`` -- ``{}`` when there is none to read."""
+    try:
+        with open(os.path.join(args.ckpt, 'config.json'), encoding='utf-8') as handle:
+            return json.load(handle).get('text_config', {})
+    except (OSError, ValueError):  # no config to read: nothing to check against
+        return {}
+
+
+def _gather_vocab(logits: torch.Tensor, args) -> torch.Tensor:
+    """Turn the vocab-parallel LM head's slice into the reference's ``[B, S, vocab]``.
+
+    The head is a ``ColumnParallelLinear(gather_output=False)``, whose weight is
+    split *contiguously* along the vocab axis -- rank ``r`` holds rows
+    ``[r * n, (r+1) * n)`` of the head's width -- so gathering in rank order
+    restores the reference's row order, i.e. the vocabulary's own order. Two
+    things the gather undoes, and both are invisible when the gate runs on one
+    die, which is why it could be green at TP=1 and red at TP=4:
+
+    * the split: a rank's logits are one slice of the vocabulary, and `compare`
+      reads the last dim *as* the vocabulary (the functional check takes an
+      argmax over it and a KL against the reference's distribution);
+    * padding, if the provider asked for any: the head is padded to
+      ``make_vocab_size_divisible_by * tp``, so the gathered width can be wider
+      than the checkpoint's vocabulary. qwen4_exp does not pad (the observed
+      width is 248320 / tp exactly), but the truncation costs nothing and keeps
+      the row honest at a ``--tp`` whose split is not exact.
+
+    The collective runs on *every* rank -- the caller places it outside the
+    `capturing` guard -- and ``gather_from_tensor_model_parallel_region`` returns
+    its input untouched at TP=1, so a single-die run is unaffected.
+    """
+    from megatron.core.tensor_parallel.mappings import gather_from_tensor_model_parallel_region
+
+    logits = gather_from_tensor_model_parallel_region(logits)
+    vocab = _checkpoint_text_config(args).get('vocab_size')
+    if vocab and logits.shape[-1] > vocab:
+        logits = logits[..., :vocab]
+    return logits
+
+
+def run_megatron(args) -> None:
+    from megatron.core.packed_seq_params import PackedSeqParams
+
+    model = build_megatron_model(args)
+    ids = torch.load(_input_path(args, 'input_ids'), weights_only=True)
+    mm = torch.load(_input_path(args, 'mm_inputs'), weights_only=True)
+    lengths = _load_lengths(args, ids.numel())
+    total = ids.numel()
+    if args.cp > 1 and (mm or args.feed_hf_merged):
+        # The VL batch splits *after* the vision merge (see cp_split.py), and the
+        # merge is exactly what `--feed-hf-merged` replaces; neither is wired up.
+        raise SystemExit('--cp > 1 is only wired for a text batch (no --mm-parquet / --feed-hf-merged)')
+
+    # Control run: start the text tower from the reference's own merged embedding,
+    # so the tower is judged on input the two sides agree on byte for byte instead
+    # of on input that differs by the vision tower's bf16 rounding. Only the
+    # embedding is fed -- the port still computes its own M-RoPE positions, which
+    # keeps `positions` in the diff (and makes a wrong one fail this run twice).
+    fed: Dict[str, torch.Tensor] = {}
+    if args.feed_hf_merged:
+        if not mm:
+            raise SystemExit('--feed-hf-merged needs a multimodal dump (--mm-parquet)')
+        reference = torch.load(os.path.join(args.work_dir, f'hf_{_batch_tag(args)}.pt'), weights_only=True)
+        # The dump is float32 and batch-first; the model takes bf16 (what the
+        # reference held) and mcore's sequence-first [`T`, `b`, `h`] layout.
+        fed = {
+            'decoder_input': reference['merged'].transpose(0, 1).to(torch.bfloat16).npu().contiguous(),
+        }
+        print(
+            '[megatron] text tower fed with the reference merged embedding '
+            '(the port still computes its own position ids)'
+        )
+
+    # One packed sequence, the layout Relax's SFT path builds (`data.py`: the
+    # concatenated tokens as `[1, T]` plus host-side `cu_seqlens_q_cpu`). With
+    # more than one sample the boundaries are the interior ones, which is what
+    # makes every sample its own attention window and restarts its positions.
+    boundaries = [0]
+    for length in lengths:
+        boundaries.append(boundaries[-1] + length)
+    assert boundaries[-1] == total, f'the per-sample boundaries {boundaries} do not cover the {total} tokens'
+    if args.cp > 1:
+        # The undivided batch a CP run is handed: the split itself is the model's
+        # job (`cp_split.py`), so what goes in is one padded row per sample plus a
+        # *global* `cu_seqlens_q_padded` -- and no `cu_seqlens_q_cpu`, which is the
+        # marker that means "already local, nothing to split".
+        input_ids, attention_mask, packed_seq_params = _cp_inputs(args, ids, lengths, boundaries)
+    else:
+        cu_seqlens = torch.tensor(boundaries, dtype=torch.int32, device='npu')
+        packed_seq_params = PackedSeqParams(
+            cu_seqlens_q=cu_seqlens,
+            cu_seqlens_kv=cu_seqlens,
+            max_seqlen_q=max(lengths),
+            max_seqlen_kv=max(lengths),
+            qkv_format='thd',
+        )
+        packed_seq_params.cu_seqlens_q_cpu = boundaries
+        input_ids, attention_mask = ids.npu(), None
+        if len(lengths) > 1:
+            print(f'[megatron] packed {len(lengths)} samples: cu_seqlens={boundaries}')
+
+    rank = torch.distributed.get_rank()
+    # Without CP every rank holds the same (whole) activations -- the TP group
+    # replicates the residual stream, SP is off, and the hooks only capture what
+    # the layers write, all of which is replicated -- so one rank dumps. The
+    # forward below still runs on all ranks because the MoE all-to-all needs the
+    # whole expert-parallel group. Under CP each rank holds a different zigzag
+    # chunk of every tensor a layer writes, so every rank dumps and `compare`
+    # joins them. The one captured tensor that is *not* whole without CP is
+    # `logits` -- the LM head is the vocab-parallel one (see `_gather_vocab`).
+    capturing = rank == 0 or args.cp > 1
+    store: Dict[str, torch.Tensor] = {}
+    if capturing:
+        for index, layer in enumerate(model.decoder.layers):
+            _capture(layer, f'layer{index}', store)
+            if getattr(layer, 'ple', None) is not None:
+                # The same two tensors the reference dumps for its PLE layer: the
+                # contribution to the layer's input and the table lookup it starts
+                # from.
+                _capture(layer.ple, 'ple', store)
+                _capture(layer.ple.ple_embedding, 'ple_embed', store)
+            if args.capture_inner:
+                # mcore's TransformerLayer names its attention `self_attention`
+                # for both layer types here (the plugin swaps in the vendored
+                # gated-delta-net for linear layers).
+                _capture_inner(layer, index, layer.self_attention, store)
+
+        def catch_final(_module, _inputs, output):
+            tensor = output[0] if isinstance(output, tuple) else output
+            store['final'] = tensor.detach().to(torch.float32).cpu()
+
+        model.decoder.register_forward_hook(catch_final)
+
+        def catch_embed(_module, _inputs, output):
+            # Hooked rather than called directly: this embedding takes a
+            # `position_ids` argument (the checkpoint's PLE plumbing), and the ones
+            # the model derives for itself are the only ones guaranteed to match
+            # the HF reference's plain `embed_tokens` lookup.
+            tensor = output[0] if isinstance(output, tuple) else output
+            store['embed'] = tensor.detach().to(torch.float32).cpu()
+
+        model.embedding.register_forward_hook(catch_embed)
+
+        if mm:
+            # The decoder's input *is* the merged embedding (the wrapper hands it
+            # over as `decoder_input`), so hooking the block shows the merge the
+            # way HF's text-tower pre-hook does.
+            def catch_decoder_input(_module, _args, kwargs):
+                hidden = kwargs.get('hidden_states')
+                if hidden is not None:
+                    store['merged'] = hidden.detach().to(torch.float32).cpu()
+
+            model.decoder.register_forward_pre_hook(catch_decoder_input, with_kwargs=True)
+            _capture_vision(model.visual, store)
+
+            # The wrapper derives the M-RoPE positions itself when the caller
+            # passes none (which is what Relax does); recording them here is what
+            # makes them comparable with HF's.
+            derive_positions = model._multimodal_position_ids
+
+            def record_positions(*call_args, **call_kwargs):
+                positions = derive_positions(*call_args, **call_kwargs)
+                store['positions'] = positions.detach().to(torch.float32).cpu()
+                return positions
+
+            model._multimodal_position_ids = record_positions
+
+    if fed and mm and rank == 0:
+        # Feeding the embedding bypasses `_combined_embeddings`, so the tower
+        # would never run and `vision` would be missing from the dump -- run it
+        # once by hand so the comparison keeps its shape (`_capture_vision`
+        # fills it). The merge result is thrown away; the forward below is what
+        # the run is about.
+        with torch.no_grad():
+            model._combined_embeddings(ids.npu(), mm['pixel_values'].npu(), None, mm['image_grid_thw'].npu(), None)
+        print('[megatron] vision tower run separately (the fed embedding skips the merge)')
+
+    with torch.no_grad():
+        logits = model(
+            input_ids=input_ids,
+            position_ids=fed.get('position_ids'),
+            attention_mask=attention_mask,
+            decoder_input=fed.get('decoder_input'),
+            labels=None,
+            packed_seq_params=packed_seq_params,
+            **{key: value.npu() for key, value in mm.items()},
+        )
+        # Outside the `capturing` guard on purpose: the gather is a collective
+        # over the TP group, so every rank has to enter it even though one writes.
+        logits = _gather_vocab(logits, args)
+        if capturing and not args.no_logits:
+            store['logits'] = logits.detach().to(torch.float32).cpu()
+
+    if capturing:
+        # The precision this phase really ran at, for the `compare` phase's
+        # `vision` row -- it sets the bar there, and only this phase knows it (see
+        # `_run_meta_path`). A sidecar rather than a key in the dump: `_dump`
+        # walks the store as tensors, and `compare` collects its keys from the
+        # intersection with the hf dump, so a string would have to be special
+        # cased in two places instead of none.
+        _write_run_meta(args, {'params_dtype': str(next(model.parameters()).dtype)})
+        _dump(args, 'megatron', store, rank=rank if args.cp > 1 else None)
+
+
+def _batch_tag(args) -> str:
+    """Name of the batch a dump belongs to.
+
+    One pair of files per batch, so a short (dense-attention) and a long
+    (QSA-sparse) run -- or a text and a multimodal one -- can be compared without
+    overwriting each other. A single-row VL batch keeps the tag it always had, so
+    dumps written before ``--mm-rows``/``--mm-merge`` existed stay readable.
+    """
+    if not args.mm_parquet:
+        tag = str(args.seq_len)
+    else:
+        tag = f'mm{args.mm_index}'
+        if args.mm_rows > 1 or args.mm_merge > 1:
+            tag += f'-r{args.mm_rows}m{args.mm_merge}'
+    # Same tokens, different local layout: a CP run's dump is per rank, so it
+    # must not land on the CP == 1 pair of the same batch.
+    if args.cp > 1:
+        tag += f'-cp{args.cp}'
+    return tag
+
+
+def _rel_stats(ref: torch.Tensor, got: torch.Tensor) -> Dict[str, float]:
+    """The five numbers every row of `compare` is judged and printed on.
+
+    Everything is measured in float64. The cosines live within 1e-3 of 1.0 -- the
+    same order as the differences being judged -- and float32
+    ``x.y / (||x|| ||y||)`` is not accurate enough to resolve that: it returned
+    1.021 where the tensors are identical in direction.
+    """
+    ref64, got64 = ref.double(), got.double()
+    diff = (got64 - ref64).abs()
+    scale = ref64.abs().max().clamp_min(1e-12)
+    return {
+        'max_abs': diff.max().item(),
+        'mean_abs': diff.mean().item(),
+        # `relative` (max|delta| / max|ref|) rides on the single largest element
+        # of an activation whose tail is two orders above its bulk, where one bf16
+        # rounding of a 10240-wide reduction is worth several percent; the cosine
+        # is scale blind (a wrong scale factor leaves it at 1). rms_rel is neither.
+        'relative': (diff.max() / scale).item(),
+        'rms_rel': (diff.square().mean().sqrt() / ref64.square().mean().sqrt().clamp_min(1e-12)).item(),
+        'cos': torch.nn.functional.cosine_similarity(ref64.flatten(), got64.flatten(), dim=0).item(),
+    }
+
+
+def _run_meta_path(args) -> str:
+    """Sidecar the ``megatron`` phase writes its run facts to (see `compare`)."""
+    return os.path.join(args.work_dir, f'megatron_{_batch_tag(args)}.meta.json')
+
+
+def _write_run_meta(args, meta: Dict) -> None:
+    with open(_run_meta_path(args), 'w', encoding='utf-8') as handle:
+        json.dump(meta, handle, indent=2, sort_keys=True)
+
+
+def _read_run_meta(args) -> Dict:
+    path = _run_meta_path(args)
+    if not os.path.exists(path):
+        # An older dump, or a `megatron` phase run by hand. Return nothing rather
+        # than guess: `compare` then falls back to its strict bar and says so.
+        return {}
+    with open(path, encoding='utf-8') as handle:
+        return json.load(handle)
+
+
+def _dump(args, tag: str, store: Dict[str, torch.Tensor], rank: Optional[int] = None) -> None:
+    # `--no-logits` skips the lm_head on both sides (see `run_hf`), so `logits` is
+    # a key this dump is *allowed* to be without; everything else is mandatory.
+    wanted = tuple(key for key in HF_KEYS if key != 'logits' or not args.no_logits)
+    missing = [key for key in wanted if key not in store]
+    if missing:
+        raise RuntimeError(f'{tag}: nothing captured for {missing}')
+    # A CP run writes one file per rank (`rank=None` keeps the single-file name).
+    name = f'{tag}_cpchunk{rank}_{_batch_tag(args)}.pt' if rank is not None else f'{tag}_{_batch_tag(args)}.pt'
+    path = os.path.join(args.work_dir, name)
+    torch.save(dict(store), path)
+    origin = f' (rank {rank})' if rank is not None else ''
+    print(f'[{tag}] dumped {len(store)} tensors{origin} to {path}')
+    for key, tensor in store.items():
+        print(f'    {key:8s} {tuple(tensor.shape)}  absmax={tensor.abs().max():.4f}')
+
+
+# --------------------------------------------------------------------------------------
+# phase 3: the comparison
+# --------------------------------------------------------------------------------------
+def _functional_agreement(
+    ref_logits: torch.Tensor, got_logits: torch.Tensor, ids: torch.Tensor, lengths=None, chunk: int = 64
+) -> Dict[str, float]:
+    """Loss, argmax agreement and KL of the two next-token distributions.
+
+    The tensor table says how far two *activations* are; this says whether the
+    two models make the same predictions -- which is what the port is for, and
+    what "aligns with HF" has to mean at the end of the day. It is also the least
+    noisy statistic available here: the loss averages over the sequence, so the
+    bf16 rounding that moves one element by a few percent largely cancels, while
+    a wrong mask, norm or router moves it by orders more.
+
+    The labels are the batch's own next tokens (the standard shift), so the
+    number is not this checkpoint's SFT loss -- only the two implementations'
+    agreement on it, which is exactly what is being judged.
+
+    Args:
+        ref_logits, got_logits: ``[T, V]`` (or reshaped to it) of the two dumps.
+        ids: The packed stream's token ids, ``[1, T]``.
+        lengths: The per-sample lengths of that stream; the positions that would
+            predict across a sample boundary are dropped (see below).
+    """
+    ids = ids.reshape(-1)
+    ref_logits = ref_logits.reshape(-1, ref_logits.shape[-1])
+    got_logits = got_logits.reshape(-1, got_logits.shape[-1])
+    # The logits of position i predict token i+1.
+    labels = ids[1:][: ref_logits.shape[0] - 1]
+    ref_logits, got_logits = ref_logits[:-1], got_logits[:-1]
+    labels = labels[: ref_logits.shape[0]]
+
+    # In a packed batch the last token of a sample predicts the *first token of
+    # the next sample*, which is a label no model could see: those positions are
+    # dropped rather than charged to both implementations.
+    keep = torch.ones(ref_logits.shape[0], dtype=torch.bool)
+    if lengths is not None:
+        boundary = 0
+        for length in lengths[:-1]:
+            boundary += int(length)
+            keep[boundary - 1] = False
+    dropped = int((~keep).sum())
+    ref_logits, got_logits, labels = ref_logits[keep], got_logits[keep], labels[keep]
+
+    ref_loss = torch.nn.functional.cross_entropy(ref_logits, labels).item()
+    got_loss = torch.nn.functional.cross_entropy(got_logits, labels).item()
+
+    top1_same = 0
+    kl = 0.0
+    for start in range(0, ref_logits.shape[0], chunk):
+        ref_chunk = ref_logits[start : start + chunk].double()
+        got_chunk = got_logits[start : start + chunk].double()
+        top1_same += int((ref_chunk.argmax(-1) == got_chunk.argmax(-1)).sum())
+        logp_ref = torch.log_softmax(ref_chunk, dim=-1)
+        logp_got = torch.log_softmax(got_chunk, dim=-1)
+        kl += float((logp_ref.exp() * (logp_ref - logp_got)).sum())
+
+    positions = ref_logits.shape[0]
+    return {
+        'ref_loss': ref_loss,
+        'got_loss': got_loss,
+        'top1_same': top1_same,
+        'positions': positions,
+        'dropped': dropped,
+        'kl': kl / positions,
+    }
+
+
+def _assemble_cp_chunks(args, hf: Dict[str, torch.Tensor], tag: str) -> Dict[str, torch.Tensor]:
+    """Join the per-rank zigzag chunks of a CP run into one sequence.
+
+    Every sample is cut into ``2 * cp`` pieces and rank ``r`` keeps the ``r``-th
+    piece from the front and the mirrored one from the back
+    (`modelling_qwen4_exp/cp_split.py`). The join is written out here by hand --
+    rank ``r``'s local first/second half landing at ``r * c`` and
+    ``L - (r + 1) * c`` -- rather than by calling that module's helper, so a wrong
+    local layout cannot cancel itself out between the split and this join and
+    quietly compare equal.
+
+    A capture that comes back whole on every rank (the embedding and the PLE
+    table lookup are both taken before the split) is passed straight through,
+    after checking that the ranks really do agree on it.
+
+    Only a one-sample batch is wired up: that is what the text batches here are,
+    and a multi-sample join would have to reproduce the per-sample padding too.
+    """
+    chunks = []
+    for rank in range(args.cp):
+        path = os.path.join(args.work_dir, f'megatron_cpchunk{rank}_{tag}.pt')
+        chunks.append(torch.load(path, weights_only=True))
+    ids = torch.load(_input_path(args, 'input_ids'), weights_only=True)
+    lengths = _load_lengths(args, ids.numel())
+    if len(lengths) != 1:
+        raise SystemExit(f'--cp is wired for a one-sample batch, got {len(lengths)} samples')
+    length = int(lengths[0])
+    align = args.tp * args.cp * 2
+    if length % align:
+        raise SystemExit(f'the sample is {length} tokens, not a multiple of tp * cp * 2 = {align}')
+    piece = length // (2 * args.cp)
+
+    local = length // args.cp
+    assembled: Dict[str, torch.Tensor] = {}
+    whole, joined = [], []
+    for key, first in chunks[0].items():
+        if key not in hf:
+            continue  # both dumps must carry it, `compare` only reads shared keys
+        # Which axis is the sequence? The captures are sequence-first (`[T, b, h]`)
+        # and the output layer's logits are already batch-first, exactly as in a
+        # CP == 1 dump -- so the layout is read off the tensor, and `compare`'s own
+        # transpose rule takes it from here once the sequence is whole again.
+        if local in tuple(first.shape):
+            seq_dim, is_chunk = tuple(first.shape).index(local), True
+        elif length in tuple(first.shape):
+            seq_dim, is_chunk = tuple(first.shape).index(length), False
+        else:
+            raise SystemExit(
+                f'{key}: {tuple(first.shape)} has neither this rank\'s {local} tokens nor the whole {length}'
+            )
+        if not is_chunk:
+            for rank, other in enumerate(chunks[1:], start=1):
+                if not torch.equal(other[key], first):
+                    raise SystemExit(
+                        f'{key}: captured whole on every rank but rank {rank} disagrees with rank 0 -- '
+                        'this is not a tensor taken before the CP split'
+                    )
+            assembled[key] = first
+            whole.append(key)
+            continue
+        shape = list(first.shape)
+        shape[seq_dim] = length
+        out = torch.empty(tuple(shape), dtype=first.dtype)
+        for rank, chunk in enumerate(chunks):
+            source = chunk[key]
+            if tuple(source.shape) != tuple(first.shape):
+                raise SystemExit(f'{key}: rank {rank} captured {tuple(source.shape)}, rank 0 {tuple(first.shape)}')
+            if source.shape[seq_dim] != 2 * piece:
+                raise SystemExit(
+                    f'{key}: rank {rank} holds {source.shape[seq_dim]} tokens on dim {seq_dim}, want 2*{piece}'
+                )
+            head = [slice(None)] * out.dim()
+            head[seq_dim] = slice(rank * piece, (rank + 1) * piece)
+            tail = [slice(None)] * out.dim()
+            tail[seq_dim] = slice(length - (rank + 1) * piece, length - rank * piece)
+            front = [slice(None)] * source.dim()
+            front[seq_dim] = slice(0, piece)
+            back = [slice(None)] * source.dim()
+            back[seq_dim] = slice(piece, 2 * piece)
+            out[tuple(head)] = source[tuple(front)]
+            out[tuple(tail)] = source[tuple(back)]
+        assembled[key], _ = out, joined.append(key)
+    print(
+        f'[compare] joined {len(chunks)} CP chunks of {length} tokens (piece={piece} per sample): '
+        f'reassembled {sorted(joined)}, passed through whole {sorted(whole)}'
+    )
+    return assembled
+
+
+def compare(args) -> int:
+    tag = _batch_tag(args)
+    hf = torch.load(os.path.join(args.work_dir, f'hf_{tag}.pt'), weights_only=True)
+    if args.cp > 1:
+        mg = _assemble_cp_chunks(args, hf, tag)
+    else:
+        mg = torch.load(os.path.join(args.work_dir, f'megatron_{tag}.pt'), weights_only=True)
+
+    print(
+        f'{"tensor":8s} {"shape":24s} {"max|Δ|":>10s} {"mean|Δ|":>10s} '
+        f'{"max|Δ|/max|ref|":>16s} {"rms|Δ|/rms|ref|":>16s} {"cos":>10s}  verdict'
+    )
+    failures = []
+    functional_failures = []
+    logits_pair = None
+    # Base tensors first, then whatever inner captures both dumps happen to
+    # share -- sorted, so a run with fewer layers still lines up.
+    keys = list(HF_KEYS) + sorted(k for k in hf if k not in HF_KEYS and k in mg)
+    # `--no-logits` dumps fewer keys than `HF_KEYS` names; the functional check
+    # below is already guarded by `logits_pair is None`.
+    keys = [key for key in keys if key in hf and key in mg]
+    if 'logits' not in keys:
+        print('(no logits in these dumps -- `--no-logits`: the loss / KL / argmax summary is skipped)\n')
+
+    # Multimodal mode: the vision tower is judged against the *fp32* reference,
+    # and the text tower -- whose input differs by the tower's bf16 rounding --
+    # only under `--feed-hf-merged`, where the port is handed the same embedding
+    # the reference used (see the module docstring).
+    mm_mode = 'vision' in hf
+    if mm_mode and 'vision_fp32' not in hf:
+        raise SystemExit(
+            f'{os.path.join(args.work_dir, f"hf_{tag}.pt")} has no vision_fp32: it was dumped by an '
+            'older revision of this script. Re-run the hf phase -- `vision` is judged against the '
+            'fp32 reference tower, because bf16-versus-bf16 cannot resolve this tower.'
+        )
+    # What the reference's own bf16 rounding costs on this batch, relative to the
+    # tensor's scale: the floor any bf16-versus-bf16 row is stuck at.
+    floor = 0.0
+    floor_rms = 0.0
+    floor_cos = 1.0
+    if mm_mode:
+        ref32 = hf['vision_fp32']
+        floor = (hf['vision'] - ref32).abs().max().item() / ref32.abs().max().item()
+        # The same measurement as the rms/cosine the vision verdict uses, so the
+        # bf16 branch below compares like with like.
+        floor_stats = _rel_stats(ref32, hf['vision'])
+        floor_rms, floor_cos = floor_stats['rms_rel'], floor_stats['cos']
+        print(f'reference bf16 rounding on this batch (floor for bf16 comparisons): rel_max={floor:.3e}\n')
+
+    # The `vision` row is the one row whose bar depends on a fact `compare` cannot
+    # read off the tensors, because both dumps are float32: the dtype the megatron
+    # phase actually ran at. The `hf` phase is fixed (the fp32 reference), but this
+    # phase is not -- `run_megatron` builds the provider at `params_dtype`, and an
+    # earlier revision set it to bf16 unconditionally, which put an fp32 bar
+    # (rtol 1e-3, cos 0.9999) on a bf16 tower. On this checkpoint that tower's own
+    # rounding is rms_rel ~4.8e-2 -- two orders above the bar, and HF's bf16 tower
+    # misses it by the same margin -- so the row could only ever report MISMATCH,
+    # whatever the port did. Read the dtype instead of assuming it.
+    port_dtype = _read_run_meta(args).get('params_dtype')
+    if mm_mode and port_dtype is None:
+        print(
+            'note: no run metadata next to this dump, so the port\'s dtype is unknown and the '
+            'strict fp32 bar is used for `vision`; re-run `--stage megatron` to write it\n'
+        )
+
+    for key in keys:
+        ref, got = hf[key], mg[key]
+        if key == 'vision':
+            # The yardstick for the tower is the fp32 reference (see the docstring).
+            ref = hf['vision_fp32']
+        # The text tower of this run started from an embedding that differs by the
+        # tower's bf16 rounding, so its own gap is inherited rather than earned:
+        # it is printed for the record and judged by `--feed-hf-merged` instead.
+        inherited = mm_mode and not args.feed_hf_merged and key not in MM_JUDGED_KEYS
+        if ref.shape != got.shape:
+            # The block hooks hand back sequence-first tensors (`[s, b, h]`) while
+            # HF is batch-first (`[b, s, h]`); mcore's output layer already
+            # transposes its logits, so only the intermediate captures need this.
+            if got.dim() >= 2 and ref.shape == (got.shape[1], got.shape[0]) + tuple(got.shape[2:]):
+                got = got.transpose(0, 1)
+            else:
+                print(f'{key:8s} {str(tuple(ref.shape)):24s} SHAPE MISMATCH vs {tuple(got.shape)}')
+                failures.append(key)
+                continue
+        # Root-mean-square relative error is the statistic the verdict rests on
+        # (see `_rel_stats`).
+        stats = _rel_stats(ref, got)
+        max_abs, mean_abs = stats['max_abs'], stats['mean_abs']
+        relative, rms_rel, cos = stats['relative'], stats['rms_rel'], stats['cos']
+        if key == 'logits':
+            # Handed to the functional check below, batch-first and float32.
+            logits_pair = (ref.double().float(), got.double().float())
+        if key == 'vision':
+            # Two bars, because the same tower is judged at two precisions and the
+            # row's whole value is that the *bar* says which. At fp32 the port
+            # reproduces the reference to ~1e-6 and the tight bar is the real test.
+            # At bf16 this tower -- no final norm, residual stream reaching ~1e2 --
+            # rounds itself by the `floor` printed above, which the reference's own
+            # bf16 tower also sits at, so the bar is that floor: the port must lose
+            # no accuracy against the fp32 truth that the reference does not lose
+            # itself. Both are printed with the verdict, so the log never leaves it
+            # to the reader to work out which one was applied.
+            if port_dtype is not None and 'float32' not in port_dtype:
+                ok = rms_rel <= floor_rms and cos >= floor_cos
+                verdict = (
+                    f'ok (at the {port_dtype} floor, rms {floor_rms:.2e}/cos {floor_cos:.6f})'
+                    if ok
+                    else 'MISMATCH (worse than the reference\'s own rounding at the same dtype)'
+                )
+            else:
+                ok = rms_rel < args.vision_rtol and cos > args.vision_min_cos
+                verdict = 'ok' if ok else 'MISMATCH'
+        elif inherited:
+            # Only a structural check: the inherited bf16 rounding is what the
+            # cosine of these rows already carries (0.9986 on this batch), while a
+            # wrong merge, mask or routing decision drops it far below this bar.
+            ok = cos > args.min_cos_inherited
+            verdict = 'inherited (cos ok)' if ok else 'inherited (cos too low: real mismatch)'
+        else:
+            ok = rms_rel < args.rtol and cos > args.min_cos
+            verdict = 'ok' if ok else 'MISMATCH'
+        if not ok:
+            failures.append(key)
+        print(
+            f'{key:8s} {str(tuple(ref.shape)):24s} {max_abs:10.3e} {mean_abs:10.3e} '
+            f'{relative:16.3e} {rms_rel:16.3e} {cos:10.6f}  {verdict}'
+        )
+
+    # Do the two implementations predict the same thing? (see _functional_agreement)
+    ids_path = _input_path(args, 'input_ids')
+    if logits_pair is not None and os.path.exists(ids_path):
+        ids = torch.load(ids_path, weights_only=True)
+        lengths = _load_lengths(args, ids.numel())
+        stats = _functional_agreement(*logits_pair, ids, lengths if len(lengths) > 1 else None)
+        loss_gap = abs(stats['ref_loss'] - stats['got_loss'])
+        loss_rel = loss_gap / abs(stats['ref_loss'])
+        # Built first: nesting a same-quoted f-string inside an f-string is
+        # Python 3.12 syntax (PEP 701) and this harness runs on 3.10.
+        dropped_note = f'; {stats["dropped"]} dropped as cross-sample' if stats['dropped'] else ''
+        print(
+            f'\nfunctional agreement over {stats["positions"]} positions '
+            f'(each position\'s label is the batch\'s own next token{dropped_note}):'
+        )
+        print(
+            f'  cross-entropy  reference={stats["ref_loss"]:.6f}  megatron={stats["got_loss"]:.6f}  '
+            f'|Δ|={loss_gap:.3e}  rel={loss_rel:.2e}  (bar {args.loss_rtol:.0e})'
+        )
+        print(
+            f'  argmax         {stats["top1_same"]}/{stats["positions"]} = '
+            f'{stats["top1_same"] / stats["positions"]:.2%} of positions agree'
+        )
+        print(f'  KL(ref||mg)    {stats["kl"]:.3e} nats/token  (bar {args.kl_max:.0e})')
+        if loss_rel >= args.loss_rtol:
+            functional_failures.append(f'loss differs by {loss_rel:.2e} (bar {args.loss_rtol:.0e})')
+        if stats['kl'] >= args.kl_max:
+            functional_failures.append(f'KL {stats["kl"]:.3e} nats/token (bar {args.kl_max:.0e})')
+
+    # Which tensor fails *first* is what localises a bug: the layers are
+    # sequential, so the earliest mismatch names the module to look at, and
+    # everything downstream of it is expected to be off too.
+    if failures or functional_failures:
+        if failures:
+            print(f'\nverdict: NOT ALIGNED -- first failing tensor: {failures[0]}')
+        else:
+            print(f'\nverdict: NOT ALIGNED -- {"; ".join(functional_failures)}')
+        return 1
+    if mm_mode and not args.feed_hf_merged:
+        print(
+            '\nverdict: aligned (vision vs the fp32 reference, positions and the merge checked; '
+            'the text tower of this run started from the reference\'s embedding only up to the '
+            'tower\'s bf16 rounding -- run with --feed-hf-merged to judge it on identical input)'
+        )
+        return 0
+    print('\nverdict: aligned (every captured tensor within tolerance)')
+    return 0
+
+
+# --------------------------------------------------------------------------------------
+# driver
+# --------------------------------------------------------------------------------------
+PHASES = ('hf', 'megatron', 'compare')
+
+
+def _ensure_pythonpath(env: dict) -> None:
+    """Put the repos on ``PYTHONPATH`` the way the training scripts do.
+
+    Same variables, so a shell that already exports them (or a caller that
+    relocated a checkout) wins. ``relax`` is not used by this harness, but
+    Megatron-Bridge's peft helpers import it and MindSpeed's patch table names
+    ``relax.*`` modules, so it has to be importable.
+    """
+    roots = [
+        os.environ.get('RELAX', '/root/Relax'),
+        os.environ.get('MINDSPEED_BRIDGE', '/root/MindSpeed-Bridge'),
+        os.environ.get('MEGATRON_BRIDGE_SRC', '/root/Megatron-Bridge/src'),
+        os.environ.get('MEGATRON', '/root/Megatron-LM'),
+        os.environ.get('MINDSPEED', '/root/MindSpeed'),
+    ]
+    current = [p for p in env.get('PYTHONPATH', '').split(':') if p]
+    missing = [root for root in roots if root not in current]
+    if missing:
+        env['PYTHONPATH'] = ':'.join(missing + current)
+
+
+# What each phase actually runs, in place of `-m <this module>`.
+#
+# `-m` resolves its target by importing the package chain first, so
+# `mindspeed_bridge.models.qwen4_exp` (whose `__init__` imports the bridge)
+# executes before a single line of this file -- and that pull reaches
+# `megatron.bridge` -> `megatron.core` -> `import transformer_engine_torch`,
+# which does not exist until `mindspeed.megatron_adaptor` has installed its
+# stand-in. The child then dies at import with a `ModuleNotFoundError` that names
+# a module this file never imports, several frames below anything it wrote.
+#
+# `_setup_npu` below is the fix for exactly this, but it cannot run early enough:
+# by the time the module body starts, the failing import has already happened.
+# So the two imports are done *before* the module is resolved, at interpreter
+# startup, with `-c` -- which also leaves the child's `_setup_npu` a no-op when it
+# reaches it later. `-c` rather than a `sitecustomize` on the `PYTHONPATH` above:
+# that would apply the import to every python started with those repos on the
+# path, while this scopes it to the processes this harness starts.
+_NPU_BOOTSTRAP = (
+    'import runpy\n'
+    'try:\n'
+    '    import torch_npu, mindspeed.megatron_adaptor\n'
+    'except ImportError:\n'
+    '    pass\n'  # no NPU stack on this box: let this file raise where it normally would
+    "runpy.run_module('mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.tests"
+    ".align_with_hf', run_name='__main__', alter_sys=True)\n"
+)
+# Printed in place of the bootstrap so the log line stays readable.
+_BOOTSTRAP_LABEL = "'<torch_npu + megatron_adaptor bootstrap>'"
+
+
+def _spawned() -> bool:
+    """True inside the processes :func:`_spawn` launched (they must not spawn)."""
+    return os.environ.get('ALIGN_SPAWNED') == '1'
+
+
+def _spawn(phase: str, args, devices: str) -> int:
+    """Re-run this file on ``devices`` (one process per die)."""
+    env = dict(os.environ)
+    _ensure_pythonpath(env)
+    env['ASCEND_RT_VISIBLE_DEVICES'] = devices
+    # Marks the child as already dispatching its own phase, so `main` runs it
+    # instead of spawning again.
+    env['ALIGN_SPAWNED'] = '1'
+    # Offset from the running training jobs' ranges so the harness never takes
+    # a socket the GRPO / SFT runs are using.
+    env.setdefault('HCCL_HOST_SOCKET_PORT_RANGE', '63300-63350')
+    env.setdefault('HCCL_NPU_SOCKET_PORT_RANGE', '64300-64350')
+    env.setdefault('ASCEND_COREDUMP_SIGNAL', 'none')
+    common = [
+        '--stage',
+        phase,
+        '--work-dir',
+        args.work_dir,
+        '--ckpt',
+        args.ckpt,
+        '--data',
+        args.data,
+        '--seq-len',
+        str(args.seq_len),
+        '--attn',
+        args.attn,
+        '--tp',
+        str(args.tp),
+        '--ep',
+        str(args.ep),
+        '--et',
+        str(args.et),
+        '--cp',
+        str(args.cp),
+        '--mm-index',
+        str(args.mm_index),
+        '--mm-rows',
+        str(args.mm_rows),
+        '--mm-merge',
+        str(args.mm_merge),
+    ]
+    if args.mm_parquet:
+        # `megatron` reads the batch `hf` wrote; it rebuilds nothing, so only the
+        # `hf` phase needs the parquet, and passing it to both keeps the command
+        # line in the log self-describing.
+        common += ['--mm-parquet', args.mm_parquet]
+    if args.capture_inner:
+        common.append('--capture-inner')
+    if args.no_logits:
+        common.append('--no-logits')
+    if args.feed_hf_merged:
+        common.append('--feed-hf-merged')
+
+    launch = [sys.executable, '-c', _NPU_BOOTSTRAP, *common]
+    command = ' '.join([sys.executable, '-c', _BOOTSTRAP_LABEL, *common])
+    ranks = len(devices.split(','))
+    if ranks == 1:
+        print(f'[driver] {command}  (ASCEND_RT_VISIBLE_DEVICES={devices})', flush=True)
+        return subprocess.call(launch, env=env)
+
+    # Launch the ranks by hand instead of under `torch.distributed.run`: on this
+    # host the agent never gets past its own rendezvous (the c10d store is
+    # addressed by hostname, the hostname does not resolve, and the agent retries
+    # with exponential backoff without ever starting a worker). `_init_dist` reads
+    # `RANK`/`LOCAL_RANK`/`WORLD_SIZE`/`MASTER_ADDR`/`MASTER_PORT`, so plain
+    # processes are equivalent -- and loopback is an address that always resolves.
+    # Each rank logs to its own file, which also keeps the per-rank ordering of the
+    # dumps readable.
+    master_port = str(_free_port())
+    print(
+        f'[driver] {ranks} ranks of {command}  (ASCEND_RT_VISIBLE_DEVICES={devices}, MASTER_PORT={master_port})',
+        flush=True,
+    )
+    children = []
+    # The rank logs stay open for as long as their process runs, so they are held
+    # by an `ExitStack` rather than a `with open(...)` per rank.
+    with contextlib.ExitStack() as stack:
+        for rank in range(ranks):
+            rank_env = dict(
+                env,
+                RANK=str(rank),
+                LOCAL_RANK=str(rank),
+                WORLD_SIZE=str(ranks),
+                MASTER_ADDR='127.0.0.1',
+                MASTER_PORT=master_port,
+            )
+            path = os.path.join(args.work_dir, f'{phase}_rank{rank}.log')
+            handle = stack.enter_context(open(path, 'w', encoding='utf-8'))
+            children.append(
+                (
+                    # All ranks run concurrently and are waited on below, so the
+                    # process cannot be scoped by a `with` of its own.
+                    subprocess.Popen(  # pylint: disable=consider-using-with
+                        launch, env=rank_env, stdout=handle, stderr=subprocess.STDOUT
+                    ),
+                    path,
+                )
+            )
+        codes = []
+        for process, path in children:
+            codes.append(process.wait())
+            print(f'[driver] rank log: {path} (exit {codes[-1]})', flush=True)
+    return next((code for code in codes if code), 0)
+
+
+def _check_parallel_layout(args) -> None:
+    """Reject the layouts that cannot build -- and the ones that build *wrong*.
+
+    Each check stands for a failure this harness has already paid for, so it runs on
+    the driver, before ``tp * ep`` processes are started on dies the run would then
+    have to give back:
+
+    * the expert-tensor axis, which ``_init_dist`` has to hand to
+      ``initialize_model_parallel`` (the group, not just the config);
+    * the die budget -- ``_spawn`` starts one rank per die in ``--mg-devices`` and
+      ``_init_dist`` declares that count as the world size, so a mismatch is either
+      a hang in the rendezvous or a layout MCore refuses;
+    * the grouped GEMM's 128-tensor cap (see the module docstring);
+    * MCore's q-head slicing under ``num_query_groups < world_size``, which
+      *truncates* rather than raising: it keeps ``heads / (tp / groups)`` heads per
+      rank and indexes them with ``rank % (tp / groups)``, so a ``tp`` that does not
+      divide that lane count silently drops heads and has the second half of the
+      ranks replay the first half's slice.
+    """
+    if args.et > args.tp or args.tp % args.et:
+        raise SystemExit(f'--et {args.et} must divide --tp {args.tp}')
+    if not _spawned():
+        # Only the driver owns the die list: the ranks it starts are handed
+        # `ASCEND_RT_VISIBLE_DEVICES` and the default `--mg-devices` (nothing else
+        # travels through `_spawn`'s flag list), so the count is checked here, once.
+        #
+        # The die count *is* the world size (`_spawn` starts one process per die,
+        # `_init_dist` declares that count), and each of the two layouts has to
+        # tile it on its own:
+        #
+        #   world = tp * pp * cp * dp        (the model grid; pp = 1 here)
+        #   world = et * ep * pp * edp       (the expert grid; tp does not appear)
+        #
+        # This used to require `world = tp * ep`, which is wrong: measured on 16
+        # dies, `tp=4 ep=16` and `tp=8 ep=16` both build (data-parallel 4 and 2,
+        # expert data-parallel 1). The apparent coupling is MCore's default
+        # `expert_tensor_parallel_size = tp` -- leave `--et` unset and the expert
+        # grid becomes `tp * ep`, which is also why the wrong rule looks right:
+        # `world = tp * ep` is *sufficient*, just not necessary.
+        dies = len([device for device in args.mg_devices.split(',') if device])
+        if dies % (args.tp * args.cp):
+            raise SystemExit(
+                f'--mg-devices lists {dies} dies, which the model grid cannot tile: '
+                f'--tp {args.tp} * --cp {args.cp} must divide it'
+            )
+        if dies % (args.et * args.ep):
+            raise SystemExit(
+                f'--mg-devices lists {dies} dies, which the expert grid cannot tile: '
+                f'--et {args.et} * --ep {args.ep} must divide it'
+            )
+    text = _checkpoint_text_config(args)
+    if not text:
+        return
+    heads = text.get('num_attention_heads')
+    groups = text.get('num_key_value_heads') or text.get('num_query_groups')
+    if heads and groups and heads % groups == 0:
+        if groups < args.tp:
+            lanes = args.tp // groups
+            if args.tp % groups or (heads // groups) % lanes:
+                raise SystemExit(
+                    f'--tp {args.tp} cannot slice {heads} q heads over {groups} kv heads: '
+                    f'{heads // groups} heads are shared by {lanes} ranks, i.e. '
+                    f'{heads // groups} / {lanes} heads each. MCore truncates that to an '
+                    f'integer instead of raising, so the model would build and answer wrongly.'
+                )
+        elif heads % args.tp or groups % args.tp:
+            raise SystemExit(
+                f'--tp {args.tp} must divide both {heads} q heads and {groups} kv heads'
+            )
+    experts = text.get('num_experts')
+    if experts:
+        if experts % args.ep:
+            raise SystemExit(f'--ep {args.ep} must divide the {experts} experts')
+        if experts // args.ep > 128:
+            raise SystemExit(
+                f'--ep {args.ep} leaves {experts // args.ep} experts on each rank; MindSpeed\'s '
+                f'grouped GEMM caps its weight list at 128, and the bridge has no '
+                f'non-grouped fallback'
+            )
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument('--stage', choices=(*PHASES, 'all'), default='all')
+    parser.add_argument('--work-dir', default='/tmp/q4_align')
+    parser.add_argument('--ckpt', default=DEFAULT_CKPT, help='checkpoint dir (or $QWEN4_EXP_CKPT)')
+    parser.add_argument('--data', default=DEFAULT_DATA, help='text SFT jsonl (or $QWEN4_EXP_DATA)')
+    # Multimodal mode: a parquet of SFT conversations whose images sit in an
+    # `images` column (what the SFT data path reads) instead of the text jsonl.
+    parser.add_argument('--mm-parquet', default=None, help='run the VL model on this parquet (e.g. pokemon)')
+    parser.add_argument('--mm-index', type=int, default=0, help='first row of --mm-parquet to use')
+    # More than one row = more than one sample in the packed stream, and
+    # --mm-merge > 1 fuses consecutive rows into one conversation, i.e. an
+    # image per turn: a multi-image sample (see the module docstring).
+    parser.add_argument('--mm-rows', type=int, default=1, help='how many rows of --mm-parquet to use')
+    parser.add_argument('--mm-merge', type=int, default=1, help='how many rows become one (multi-image) sample')
+    parser.add_argument('--seq-len', type=int, default=512)
+    # Eager attention keeps the reference on plain matmul + softmax; sdpa fuses
+    # them, which moves the reference's own last bits around.
+    parser.add_argument('--attn', default='eager')
+    # The megatron phase needs `tp * ep` ranks, one per die, and the experts must
+    # be spread over at least four of them: MindSpeed's grouped GEMM takes one
+    # weight tensor per local expert and its kernel caps that list at 128, so 512
+    # experts on a single die cannot run grouped (the bridge has no mapping for
+    # the sequential fallback either). EP=4 leaves exactly 128 per rank.
+    parser.add_argument('--tp', type=int, default=1)
+    parser.add_argument('--ep', type=int, default=4)
+    # Expert tensor parallelism: how many ways an expert's *ffn* axis is split. 1 holds
+    # every expert whole (the HF layout) and 1 is what this harness compares against;
+    # it is an argument only because `_init_dist` has to build the group with it.
+    parser.add_argument('--et', type=int, default=1)
+    # Context parallelism: > 1 runs the megatron phase on the undivided batch the
+    # SFT path hands its CP runs (`relax/backends/megatron/data.py`) and joins the
+    # per-rank zigzag chunks back into one sequence before comparing (`_cp_inputs`
+    # / `_assemble_cp_chunks`). Text batches only -- the VL batch's split happens
+    # after the vision merge, which this harness does not reproduce yet.
+    parser.add_argument('--cp', type=int, default=1)
+    parser.add_argument('--hf-device', default='12')
+    parser.add_argument('--mg-devices', default='12,13,14,15')
+    # Drop the `logits` dump from both sides. It is `[T, vocab]` in float32 --
+    # 33 GB at `--seq-len 32768` -- which fits neither the reference die (64 GB,
+    # already holding the weights and the model's own bf16 logits) nor the work
+    # dir. Every hidden state is still compared; the loss / KL / argmax summary
+    # is not, and the compare phase says so.
+    parser.add_argument('--no-logits', action='store_true')
+    # Adds three per-layer intermediates (see INNER_PREFIXES) to both dumps, so a
+    # mismatch can be attributed to the hyper-connection, the attention or the
+    # MoE instead of only to "the layer".
+    parser.add_argument('--capture-inner', action='store_true')
+    # Multimodal control run: hand the text tower the reference's merged embedding
+    # and positions instead of letting the port produce them, so the tower is
+    # compared on identical input. Use it when `vision`/`merged` mismatch and you
+    # need to know whether the text half is still aligned.
+    parser.add_argument('--feed-hf-merged', action='store_true')
+    # rms|delta|/rms|ref| -- the gross-error bar for a bf16 row, see compare().
+    # 5% is deliberately loose: the audited bf16 rounding of the port's chunked
+    # gated-delta-net kernel against the reference's eager one is worth 8e-3 at
+    # layer0 on this stack, and the residual stream amplifies it to 2.7e-2 by
+    # `final`; a bar below that would only be measuring the amplification. What a
+    # wrong norm, mask or router costs is orders past this, and the loss/KL bars
+    # below are the ones that would catch a subtle one.
+    parser.add_argument('--rtol', type=float, default=0.05)
+    parser.add_argument('--min-cos', type=float, default=0.999)
+    # The functional bars (see _functional_agreement): what the two models'
+    # distributions are allowed to differ by. Measured on the math batch: loss rel
+    # 4.9e-5, KL 2.5e-4 nats/token; on the pokemon batch: 1.2e-4 and 4.0e-4.
+    parser.add_argument('--loss-rtol', type=float, default=1e-3)
+    parser.add_argument('--kl-max', type=float, default=1e-2)
+    # Inherited rows (see the module docstring) are only checked for structure.
+    parser.add_argument('--min-cos-inherited', type=float, default=0.99)
+    # The vision tower is compared in fp32 (see the module docstring), which is
+    # a different regime from the bf16 rows and gets its own tolerances.
+    parser.add_argument('--vision-rtol', type=float, default=1e-3)
+    parser.add_argument('--vision-min-cos', type=float, default=0.9999)
+    args = parser.parse_args()
+
+    if args.no_logits and args.mm_parquet:
+        # The tower-only call cannot take the multimodal kwargs the wrapper
+        # passes, and the long-sequence case this flag exists for is text.
+        raise SystemExit('--no-logits is wired for a text batch (no --mm-parquet)')
+
+    os.makedirs(args.work_dir, exist_ok=True)
+    # The `compare` phase reads dumps the layout already produced, and `hf` builds no
+    # megatron model at all; only the phases that run `run_megatron` need it to hold.
+    if args.stage in ('megatron', 'all'):
+        _check_parallel_layout(args)
+
+    if args.stage == 'all':
+        for phase, device in (('hf', args.hf_device), ('megatron', args.mg_devices)):
+            code = _spawn(phase, args, device)
+            if code != 0:
+                print(f'[driver] phase {phase} exited with {code}; stopping')
+                return code
+        return compare(args)
+    if args.stage in ('hf', 'megatron'):
+        # Each phase runs in its own process: `hf` so the reference model is
+        # released before the port is built, `megatron` because it needs `tp * ep`
+        # ranks. A single phase therefore spawns too -- which is what lets
+        # `--stage megatron --feed-hf-merged` reuse an existing hf dump.
+        if _spawned():
+            (run_hf if args.stage == 'hf' else run_megatron)(args)
+            return 0
+        return _spawn(args.stage, args, args.hf_device if args.stage == 'hf' else args.mg_devices)
+    return compare(args)
+
+
+if __name__ == '__main__':
+    sys.exit(main())
