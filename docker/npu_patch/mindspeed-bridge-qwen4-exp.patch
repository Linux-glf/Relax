+# --------------------------------------------------------------------------------------
+# 2. the derived index buffers against the checkpoint's
+# --------------------------------------------------------------------------------------
+def test_checkpoint_tensors(checkpoint: Optional[str] = None, with_table: bool = False) -> bool:
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.ple import (
+        _read_safetensors_header,  # pylint: disable=protected-access
+        Qwen4ExpTextNGramEmbedding,
+    )
+
+    path = next(
+        (
+            candidate
+            for candidate in (checkpoint,) + tuple(os.environ.get(n) for n in CKPT_ENV_VARS)
+            if candidate and os.path.isdir(candidate)
+        ),
+        None,
+    )
+    if path is None:
+        print(f'    [SKIP] no checkpoint: pass --checkpoint or set {" or ".join(CKPT_ENV_VARS)}')
+        return True
+
+    with open(os.path.join(path, 'config.json'), 'r', encoding='utf-8') as handle:
+        config = json.load(handle)
+    text_config = config.get('text_config', config)
+    print(f'    [info] {path}: ple_layer_ids={text_config.get("ple_layer_ids")}')
+    # The table directory is what the module reads its shards from, and it is the
+    # checkpoint's own directory -- the bridge fills the same field from the
+    # checkpoint it converts.
+    module = Qwen4ExpTextNGramEmbedding(SimpleNamespace(ple_table_dir=path, **text_config), 0)
+
+    index_path = os.path.join(path, 'model.safetensors.index.json')
+    if os.path.isfile(index_path):
+        with open(index_path, 'r', encoding='utf-8') as handle:
+            weight_map = json.load(handle)['weight_map']
+    else:
+        weight_map = {name: name for name in os.listdir(path) if name.endswith('.safetensors')}
+
+    from safetensors import safe_open
+
+    ok = True
+    stored = {}
+    for key in _metadata_keys():
+        with safe_open(os.path.join(path, weight_map[key]), framework='pt', device='cpu') as handle:
+            stored[key] = handle.get_tensor(key)
+    for attribute, key in zip(
+        ('layer_multipliers', 'ngram_heads_vocab_sizes', 'ngram_heads_offsets'), _metadata_keys()
+    ):
+        derived = getattr(module, attribute)
+        ok &= _check(
+            torch.equal(derived, stored[key]),
+            f'{attribute} derived from the config == the checkpoint',
+            f'derived[:4]={derived.tolist()[:4]} stored[:4]={stored[key].tolist()[:4]}',
+        )
+    sizes, offsets = stored[_metadata_keys()[1]], stored[_metadata_keys()[2]]
+    ok &= _check(
+        module.total_vocab_size == int(sizes.sum()) == int(offsets[-1]) + int(sizes[-1]),
+        'the per-head vocabularies tile the table',
+        f'total={module.total_vocab_size}',
+    )
+    ok &= _check(
+        module.padded_vocab_size % module.split_ngram_parts == 0,
+        'the padded table divides into its shards',
+        f'padded={module.padded_vocab_size} splits={module.split_ngram_parts}',
+    )
+
+    if with_table:
+        header, _ = _read_safetensors_header(os.path.join(path, weight_map[_shard_key(0)]))
+        rows_per_shard = header[_shard_key(0)]['shape'][0]
+        ok &= _check(
+            module.padded_vocab_size // module.split_ngram_parts == rows_per_shard,
+            'the derived rows per shard == the checkpoint shard height',
+            f'derived={module.padded_vocab_size // module.split_ngram_parts} stored={rows_per_shard}',
+        )
+        # One rank, one buffer: the table is loaded by the same call a conversion
+        # makes, and it is the module's own `weight` that is read back below.
+        module.load_table()
+        table = module.table
+        ok &= _check(module._table_loaded, 'the load marks the table loaded')
+        # The first, last and boundary rows of every shard: rows that no forward pass
+        # of a small batch would ever reach, and the only ones that can be wrong when
+        # the shard walk is off by one.
+        rows = module.padded_vocab_size
+        probes = [0, 1, rows_per_shard - 1, rows_per_shard, rows_per_shard + 1, rows - 1]
+        ids = torch.tensor(probes, dtype=torch.long).unsqueeze(-1).repeat(1, module.ngram_heads)
+        got = _lookup_table(table, module.weight, ids)
+        want = []
+        for row in probes:
+            shard, offset = row // rows_per_shard, row % rows_per_shard
+            file = os.path.join(path, weight_map[_shard_key(shard)])
+            with safe_open(file, framework='pt', device='cpu') as handle:
+                piece = handle.get_slice(_shard_key(shard))[offset : offset + 1]
+                # Older safetensors hand back the slice object, newer ones a tensor.
+                want.append(piece if torch.is_tensor(piece) else piece.get_tensor())
+        want = torch.cat(want).unsqueeze(1).repeat(1, module.ngram_heads, 1)
+        ok &= _check(
+            torch.equal(got, want),
+            f'the real {module.split_ngram_parts}-shard table reads back its boundary rows',
+            f'rows {probes[0]}..{probes[-1]}',
+        )
+    return ok
+
