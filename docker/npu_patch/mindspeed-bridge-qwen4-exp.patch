+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Replicated (tensor-parallel-independent) linear for ``qwen4_exp``.
+
+The hyper-connection mixers and the QSA indexer project ``hc_count * hidden_size``
+(or a head-sized slice) down to small widths that cannot be split across TP, so
+their weights are replicated on every TP rank -- exactly like the reference
+implementation's ``parallel_mode='duplicated'`` TE linears.
+
+A plain ``nn.Module`` is used instead of a TE/backend linear on purpose: it is
+dtype- and device-agnostic (works unchanged on Ascend), and it keeps the
+parameter names identical to the HF checkpoint (``<name>.weight``), which the
+bridge maps one-to-one.
+"""
+
+from __future__ import annotations
+
+import torch
+from megatron.core.transformer.module import MegatronModule
+from torch import nn
+
+
+class ReplicatedLinear(MegatronModule):
+    """``y = x @ weight.T`` with a weight replicated across tensor-parallel ranks.
+
+    Args:
+        config: Transformer config; supplies dtype, ``sequence_parallel`` and the
+            default initializer.
+        input_size: Input feature dim.
+        output_size: Output feature dim.
+        bias: Whether to add a bias term.
+        skip_bias_add: When True, ``forward`` returns ``(output, bias)`` instead
+            of folding the bias in, matching the mcore linear convention.
+        init_method: Override for the initializer; defaults to ``config.init_method``.
+        sequence_parallel: Force the SP grad-sync flag; defaults to the config.
+    """
+
+    def __init__(
+        self,
+        config,
+        input_size: int,
+        output_size: int,
+        bias: bool = False,
+        skip_bias_add: bool = True,
+        init_method=None,
+        sequence_parallel: bool = None,
+    ):
+        super().__init__(config)
+        self.input_size = input_size
+        self.output_size = output_size
+        self.skip_bias_add = skip_bias_add
+        self.sequence_parallel = config.sequence_parallel if sequence_parallel is None else sequence_parallel
+
+        init_method = init_method if init_method is not None else config.init_method
+        self.weight = nn.Parameter(
+            torch.empty(
+                self.output_size, self.input_size, device=torch.cuda.current_device(), dtype=config.params_dtype
+            )
+        )
+        init_method(self.weight)
+        setattr(self.weight, 'sequence_parallel', self.sequence_parallel)
+
+        self.bias = None
+        if bias:
+            self.bias = nn.Parameter(
+                torch.empty(self.output_size, device=torch.cuda.current_device(), dtype=config.params_dtype)
+            )
+            setattr(self.bias, 'sequence_parallel', self.sequence_parallel)
+            if config.perform_initialization:
+                with torch.no_grad():
+                    self.bias.zero_()
+
+    def forward(self, x: torch.Tensor):
+        out = torch.matmul(x, self.weight.t())
+        if self.bias is not None and not self.skip_bias_add:
+            out = out + self.bias
+        if self.skip_bias_add:
+            return out, self.bias
+        return out
+
+
+def build_replicated_linear(spec, config, input_size: int, output_size: int, **kwargs) -> ReplicatedLinear:
+    """``build_module``-style factory so specs can name this class directly."""
+    if spec is None:
+        return None
+    if isinstance(spec, type) and issubclass(spec, ReplicatedLinear):
+        return spec(config, input_size, output_size, **kwargs)
+    # Anything else is assumed to be a mcore linear class (TE/backend) that takes
+    # (input_size, output_size, config=..., ...) -- kept for spec reuse.
+    return spec(input_size, output_size, config=config, **kwargs)
