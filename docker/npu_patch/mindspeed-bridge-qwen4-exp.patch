@@ -0,0 +1,340 @@
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Multi-token-prediction head for Qwen3.8-Flash-Next (``qwen4_exp``).
+
+The checkpoint stores a single MTP depth whose head is Qwen3.8-Flash-Next's own
+``residual_linear_shared``: the rolled-token embedding is projected to ``H`` and
+added to *every* one of the backbone's ``hc_count`` hyper-connection streams,
+which are then normalized jointly with the fused hidden projection. Megatron's
+stock MTP instead concatenates embedding and hidden states into a fused
+``eh_proj`` (``2H -> H``); the two are mathematically different, so the stock
+``_concat_embeddings`` / ``_postprocess`` are replaced here, the same way the
+reference implementation does it.
+
+Two further differences from stock MTP matter for numerics:
+
+* the MTP layer is always a **full-attention** layer (it carries a QSA indexer),
+  so ``_resolve_is_linear_attention`` is pinned to False;
+* the MTP depth sees token ``i + k``, so the per-token rotary frequencies are
+  rolled by ``-layer_number`` before the inner layer runs -- stock Megatron rolls
+  ``input_ids``/``position_ids`` for the embedding but hands the unrolled rotary
+  to the attention, which silently misaligns RoPE for multimodal-rope models.
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+import torch
+
+from megatron.core.packed_seq_params import PackedSeqParams
+from megatron.core.tensor_parallel import (
+    ColumnParallelLinear,
+    gather_from_tensor_model_parallel_region,
+    scatter_to_sequence_parallel_region,
+)
+from megatron.core.transformer.multi_token_prediction import (
+    MultiTokenPredictionBlock,
+    MultiTokenPredictionLayer,
+    get_mtp_layer_offset,
+)
+from megatron.core.utils import make_viewless_tensor
+
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.hyper_connection import (
+    Qwen4ExpTextGatedResidual,
+)
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.layer import Qwen4ExpLayer
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.norms import Qwen4ExpTextRMSNorm
+
+
+class Qwen4ExpMTPEmbeddingNorm(Qwen4ExpTextRMSNorm):
+    """``pre_fc_norm_embedding``: zero-centered RMSNorm over the embedding width.
+
+    Adapter for Megatron's norm builder, which instantiates norms as
+    ``(config, hidden_size, eps)``.
+    """
+
+    def __init__(self, config, hidden_size: int, eps: float = 1e-6, **kwargs):
+        super().__init__(hidden_size, eps=eps, dtype=config.params_dtype, sequence_parallel=config.sequence_parallel)
+
+
+class Qwen4ExpMTPStreamNorm(Qwen4ExpTextRMSNorm):
+    """``pre_fc_norm_hidden``: zero-centered RMSNorm over the whole multi-stream.
+
+    Unlike Megatron's mHC MTP, which normalizes each ``H``-wide stream on its own,
+    Qwen3.8-Flash-Next normalizes the concatenated ``hc_count * hidden_size``
+    features jointly (a single affine over all of them). The builder only knows
+    ``hidden_size``, so the width is scaled here.
+    """
+
+    def __init__(self, config, hidden_size: int, eps: float = 1e-6, **kwargs):
+        super().__init__(
+            config.hc_count * hidden_size,
+            eps=eps,
+            dtype=config.params_dtype,
+            sequence_parallel=config.sequence_parallel,
+        )
+
+
+class Qwen4ExpMTPInnerLayer(Qwen4ExpLayer):
+    """The decoder layer inside the MTP head: full attention, never GDN."""
+
+    def _resolve_is_linear_attention(self, config) -> bool:
+        return False
+
+
+class Qwen4ExpMultiTokenPredictionLayer(MultiTokenPredictionLayer):
+    """``residual_linear_shared`` MTP head over a gated-hyper-connection backbone."""
+
+    def __init__(self, config, submodules, *args, **kwargs):
+        super().__init__(config, submodules, *args, **kwargs)
+        hidden_size = self.config.hidden_size
+        # `fc_embedding` / `fc_hidden`, both H -> H and column parallel, replacing
+        # the fused `eh_proj` (whose spec is `IdentityOp`, so it holds no weight).
+        self.e_proj = ColumnParallelLinear(
+            hidden_size,
+            hidden_size,
+            config=self.config,
+            init_method=self.config.init_method,
+            gather_output=False,
+            bias=False,
+            skip_bias_add=True,
+            is_expert=False,
+        )
+        self.h_proj = ColumnParallelLinear(
+            hidden_size,
+            hidden_size,
+            config=self.config,
+            init_method=self.config.init_method,
+            gather_output=False,
+            bias=False,
+            skip_bias_add=True,
+            is_expert=False,
+        )
+        # Contraction of the MTP head's own multi-stream; this architecture has no
+        # final layernorm here either.
+        self.hyper_connection_mixer = Qwen4ExpTextGatedResidual(config, use_combine=False)
+
+    def _concat_embeddings(self, hidden_states: torch.Tensor, decoder_input: torch.Tensor):
+        n = self.config.hc_count
+        h = self.config.hidden_size
+
+        # Per-path detach (`--mtp-detach-paths`). The current MCore only knows the
+        # single `mtp_detach_heads` bool, which `configure_mtp_detach_paths` sets only
+        # when all three paths are selected; honoring the two per-path flags here
+        # makes partial selections behave like the Megatron patch the GPU stack
+        # applies (embedding/backbone cut before the norms, so the MTP loss still
+        # trains the norm and projection parameters but not the embedding rows or
+        # the backbone). Defaults to False, i.e. the joint behavior this layer had
+        # before the flags existed.
+        if getattr(self.config, "mtp_detach_embedding", False):
+            decoder_input = decoder_input.detach()
+        if getattr(self.config, "mtp_detach_backbone", False):
+            hidden_states = hidden_states.detach()
+
+        decoder_input = self.enorm(decoder_input)
+        decoder_input = make_viewless_tensor(inp=decoder_input, requires_grad=True, keep_graph=True)
+        # The multi-stream is normalized jointly, so `hnorm` covers n * H.
+        hidden_states = self.hnorm(hidden_states)
+        hidden_states = make_viewless_tensor(inp=hidden_states, requires_grad=True, keep_graph=True)
+        s, b, _ = hidden_states.shape
+        # The projections are TP linears, and mcore's non-fused backward only
+        # reshapes a *3-D* grad output to 2-D before `grad_output.t()`
+        # (`prepare_input_tensors_for_wgrad_compute`), so the streams cannot ride
+        # along as a fourth dimension: they travel as extra rows of the batch dim
+        # and are folded back into the width after the projection.
+        hidden_states = hidden_states.reshape(s, b * n, h)
+
+        e_out, _ = self.e_proj(decoder_input)  # [s', b, h/tp]
+        h_out, _ = self.h_proj(hidden_states)  # [s', b*n, h/tp]
+        # `s'` is the sequence the column-parallel projections gathered under SP.
+        h_out = h_out.reshape(h_out.shape[0], b, n, h_out.shape[-1])
+        out = e_out.unsqueeze(2) + h_out  # the embedding residual reaches every stream
+        out = gather_from_tensor_model_parallel_region(out)
+        # Read the shape after the gather: under sequence parallelism the
+        # column-parallel projections all-gather the sequence dim, so a width
+        # captured before the projection would be stale.
+        s, b, n_out, h_dim = out.shape
+        out = out.reshape(s, b, n_out * h_dim)
+        if self.sequence_parallel:
+            out = scatter_to_sequence_parallel_region(out)
+        return out
+
+    def _postprocess(self, hidden_states: torch.Tensor):
+        """Contract the multi-stream -- this head has no final layernorm either."""
+        return self.hyper_connection_mixer(hidden_states)
+
+    def _proj_and_transformer_layer(
+        self,
+        hidden_states: torch.Tensor,
+        decoder_input: torch.Tensor,
+        attention_mask: Optional[torch.Tensor] = None,
+        # Signature mirrors ``MultiTokenPredictionLayer``'s, including the three
+        # parameters this override has no opinion about: the base method is called
+        # from the layer's ``forward``, which passes all of them by name, so a
+        # narrower signature raises ``TypeError: unexpected keyword argument``
+        # whichever of them the caller happens to supply first.
+        padding_mask: Optional[torch.Tensor] = None,
+        context: Optional[torch.Tensor] = None,
+        context_mask: Optional[torch.Tensor] = None,
+        rotary_pos_emb: Optional[torch.Tensor] = None,
+        rotary_pos_cos: Optional[torch.Tensor] = None,
+        rotary_pos_sin: Optional[torch.Tensor] = None,
+        attention_bias: Optional[torch.Tensor] = None,
+        inference_params: Optional[object] = None,
+        packed_seq_params: Optional[PackedSeqParams] = None,
+        sequence_len_offset: Optional[torch.Tensor] = None,
+        packed_seq_params_by_layout: Optional[dict] = None,
+        cp_layout_plan: Optional[object] = None,
+    ) -> torch.Tensor:
+        rotary_pos_emb = self._roll_rotary_pos_emb(rotary_pos_emb)
+        return super()._proj_and_transformer_layer(
+            hidden_states=hidden_states,
+            decoder_input=decoder_input,
+            attention_mask=attention_mask,
+            padding_mask=padding_mask,
+            context=context,
+            context_mask=context_mask,
+            rotary_pos_emb=rotary_pos_emb,
+            rotary_pos_cos=rotary_pos_cos,
+            rotary_pos_sin=rotary_pos_sin,
+            attention_bias=attention_bias,
+            inference_params=inference_params,
+            packed_seq_params=packed_seq_params,
+            sequence_len_offset=sequence_len_offset,
+            packed_seq_params_by_layout=packed_seq_params_by_layout,
+            cp_layout_plan=cp_layout_plan,
+        )
+
+    def _roll_rotary_pos_emb(self, rotary_pos_emb):
+        """Shift the rotary frequencies one token per MTP depth.
+
+        ``-layer_number`` because the k-th depth predicts token ``i + k`` from the
+        state of token ``i``: token ``i``'s key is compared against the query at
+        position ``i + k``. The inner layer's RoPE has to be built from those
+        positions, and rolling the per-token frequencies is the same thing.
+        """
+        if rotary_pos_emb is None:
+            return None
+        if getattr(self.config, 'apply_rope_fusion', False):
+            # Fused RoPE hands over a raw frequency table rather than per-token
+            # frequencies, which cannot be shifted by a roll.
+            raise NotImplementedError(
+                'MTP with gated hyper-connections needs per-token rotary frequencies to shift them '
+                'by the MTP depth; run with --apply-rope-fusion false (also required by the QSA '
+                'sparse selection under packing).'
+            )
+        shifts = -self.layer_number
+        if isinstance(rotary_pos_emb, dict):
+            return {key: torch.roll(value, shifts=shifts, dims=0) for key, value in rotary_pos_emb.items()}
+        return torch.roll(rotary_pos_emb, shifts=shifts, dims=0)
+
+
+class Qwen4ExpMultiTokenPredictionBlock(MultiTokenPredictionBlock):
+    """MTP block fed with the backbone's *pre*-contraction multi-stream.
+
+    The backbone contracts its ``hc_count`` streams on the way out (see
+    ``block.py``), because that is what the output layer consumes, but the MTP
+    layers need the un-contracted tensor. ``Qwen4ExpModel._postprocess`` hands it
+    over as ``mtp_multistream``; the layers then run on it while the *first* chunk
+    of the block output -- the one ``process_mtp_loss`` sends to the output layer
+    -- stays the contracted ``[s, b, hidden]`` tensor.
+    """
+
+    def forward(
+        self,
+        input_ids: torch.Tensor,
+        position_ids: torch.Tensor,
+        hidden_states: torch.Tensor,
+        attention_mask: torch.Tensor,
+        # This tree's ``MultiTokenPredictionBlock`` carries ``padding_mask`` and
+        # ``mtp_input_mask`` and threads both through each depth: the layer rolls
+        # the mask alongside ``input_ids`` and hands the rolled copy back, so
+        # depth N+1 is conditioned on the mask depth N produced. Omitting the two
+        # parameters is not a no-op -- ``GPTModel._postprocess`` passes
+        # ``padding_mask`` by name, so the call raises ``TypeError`` before any
+        # layer runs.
+        padding_mask: Optional[torch.Tensor] = None,
+        mtp_input_mask: Optional[torch.Tensor] = None,
+        context: Optional[torch.Tensor] = None,
+        context_mask: Optional[torch.Tensor] = None,
+        rotary_pos_emb: Optional[torch.Tensor] = None,
+        rotary_pos_cos: Optional[torch.Tensor] = None,
+        rotary_pos_sin: Optional[torch.Tensor] = None,
+        attention_bias: Optional[torch.Tensor] = None,
+        inference_params: Optional[object] = None,
+        packed_seq_params: Optional[PackedSeqParams] = None,
+        sequence_len_offset: Optional[torch.Tensor] = None,
+        extra_block_kwargs: Optional[dict] = None,
+        embedding=None,
+        mtp_multistream: Optional[torch.Tensor] = None,
+    ) -> torch.Tensor:
+        if mtp_multistream is None:
+            return super().forward(
+                input_ids=input_ids,
+                position_ids=position_ids,
+                hidden_states=hidden_states,
+                attention_mask=attention_mask,
+                padding_mask=padding_mask,
+                mtp_input_mask=mtp_input_mask,
+                context=context,
+                context_mask=context_mask,
+                rotary_pos_emb=rotary_pos_emb,
+                rotary_pos_cos=rotary_pos_cos,
+                rotary_pos_sin=rotary_pos_sin,
+                attention_bias=attention_bias,
+                inference_params=inference_params,
+                packed_seq_params=packed_seq_params,
+                sequence_len_offset=sequence_len_offset,
+                extra_block_kwargs=extra_block_kwargs,
+                embedding=embedding,
+            )
+
+        # The loop below is `MultiTokenPredictionBlock.forward`, with the cat
+        # rebuilt around the contracted tensors. The stock code keeps the tensor
+        # it was handed as the first entry of `hidden_states_list` and cats the
+        # layer outputs onto it, which only works while every entry has the same
+        # width -- here that first entry is the *multi-stream* (`hc_count` times
+        # wider) while the layers contract, so `torch.cat` inside the stock
+        # implementation would be handed 10240- and 2560-wide tensors.
+        # `process_mtp_loss` wants `[backbone hidden ; depth-1 hidden ; ...]` in
+        # the contracted width, so the backbone's contracted hidden states take
+        # the first slot and the multi-stream only feeds the layers.
+        offset = get_mtp_layer_offset(self.config, self.vp_stage)
+        assert offset == 0, (
+            f"the qwen4_exp MTP head only runs on the last stage, got vp offset {offset}: "
+            "the multi-stream hand-off assumes the head sees no previous MTP stages."
+        )
+        hidden_states_list = [hidden_states]
+        current = mtp_multistream
+        # `mtp_multistream` is delivered through `extra_block_kwargs` (see
+        # `Qwen4ExpModel._postprocess`), so it is still in the dict here. The
+        # block has already consumed it into `current`, and the layer's signature
+        # has no such parameter, so expanding the dict unmodified raises
+        # `TypeError: ... unexpected keyword argument 'mtp_multistream'`.
+        layer_extra_kwargs = {
+            key: value for key, value in (extra_block_kwargs or {}).items() if key != 'mtp_multistream'
+        }
+        for layer_number in range(len(self.layers)):
+            # Five values, not three: this tree's `MultiTokenPredictionLayer`
+            # returns the rolled `padding_mask`/`mtp_input_mask` so the next depth
+            # sees them already shifted alongside `input_ids`.
+            (current, input_ids, position_ids, padding_mask, mtp_input_mask) = self.layers[layer_number](
+                input_ids=input_ids,
+                position_ids=position_ids,
+                hidden_states=current,
+                attention_mask=attention_mask,
+                padding_mask=padding_mask,
+                mtp_input_mask=mtp_input_mask,
+                inference_params=inference_params,
+                rotary_pos_emb=rotary_pos_emb,
+                rotary_pos_cos=rotary_pos_cos,
+                rotary_pos_sin=rotary_pos_sin,
+                packed_seq_params=packed_seq_params,
+                sequence_len_offset=sequence_len_offset,
+                embedding=embedding,
+                **layer_extra_kwargs,
+            )
+            hidden_states_list.append(current)
+        return torch.cat(hidden_states_list, dim=0)
