+        print(f'bool mask -> delegated to wrapped core_attention: {delegated!r}, calls={stub.calls}')
+        no_mask = shim(q, k, v, None)
+        print(f'None mask -> delegated: {no_mask!r}')
+        ok &= delegated == 'delegated' and no_mask == 'delegated'
+    except Exception:
+        print('shim RAISED:')
