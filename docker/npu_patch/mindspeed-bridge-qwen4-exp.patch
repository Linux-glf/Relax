+
+def _hf_indexer_config(cfg):
+    """A transformers config carrying the QSA fields.
+
+    The real ``Qwen4ExpTextConfig`` is used when it accepts these values; a plain
+    attribute stub is the fallback, because the surrounding model fields it validates
+    (expert counts, hyper-connection streams) have nothing to do with the indexer, which
+    only reads the six QSA/rope attributes assigned here either way.
+    """
+    try:
+        from transformers.models.qwen4_exp.configuration_qwen4_exp import Qwen4ExpTextConfig
+
+        return Qwen4ExpTextConfig(
+            hidden_size=cfg.hidden_size,
+            num_attention_heads=8,
+            num_key_value_heads=2,
+            head_dim=16,
+            indexer_n_heads=cfg.indexer_n_heads,
+            indexer_kv_heads=cfg.indexer_kv_heads,
+            indexer_head_dim=cfg.indexer_head_dim,
+            indexer_budget=cfg.indexer_budget,
+            indexer_compress_ratio=cfg.indexer_compress_ratio,
+            rms_norm_eps=cfg.layernorm_epsilon,
+            hc_count=4,
+            num_experts=4,
+            num_experts_per_tok=2,
+            moe_intermediate_size=64,
+            shared_expert_intermediate_size=64,
+        ), 'Qwen4ExpTextConfig'
+    except Exception as exc:
+
+        class _HFConfigStub:
+            hidden_size = cfg.hidden_size
+            indexer_n_heads = cfg.indexer_n_heads
+            indexer_kv_heads = cfg.indexer_kv_heads
+            indexer_head_dim = cfg.indexer_head_dim
+            indexer_budget = cfg.indexer_budget
+            indexer_compress_ratio = cfg.indexer_compress_ratio
+            rms_norm_eps = cfg.layernorm_epsilon
+
+        return _HFConfigStub, f'attribute stub ({type(exc).__name__})'
+
+
+def _hf_indexer_reference_keys(cfg, indexer, hidden, freqs, mscale, rot, s, b):
+    """Run the transformers ``Qwen4ExpTextQSAIndexer`` on the same weights/inputs.
+
+    Returns ``(keys_per_sample_query, description)``.
+    """
+    from transformers.models.qwen4_exp.modeling_qwen4_exp import Qwen4ExpTextQSAIndexer
+
+    hf_config, config_kind = _hf_indexer_config(cfg)
+    hf = Qwen4ExpTextQSAIndexer(hf_config, layer_idx=0)
+    with torch.no_grad():
+        hf.index_qk_proj.weight.copy_(indexer.index_qk_proj.weight.detach())
+        hf.q_layernorm.weight.copy_(indexer.q_layernorm.weight.detach())
+        hf.k_layernorm.weight.copy_(indexer.k_layernorm.weight.detach())
+
+    # HF consumes cos/sin (the model's position_embeddings), not angles.
+    angle = freqs[:s, 0, 0]  # [s, rot]
+    cos = (torch.cos(angle) * mscale).unsqueeze(0).expand(b, s, rot).contiguous()
+    sin = (torch.sin(angle) * mscale).unsqueeze(0).expand(b, s, rot).contiguous()
+    # Causal visibility, True == visible (HF's convention, the opposite of our mask).
+    visible = torch.tril(torch.ones(s, s, dtype=torch.bool)).unsqueeze(0).unsqueeze(0).expand(b, 1, s, s)
+
+    hf_hidden = hidden.permute(1, 0, 2).contiguous()  # [b, s, h]
+    with torch.no_grad():
+        # (hidden_states, (cos, sin), attention_mask, past_key_values)
+        selected = hf(hf_hidden, (cos, sin), visible, None)
+    # selected: [b, 1, s, s] bool, True == selected.
+    keys = []
+    for sample in range(selected.shape[0]):
+        rows = []
+        for query in range(selected.shape[2]):
+            rows.append(set(torch.nonzero(selected[sample, 0, query], as_tuple=False).flatten().tolist()))
+        keys.append(rows)
+    return keys, f'transformers Qwen4ExpTextQSAIndexer (config: {config_kind})'
+
+
+def test_selection_cpu_reference() -> bool:
+    print()
+    print('== test 2: CPU reference (mask vs indices vs HF) ==')
+
+    # (s, b, budget, rot, attention_scaling) -- the first is the no-op case: with
+    # s=64/R=4 there are 16 candidate blocks and block_topk=16, so selection is a no-op.
+    cases = [
+        dict(s=64, b=2, budget=64, rot=8, mscale=1.0, expect_none=True),
+        dict(s=64, b=2, budget=16, rot=8, mscale=1.0, expect_none=False),
+        dict(s=256, b=2, budget=64, rot=8, mscale=1.0, expect_none=False),
+        dict(s=64, b=2, budget=16, rot=8, mscale=2.0, expect_none=False),
+    ]
+    ok = True
+    for case in cases:
+        cfg = QSAIndexerTestConfig(indexer_budget=case['budget'], attention_scaling=case['mscale'])
+        s, b, rot = case['s'], case['b'], case['rot']
+        indexer = _build_indexer(cfg)
+        hidden, freqs = _build_hidden_freqs(cfg, s, b, rot)
+        print(
+            f'-- s={s} b={b} budget={case["budget"]} R={cfg.indexer_compress_ratio} '
+            f'block_topk={cfg.indexer_budget // cfg.indexer_compress_ratio} rot={rot} mscale={case["mscale"]}'
+        )
+
+        mask_out = indexer.selection_as_mask(hidden, freqs)
+        idx = indexer.selection_as_token_indices(hidden, freqs)
+        if case['expect_none']:
+            no_op = mask_out is None and idx is None
+            print(
+                f'   selection_as_mask -> {type(mask_out).__name__}, '
+                f'selection_as_token_indices -> {type(idx).__name__} (no-op expected: {no_op})'
+            )
+            ok &= no_op
+            continue
+
+        print(f'   selection_as_mask -> {tuple(mask_out.shape)} bool, blocked={int(mask_out.sum())}')
+        print(f'   selection_as_token_indices -> {tuple(idx.shape)} {idx.dtype}, unused slots={int((idx < 0).sum())}')
+
+        mask_keys = _allowed_keys_from_mask(mask_out)
+        idx_keys = _allowed_keys_from_indices(idx)
+        diffs = _diff_key_sets(mask_keys, idx_keys)
+        row_sizes = [len(r) for r in idx_keys[0]]
+        print(
+            f'   key-set agreement mask vs indices: {"OK" if not diffs else f"MISMATCH {diffs}"} '
+            f'(batch0 row key counts: min={min(row_sizes)} max={max(row_sizes)} of {s})'
+        )
+        causal_ok = all(all(k <= q for k in row) for sample in idx_keys for q, row in enumerate(sample))
+        print(f'   every selected index within its causal prefix: {causal_ok}')
+        ok &= (not diffs) and causal_ok
+
+        # Cross-check against the reference implementation of the selection.
+        try:
+            hf_keys, who = _hf_indexer_reference_keys(cfg, indexer, hidden, freqs, case['mscale'], rot, s, b)
+        except Exception as exc:  # pragma: no cover - depends on the installed transformers
+            print(f'   HF cross-check unavailable ({type(exc).__name__}: {exc}); falling back to the row-wise oracle')
+            hf_keys, who = _rowwise_oracle_keys(cfg, indexer, hidden, freqs, case['mscale'], rot, s, b)
+        diffs = _diff_key_sets(mask_keys, hf_keys)
+        print(f'   key-set agreement mask vs {who}: {"OK" if not diffs else f"MISMATCH {diffs}"}')
+        ok &= not diffs
+    print(f'test 2: {"PASS" if ok else "FAIL"}')
+    return ok
+
+
+def _rowwise_oracle_keys(cfg, indexer, hidden, freqs, mscale, rot, s, b):
+    """Fallback oracle: the documented QSA selection, written out row by row.
+
+    Same formula as the reference indexer (pool every complete visible block, score with
+    relu-sum, keep the top ``block_topk``, always keep the tail of the query's own block)
+    but implemented independently of the vectorised encoders under test.
+    """
+    R = cfg.indexer_compress_ratio
+    block_topk = cfg.indexer_budget // R
+    angle = freqs[:s, 0, 0]
+    cos = (torch.cos(angle) * mscale)[:, :rot]
+    sin = (torch.sin(angle) * mscale)[:, :rot]
+
+    def rotate(t, pos):
+        t_rope, t_pass = t[..., :rot], t[..., rot:]
+        c, sn = cos[pos], sin[pos]
+        half = t_rope.shape[-1] // 2
+        rot_half = torch.cat((-t_rope[..., half:], t_rope[..., :half]), dim=-1)
+        return torch.cat((t_rope * c + rot_half * sn, t_pass), dim=-1)
+
+    qk = indexer.index_qk_proj(hidden)[0]
+    q_all, k_all = torch.split(
+        qk, [cfg.indexer_n_heads * cfg.indexer_head_dim, cfg.indexer_kv_heads * cfg.indexer_head_dim], dim=-1
+    )
+    q_all = indexer.q_layernorm(q_all.view(s, b, cfg.indexer_n_heads, cfg.indexer_head_dim).permute(1, 0, 2, 3))
+    raw_keys = k_all.view(s, b, cfg.indexer_kv_heads, cfg.indexer_head_dim).permute(1, 0, 2, 3).squeeze(2)
+
+    keys = []
+    for sample in range(b):
+        rows = []
+        for query in range(s):
+            visible = torch.arange(query + 1)
+            n_blocks = visible.numel() // R
+            selected = []
+            if n_blocks > 0:
+                blocks = visible[: n_blocks * R].view(n_blocks, R)
+                pooled = raw_keys[sample].index_select(0, blocks.flatten()).view(n_blocks, R, -1)
+                pooled = indexer.k_layernorm(pooled.float().mean(dim=1))
+                block_keys = rotate(pooled, blocks[:, 0])
+                scores = torch.matmul(q_all[sample, query].float(), block_keys.float().transpose(-1, -2)).transpose(
+                    -1, -2
+                )
+                scores = torch.relu(scores).sum(dim=-1) / math.sqrt(cfg.indexer_head_dim)
+                top = scores.topk(min(block_topk, n_blocks), dim=0).indices
+                selected = blocks.index_select(0, top).flatten().tolist()
+            tail = visible[n_blocks * R :].tolist() if n_blocks * R <= query else []
+            rows.append(set(selected) | set(tail))
+        keys.append(rows)
+    return keys, 'row-wise oracle (documented QSA selection)'
+
+
+# --------------------------------------------------------------------------------------
+# test 3: NPU sparse kernel
+# --------------------------------------------------------------------------------------
+
+
+def _npu_available() -> bool:
+    try:
+        import torch_npu  # noqa: F401
+    except ImportError:
+        return False
+    return hasattr(torch, 'npu') and torch.npu.is_available()
+
+
+def _build_block_aligned_selection(T: int, keep_blocks: int, R: int, seed: int = 7):
+    """One selection per row, in both encodings: ``(token_indices, block_starts)``.
+
+    Rows are whole ``R``-token blocks plus the query's own causally truncated tail --
+    the shape contract the kernel relies on (see kernels/qsa_block_sparse_attn.py):
+    every row must be whole blocks, otherwise the block membership test over-attends.
+    ``block_starts`` is the same choice in the indexer's wire format (``[T, k+1]``
+    pack-space block starts, own block last).
+    """
+    g = torch.Generator().manual_seed(seed)
+    K = keep_blocks * R + R
+    indices = torch.full((T, K), -1, dtype=torch.int64)
+    starts = torch.full((T, keep_blocks + 1), -1, dtype=torch.int32)
+    for t in range(T):
+        n_blocks = (t + 1) // R
+        take = min(keep_blocks, n_blocks)
+        chosen = torch.randperm(n_blocks, generator=g)[:take] if n_blocks else torch.empty(0, dtype=torch.long)
+        top = []
+        for blk in chosen.tolist():
+            top.extend(range(blk * R, blk * R + R))
+        tail = list(range(n_blocks * R, t + 1))
+        row = (top + tail)[:K]
+        indices[t, : len(row)] = torch.tensor(row, dtype=torch.int64)
+        starts[t, :take] = torch.tensor([blk * R for blk in chosen.tolist()], dtype=torch.int32)
+        starts[t, -1] = n_blocks * R
+    return indices, starts
+
+
+def _build_block_aligned_indices(T: int, keep_blocks: int, R: int, seed: int = 7):
+    return _build_block_aligned_selection(T, keep_blocks, R, seed)[0]
+
+
+def _sparse_attention_reference(q, k, v, indices, scale):
+    """Per-row gather + softmax in fp32: each query attends exactly its index row."""
+    T, Hq, D = q.shape
+    S, Hkv, _ = k.shape
+    group = Hq // Hkv
+    qf, kf, vf = q.float().cpu(), k.float().cpu(), v.float().cpu()
+    indices = indices.cpu()
+    valid = indices >= 0
+    mask = torch.zeros(T, S, dtype=torch.bool)
+    rows = torch.arange(T).unsqueeze(1).expand_as(indices)
+    mask[rows[valid], indices[valid]] = True
+    empty = ~mask.any(dim=-1)
+    if empty.any():
+        raise AssertionError(
+            f'{int(empty.sum())} query rows have an empty selection; the softmax reference would be undefined.'
+        )
+    out = torch.zeros(T, Hq, D)
+    for h in range(Hq):
+        scores = torch.einsum('td,sd->ts', qf[:, h], kf[:, h // group]) * scale
+        scores = scores.masked_fill(~mask, float('-inf'))
+        probs = torch.softmax(scores, dim=-1)
+        out[:, h] = torch.einsum('ts,sd->td', probs, vf[:, h // group])
+    return out
+
+
+def _cosine(a: torch.Tensor, b: torch.Tensor) -> float:
+    # Both sides are brought to CPU: the kernel's tensors live on the accelerator, the
+    # autograd reference does not.
+    a, b = a.detach().flatten().float().cpu(), b.detach().flatten().float().cpu()
+    denom = a.norm() * b.norm()
+    return float((a @ b) / denom) if denom > 0 else float('nan')
+
+
+class _CoreAttentionStub(torch.nn.Module):
+    """Stands in for the wrapped ``core_attention``; records its calls."""
+
+    def __init__(self):
+        super().__init__()
+        self.calls = []
+
+    def forward(self, query, key, value, attention_mask, **kwargs):
+        self.calls.append(
+            {'mask_dtype': None if attention_mask is None else attention_mask.dtype, 'kwargs': sorted(kwargs)}
+        )
+        return 'delegated'
+
+
+def test_npu_sparse_kernel() -> bool:
+    print()
+    print('== test 3: NPU sparse kernel ==')
+    if not _npu_available():
+        print('torch.npu is not available -- SKIPPED')
+        return True
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.qsa import (
+        QSASparseCoreAttention,
+        qsa_sparse_attention_thd,
+    )
+
+    ok = True
+    T, Hq, Hkv, D, R = 512, 8, 2, 128, 4
+    budget_blocks = 16
+    device = torch.device('npu')
+    g = torch.Generator().manual_seed(11)
+    q = (torch.randn(T, Hq, D, generator=g, dtype=torch.float32) / D**0.5).to(torch.float16).to(device)
+    k = (torch.randn(T, Hkv, D, generator=g, dtype=torch.float32) / D**0.5).to(torch.float16).to(device)
+    v = torch.randn(T, Hkv, D, generator=g, dtype=torch.float32).to(torch.float16).to(device)
+    indices = _build_block_aligned_indices(T, budget_blocks, R).to(device)
+    scale = D**-0.5
+    print(
+        f'shape: T={T} Hq={Hq} Hkv={Hkv} D={D} block_size={R} budget_blocks={budget_blocks} '
