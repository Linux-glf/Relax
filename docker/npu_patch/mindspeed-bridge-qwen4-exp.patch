index 0000000..54c857f
--- /dev/null
+++ b/mindspeed_bridge/models/qwen4_exp/modelling_qwen4_exp/cp_split.py
@@ -0,0 +1,108 @@
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Context-parallel split of an *undivided* Qwen3.8-Flash-Next batch.
+
+Under CP > 1 Relax hands a VL batch to the model whole: ``input_ids`` is
+``[batch, seq]`` with one padded row per sample, ``attention_mask`` marks the
+valid tokens, and ``packed_seq_params`` carries the *global* per-sample
+boundaries (each sample padded to a multiple of ``tp * cp * 2`` --
+``relax/backends/megatron/data.py``). The model then owns the split, exactly
+like the bridge's ``Qwen3VLModel`` does through ``utils.preprocess_packed_seqs``:
+the vision embeddings have to be merged while the sequence is still whole, so
+the split happens after the merge rather than in the data loader.
+
+What comes out is the usual zigzag layout: for every sample the rank keeps its
+``cp_rank``-th chunk from the front and the mirrored chunk from the back
+(TransformerEngine's load balancing, see
+https://github.com/NVIDIA/TransformerEngine/issues/1368), the samples
+concatenated in order. The boundaries reported to the layers stay *global*:
+that is what the CP attention reads on NPU (MindSpeed's ring implementation
+uses ``cu_seqlens_q_padded // cp_size``), what the plugin's GDN divides by
+``cp_size``, and what the loss side re-derives from
+``relax/backends/megatron/cp_utils.py::maybe_padded_total_lengths``.
+
+The plain packed batch of a CP == 1 run never reaches these helpers: it is
+already split (or rather, not split at all) and carries ``cu_seqlens_q_cpu``.
+"""
+
+from __future__ import annotations
+
+from typing import List, Optional, Sequence
+
+import torch
+from torch import Tensor
+
+
+def padded_sample_lengths(packed_seq_params) -> Optional[List[int]]:
+    """Per-sample padded lengths of an undivided thd batch, or ``None``.
+
+    ``None`` means "not this flavour": there is no packed batch, or the batch is
+    the ordinary one whose ``cu_seqlens`` describe the tokens this rank actually
+    holds (``cu_seqlens_q_cpu``), which needs no splitting here.
+
+    The lengths are read off the device once per micro-batch -- the whole local
+    layout is derived from them, so one host round trip is the cheap option
+    against re-reading the tensor for every sample.
+    """
+    if packed_seq_params is None or getattr(packed_seq_params, 'qkv_format', None) != 'thd':
+        return None
+    if getattr(packed_seq_params, 'cu_seqlens_q_cpu', None) is not None:
+        return None
+    padded = getattr(packed_seq_params, 'cu_seqlens_q_padded', None)
+    if padded is None:
+        return None
+    boundaries = [int(offset) for offset in padded.reshape(-1).tolist()]
+    return [end - start for start, end in zip(boundaries, boundaries[1:])]
+
+
+def padded_boundaries(padded_lengths: Sequence[int]) -> List[int]:
+    """``[0, ...]`` cumulative boundaries of :func:`padded_sample_lengths`."""
+    boundaries = [0]
+    for length in padded_lengths:
+        boundaries.append(boundaries[-1] + int(length))
+    return boundaries
+
+
+def flat_ids(input_ids: Tensor, padded_lengths: Sequence[int]) -> Tensor:
+    """The undivided batch as one packed stream, ``[1, sum(padded_lengths)]``.
+
+    Every row of the ``[batch, seq]`` input holds its valid tokens first and
+    ``pad_token_id`` after them, so taking each row's padded length lines the
+    stream up with the global ``cu_seqlens`` of the batch -- the same stream a
+    CP == 1 run would have been handed.
+    """
+    assert input_ids.dim() == 2, f'an undivided packed batch is [batch, seq], got {tuple(input_ids.shape)}.'
+    assert input_ids.size(0) == len(padded_lengths), (
+        f'the batch has {input_ids.size(0)} rows but {len(padded_lengths)} per-sample boundaries.'
+    )
+    return torch.cat([input_ids[index, :length] for index, length in enumerate(padded_lengths)]).unsqueeze(0)
+
+
+def cp_local_index(padded_lengths: Sequence[int], cp_size: int, cp_rank: int, device) -> Tensor:
+    """Positions of this CP rank's tokens inside the undivided packed stream.
+
+    Per sample of padded length ``L``: the chunk ``[r * L / (2 * cp), (r + 1) * L / (2 * cp))``
+    from the front and the mirrored one from the back, in that order.
+    """
+    assert cp_size > 1, 'the local CP layout is only defined for cp_size > 1.'
+    chunks = []
+    offset = 0
+    for length in padded_lengths:
+        length = int(length)
+        assert length % (2 * cp_size) == 0, (
+            f'every sample must be padded to a multiple of 2 * cp_size = {2 * cp_size} before the CP split, '
+            f'got a padded length of {length}.'
+        )
+        chunk = length // (2 * cp_size)
+        chunks.append(torch.arange(offset + chunk * cp_rank, offset + chunk * (cp_rank + 1), device=device))
+        chunks.append(
+            torch.arange(offset + length - chunk * (cp_rank + 1), offset + length - chunk * cp_rank, device=device)
+        )
+        offset += length
+    return torch.cat(chunks)
+
+
+def split_for_cp(tensor: Tensor, index: Tensor, dim: int) -> Tensor:
+    """Take this rank's tokens (``index``, made by :func:`cp_local_index`) of ``tensor``."""
+    return tensor.index_select(dim, index)
diff --git a/mindspeed_bridge/models/qwen4_exp/modelling_qwen4_exp/gdn.py b/mindspeed_bridge/models/qwen4_exp/modelling_qwen4_exp/gdn.py
