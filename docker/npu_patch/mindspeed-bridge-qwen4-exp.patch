+        and (empty[0, -R:][valid:] == -1).all()
+    )
+    print(f'no-op row keeps only its causal tail ({valid} of {R} tokens): {tail_ok}')
+    ok &= tail_ok
+
+    print(f'test 7: {"PASS" if ok else "FAIL"}')
