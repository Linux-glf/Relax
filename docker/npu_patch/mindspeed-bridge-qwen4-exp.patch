+# --------------------------------------------------------------------------------------
+# 3. the hash and the padding mask
+# --------------------------------------------------------------------------------------
+def test_hash() -> bool:
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.ple import (
+        Qwen4ExpTextNGramEmbedding,
+        _segment_start,  # pylint: disable=protected-access
+    )
+
+    module = Qwen4ExpTextNGramEmbedding(SimpleNamespace(**SMALL), 0)
+    ok = _check(
+        module.total_vocab_size == 60 and module.padded_vocab_size == 64 and module.head_dim == TABLE_HEAD_DIM,
+        'the geometry of `SMALL` is what the stages assume',
+        f'total={module.total_vocab_size} padded={module.padded_vocab_size} head_dim={module.head_dim}',
+    )
+    ok &= _check(
+        module.ngram_heads_vocab_sizes.tolist() == [11, 13, 17, 19]
+        and module.ngram_heads_offsets.tolist() == [0, 11, 24, 41],
+        'per-head vocabularies are the primes after the base, offsets their prefix sum',
+        str(module.ngram_heads_vocab_sizes.tolist()),
+    )
+
+    generator = torch.Generator().manual_seed(7)
+    eos = module.eos_token_id
+    cases = {
+        'random ids': torch.randint(8, 100, (2, 24), generator=generator),
+        'one row': torch.randint(8, 100, (1, 8), generator=generator),
+        'a single token': torch.randint(8, 100, (1, 1), generator=generator),
+        'two tokens': torch.randint(8, 100, (1, 2), generator=generator),
+        'eos-separated packed samples': torch.tensor([[3, 8, 5, eos, 9, 2, 7, eos, 4, 1, 6, 0]]),
+        'eos among the first context tokens': torch.tensor([[eos, 5, eos, 3, 4], [eos, eos, 2, 3, 4]]),
+        'eos at the very end': torch.tensor([[3, 4, 5, eos]]),
+        'everything eos': torch.full((1, 6), eos, dtype=torch.long),
+    }
+    for label, ids in cases.items():
+        got = module.ngram_ids(ids)
+        want = reference_ngram_ids(module, ids)
+        ok &= _check(torch.equal(got, want), f'ngram_ids == the reference on {label}', str(tuple(got.shape)))
+        ok &= _check(
+            bool((got >= 0).all() and (got < module.total_vocab_size).all()),
+            f'  ... and lands inside the table on {label}',
+        )
+
+    # A packed stream is cut into its samples, and the cut -- not an EOS token -- is
+    # what separates them: a sample of this data ends with `<|im_end|>`, the hash
+    # resets at `<|endoftext|>`, and only the boundary keeps the two apart. The
+    # reference spells the same thing by running one sample per row.
+    packed_ids = torch.tensor([[3, 8, 5, 12, 9, 2, 7, 11, 4, 1, 6, 0]])
+    lengths = [5, 7]
+    boundaries = _segment_start(lengths, packed_ids.shape[1], torch.device('cpu'))
+    got = module.ngram_ids(packed_ids, boundaries)
+    want = _per_sample(lambda ids: reference_ngram_ids(module, ids), (packed_ids,), lengths)
+    ok &= _check(torch.equal(got, want), 'a packed stream hashes every sample on its own', str(tuple(got.shape)))
+    ok &= _check(
+        torch.equal(got[:, lengths[0] :], module.ngram_ids(packed_ids[:, lengths[0] :])),
+        '  ... so its second sample hashes as if it were a stream of its own',
+        f'positions {lengths[0]}.. of {packed_ids.shape[1]}',
+    )
+    ok &= _check(
+        not torch.equal(got[:, lengths[0] :], module.ngram_ids(packed_ids)[:, lengths[0] :]),
+        '  ... which the EOS reset alone does not do here',
+        f'no EOS token at position {lengths[0] - 1}',
+    )
+    return ok
+
+
+def test_segments() -> bool:
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.ple import (
+        _segment_start,  # pylint: disable=protected-access
+        _sequence_lengths,  # pylint: disable=protected-access
+    )
+
+    # Two samples of 13 and 6 tokens, in slots of 16 and 8: five tokens of padding,
+    # three of them in the middle of the stream where the next sample's conv would
+    # read them. This is the same batch in both spellings -- a text context-parallel
+    # run carries the padded ends on `cu_seqlens_q` (the loader cut and padded the
+    # stream itself, and `cu_seqlens_q_padded` is empty), a multimodal one on
+    # `cu_seqlens_q_padded` -- and the samples are the slots either way.
+    padded = [0, 16, 24]
+    ok = _check(_sequence_lengths(_packed(padded, padded)) == [16, 8], 'the slots are read off `cu_seqlens_q_padded`')
+    ok &= _check(
+        _sequence_lengths(_packed(padded, None)) == [16, 8], '  ... and off `cu_seqlens_q` when that is all there is'
+    )
+    ok &= _check(_sequence_lengths(_packed(None, None)) is None, 'a batch without boundaries has no slots')
+    ok &= _check(_sequence_lengths(None) is None, 'and neither has no batch at all')
+
+    starts = _segment_start([16, 8], padded[-1], torch.device('cpu'))
+    expected = torch.zeros(padded[-1], dtype=torch.long)
+    expected[16:] = 16  # the second sample's slot
+    ok &= _check(torch.equal(starts, expected.unsqueeze(0)), 'every position knows the sample it belongs to')
+
+    # One sample is the common case, and one that must not pay for a tensor.
+    ok &= _check(_segment_start([24], padded[-1], torch.device('cpu')) is None, 'a single sample has no boundary')
+    ok &= _check(_segment_start(None, padded[-1], torch.device('cpu')) is None, 'nor does a batch without slots')
+    # Lengths that do not tile the stream describe a batch this module is not
+    # looking at (a context-parallel rank's slice, say); resetting on the wrong
+    # positions would corrupt the hash silently.
+    try:
+        _segment_start([13, 6], padded[-1], torch.device('cpu'))
+        ok &= _check(False, 'boundaries that do not cover the stream are refused')
+    except ValueError as exc:
+        ok &= _check('undivided' in str(exc), 'boundaries that do not cover the stream are refused', str(exc)[:70])
+    return ok
+
