+def _reference_expansion(order, picked, layout, R):
+    """Column-wise reference for ``expand_block_starts``: whole blocks, clipped tail."""
+    T, keep_blocks = order.shape
+    out = torch.full((T, (keep_blocks + 1) * R), -1, dtype=torch.int32)
+    for t in range(T):
+        doc_start = int(layout.doc_start32[t])
+        for j in range(keep_blocks):
+            if bool(picked[t, j]):
+                base = doc_start + int(order[t, j]) * R
+                out[t, j * R : (j + 1) * R] = torch.arange(base, base + R, dtype=torch.int32)
+        tail_base = doc_start + int(layout.q_nblocks[t]) * R
+        tail_end = doc_start + int(layout.pos_in_doc[t]) + 1
+        tail = list(range(tail_base, tail_end))
+        out[t, keep_blocks * R : keep_blocks * R + len(tail)] = torch.tensor(tail, dtype=torch.int32)
+    return out
+
