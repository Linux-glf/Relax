+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Context-parallel helpers the QSA indexer needs.
+
+The indexer's selection must see *every* key of a sequence before attention runs, so
+under CP>1 the layer gathers the full sequence back (``reconstruct_tensor_cp``) before
+calling ``QSAIndexer.selection_as_token_indices`` / ``select_token_indices_thd``. This is
+the inverse of the zigzag sharding ``split_cp_inputs`` applies.
+
+Ported from mcore-bridge ``utils/megatron_utils.py``. The THD branch keeps the Ascend
+adaptation of ``mcore-bridge.bc58ea9c.patch``: Megatron's own
+``_undo_attention_load_balancing`` delegates to Transformer Engine
+(``thd_get_partitioned_indices``) and TE is not installed on NPU, so the partition is
+rebuilt in pure torch there instead of falling back to something else.
+"""
+
+from __future__ import annotations
+
+from collections import OrderedDict
+from typing import Optional
+
+import torch
+from megatron.core.ssm.mamba_context_parallel import _undo_attention_load_balancing
+from transformers.utils import is_torch_npu_available
+
+# Memo for normalize_cu_seqlens; see there for why the identity of the result matters.
+_NORMALIZED_CU_CACHE: 'OrderedDict[tuple, tuple]' = OrderedDict()
+_NORMALIZED_CU_CACHE_SIZE = 4
+
+
+def normalize_cu_seqlens(cu: Optional[torch.Tensor], total: int) -> Optional[torch.Tensor]:
+    """Align a (possibly padded/offset) ``cu_seqlens`` against the gathered full length.
+
+    Accepts a global cumulative layout (possibly missing its leading 0 or carrying
+    a per-batch offset) and returns a ``cu`` whose last entry equals ``total``, so
+    it indexes a gathered full-sequence tensor directly.
+
+    Memoized on ``(id, version, total)``, because the alignment check reads the vector
+    back to the host and the *identity* of the result is what the downstream layout
+    caches key on: a fresh rebased tensor per call would rebuild the per-token QSA
+    tables in every layer of every step. The entry pins its input so a recycled
+    ``id()`` cannot hit a stale result.
+    """
+    if cu is None:
+        return None
+    try:
+        version = cu._version
+    except RuntimeError:
+        # Inference tensors carry no version counter -- and are immutable outside
+        # InferenceMode, so the id alone identifies them.
+        version = None
+    key = (id(cu), version, total)
+    entry = _NORMALIZED_CU_CACHE.get(key)
+    if entry is not None:
+        _NORMALIZED_CU_CACHE.move_to_end(key)
+        return entry[1]
+    aligned = _align_cu_seqlens(cu, total)
+    _NORMALIZED_CU_CACHE[key] = (cu, aligned)
+    while len(_NORMALIZED_CU_CACHE) > _NORMALIZED_CU_CACHE_SIZE:
+        _NORMALIZED_CU_CACHE.popitem(last=False)
+    return aligned
+
+
+def _align_cu_seqlens(cu: torch.Tensor, total: int) -> torch.Tensor:
+    cu = cu.reshape(-1)
+    # One device sync for the whole vector. `int(cu[0])` / `int(cu[-1])` each pull
+    # a 0-dim tensor back through aten::_local_scalar_dense, and the checks below
+    # used to read both of them twice on the padded path and again in the error
+    # branch.
+    bounds = cu.tolist()
+    if bounds and bounds[0] != 0:
+        if bounds[-1] == total:
+            cu = torch.cat([cu.new_zeros(1), cu])
+            bounds = [0] + bounds
+        elif bounds[-1] - bounds[0] == total:
+            cu = cu - cu[0]
+            # Rebase the host copy too; `bounds[0]` here is still the pre-rebase
+            # value because the comprehension builds a new list.
+            bounds = [bound - bounds[0] for bound in bounds]
+    if not (bounds and bounds[-1] == total):
+        raise ValueError(
+            f'Cannot align cu_seqlens (last={bounds[-1] if bounds else None}, '
+            f'first={bounds[0] if bounds else None}) with the gathered sequence '
+            f'length {total} under sequence parallelism.'
+        )
+    return cu
+
+
+def _thd_partitioned_indices_torch(cu_seqlens: torch.Tensor, cp_size: int, cp_rank: int, device) -> torch.Tensor:
+    """Pure-Torch equivalent of TE's ``thd_get_partitioned_indices``.
+
+    Returns, in local order, the global packed positions this CP rank owns: for every
+    sample, its ``cp_rank``-th chunk from the front and its mirrored chunk from the
+    back (the same zigzag partition ``split_cp_inputs`` produces).
+    """
+    cu = cu_seqlens.reshape(-1).to(device=device, dtype=torch.long)
+
+    starts = cu[:-1]
+    ends = cu[1:]
+    seq_lens = ends - starts
+
+    if torch.any(seq_lens <= 0):
+        raise RuntimeError(f'THD CP requires positive sequence lengths, got {seq_lens}')
+    divisor = 2 * cp_size
+    if torch.any(seq_lens % divisor != 0):
+        raise RuntimeError(
+            'THD CP requires every packed sequence length to be divisible by '
+            f'2*cp_size={divisor}, got lengths={seq_lens}'
+        )
+
+    chunk = seq_lens // divisor
+
+    # Rank r owns:
+    #   front chunk r
+    #   back  chunk (2*cp_size-r-1)
+    front_starts = starts + cp_rank * chunk
+    back_starts = ends - (cp_rank + 1) * chunk
+    seg_starts = torch.stack((front_starts, back_starts), dim=1).reshape(-1)
+    seg_lens = torch.stack((chunk, chunk), dim=1).reshape(-1)
+
+    # Expand [segment_start, segment_length] into token indices without Python-side
+    # per-token loops.
+    nz = seg_lens > 0
+    seg_starts = seg_starts[nz]
+    seg_lens = seg_lens[nz]
+    seg_ids = torch.repeat_interleave(
+        torch.arange(seg_lens.numel(), device=device, dtype=torch.long),
+        seg_lens,
+    )
+    prefix = torch.cumsum(seg_lens, dim=0) - seg_lens
+    offsets = torch.arange(int(seg_lens.sum().item()), device=device, dtype=torch.long)
+    offsets -= torch.repeat_interleave(prefix, seg_lens)
+    return seg_starts.index_select(0, seg_ids) + offsets
+
+
+def _undo_attention_load_balancing_thd_torch(input_: torch.Tensor, cp_size: int, packed_seq_params) -> torch.Tensor:
+    """Undo the zigzag sharding of a packed (thd) gathered tensor, TE-free."""
+    cu = packed_seq_params.cu_seqlens_q_padded
+    if cu is None:
+        cu = packed_seq_params.cu_seqlens_q
+    if cu is None:
+        raise RuntimeError('THD CP reconstruction requires cu_seqlens_q_padded or cu_seqlens_q.')
+
+    total_tokens = input_.shape[0]
+    cu = cu.reshape(-1)
+    if int(cu[-1].item()) != total_tokens:
+        raise RuntimeError(
+            f'THD CP metadata does not match gathered tensor: cu[-1]={int(cu[-1].item())}, total_tokens={total_tokens}'
+        )
+
+    # gathered layout is: [rank0_local, rank1_local, ..., rankN_local]
+    # Build the global token positions represented by each row.
+    rank_major_positions = torch.cat(
+        [_thd_partitioned_indices_torch(cu, cp_size, rank, input_.device) for rank in range(cp_size)],
+        dim=0,
+    )
+    if rank_major_positions.numel() != total_tokens:
+        raise RuntimeError(
+            f'Invalid THD CP reconstruction index size: {rank_major_positions.numel()} vs {total_tokens}'
+        )
+
+    # rank_major_positions[j] means: gathered[j] belongs to global position
+    # rank_major_positions[j]. Build the inverse permutation so that
+    # output[global_position] = gathered[j].
+    restore_order = torch.empty(total_tokens, dtype=torch.long, device=input_.device)
+    restore_order.scatter_(
+        0,
+        rank_major_positions,
+        torch.arange(total_tokens, device=input_.device, dtype=torch.long),
+    )
+    return input_.index_select(0, restore_order)
+
+
+def reconstruct_tensor_cp(tensor, packed_seq_params, dim: int, cp_partition_mode: str = 'zigzag') -> torch.Tensor:
+    """In CP mode, all-gather and undo the chunking produced by
+    ``split_cp_inputs``, restoring the full sequence in original token order
+    along ``dim``.
+
+    Args:
+        tensor: CP-sharded local tensor whose sequence dim is at ``dim``.
+        packed_seq_params: ``PackedSeqParams`` for THD inputs, or ``None`` for
+            regular ``[B, S, ...]`` inputs.
+        dim: Sequence dimension index of ``tensor``.
+        cp_partition_mode: Only ``'zigzag'`` is implemented -- the undo helper below
+            hard-codes that chunk order, so anything else is rejected rather than
+            silently restoring a scrambled sequence.
+
+    Returns:
+        torch.Tensor: Full-sequence tensor with the same shape as ``tensor``
+        except the size at ``dim`` is multiplied by ``cp_size``.
+    """
+    from megatron.core import mpu
+
+    if cp_partition_mode != 'zigzag':
+        raise NotImplementedError(
+            f'reconstruct_tensor_cp only implements zigzag CP sharding, got cp_partition_mode={cp_partition_mode!r}.'
+        )
+
+    cp_size = mpu.get_context_parallel_world_size()
+    if cp_size <= 1:
+        return tensor
+
+    cp_rank = mpu.get_context_parallel_rank()
+    cp_group = mpu.get_context_parallel_group()
+
+    # All-gather across CP ranks (preserve local autograd graph for `tensor`).
+    output_list = [torch.empty_like(tensor) for _ in range(cp_size)]
+    torch.distributed.all_gather(output_list, tensor.contiguous(), group=cp_group)
+    output_list[cp_rank] = tensor
+    gathered = torch.cat(output_list, dim=dim)
+
+    # `_undo_attention_load_balancing` assumes sequence dim is 0; transpose if needed.
+    if dim != 0:
+        gathered = gathered.transpose(0, dim).contiguous()
+    if packed_seq_params is not None and is_torch_npu_available():
+        # THD path: TE-free implementation for NPU.
+        out = _undo_attention_load_balancing_thd_torch(gathered, cp_size, packed_seq_params)
+    else:
+        out = _undo_attention_load_balancing(gathered, cp_size, packed_seq_params)
+    if dim != 0:
+        out = out.transpose(0, dim).contiguous()
+    return out
