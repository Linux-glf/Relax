+# --------------------------------------------------------------------------------------
+# 5. the layer
+# --------------------------------------------------------------------------------------
+def test_layer() -> bool:
+    ok = True
+    with tempfile.TemporaryDirectory() as root:
+        dense = write_synthetic_table(root)
+        layer = build_ple_layer(make_config(table_dir=root)).cpu()
+        layer.eval()
+
+        # The transforms a build runs over every module -- `.cuda()`, `.bfloat16()`,
+        # `.to(...)` -- must leave the table where it is. Each of them would otherwise
+        # move 47.7 GiB per rank onto a die or allocate a second copy of it.
+        embedding = layer.ple_embedding
+        before = embedding.weight
+        embedding.bfloat16()
+        ok &= _check(
+            embedding.weight is before and embedding.weight.is_pinned() and embedding.weight.device.type == 'cpu',
+            'a module transform leaves the table on its own pinned host buffer',
+            f'{embedding.weight.dtype} on {embedding.weight.device.type}',
+        )
+        # The short conv starts at zero, the way the reference builds it: a sequence
+        # the model has not learned to correct yet reads through untouched. An HF load
+        # overwrites it immediately (the mapping is 1:1), so this only decides what a
+        # from-scratch build starts from -- but it has to be that same zero.
+        ok &= _check(
+            bool((layer.conv1d.weight == 0).all()),
+            'a freshly built layer starts its short conv at zero',
+            str(tuple(layer.conv1d.weight.shape)),
+        )
+        # And a forward may not read the table before something loaded it: on a fresh
+        # build the buffer is zeros, so this is the one place that catches a run whose
+        # bridge never mapped the table.
+        generator = torch.Generator().manual_seed(4242)
+        tokens = 24
+        hidden = torch.randn(tokens, 1, HC_HIDDEN, generator=generator)
+        ids = torch.randint(0, 100, (tokens, 1), generator=generator, dtype=torch.long)
+        try:
+            layer(hidden, ids, None)
+            ok &= _check(False, 'a forward on an unloaded table is refused')
+        except RuntimeError as exc:
+            ok &= _check('was not loaded' in str(exc), 'a forward on an unloaded table is refused', str(exc)[:70])
+        # Which is what the bridge's import does, and what this stage does instead of it.
+        embedding.load_table()
+
+        got = layer(hidden, ids, None)
+        want = reference_ple_forward(layer, hidden.transpose(0, 1), ids.transpose(0, 1), dense)
+        ok &= _check(got.shape == hidden.shape, 'the output has the layer input layout', str(tuple(got.shape)))
+        passed, detail = _close(got.transpose(0, 1), want, 1e-5)
+        ok &= _check(passed, 'the whole chain == the reference formula (no padding)', detail)
+
+        # The two windows decide how far a token reaches: the hash reads two back, the
+        # conv nine more, so a perturbed token must leave everything before it alone and
+        # stop mattering eleven tokens later.
+        probe = 12
+        perturbed = ids.clone()
+        perturbed[probe] = (perturbed[probe] + 5) % 100
+        moved = layer(hidden, perturbed, None)
+        ok &= _check(bool((moved[:probe] == got[:probe]).all()), 'a token does not touch what came before it')
+        ok &= _check(
+            bool((moved[probe : probe + 3] != got[probe : probe + 3]).any()),
+            'a token does touch itself',
+            f'rows {probe}..{probe + 2}',
+        )
+        ok &= _check(
+            bool((moved[probe + 13 :] == got[probe + 13 :]).all()),
+            'and reaches exactly its n-gram and conv windows, no further',
+            f'reach={probe + 12} of {tokens} tokens',
+        )
+
+        # A packed batch is a number of samples, and the reference runs each of them
+        # on its own row: nothing of one sample reaches another -- not its tokens
+        # (the hash) and not its last frames (the conv).
+        first = 13
+        plain = [0, first, tokens]
+        packed_run = layer(hidden, ids, _packed(plain, plain))
+        want_packed = _per_sample(
+            lambda sample_hidden, sample_ids: reference_ple_forward(layer, sample_hidden, sample_ids, dense),
+            (hidden.transpose(0, 1), ids.transpose(0, 1)),
+            [first, tokens - first],
+        )
+        passed, detail = _close(packed_run.transpose(0, 1), want_packed, 1e-5)
+        ok &= _check(passed, 'a packed batch == the reference run once per sample', detail)
+        ok &= _check(bool((packed_run[:first] == got[:first]).all()), 'the first sample is the stream it was')
+        ok &= _check(
+            bool((packed_run[first:] != got[first:]).any()),
+            'and the second starts its own windows',
+            f'position {first} is no EOS token',
+        )
+        # The crisp form of the same thing: the second sample's first token is what
+        # that sample's first token is on its own, at the hash and at the conv.
+        alone = reference_ple_forward(layer, hidden[first:].transpose(0, 1), ids[first:].transpose(0, 1), dense)
+        passed, detail = _close(packed_run[first], alone[:, 0], 1e-5)
+        ok &= _check(passed, "  ... and is that sample's own first token", detail)
+
+        # And a batch whose slots hold padding: what trails a sample is its own, so
+        # the sample before it is not shifted by it and neither window reads it.
+        padded = [0, 16, tokens]
+        real = [13, tokens - 16]
+        assert padded[-1] == tokens, 'the padded boundaries have to cover the stage input'
+        want = torch.zeros_like(got)
+        real_mask = torch.zeros(tokens, dtype=torch.bool)
+        for start, length in zip(padded[:-1], real):
+            want[start : start + length] = reference_ple_forward(
+                layer,
+                hidden[start : start + length].transpose(0, 1),
+                ids[start : start + length].transpose(0, 1),
+                dense,
+            ).transpose(0, 1)
+            real_mask[start : start + length] = True
+        padded_run = layer(hidden, ids, _packed(padded, padded))
+        passed, detail = _close(padded_run[real_mask], want[real_mask], 1e-5)
+        ok &= _check(passed, "a sample's padding stays inside its slot", detail)
+        blank_ids = torch.where(real_mask.unsqueeze(-1), ids, torch.zeros_like(ids))
+        ok &= _check(
+            bool((layer(hidden, blank_ids, _packed(padded, padded))[real_mask] == padded_run[real_mask]).all()),
+            '  ... so what the padding holds changes nothing',
+            'the padding positions set to id 0',
+        )
+
+        # A batch that travels without packed boundaries is one sample: the common
+        # case of a run whose batches are unpacked, and the same numbers as the
+        # unpacked call above.
+        ok &= _check(
+            bool((layer(hidden, ids, _packed(None, None)) == got).all()),
+            'a batch without boundaries runs as the one sample it is',
+        )
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+# 6. the sequence-parallel layout
+# --------------------------------------------------------------------------------------
+class _FakeGroup:
+    """A process group of a size (and rank) the one-rank test world does not have.
+
+    ``size``/``rank`` is the whole interface MCore's ``get_pg_size``/``get_pg_rank`` ask
+    for -- but only once a process group exists at all: both return ``1``/``0`` without
+    asking the group anything, so a stage that uses one has to have run ``_init_dist``.
+    """
+
+    def __init__(self, size: int, rank: int = 0):
+        self._size = size
+        self._rank = rank
+
+    def size(self) -> int:
+        return self._size
+
+    def rank(self) -> int:
+        return self._rank
+
+
+def test_layout() -> bool:
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp import ple
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.ple import (
+        PLE_SP_FULL_SEQUENCE_ENV,
+        _keep_own_chunk,  # pylint: disable=protected-access
+    )
+
+    ok = True
+
+    # First which layout a geometry gets -- a decision made off the config and the escape
+    # hatch, and one nothing else in the file reads back. The sharded layout is the
+    # reference's, so it is what a sequence-parallel model gets wherever it is defined at
+    # all; the two exclusions are structural (context parallelism splits the sequence
+    # round-robin, so the rank before this one does not hold the frames before this chunk)
+    # and they must hold *without* the hatch, while the hatch must be able to pin the full
+    # sequence anywhere. No table is built to ask: the property reads three config fields.
+    def layout_of(**geometry) -> bool:
+        layer = object.__new__(ple.Qwen4ExpTextPLELayer)
+        torch.nn.Module.__init__(layer)
+        layer.config = SimpleNamespace(**geometry)
+        return layer._sharded_layout  # pylint: disable=protected-access
+
+    with mock.patch.dict(os.environ, {PLE_SP_FULL_SEQUENCE_ENV: '0'}):
+        ok &= _check(
+            layout_of(tensor_model_parallel_size=2, sequence_parallel=True, context_parallel_size=1),
+            'TP=2 with sequence parallelism runs the sharded layout',
+        )
+        ok &= _check(
+            not layout_of(tensor_model_parallel_size=1, sequence_parallel=True, context_parallel_size=1),
+            'TP=1 has no other layout to pick: the sharded one is the same code there',
+        )
+        ok &= _check(
+            not layout_of(tensor_model_parallel_size=2, sequence_parallel=True, context_parallel_size=2),
+            'context parallelism keeps the full-sequence layout',
+        )
+        ok &= _check(
+            not layout_of(tensor_model_parallel_size=2, sequence_parallel=False, context_parallel_size=1),
+            'and so does a model without sequence parallelism',
+        )
+        with mock.patch.dict(os.environ, {PLE_SP_FULL_SEQUENCE_ENV: '1'}):
+            ok &= _check(
+                not layout_of(tensor_model_parallel_size=2, sequence_parallel=True, context_parallel_size=1),
+                'the escape hatch pins the full-sequence layout',
+            )
+
+    tensor = torch.arange(8.0, requires_grad=True)
+    with mock.patch('torch.distributed.get_rank', return_value=1):
+        chunk = _keep_own_chunk(tensor, _FakeGroup(2))
+    ok &= _check(chunk.tolist() == [4, 5, 6, 7], 'the second rank gets its own half', str(chunk.tolist()))
+    chunk.sum().backward()
+    ok &= _check(
+        tensor.grad.tolist() == [0, 0, 0, 0, 1, 1, 1, 1],
+        'and the other half is zero on this rank, so the sequence-parallel sum adds disjoint '
+        'partials instead of counting the same one twice',
+        str(tensor.grad.tolist()),
+    )
+    with mock.patch('torch.distributed.get_rank', return_value=0):
+        first = _keep_own_chunk(torch.arange(8.0), _FakeGroup(2))
+    ok &= _check(first.tolist() == [0, 1, 2, 3], 'the first rank gets the first half')
+    ok &= _check(_keep_own_chunk(tensor, _FakeGroup(1)) is tensor, 'one rank is a pass-through')
+    try:
+        _keep_own_chunk(torch.arange(7.0), _FakeGroup(2))
+        ok &= _check(False, 'a sequence that does not divide into the chunks is refused')
+    except ValueError as exc:
+        ok &= _check('does not divide' in str(exc), 'a sequence that does not divide is refused', str(exc)[:60])
+
+    # Then the whole sharded forward, one rank at a time. `forward` under `sequence_parallel`
+    # with a TP group of two now runs the *reference's* layout: the ids are gathered (the
+    # hash reads backwards), the lookup's partial comes back cut to this rank's chunk, and
+    # the conv takes the frames before it off the rank before it. Both ranks are built here
+    # as real layers -- each holding its own row shard of the table, sharing every other
+    # parameter -- and the three collectives they would run are emulated off each other's
+    # activations: the sum of two partials is the dense lookup, and what this rank calls its
+    # halo is the other rank's last real frames. The one thing the emulation cannot check is
+    # the collectives themselves; the `sp2` stage runs those for real on two dies.
+    with tempfile.TemporaryDirectory() as root:
+        dense = write_synthetic_table(root)
+        config = make_config(table_dir=root, sequence_parallel=True, tensor_model_parallel_size=2)
+        group = _FakeGroup(2)
+        tokens, half = 40, 20  # every chunk reaches past the conv's receptive field
+        generator = torch.Generator().manual_seed(99)
+        hidden = torch.randn(tokens, 1, HC_HIDDEN, generator=generator)
+        ids = torch.randint(0, 100, (tokens, 1), generator=generator, dtype=torch.long)
+        full_ids = ids.transpose(0, 1)  # `[rows, length]` -- what the layer hashes
+        halo = (SMALL['ple_conv_kernel_size'] - 1) * SMALL['ngram_size']
+
+        worlds = []
+        with torch.no_grad():
+            for rank in range(2):
+                with mock.patch('torch.distributed.get_rank', return_value=rank):
+                    layer = build_ple_layer(config, pg_collection=SimpleNamespace(tp=group)).cpu()
+                layer.eval()
+                layer.ple_embedding.load_table()  # this rank's row shard of the table
+                worlds.append(layer)
+        # One model: the two ranks agree on everything but the table, which is the param
+        # sharding. Without this the reference and the layers would disagree for the
+        # trivial reason of being two different initializations.
+        shared = {
+            name: value for name, value in worlds[0].state_dict().items() if not name.endswith('ple_embedding.weight')
+        }
+        worlds[1].load_state_dict(shared, strict=False)
+
+        def lookup(target):
+            """That rank's full-stream partial of the lookup, with the TP sum mocked away."""
+            with mock.patch(
+                'megatron.core.tensor_parallel.reduce_from_tensor_model_parallel_region',
+                side_effect=lambda value, group=None: value,
+            ):
+                return target.ple_embedding(full_ids, None)
+
+        with torch.no_grad():
+            problems = []
+            for rank in (0, 1):
+                layer, other = worlds[rank], worlds[1 - rank]
+                own = slice(rank * half, (rank + 1) * half)
+                local_hidden, local_ids = hidden[own], ids[own]
+                mine, theirs = lookup(layer), lookup(other)
+                # `[1, tokens, width]`: what the group sums to, i.e. the dense lookup, and
+                # -- off the same numbers -- the frames each rank's conv reads and the halo
+                # it hands the next one.
+                total = mine + theirs
+
+                def normed_tail(target, index):
+                    piece = total[:, index * half : (index + 1) * half]
+                    _, normed = target._gated_output(  # pylint: disable=protected-access
+                        piece, hidden[index * half : (index + 1) * half].transpose(0, 1)
+                    )
+                    return normed[:, -halo:, :]
+
+                tails = [normed_tail(worlds[0], 0), normed_tail(worlds[1], 1)]
+
+                def gather(local, group=None):
+                    # The ids are the only thing gathered under this layout: int64, the whole
+                    # stream on every rank, and this rank's own chunk of it to start with.
+                    problems.append(
+                        _check(
+                            local.dtype == torch.long and torch.equal(local, local_ids),
+                            f'rank {rank} gathers the ids and nothing else',
+                        )
+                    )
+                    return ids
+
+                def reduce_scatter(value, group=None):
+                    problems.append(
+                        _check(
+                            torch.equal(value, mine.transpose(0, 1)),
+                            f'rank {rank} hands the collective its own rows of the partial',
+                        )
+                    )
+                    return total.transpose(0, 1)[own]
+
+                def halo_gather(gathered, value, group=None):
+                    # `_HaloAllGather.forward` hands the collective this rank's tail and
+                    # an empty slot per rank; filling the slots off the other rank's
+                    # activations is what the real one would have put there.
+                    problems.append(
+                        _check(
+                            torch.equal(value, tails[rank]),
+                            f'rank {rank} gathers the {halo} frames before its chunk',
+                        )
+                    )
+                    for slot, tail in zip(gathered, tails):
+                        slot.copy_(tail)
+
+                with (
+                    mock.patch(
+                        'megatron.core.tensor_parallel.gather_from_sequence_parallel_region', side_effect=gather
+                    ),
+                    mock.patch(
+                        'megatron.core.tensor_parallel.reduce_scatter_to_sequence_parallel_region',
+                        side_effect=reduce_scatter,
+                    ),
+                    mock.patch('torch.distributed.all_gather', side_effect=halo_gather),
+                    mock.patch('torch.distributed.get_rank', return_value=rank),
+                ):
+                    got = layer(local_hidden, local_ids, None)
+                want = reference_ple_forward(layer, hidden.transpose(0, 1), full_ids, dense)[0, own]
+                passed, detail = _close(got.transpose(0, 1), want.unsqueeze(0), 1e-5)
+                ok &= _check(passed, f'rank {rank} of the sharded layout gets its own half back', detail)
+            ok &= all(problems)
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+# 7. the sharded convolution, bit for bit
+# --------------------------------------------------------------------------------------
+def _bare_conv_layer(tp, channels, kernel=4, dilation=3, dtype=torch.float64, tap=None):
+    """A ``Qwen4ExpTextPLELayer`` carrying only what its two conv paths read.
+
+    The real constructor allocates this rank's rows of the n-gram table (on pinned
+    host memory, a table this stage never looks at) and three linears and norms, so
+    building one to check a window would be almost entirely setup. ``_short_conv``
+    and ``_short_conv_halo`` read ``conv1d``, ``short_conv_state_len``, ``_sp_size``
+    (off the config) and the TP group -- the four are what this puts on it.
+    """
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.ple import Qwen4ExpTextPLELayer
+
+    layer = object.__new__(Qwen4ExpTextPLELayer)
+    torch.nn.Module.__init__(layer)
+    layer.conv1d = torch.nn.Conv1d(
+        channels, channels, kernel_size=kernel, groups=channels, dilation=dilation, bias=False, dtype=dtype
+    )
+    generator = torch.Generator().manual_seed(7)
+    with torch.no_grad():
+        layer.conv1d.weight.copy_(torch.randn(layer.conv1d.weight.shape, generator=generator, dtype=dtype) * 0.3)
+        if tap is not None:  # one tap at a time: a single product per output cannot be reordered
+            mask = torch.zeros_like(layer.conv1d.weight)
+            mask[:, :, tap] = 1
+            layer.conv1d.weight *= mask
+    layer.short_conv_state_len = (kernel - 1) * dilation
+    layer.config = SimpleNamespace(tensor_model_parallel_size=tp, sequence_parallel=True, context_parallel_size=1)
+    layer._tp_group = lambda: _FakeGroup(tp)  # pylint: disable=protected-access
+    return layer
+
+
+def _halo_case(
+    name, lengths, tp, *, dtype=torch.float64, channels=6, kernel=4, dilation=3, exact=False, tap=None
+) -> Tuple[bool, str]:
+    """`_short_conv_halo` on each of ``tp`` chunks against `_short_conv` on the stream.
+
+    With ``exact`` the weights are powers of two and the input integers, so every
+    product and every sum is exact: a tap that reads the wrong frame is then a
+    multiple of 2^-4 away, and the two layouts have to agree to the bit.
+    """
+    dtype = torch.float32 if exact else dtype  # powers of two and integers, in fp32
+    halo = (kernel - 1) * dilation
+    total = sum(lengths)
+    if total % tp or total // tp < halo:
+        return True, f'{name}: skipped, {total} frames do not split into {tp} chunks of at least {halo}'
+    length = total // tp
+    layer = _bare_conv_layer(tp, channels, kernel=kernel, dilation=dilation, dtype=dtype, tap=tap)
+    generator = torch.Generator().manual_seed(11)
+    if exact:
+        with torch.no_grad():
+            layer.conv1d.weight.copy_(torch.tensor([[[-0.5, 0.25, -0.125, 0.0625]]]).repeat(channels, 1, 1))
+        full = torch.randint(-32, 33, (1, total, channels), generator=generator).float()
+    else:
+        full = torch.randn(1, total, channels, generator=generator, dtype=dtype)
+    with torch.no_grad():
+        reference = layer._short_conv(full, list(lengths))
+    for rank in range(tp):
+        tails = [full[:, (r + 1) * length - halo : (r + 1) * length] for r in range(tp)]
+
+        def halo_gather(gathered, _value, group=None):
+            for slot, tail in zip(gathered, tails):
+                slot.copy_(tail)
+
+        with (
+            mock.patch('torch.distributed.all_gather', side_effect=halo_gather),
+            mock.patch('torch.distributed.get_rank', return_value=rank),
+        ):
+            with torch.no_grad():
+                got = layer._short_conv_halo(full[:, rank * length : (rank + 1) * length], list(lengths))
+        want = reference[:, rank * length : (rank + 1) * length]
+        if not torch.equal(got, want):
+            return False, (
+                f'{name} rank {rank}/{tp}: max|diff|={(got - want).abs().max().item():.3e}, '
+                f'lengths={lengths}, chunk={length}, dtype={got.dtype}'
+            )
+    return True, ''
+
+
+def _halo_group(label, cases) -> Tuple[bool, str]:
+    """Run the ``(ok, detail)`` pairs of one family; one line, with the first failure named."""
+    total = failed = skipped = 0
+    first = ''
+    for ok, detail in cases:
+        total += 1
+        if ok and detail:
+            skipped += 1
+        if not ok:
+            failed += 1
+            first = first or detail
+    summary = f'{label}: {total - failed}/{total} agree bit for bit' + (f', {skipped} skipped' if skipped else '')
+    return failed == 0, summary + (f' -- {first}' if first else '')
+
+
+def test_halo_conv() -> bool:
+    """`_short_conv_halo` against `_short_conv`, on every way a stream can be cut.
+
+    The sharded conv claims to be the full-sequence one -- same taps, same values --
+    with the frames before this rank's chunk taken off the rank that holds them instead
+    of off a pad. That is arithmetic and offset bookkeeping, and both are checkable
+    without a process group: split a packed stream into ``tp`` chunks and hand
+    `_short_conv_halo` exactly what the all-gather would have returned, every chunk's
+    last ``short_conv_state_len`` frames.
+
+    ``F.silu`` is the identity for this stage. On this build it is not
+    position-invariant in float32: the CPU kernel's vectorized body and its scalar tail
+    round the same value differently, so the same convolution rendered into a tensor of
+    another length comes out an ULP apart in the activation -- noise about the kernel,
+    not about the window, and four orders of magnitude under the bf16 the model trains
+    in. With it out of the way, both layouts have to agree to the bit in float32 as well,
+    which is what turns a wrong tap or a misplaced sample pad into a failure instead of a
+    rounding.
+
+    What this stage cannot reach: the collective itself (a fake stands in for it -- the
+    `sp2` stage runs it for real on two dies) and the module around the conv, whose
+    own layout is stage 6's.
+    """
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp import ple
+
+    real_silu, ple.F.silu = ple.F.silu, lambda value: value
+    halo, ok = 9, True
+    try:
+        groups = []
+
+        # One sample, so every chunk but the first reads the previous chunk's real frames
+        # and the first one reads a zero pad.
+        groups.append(_halo_group('one sample', [_halo_case(f'one sample tp={tp}', [64], tp) for tp in (2, 4)]))
+        # The whole family of sample boundaries around a chunk boundary: exactly at it,
+        # just inside or outside on either side, and inside the first `halo` frames.
+        groups.append(
+            _halo_group(
+                'boundaries around a chunk start',
+                [_halo_case(f'boundary {offset:+d}', [32 + offset, 32 - offset], 2) for offset in range(-2, 3)]
+                + [
+                    _halo_case(f'boundary inside {offset}', [16 + offset, 48 - offset], 2)
+                    for offset in range(1, halo + 2)
+                ],
+            )
+        )
+        # Several samples, a chunk boundary that is not a sample boundary, samples shorter
+        # than the receptive field, and a sample that begins inside a chunk.
+        shapes = (
+            ('many samples', [13, 19, 17, 15], 2),
+            ('many samples, four ways', [13, 19, 17, 15], 4),
+            ('short samples', [4, 6, 4, 6, 8, 4], 2),
+            ('short samples, four ways', [14, 16, 14, 16, 28, 24], 4),
+            ('boundary at the first frame', [9, 55], 2),
+            ('boundary one frame in', [10, 54], 2),
+        )
+        groups.append(_halo_group('packed shapes', [_halo_case(*case) for case in shapes]))
+
+        # The sweeps. Every case here has to be bit for bit identical either way -- the
+        # exact ones because the arithmetic does not round, the float32 ones because the
+        # conv does not care how long the array it is handed is.
+        random.seed(3)
+        sweep = []
+        for trial in range(40):
+            lengths, tp = _random_split(random, halo, high=40)
+            sweep.append(_halo_case(f'random {trial}', lengths, tp))
+        groups.append(_halo_group('random splits', sweep))
+
+        random.seed(9)
+        exact_sweep = [_halo_case(f'exact {trial}', *_random_split(random, halo), exact=True) for trial in range(60)]
+        exact_sweep += [
+            _halo_case(f'exact boundary {offset:+d}', [24 + offset, 40 - offset], 2, exact=True)
+            for offset in range(-1, halo + 2)
+        ]
+        exact_sweep += [
+            _halo_case(f'exact shape {lengths[:3]}..', lengths, 2, exact=True)
+            for lengths in ([3] * 12, [9, 55], [4, 6, 4, 6, 8, 4, 6, 4, 6, 8])
+        ]
+        groups.append(_halo_group('exact arithmetic', exact_sweep))
+
+        # One tap at a time leaves a single product per output, so there is nothing the
+        # kernel could reorder: these are where the pads and the offsets around each tap
+        # are pinned down rather than the taps themselves.
+        random.seed(5)
+        tap_sweep = []
+        for tap in range(4):
+            for trial in range(10):
+                lengths, tp = _random_split(random, halo)
+                tap_sweep.append(
+                    _halo_case(
+                        f'tap {tap} #{trial}',
+                        lengths,
+                        tp,
+                        dtype=torch.float32 if trial % 2 else torch.float64,
+                        tap=tap,
+                    )
+                )
+        groups.append(_halo_group('one tap at a time', tap_sweep))
+
+        for passed, detail in groups:
+            ok &= _check(passed, 'the sharded conv equals the full-sequence one', detail)
+
+        # The two ways a chunk can be unusable say so instead of computing silently wrong.
+        layer = _bare_conv_layer(4, 6)
+        try:
+            with torch.no_grad():
+                layer._short_conv_halo(torch.zeros(1, halo - 1, 6), [4 * (halo - 1)])
+            ok &= _check(False, 'a chunk shorter than the receptive field is refused')
+        except ValueError as exc:
+            ok &= _check(
+                'receptive field' in str(exc), 'a chunk shorter than the receptive field is refused', str(exc)[:70]
+            )
+        layer = _bare_conv_layer(2, 6)
+        try:
+            with torch.no_grad():
+                layer._short_conv_halo(torch.zeros(2, 32, 6), [64])
+            ok &= _check(False, 'a batch of two rows is refused')
+        except RuntimeError as exc:
+            ok &= _check('rows' in str(exc), 'a batch of two rows is refused', str(exc)[:70])
+    finally:
+        ple.F.silu = real_silu
+    return ok
+
+
+def _random_split(generator, halo, high=60) -> Tuple[List[int], int]:
+    """A random packed stream long enough for every chunk to reach past its first frame."""
+    tp = generator.choice([2, 4])
+    lengths = [generator.randint(3, high) for _ in range(generator.randint(1, 6))]
+    lengths[-1] += max(0, tp * (halo + 3) - sum(lengths))
+    lengths[-1] += (-sum(lengths)) % tp
+    return lengths, tp
+
+
+# --------------------------------------------------------------------------------------
+# 8. the table's export, shard by shard
+# --------------------------------------------------------------------------------------
+def test_export() -> bool:
+    """`assemble_shard` walks a shard in pieces and still puts every row where it belongs.
+
+    The export used to stage a whole shard on a die at once -- 800 MB for this table --
+    and now assembles it in ``_ASSEMBLY_CHUNK_BYTES`` pieces. What the pieces must not
+    change is the result, and the case worth checking is the shard a rank boundary falls
+    inside: half a chunk owned by one rank, half by the other, and a last chunk shorter
+    than the rest. The collectives are mocked to the identity and the two ranks' pieces
+    are summed the way an all-reduce would -- a row has one owner and the rest are zeros,
+    so that sum is the row. That they run at all, on the pieces and in the same order on
+    every rank, is the eight-die export's job (`align_with_hf.py --stage export`).
+    """
+    from mindspeed_bridge.models.qwen4_exp import qwen4_exp_bridge as bridge_module
+
+    ok = True
+    rows_per_rank, width, shards, tp_size = 20, 3, 5, 2  # 40 rows: 8 per shard, 2.5 shards per rank
+    rows_per_shard = rows_per_rank * tp_size // shards
+    generator = torch.Generator().manual_seed(4242)
+    dense = torch.randn(rows_per_rank * tp_size, width, generator=generator).to(torch.bfloat16)
+    names = {
+        f'shard_{index}': f'model.language_model.layers.0.ple.ple_embedding.ngram_embedding.shard_{index}.weight'
+        for index in range(shards)
+    }
+    mappings = []
+    for _ in range(tp_size + 1):  # one per rank, plus a single-rank mapping for the shortcut
+        mapping = bridge_module.PLENGramEmbeddingMapping(
+            megatron_param='decoder.layers.0.ple.ple_embedding.weight', hf_param=names
+        )
+        mappings.append(mapping)
+    for rank, mapping in enumerate(mappings[:tp_size]):
+        mapping._tp_group = _FakeGroup(tp_size, rank)  # pylint: disable=protected-access
+    mappings[tp_size]._tp_group = _FakeGroup(1)  # pylint: disable=protected-access
+
+    # The whole table on one rank is a view, not an assembly.
+    single = mappings[tp_size].assemble_shard(3, dense)
+    ok &= _check(
+        torch.equal(single, dense[3 * rows_per_shard : 4 * rows_per_shard])
+        and single.untyped_storage().data_ptr() == dense.untyped_storage().data_ptr(),
+        'one rank: the shard is a view of the rows it already holds',
+    )
+
+    def identity_all_reduce(piece, group=None):
+        return piece
+
+    for chunk_rows in (3, 7, rows_per_shard, rows_per_shard + 5):
+        with mock.patch.object(bridge_module, '_ASSEMBLY_CHUNK_BYTES', chunk_rows * width * 2):
+            for shard_index in range(shards):
+                want = dense[shard_index * rows_per_shard : (shard_index + 1) * rows_per_shard]
+                pieces = []
+                for rank in range(tp_size):
+                    local = dense[rank * rows_per_rank : (rank + 1) * rows_per_rank]
+                    with (
+                        mock.patch('torch.distributed.all_reduce', side_effect=identity_all_reduce),
+                        mock.patch('torch.distributed.get_rank', return_value=rank),
+                    ):
+                        pieces.append(mappings[rank].assemble_shard(shard_index, local))
+                assembled = sum(piece.float() for piece in pieces).to(torch.bfloat16)
+                ok &= _check(
+                    torch.equal(assembled, want),
+                    f'the ranks assemble shard {shard_index} in {chunk_rows}-row pieces'
+                    + (' (a rank boundary inside one)' if rows_per_rank % rows_per_shard else ''),
+                )
+
+    # The pipeline case: a stage without the table holds no rows and learns the geometry
+    # from the spec, and every piece it writes is one the holder broadcast to it. The spec
+    # is the shape of a *rank's* rows -- what a stage that has the table would pass -- so
+    # the shards it walks are the same ones, of the same size.
+    spec = ((rows_per_rank, width), dense.dtype)
+    with mock.patch.object(bridge_module, '_ASSEMBLY_CHUNK_BYTES', 3 * width * 2):
+        for shard_index in (1, 4):
+            want = dense[shard_index * rows_per_shard : (shard_index + 1) * rows_per_shard]
+            seen = []
+
+            def fake_broadcast(piece, src=None, group=None):
+                begin = len(seen) * 3
+                seen.append(begin)
+                piece.copy_(want[begin : begin + piece.shape[0]])
+
+            with (
+                mock.patch('torch.distributed.broadcast', side_effect=fake_broadcast),
+                mock.patch('torch.distributed.all_reduce', side_effect=identity_all_reduce),
+            ):
+                got = mappings[0].assemble_shard(shard_index, None, spec, source_rank=7)
+            ok &= _check(
+                torch.equal(got, want) and len(seen) == -(-rows_per_shard // 3),
+                f'a stage without the table assembles shard {shard_index} off the broadcast',
+                f'{len(seen)} pieces',
+            )
+
+    # The row-routed form: the same table and the same shards, but the owners are the
+    # expert-parallel ranks. The mapping's own coordinates are still the tensor-parallel
+    # ones -- a single rank here, which is the shortcut checked above -- so the export
+    # has to take the owners it is handed: the geometry (rows per owner, shard size)
+    # and the sum both. Ignoring them would cut shards of 4 rows out of one rank's 20.
+    mapping = mappings[tp_size]
+    owners = _FakeGroup(tp_size)
+    for shard_index in range(shards):
+        want = dense[shard_index * rows_per_shard : (shard_index + 1) * rows_per_shard]
+        pieces = []
+        for rank in range(tp_size):
+            local = dense[rank * rows_per_rank : (rank + 1) * rows_per_rank]
+            with (
+                mock.patch('torch.distributed.all_reduce', side_effect=identity_all_reduce),
+                mock.patch('torch.distributed.get_rank', return_value=rank),
+            ):
+                pieces.append(
+                    mapping.assemble_shard(shard_index, local, owner_group=owners, owner_rank=rank, owner_size=tp_size)
+                )
+        assembled = sum(piece.float() for piece in pieces).to(torch.bfloat16)
+        ok &= _check(
+            torch.equal(assembled, want),
+            f'owners handed in assemble shard {shard_index} the same way',
+        )
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+# 9. the cpu offload switch (QWEN4_EXP_PLE_CPU_OFFLOAD)
+# --------------------------------------------------------------------------------------
+def test_trainable() -> bool:
+    """The switch that takes the table off the host, and what it changes.
+
+    The frozen host buffer and the device EP-sharded parameter are two forms of the
+    same weight. This stage reads the switch every way it is written -- unset, each
+    name, both names disagreeing -- and then builds both forms: the parameter's
+    residency, its ``_apply`` travel, its load, and the state dict it shares with the
+    buffer form. The routed lookup and its gradient need a real EP group and run in
+    the ``ep`` stage (stage 11).
+    """
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp import ple as ple_module
+
+    ok = True
+    device = torch.cuda.current_device()
+
+    # The switch itself, before any layer is built: the default is offload *on*, the
+    # name the gate had first is read as its negation, and saying both at once with
+    # values that disagree is refused rather than resolved.
+    for name in (ple_module.PLE_CPU_OFFLOAD_ENV, ple_module.PLE_TABLE_TRAINABLE_ENV):
+        os.environ.pop(name, None)
+    ok &= _check(
+        ple_module._table_offloaded(), 'unset, the table is offloaded to the host', 'the frozen default'
+    )
+    os.environ[ple_module.PLE_CPU_OFFLOAD_ENV] = '0'
+    ok &= _check(not ple_module._table_offloaded(), '  ... and `0` takes it off the host')
+    # The old name is the negation, so agreeing means the opposite value: `trainable=1`
+    # says what `offload=0` says, and the other way round.
+    os.environ[ple_module.PLE_TABLE_TRAINABLE_ENV] = '1'
+    ok &= _check(
+        not ple_module._table_offloaded(), '  ... and the old name, saying it the other way round, is read too'
+    )
+    os.environ[ple_module.PLE_TABLE_TRAINABLE_ENV] = '0'
+    try:
+        ple_module._table_offloaded()
+        ok &= _check(False, 'the two names disagreeing is refused', 'no error raised')
+    except ValueError as error:
+        ok &= _check(
+            ple_module.PLE_CPU_OFFLOAD_ENV in str(error) and ple_module.PLE_TABLE_TRAINABLE_ENV in str(error),
+            'the two names disagreeing is refused, and the message names both',
+            str(error)[:80],
+        )
+    for name in (ple_module.PLE_CPU_OFFLOAD_ENV, ple_module.PLE_TABLE_TRAINABLE_ENV):
+        os.environ.pop(name, None)
+
+    with tempfile.TemporaryDirectory() as root:
+        dense = write_synthetic_table(root, dtype=torch.float32)
+        os.environ[ple_module.PLE_CPU_OFFLOAD_ENV] = '0'
+        try:
+            gated = build_ple_layer(make_config(table_dir=root))
+            embedding = gated.ple_embedding
+            weight = embedding.weight
+            ok &= _check(
+                'weight' in embedding._parameters and 'weight' not in embedding._buffers,
+                'with the offload off the table is a parameter, not a buffer',
+                f'parameters={sorted(embedding._parameters)} buffers={sorted(embedding._buffers)}',
+            )
+            ok &= _check(
+                isinstance(weight, torch.nn.Parameter) and weight.requires_grad,
+                'and it asks for a gradient',
+                str(type(weight).__name__),
+            )
+            ok &= _check(
+                tuple(weight.shape) == (TABLE_ROWS, TABLE_HEAD_DIM),
+                'holding every row of a one-rank table',
+                str(tuple(weight.shape)),
+            )
+            ok &= _check(
+                weight.dtype == torch.float32 and weight.device.type != 'cpu' and not weight.is_pinned(),
+                'a device tensor of the config\'s dtype, not pinned host memory',
+                f'{weight.dtype} on {weight.device.type}, pinned={weight.is_pinned()}',
+            )
+            # A parameter travels with the module -- the `_apply` guard exists for the
+            # host buffer, and popping this name instead would raise here.
+            before = weight
+            gated.to(device)
+            ok &= _check(
+                embedding.weight is before and embedding.weight.device.index == device,
+                'a module transform carries the table to the device',
+                f'{embedding.weight.device}',
+            )
+            # Two-die equality and the sweep: a parameter marked `sequence_parallel` is
+            # summed over the TP group by `finalize_model_grads`, and the table is the one
+            # weight here whose gradient must not be -- its rows are disjoint per rank and
+            # the gradient a rank holds for its own is already complete. Asked of a layer
+            # of its own: MCore refuses a config that asks for sequence parallelism without
+            # tensor parallelism and this world has one rank, but the sweep reads the
+            # config and nothing here runs the layer.
+            sweep = build_ple_layer(make_config(table_dir=root, sequence_parallel=True, tensor_model_parallel_size=2))
+            others = [(name, p) for name, p in sweep.named_parameters() if p is not sweep.ple_embedding.weight]
+            ok &= _check(
+                not getattr(sweep.ple_embedding.weight, 'sequence_parallel', False)
+                and others
+                and all(getattr(p, 'sequence_parallel', False) for _, p in others),
+                'the table is left out of the sequence-parallel sweep and nothing else is',
+                f'{len(others)} other parameters',
+            )
+            # The load writes into a leaf that requires grad: an in-place write into a
+            # view of one is an error outside `no_grad`, which is what a load is.
+            embedding.load_table()
+            ok &= _check(
+                torch.equal(embedding.weight.detach().cpu(), dense),
+                'the shard-at-a-time load lands in the parameter',
+                f'{tuple(embedding.weight.shape)}',
+            )
+
+            # The same checkpoint through the buffer form, with these weights: the two
+            # forms have to be one model. (The frozen layer is built second, so it holds
+            # a host buffer -- the same module class, told apart by the switch alone.)
+            os.environ[ple_module.PLE_CPU_OFFLOAD_ENV] = '1'
+            frozen = build_ple_layer(make_config(table_dir=root)).cpu()
+            gated.cpu()
+            embedding_frozen = frozen.ple_embedding
+            ok &= _check(
+                'weight' in embedding_frozen._buffers and set(gated.state_dict()) == set(frozen.state_dict()),
+                'the two forms are one state dict: the same names, a buffer on one side and a parameter on the other',
+                f'{len(gated.state_dict())} tensors each',
+            )
+            embedding_frozen.load_table()
+            # A load of one form's state dict into the other, which is what a framework
+            # checkpoint does to the frozen form on the way in.
+            frozen.load_state_dict(gated.state_dict())
+        finally:
+            os.environ.pop(ple_module.PLE_CPU_OFFLOAD_ENV, None)
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+# 10. the sharded layout's collectives, on two dies
+# --------------------------------------------------------------------------------------
+TWO_DIE_STAGE = 'sp2'
+# Set in each child: which rank it is, and the table directory the two of them share. The
+# driver reads the die list off `TWO_DIE_DEVICES_ENV`.
+TWO_DIE_RANK_ENV = 'QWEN4_EXP_PLE_SP2_RANK'
+TWO_DIE_TABLE_ENV = 'QWEN4_EXP_PLE_SP2_TABLE'
+TWO_DIE_DEVICES_ENV = 'QWEN4_EXP_PLE_SP2_DEVICES'
+TWO_DIE_TIMEOUT = 1200
+TWO_DIE_TOKENS = 40
+# One sample that spans the chunk boundary and one that begins inside the second chunk,
+# so the second rank's halo is half real frames and half a zero pad -- the place where
+# `_short_conv_halo`'s two kinds of pad meet.
+TWO_DIE_SAMPLES = [24, 16]
+
+
+def _two_die_child() -> int:
+    """One rank of the two-die stage: one layer, both layouts, against each other.
+
+    Everything the one-rank stage has to fake is real here -- the tensor-parallel group,
+    the gather of the ids, the lookup's reduce-scatter, the halo all-gather and the
+    backward of each -- and the comparison is in both layouts' own terms: *this* rank's
+    rows of the output, *this* rank's rows of the input gradient, and the TP *sum* of
+    every parameter gradient, which is what ``finalize_model_grads`` makes of the ones
+    the plugin marks ``sequence_parallel``. The per-rank partials of those deliberately do
+    not match: each rank differentiates its own chunk, and either layout's partials add
+    up to the full-sequence gradient (see :func:`_keep_own_chunk`).
+
+    Rank 0's last ``halo`` input rows are the sharp end of it. Those frames feed the
+    *next* rank's convolution, so their gradient only exists if the halo exchange's
+    backward carries it -- a detached or mis-wired all-gather leaves them short by the
+    taps they owe, and nothing else in the file would notice.
+    """
+    from megatron.core import parallel_state
+    from megatron.core.tensor_parallel import model_parallel_cuda_manual_seed
+
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.ple import PLE_SP_FULL_SEQUENCE_ENV
+
+    sys.stdout.reconfigure(line_buffering=True)  # the driver shows this log when a rank fails
+    rank = int(os.environ[TWO_DIE_RANK_ENV])
+    torch.npu.set_device(int(os.environ.get('LOCAL_RANK', '0')))
+    torch.distributed.init_process_group(backend='hccl', init_method='env://')
+    parallel_state.initialize_model_parallel(tensor_model_parallel_size=2)
+    model_parallel_cuda_manual_seed(1234)
+    group = parallel_state.get_tensor_model_parallel_group()
+    print(f'    [setup] rank {rank} of 2 on device {torch.cuda.current_device()}', flush=True)
+
+    config = make_config(table_dir=os.environ[TWO_DIE_TABLE_ENV], sequence_parallel=True, tensor_model_parallel_size=2)
+    with torch.no_grad():
+        layer = build_ple_layer(config).npu().eval()
+    layer.ple_embedding.load_table()
+    # `model_parallel_cuda_manual_seed` seeds per tensor-parallel rank, so the two ranks
+    # would otherwise hold two different initializations of every linear and norm in the
+    # layer, and the two layouts would be compared across two models. The table is
+    # deliberately not part of this: its two halves are *different* rows of one table, and
+    # a broadcast from rank 0 would overwrite rank 1's with rank 0's. It is a buffer here
+    # -- which already keeps it out of `named_parameters()` -- but skipping it by identity
+    # keeps that true if this stage is ever run with the trainable gate on.
+    table_weight = layer.ple_embedding.weight
+    with torch.no_grad():
+        for _name, parameter in layer.named_parameters():
+            if parameter is table_weight:
+                continue
+            torch.distributed.broadcast(parameter.data, src=0)
+
+    # One batch, both ranks: the same values on each, of which each rank holds its chunk.
+    generator = torch.Generator().manual_seed(20261015)
+    full_hidden = torch.randn(TWO_DIE_TOKENS, 1, HC_HIDDEN, generator=generator)
+    full_ids = torch.randint(0, SMALL['vocab_size'], (TWO_DIE_TOKENS, 1), generator=generator, dtype=torch.long)
+    local = TWO_DIE_TOKENS // 2
+    own = slice(rank * local, (rank + 1) * local)
+    halo = (SMALL['ple_conv_kernel_size'] - 1) * SMALL['ngram_size']
+
+    def run(packed, full_sequence: bool):
+        """This rank's forward and backward in one layout: its output and every gradient."""
+        os.environ[PLE_SP_FULL_SEQUENCE_ENV] = '1' if full_sequence else '0'
+        sharded = layer._sharded_layout  # pylint: disable=protected-access
+        hidden = full_hidden[own].to('npu').requires_grad_(True)
+        layer.zero_grad(set_to_none=True)
+        output = layer(hidden, full_ids[own].to('npu'), packed)
+        output.float().square().sum().backward()
+        gradients = {}
+        for name, parameter in layer.named_parameters():
+            if parameter.grad is None:
+                gradients[name] = None
+                continue
+            summed = parameter.grad.detach().float().clone()
+            torch.distributed.all_reduce(summed, group=group)
+            gradients[name] = summed.cpu()
+        return SimpleNamespace(
+            sharded=sharded,
+            output=output.detach().float().cpu(),
+            hidden_grad=hidden.grad.detach().float().cpu(),
+            gradients=gradients,
+        )
+
+    cases = [
+        ('one sample', None),
+        (
+            f'samples {TWO_DIE_SAMPLES}',
+            _packed([0, TWO_DIE_SAMPLES[0], sum(TWO_DIE_SAMPLES)]),
+        ),
+    ]
+    ok = True
+    for label, packed in cases:
+        # The full-sequence layout first, on the same weights and the same batch: it is the
+        # one every other stage in this file has already checked against the reference.
+        want, got = run(packed, True), run(packed, False)
+        ok &= _check(
+            want.sharded is False and got.sharded is True,
+            f'rank {rank}, {label}: the two runs really are the two layouts',
+        )
+        passed, detail = _close(got.output, want.output, 1e-5)
+        ok &= _check(passed, f'rank {rank}, {label}: the sharded layout returns the same rows', detail)
+        passed, detail = _close(got.hidden_grad, want.hidden_grad, 1e-5)
+        ok &= _check(passed, f'rank {rank}, {label}: and the same gradient for this rank\'s input rows', detail)
+        missing = sorted(name for name, grad in want.gradients.items() if grad is None or got.gradients[name] is None)
+        ok &= _check(
+            not missing, f'rank {rank}, {label}: every parameter of the layer got a gradient', str(missing[:3])
+        )
+        if not missing:
+            scales = {name: max(1.0, want.gradients[name].abs().max().item()) for name in want.gradients}
+            diffs = {
+                name: (got.gradients[name] - want.gradients[name]).abs().max().item() / scales[name]
+                for name in want.gradients
+            }
+            worst = max(diffs, key=diffs.get)
+            ok &= _check(
+                diffs[worst] <= 1e-5,
+                f'rank {rank}, {label}: the tensor-parallel sum of every parameter gradient agrees',
+                f'worst {worst}: {diffs[worst]:.3e}',
+            )
+        if rank == 0:
+            ok &= _check(
+                want.hidden_grad[-halo:].abs().max().item() > 0,
+                f'rank 0, {label}: the frames the next rank\'s conv reads carry gradient',
+            )
+    print(f'    [summary] rank {rank}: {"PASS" if ok else "FAIL"}', flush=True)
+    return 0 if ok else 1
+
+
+def test_two_die_layout() -> bool:
+    """Run the sharded layout and the full-sequence one on two dies and diff them.
+
+    The one-rank stage above emulates the three collectives off the other rank's own
+    numbers, so it cannot say whether they work: a reduce-scatter handing back the wrong
+    chunk, an all-gather whose backward never returns the halo's gradient, or a
+    ``torch.distributed.nn`` autograd wrapper hccl cannot run at all would each pass it.
+    Same layer, same weights, same batch, two processes -- and the layouts have to agree.
+    """
+    devices = [device for device in os.environ.get(TWO_DIE_DEVICES_ENV, '0,1').split(',') if device]
+    if len(devices) != 2:
+        print(f'    [FAIL] {TWO_DIE_DEVICES_ENV} names {devices}: this stage needs exactly two dies')
+        return False
+    ok = True
+    with tempfile.TemporaryDirectory(prefix='ple-sp2-') as root:
+        write_synthetic_table(root)
+        env = dict(
+            os.environ,
+            # Both dies stay visible and `LOCAL_RANK` picks one, the way the other
+            # multi-die harness in this directory starts its ranks.
+            ASCEND_RT_VISIBLE_DEVICES=','.join(devices),
+            MASTER_ADDR=os.environ.get('MASTER_ADDR', '127.0.0.1'),
+            MASTER_PORT=str(_free_port()),
+            ASCEND_COREDUMP_SIGNAL='none',
+            # The child gets the import path the parent proved works; the repositories are
+            # prepended the way the training scripts spell them, in case this file is run
+            # out of a checkout that is not installed.
+            PYTHONPATH=os.pathsep.join([*[path or os.getcwd() for path in sys.path], os.environ.get('PYTHONPATH', '')]),
+        )
+        for name in ('RANK', 'LOCAL_RANK', 'WORLD_SIZE'):
+            env.pop(name, None)  # the driver tells each child its own
+        env[TWO_DIE_TABLE_ENV] = root
+        # Offset from the ranges the training jobs use, so a stage run alongside one does
+        # not take a socket off it.
+        env.setdefault('HCCL_HOST_SOCKET_PORT_RANGE', '63300-63350')
+        env.setdefault('HCCL_NPU_SOCKET_PORT_RANGE', '64300-64350')
+
+        children, logs = [], []
+        with contextlib.ExitStack() as stack:
+            for rank, device in enumerate(devices):
+                rank_env = dict(env, RANK=str(rank), LOCAL_RANK=str(rank), WORLD_SIZE='2')
+                rank_env[TWO_DIE_RANK_ENV] = str(rank)
+                path = os.path.join(root, f'{TWO_DIE_STAGE}_rank{rank}.log')
+                logs.append(path)
+                handle = stack.enter_context(open(path, 'w', encoding='utf-8'))
+                print(f'    [driver] rank {rank} of 2 on die {device}', flush=True)
+                children.append(
+                    subprocess.Popen(  # pylint: disable=consider-using-with
+                        [sys.executable, '-u', __file__, '--stage', TWO_DIE_STAGE],
+                        env=rank_env,
+                        stdout=handle,
+                        stderr=subprocess.STDOUT,
+                    )
+                )
+            codes, timed_out = [], False
+            try:
+                codes = [child.wait(timeout=TWO_DIE_TIMEOUT) for child in children]
+            except subprocess.TimeoutExpired:
+                timed_out = True
+                for child in children:
+                    child.kill()
+                codes = [child.wait() for child in children]
+        for rank, code in enumerate(codes):
+            print(f'    [driver] rank {rank} exited {code}', flush=True)
+            with open(logs[rank], encoding='utf-8') as handle:
+                lines = handle.read().splitlines()
+            if code:
+                # A rank that died never got to print its checks: show what it did print.
+                lines = lines[-20:]
+            else:
+                marks = ('    [setup]', '    [PASS]', '    [FAIL]', '    [summary]')
+                lines = [line.strip() for line in lines if any(mark in line for mark in marks)]
+            print('\n'.join(f'      {line}' for line in lines))
+        if timed_out:
+            ok &= _check(False, f'a die did not finish in {TWO_DIE_TIMEOUT}s')
+        ok &= _check(codes == [0, 0], 'both dies ran both layouts and found them equal', str(codes))
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+# 11. the EP-routed table, on two dies
+# --------------------------------------------------------------------------------------
+EP_STAGE = 'ep'
+# Set in each child: which rank it is, and the table directory the two of them share. The
+# driver reads the die list off `EP_DEVICES_ENV`.
+EP_RANK_ENV = 'QWEN4_EXP_PLE_EP_RANK'
+EP_TABLE_ENV = 'QWEN4_EXP_PLE_EP_TABLE'
+EP_DEVICES_ENV = 'QWEN4_EXP_PLE_EP_DEVICES'
+EP_TIMEOUT = 900
+EP_TOKENS = 32
+
+
+def test_table_modes() -> bool:
+    """The table form switch, next to the older offload switch, without building anything."""
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp import ple
+
+    ok = True
+    base = {
+        name: value
+        for name, value in os.environ.items()
+        if name not in (ple.PLE_TABLE_MODE_ENV, ple.PLE_CPU_OFFLOAD_ENV, ple.PLE_TABLE_TRAINABLE_ENV)
+    }
+
+    def form_of(**env):
+        with mock.patch.dict(os.environ, dict(base, **env), clear=True):
+            try:
+                return ple._table_form()[0], ''  # pylint: disable=protected-access
+            except ValueError as exc:
+                return None, str(exc)
+
+    mode, _ = form_of()
+    ok &= _check(mode == ple._TABLE_MODE_HOST, 'no switch at all keeps the frozen host buffer', str(mode))
+    mode, _ = form_of(**{ple.PLE_CPU_OFFLOAD_ENV: '0'})
+    ok &= _check(mode == ple._TABLE_MODE_DEVICE_EP, 'the offload switch off picks the device EP form', str(mode))
+    mode, error = form_of(**{ple.PLE_TABLE_MODE_ENV: 'device-tp'})
+    ok &= _check(mode is None and 'names no table form' in error, 'the removed TP form is refused', error[:60])
+    mode, _ = form_of(**{ple.PLE_TABLE_MODE_ENV: 'device-ep'})
+    ok &= _check(mode == ple._TABLE_MODE_DEVICE_EP, 'the mode switch picks the EP form', str(mode))
+    mode, _ = form_of(**{ple.PLE_TABLE_MODE_ENV: 'ep'})
+    ok &= _check(mode == ple._TABLE_MODE_DEVICE_EP, 'and its alias does too', str(mode))
+    mode, _ = form_of(**{ple.PLE_TABLE_MODE_ENV: 'host'})
+    ok &= _check(mode == ple._TABLE_MODE_HOST, 'the mode switch can pin the host form', str(mode))
+    mode, _ = form_of(**{ple.PLE_TABLE_MODE_ENV: 'device-ep', ple.PLE_TABLE_TRAINABLE_ENV: '1'})
+    ok &= _check(mode == ple._TABLE_MODE_DEVICE_EP, 'the trainable switch agrees with a device form', str(mode))
+    mode, error = form_of(**{ple.PLE_TABLE_MODE_ENV: 'nonsense'})
+    ok &= _check(mode is None and 'names no table form' in error, 'an unknown form is refused', error[:60])
+    mode, error = form_of(**{ple.PLE_TABLE_MODE_ENV: 'device-ep', ple.PLE_CPU_OFFLOAD_ENV: '1'})
+    ok &= _check(mode is None and 'stays on the host' in error, 'and so is a mode that contradicts the offload', error[:60])
+    mode, error = form_of(**{ple.PLE_TABLE_MODE_ENV: 'host', ple.PLE_CPU_OFFLOAD_ENV: '0'})
+    ok &= _check(mode is None and 'on the device' in error, 'in either direction', error[:60])
+    return ok
+
+
+def _ep_child() -> int:
+    """One rank of the EP stage: route rows to their owners and back, for real.
+
+    Everything the routing is made of runs here on a real process group: the owner map,
+    the count exchange that yields both split vectors, the variable-split request and
+    return exchanges, and the return exchange's mirrored backward. The owner side is a
+    real device parameter, so the check is both numeric (the routed lookup equals a dense
+    lookup of the same rows) and structural (a row's gradient lands on the rank that owns
+    it, once per request, and nowhere else).
+
+    Both layouts are run through :meth:`Qwen4ExpTextNGramEmbedding.forward`, not just the
+    routing helper: the sharded one has to hand back this rank's sequence-parallel chunk,
+    and the whole-sequence one has to hand back the whole stream without sending every
+    token to its owner on both ranks.
+    """
+    from megatron.core import parallel_state
+    from megatron.core.tensor_parallel import model_parallel_cuda_manual_seed
+
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp import ple as ple_module
+
+    sys.stdout.reconfigure(line_buffering=True)
+    rank = int(os.environ[EP_RANK_ENV])
+    torch.npu.set_device(int(os.environ.get('LOCAL_RANK', '0')))
+    torch.distributed.init_process_group(backend='hccl', init_method='env://')
+    parallel_state.initialize_model_parallel(tensor_model_parallel_size=2)
+    model_parallel_cuda_manual_seed(1234)
+    group = parallel_state.get_tensor_model_parallel_group()
+    print(f'    [setup] rank {rank} of 2 on device {torch.cuda.current_device()}', flush=True)
+
+    config = make_config(table_dir=os.environ[EP_TABLE_ENV], sequence_parallel=True, tensor_model_parallel_size=2)
+    # The two older switches are cleared to empty (which `_env_switch` reads as unset),
+    # so a shell that exports either of them cannot make the form resolution refuse.
+    with mock.patch.dict(
+        os.environ,
+        {
+            ple_module.PLE_TABLE_MODE_ENV: 'device-ep',
+            ple_module.PLE_CPU_OFFLOAD_ENV: '',
+            ple_module.PLE_TABLE_TRAINABLE_ENV: '',
+        },
+    ):
+        embedding = ple_module.Qwen4ExpTextNGramEmbedding(
+            config, 0, pg_collection=SimpleNamespace(ep=group, tp=group)
+        )
+    # A parameter table travels with the module and the three hash-index buffers go with
+    # it, which `ngram_ids` and the routing both read on the device.
+    embedding.npu()
+    ok = True
+    ok &= _check(embedding.table_mode == ple_module._TABLE_MODE_DEVICE_EP, 'the EP form is what was built')
+    ok &= _check(embedding.table.owner_name == 'ep', 'and its row axis is the EP group')
+    ok &= _check(tuple(embedding.weight.shape) == (TABLE_ROWS // 2, TABLE_HEAD_DIM),
+                 'each rank owns half the rows as a device parameter', str(tuple(embedding.weight.shape)))
+    ok &= _check(embedding.weight.requires_grad, 'which is trainable')
+    ok &= _check(getattr(embedding.weight, 'allreduce', True) is False,
+                 'and left out of the dense data-parallel reduction')
+    ok &= _check(not hasattr(embedding.weight, 'sequence_parallel'),
+                 'and out of the tensor-parallel sequence-parallel sum')
+    embedding.load_table()
+
+    def dense_grad() -> torch.Tensor:
+        """Both ranks' gradients, in dense row order."""
+        gathered = [torch.empty_like(embedding.weight.grad) for _ in range(group.size())]
+        torch.distributed.all_gather(gathered, embedding.weight.grad.detach().float(), group=group)
+        return torch.cat(gathered, dim=0).cpu()
+
+    mine = embedding.weight.detach().float()
+    gathered = [torch.empty_like(mine) for _ in range(group.size())]
+    torch.distributed.all_gather(gathered, mine, group=group)
+    dense = torch.cat(gathered, dim=0).cpu()
+
+    # Global row ids, not tokens: `_route_ep_rows` is the lookup itself. Both ranks ask
+    # for five of the same rows -- one from each end and one from either side of the row
+    # boundary -- so each owner answers the other rank too, and repeated ids inside one
+    # request set accumulate on one row.
+    generator = torch.Generator().manual_seed(9000 + rank)
+    ids = torch.randint(0, TABLE_ROWS, (1, 10, NGRAM_HEADS), generator=generator, dtype=torch.long)
+    shared = torch.tensor([0, 1, TABLE_ROWS // 2 - 1, TABLE_ROWS // 2, TABLE_ROWS - 1], dtype=torch.long)
+    ids = torch.cat([ids, shared.view(1, -1, 1).expand(1, shared.numel(), NGRAM_HEADS)], dim=1).npu()
+    embedding.zero_grad(set_to_none=True)
+    out = embedding._route_ep_rows(ids)  # pylint: disable=protected-access
+    want = dense.index_select(0, ids.reshape(-1).cpu()).view(*ids.shape, TABLE_HEAD_DIM)
+    passed, detail = _close(out.detach().float().cpu(), want, 1e-6)
+    ok &= _check(passed, 'a routed lookup is the dense lookup of the same rows', detail)
+    out.float().sum().backward()
+    counts = torch.bincount(ids.reshape(-1), minlength=TABLE_ROWS).float()
+    torch.distributed.all_reduce(counts, group=group)
+    passed, detail = _close(dense_grad(), counts.cpu().view(-1, 1).expand(TABLE_ROWS, TABLE_HEAD_DIM), 1e-6)
+    ok &= _check(passed, 'each row is credited once per request, on its owner only', detail)
+
+    # The two layouts through `forward`: the same full stream on both ranks, of which the
+    # sharded one routes only this rank's chunk and the whole-sequence one routes a chunk
+    # of the lookup each and gathers it back.
+    generator = torch.Generator().manual_seed(4321)
+    full_ids = torch.randint(0, SMALL['vocab_size'], (1, EP_TOKENS), generator=generator, dtype=torch.long).npu()
+    all_ids = embedding.ngram_ids(full_ids)
+    want_full = dense.index_select(0, all_ids.reshape(-1).cpu()).view(1, EP_TOKENS, NGRAM_HEADS, TABLE_HEAD_DIM)
+    want_full = want_full.flatten(-2)
+    expected = torch.bincount(all_ids.reshape(-1), minlength=TABLE_ROWS).float()
+    local = EP_TOKENS // 2
+
+    embedding.zero_grad(set_to_none=True)
+    local_out = embedding(full_ids, None, reduce_scatter=True)
+    want_local = want_full.narrow(1, rank * local, local)
+    passed, detail = _close(local_out.detach().float().cpu(), want_local, 1e-6)
+    ok &= _check(passed, 'the sharded layout returns this rank\'s chunk of the dense lookup', detail)
+    local_out.float().sum().backward()
+    passed, detail = _close(dense_grad(), expected.cpu().view(-1, 1).expand(TABLE_ROWS, TABLE_HEAD_DIM), 1e-6)
+    ok &= _check(passed, 'and the full stream was routed exactly once, not once per rank', detail)
+
+    embedding.zero_grad(set_to_none=True)
+    full_out = embedding(full_ids, None, reduce_scatter=False)
+    passed, detail = _close(full_out.detach().float().cpu(), want_full, 1e-6)
+    ok &= _check(passed, 'the whole-sequence layout returns the whole stream on both ranks', detail)
+    # What the layer does downstream is `_to_local`: it keeps this rank's own chunk of
+    # the full-sequence output, and a slice's backward zero-fills every other chunk
+    # (`_keep_own_chunk`). So the gradient that reaches this rank's routing graph is its
+    # own chunk's alone -- and because the owners answer the whole group, the two ranks'
+    # shards together still cover the whole stream exactly once, not twice. A gather
+    # whose backward summed every rank's full-sequence gradient would credit each row
+    # twice here.
+    mask = torch.zeros_like(full_out)
+    mask[:, rank * local : (rank + 1) * local] = 1
+    (full_out * mask).sum().backward()
+    passed, detail = _close(dense_grad(), expected.cpu().view(-1, 1).expand(TABLE_ROWS, TABLE_HEAD_DIM), 1e-6)
+    ok &= _check(passed, 'and each chunk\'s gradient reaches its owner once, through the gather', detail)
+
+    # The export side of the same coordinates. The module says whose rows a shard is
+    # assembled from -- the EP group and this rank's place in it -- and the mapping
+    # must use that answer, not the tensor-parallel geometry it defaults to: summing
+    # the pieces over the TP group here would read each rank's rows as half a table.
+    from mindspeed_bridge.models.qwen4_exp import qwen4_exp_bridge as bridge_module
+
+    owner_group, owner_rank, owner_size = embedding.table_owner()
+    ok &= _check(
+        owner_group is group and owner_size == group.size() and owner_rank == rank,
+        'the module names the table\'s owners: the EP group and this rank\'s place in it',
+        f'{owner_size} owners, rank {owner_rank}',
+    )
+    mapping = bridge_module.PLENGramEmbeddingMapping(
+        megatron_param='decoder.layers.0.ple.ple_embedding.weight',
+        hf_param='model.language_model.layers.0.ple.ple_embedding.ngram_embedding.shard_{}.weight',
+        num_shards=TABLE_SPLITS,
+    )
+    export = bridge_module._PLEShardExport(mapping, embedding.weight.detach(), embedding)
+    ok &= _check(
+        export._owner_group is owner_group and export._owner_size == owner_size,  # pylint: disable=protected-access
+        'and the export carries them through',
+    )
+    rows_per_shard = TABLE_ROWS // TABLE_SPLITS
+    for shard_index in range(TABLE_SPLITS):
+        want = dense[shard_index * rows_per_shard : (shard_index + 1) * rows_per_shard]
+        got = export[f'model.language_model.layers.0.ple.ple_embedding.ngram_embedding.shard_{shard_index}.weight']
+        passed, detail = _close(got.float(), want, 1e-6)
+        ok &= _check(passed, f'the export assembles shard {shard_index} off the EP rows', detail)
+
+    # The save side. Under `QWEN4_EXP_PLE_TABLE_IN_DCP=1` the table is declared as the
+    # row range this rank owns -- not as a TP-sharded tensor of the same shape, which
+    # is what the other two forms write -- and with a replica id DCP's
+    # `keep_only_main_replica` reads as main. The TP component is the one that matters:
+    # a non-zero one is exactly how the row-routed checkpoint would keep one rank's
+    # rows and drop the other's without a word. At this shape the expert-data-parallel
+    # group is a single rank, so every owner is main.
+    from megatron.core.transformer.utils import ensure_metadata_has_dp_cp_group
+    from megatron.core.utils import get_pg_rank
+
+    with mock.patch.dict(os.environ, {ple_module.PLE_TABLE_IN_DCP_ENV: '1'}):
+        sharded = embedding.sharded_state_dict(
+            'decoder.layers.0.ple.ple_embedding.', metadata=ensure_metadata_has_dp_cp_group(None)
+        )
+    entry = sharded['decoder.layers.0.ple.ple_embedding.weight']
+    ok &= _check(
+        tuple(entry.global_shape) == (TABLE_ROWS, TABLE_HEAD_DIM)
+        and tuple(entry.global_offset) == (rank * (TABLE_ROWS // 2), 0)
+        and tuple(entry.local_shape) == (TABLE_ROWS // 2, TABLE_HEAD_DIM),
+        'the table is declared as this rank\'s row range of the whole',
+        f'offset {tuple(entry.global_offset)} of {tuple(entry.global_shape)}',
+    )
+    expt_dp_group = embedding._expt_dp_group()  # pylint: disable=protected-access
+    expt_dp_rank = get_pg_rank(expt_dp_group) if expt_dp_group is not None else 0
+    ok &= _check(
+        expt_dp_rank == 0,
+        'and this shape has one expert-data-parallel replica, so every owner is main',
+        f'expt_dp rank {expt_dp_rank}',
+    )
+    ok &= _check(
+        tuple(entry.replica_id) == (0, 0, 0),
+        'the replica id leaves the TP axis out, so the save keeps both ranks\' rows',
+        f'replica_id {tuple(entry.replica_id)}',
+    )
+
+    print(f'    [summary] rank {rank}: {"PASS" if ok else "FAIL"}', flush=True)
+    return 0 if ok else 1
+
+
+def test_ep_two_die() -> bool:
+    """Spawn the EP stage's two ranks and collect their verdicts."""
+    devices = [device for device in os.environ.get(EP_DEVICES_ENV, '0,1').split(',') if device]
+    if len(devices) != 2:
+        print(f'    [FAIL] {EP_DEVICES_ENV} names {devices}: this stage needs exactly two dies')
+        return False
+    ok = True
+    with tempfile.TemporaryDirectory(prefix='ple-ep2-') as root:
+        write_synthetic_table(root)
+        env = dict(
+            os.environ,
+            ASCEND_RT_VISIBLE_DEVICES=','.join(devices),
+            MASTER_ADDR=os.environ.get('MASTER_ADDR', '127.0.0.1'),
+            MASTER_PORT=str(_free_port()),
+            ASCEND_COREDUMP_SIGNAL='none',
+            PYTHONPATH=os.pathsep.join([*[path or os.getcwd() for path in sys.path], os.environ.get('PYTHONPATH', '')]),
+        )
+        for name in ('RANK', 'LOCAL_RANK', 'WORLD_SIZE'):
+            env.pop(name, None)
+        env[EP_TABLE_ENV] = root
+        # Offset from both the training jobs' ranges and the sp2 stage's.
+        env.setdefault('HCCL_HOST_SOCKET_PORT_RANGE', '63360-63410')
+        env.setdefault('HCCL_NPU_SOCKET_PORT_RANGE', '64360-64410')
+
+        children, logs = [], []
+        with contextlib.ExitStack() as stack:
+            for rank, device in enumerate(devices):
+                rank_env = dict(env, RANK=str(rank), LOCAL_RANK=str(rank), WORLD_SIZE='2')
+                rank_env[EP_RANK_ENV] = str(rank)
+                path = os.path.join(root, f'{EP_STAGE}_rank{rank}.log')
+                logs.append(path)
+                handle = stack.enter_context(open(path, 'w', encoding='utf-8'))
+                print(f'    [driver] rank {rank} of 2 on die {device}', flush=True)
+                children.append(
+                    subprocess.Popen(  # pylint: disable=consider-using-with
+                        [sys.executable, '-u', __file__, '--stage', EP_STAGE],
+                        env=rank_env,
+                        stdout=handle,
+                        stderr=subprocess.STDOUT,
+                    )
+                )
+            codes, timed_out = [], False
+            try:
+                codes = [child.wait(timeout=EP_TIMEOUT) for child in children]
+            except subprocess.TimeoutExpired:
+                timed_out = True
+                for child in children:
+                    child.kill()
+                codes = [child.wait() for child in children]
+        for rank, code in enumerate(codes):
+            print(f'    [driver] rank {rank} exited {code}', flush=True)
+            with open(logs[rank], encoding='utf-8') as handle:
+                lines = handle.read().splitlines()
+            if code:
+                lines = lines[-20:]
+            else:
+                marks = ('    [setup]', '    [PASS]', '    [FAIL]', '    [summary]')
+                lines = [line.strip() for line in lines if any(mark in line for mark in marks)]
+            print('\n'.join(f'      {line}' for line in lines))
+        if timed_out:
+            ok &= _check(False, f'a die did not finish in {EP_TIMEOUT}s')
+        ok &= _check(codes == [0, 0], 'both dies routed rows to each other and found the dense table', str(codes))
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+# main
+# --------------------------------------------------------------------------------------
+def main(argv: Optional[list] = None) -> int:
+    parser = argparse.ArgumentParser(description='Qwen4Exp PLE self-tests')
+    parser.add_argument(
+        '--stage',
+        default='all',
+        choices=[
+            'all',
+            'import',
+            'tensors',
+            'hash',
+            'table',
+            'layer',
+            'layout',
+            'conv',
+            'export',
+            'trainable',
+            TWO_DIE_STAGE,
+            EP_STAGE,
+        ],
+    )
+    parser.add_argument(
+        '--checkpoint', default=None, help='checkpoint directory of the tensors stage (default: the env vars)'
+    )
+    parser.add_argument(
+        '--with-table',
+        action='store_true',
+        help='also load the real n-gram shard files into the rank\'s buffer and read a few rows back out',
+    )
+    args = parser.parse_args(argv)
+    print(f'[setup] torch={torch.__version__}')
+
+    # Every stage needs the adaptor, not just the two that use the NPU: touching
+    # this package at all runs `qwen4_exp/__init__.py`, which imports the bridge,
+    # which imports `megatron.bridge` -> `megatron.core` -> `transformer_engine_torch`
+    # -- and that module only exists once `mindspeed.megatron_adaptor` has installed
+    # its stand-in. Without this the CPU-only stages (`tensors`, `hash`, `table`)
+    # died at their first plugin import with a `ModuleNotFoundError` naming a module
+    # they never import.
+    _setup_npu()
+    if os.environ.get(TWO_DIE_RANK_ENV) is not None:
+        # One rank of the two-die stage, re-entered through this same file: it does its
+        # own process group, on the device the driver left visible for it.
+        return _two_die_child()
+    if os.environ.get(EP_RANK_ENV) is not None:
+        # Likewise for the EP stage: the driver leaves one die visible to each rank.
+        return _ep_child()
+
+    results = {}
+
+    def run(label, fn, *a, **kw):
+        try:
+            results[label] = fn(*a, **kw)
+        except BaseException as exc:  # noqa: BLE001 - self-test must report, not raise
+            results[label] = False
+            print(f'    [ERROR] {label}: {type(exc).__name__}: {exc}')
+            traceback.print_exc()
+
+    if args.stage in ('all', EP_STAGE):
+        # Neither of these builds a model, and both have to run before `_init_dist`:
+        # the mode stage only reads the environment, and the EP stage hands two dies
+        # to its children, which the parent must not be holding -- nor an hccl context
+        # of its own -- while they claim one.
+        run('table modes', test_table_modes)
+        run('ep routing', test_ep_two_die)
+    if args.stage in ('all', TWO_DIE_STAGE):
+        # Before `_init_dist`: this stage hands two dies to its children, and the parent
+        # must not hold a device -- or an hccl context of its own -- while they claim one.
+        run('two-die layout', test_two_die_layout)
+    if args.stage in ('all', 'layer', 'layout', 'export', 'trainable'):
+        _init_dist()
+
+    if args.stage in ('all', 'import'):
+        run('import smoke', test_import_smoke)
+    if args.stage in ('all', 'tensors'):
+        run('checkpoint index buffers', test_checkpoint_tensors, args.checkpoint, args.with_table)
+    if args.stage in ('all', 'hash'):
+        run('hash vs reference', test_hash)
+        run('sample boundaries', test_segments)
+    if args.stage in ('all', 'table'):
+        run('table lookup', test_table)
+    if args.stage in ('all', 'layer'):
+        run('layer vs reference', test_layer)
+    if args.stage in ('all', 'layout'):
+        run('sequence-parallel layout', test_layout)
+    if args.stage in ('all', 'conv'):
+        run('sharded conv', test_halo_conv)
+    if args.stage in ('all', 'export'):
+        run('shard export', test_export)
+    if args.stage in ('all', 'trainable'):
+        run('trainable table', test_trainable)
+
+    print('\n=== summary ===')
+    for label, ok in results.items():
+        print(f'  {"PASS" if ok else "FAIL"}  {label}')
+    failed = [k for k, v in results.items() if not v]
+    print(f'\n{len(results) - len(failed)}/{len(results)} passed' + (f'; FAILED: {failed}' if failed else ''))
+    return 1 if failed else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
