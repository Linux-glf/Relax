@@ -0,0 +1,160 @@
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""HuggingFace <-> Megatron weight mapping for multimodal Qwen3.8-Flash-Next.
+
+The checkpoint is a vision-language model: ``model.language_model.`` holds the
+text tower, ``model.visual.`` the vision tower and ``mtp.`` the MTP head. The
+text half of the mapping is the one of
+:class:`~mindspeed_bridge.models.qwen4_exp.qwen4_exp_bridge.Qwen4ExpBridge` and
+is reused here as it is -- the Megatron model owns the text tower directly, so
+its parameter names are unchanged -- and this module adds the vision tower.
+
+Vision tower naming (the same conventions the Qwen3.5-VL bridge and
+``tests/test_vision.py`` use):
+
+* ``model.visual.blocks.N.norm1`` is the pre-attention LayerNorm
+  (``decoder.layers.N.input_layernorm``), ``norm2`` the pre-MLP one
+  (``pre_mlp_layernorm``);
+* the attention projection is one fused ``attn.qkv`` tensor laid out as
+  ``[all q | all k | all v]``, which :class:`ConcatenatedQKVMapping` interleaves
+  into Megatron's per-group ``[q k v]`` layout;
+* the merger's LayerNorm is ``merger.norm`` in the checkpoint and
+  ``merger.patch_norm`` in Megatron;
+* ``patch_embed.proj`` (a ``Conv3d``) and ``pos_embed`` (an ``nn.Embedding``)
+  are replicated across tensor-parallel ranks: neither is sharded here.
+
+Registering this bridge for the same HF class as the text bridge is deliberate:
+``AutoBridge`` dispatches on the source class alone, and this checkpoint *is*
+multimodal, so the VL model is what a plain ``AutoBridge.from_hf_pretrained``
+has to build. The text model stays reachable by constructing it (and its
+provider) directly, and exporting a VL model back to HF keeps working because
+the reverse dispatch is keyed by the (source, target) pair.
+"""
+
+from __future__ import annotations
+
+from typing import List
+
+from megatron.bridge.models.conversion.mapping_registry import MegatronMappingRegistry
+from megatron.bridge.models.conversion.model_bridge import MegatronModelBridge
+from megatron.bridge.models.conversion.param_mapping import (
+    AutoMapping,
+    ConcatenatedQKVMapping,
+    ReplicatedMapping,
+)
+from megatron.bridge.models.hf_pretrained.causal_lm import PreTrainedCausalLM
+
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.vl_model import Qwen4ExpVLModel
+from mindspeed_bridge.models.qwen4_exp.qwen4_exp_bridge import (
+    _QWEN4_EXP_HF_CLASS_NAME,
+    Qwen4ExpBridge,
+)
+from mindspeed_bridge.models.qwen4_exp.qwen4_exp_vl_provider import Qwen4ExpVLModelProvider
+
+# The vision tower hangs off the model itself (`visual.`), the way HF keeps it
+# under `model.visual.`; the text tower has no wrapper module in either format.
+_HF_VISION = "model.visual."
+_MG_VISION = "visual."
+
+
+@MegatronModelBridge.register_bridge(
+    source=_QWEN4_EXP_HF_CLASS_NAME,
+    target=Qwen4ExpVLModel,
+    provider=Qwen4ExpVLModelProvider,
+    model_type="qwen4_exp",
+)
+class Qwen4ExpVLBridge(Qwen4ExpBridge):
+    """Bridge for the full Qwen3.8-Flash-Next checkpoint (text + vision + MTP).
+
+    Example:
+        >>> from megatron.bridge import AutoBridge
+        >>> bridge = AutoBridge.from_hf_pretrained("Qwen/Qwen3.8-Flash-Next")
+        >>> provider = bridge.to_megatron_provider()
+    """
+
+    def provider_bridge(self, hf_pretrained: PreTrainedCausalLM) -> Qwen4ExpVLModelProvider:
+        """Build a :class:`Qwen4ExpVLModelProvider` from the checkpoint config."""
+        provider = super().provider_bridge(hf_pretrained)
+
+        hf_config = hf_pretrained.config
+        vision_config = getattr(hf_config, "vision_config", None)
+        assert vision_config is not None, (
+            "the checkpoint carries no vision config, so it cannot be a Qwen4Exp VL model: "
+            "use Qwen4ExpBridge / Qwen4ExpModelProvider for the text tower alone."
+        )
+        provider.vision_config = vision_config
+
+        # The ids that mark the vision placeholders in the sequence travel with
+        # the tokenizer, so they come from the checkpoint rather than from an
+        # architecture constant.
+        provider.image_token_id = getattr(hf_config, "image_token_id", 248056)
+        provider.video_token_id = getattr(hf_config, "video_token_id", 248057)
+        provider.vision_start_token_id = getattr(hf_config, "vision_start_token_id", 248053)
+        provider.vision_end_token_id = getattr(hf_config, "vision_end_token_id", 248054)
+        provider.spatial_merge_size = getattr(vision_config, "spatial_merge_size", 2)
+        return provider
+
+    def mapping_registry(self) -> MegatronMappingRegistry:
+        """Text mappings of the checkpoint plus the vision tower's."""
+        mappings = super().mapping_registry().get_all_mappings()
+        mappings.extend(self._vision_mappings())
+        return MegatronMappingRegistry(*mappings)
+
+    def _vision_mappings(self) -> List:
+        """Parameter mappings of ``model.visual.`` <-> ``visual.``."""
+        mapping_list = []
+        for megatron_param, hf_param in self._vision_param_mappings().items():
+            mapping_list.append(AutoMapping(megatron_param=megatron_param, hf_param=hf_param))
+
+        mapping_list.extend(
+            [
+                # One fused [q | k | v] tensor per block in the checkpoint;
+                # Megatron keeps the three inside every query group. The vision
+                # tower has as many query groups as heads (no GQA), so the
+                # interleaving is a plain head-wise reshuffle.
+                ConcatenatedQKVMapping(
+                    megatron_param=f"{_MG_VISION}decoder.layers.*.self_attention.linear_qkv.weight",
+                    hf_param=f"{_HF_VISION}blocks.*.attn.qkv.weight",
+                ),
+                ConcatenatedQKVMapping(
+                    megatron_param=f"{_MG_VISION}decoder.layers.*.self_attention.linear_qkv.bias",
+                    hf_param=f"{_HF_VISION}blocks.*.attn.qkv.bias",
+                ),
+                # The patch projection is a convolution and the position table an
+                # embedding: neither is tensor-parallel in this tower, and their
+                # module types are not linear layers the automatic detection
+                # could classify.
+                ReplicatedMapping(
+                    megatron_param=f"{_MG_VISION}patch_embed.proj.**",
+                    hf_param=f"{_HF_VISION}patch_embed.proj.**",
+                ),
+                ReplicatedMapping(
+                    megatron_param=f"{_MG_VISION}pos_embed.weight",
+                    hf_param=f"{_HF_VISION}pos_embed.weight",
+                ),
+            ]
+        )
+        return mapping_list
+
+    @staticmethod
+    def _vision_param_mappings() -> dict:
+        """Vision parameters whose names only differ by prefix (and by ``norm1``/``norm2``)."""
+        mappings = {}
+
+        def add(megatron_suffix: str, hf_suffix: str) -> None:
+            mappings[f"{_MG_VISION}{megatron_suffix}"] = f"{_HF_VISION}{hf_suffix}"
+
+        for param in ("weight", "bias"):
+            add(f"decoder.layers.*.input_layernorm.{param}", f"blocks.*.norm1.{param}")
+            add(f"decoder.layers.*.pre_mlp_layernorm.{param}", f"blocks.*.norm2.{param}")
+            add(f"decoder.layers.*.self_attention.linear_proj.{param}", f"blocks.*.attn.proj.{param}")
+            add(f"decoder.layers.*.mlp.linear_fc1.{param}", f"blocks.*.mlp.linear_fc1.{param}")
+            add(f"decoder.layers.*.mlp.linear_fc2.{param}", f"blocks.*.mlp.linear_fc2.{param}")
+            add(f"merger.linear_fc1.{param}", f"merger.linear_fc1.{param}")
+            add(f"merger.linear_fc2.{param}", f"merger.linear_fc2.{param}")
+
+        # The merger's LayerNorm keeps its checkpoint name except for the
+        # `norm` -> `patch_norm` rename. `**` covers the weight and the bias.
+        add("merger.patch_norm.**", "merger.norm.**")
+        return mappings
