+            f"{_MG_TEXT}mtp.layers.0.mtp_model_layer.attn_hyper_connection.input_mix_weight_up.weight": "mtp.layers.0.attn_hyper_connection.input_mix_weight_up.weight",
+            f"{_MG_TEXT}mtp.layers.0.mtp_model_layer.attn_hyper_connection.block_inject_weight.weight": "mtp.layers.0.attn_hyper_connection.block_inject_weight.weight",
