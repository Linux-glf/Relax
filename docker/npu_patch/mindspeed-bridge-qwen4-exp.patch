+    want = _reference_expansion(order, picked, layout, R)
+    print(f'carrier {tuple(carrier.shape)} {carrier.dtype} -> tokens {tuple(got.shape)} {got.dtype}')
+    same = torch.equal(got, want)
+    print(f'expansion matches the column-wise reference: {same}')
+    ok &= same and got.dtype == torch.int32 and got.shape == want.shape
+
+    # the own block is the carrier's last column, and every entry is doc_start + b*R
+    own_ok = torch.equal(carrier[:, -1], layout.tail_base)
+    grid_ok = bool(((carrier.to(torch.int64) - layout.doc_start32[:, None]) % R == 0)[carrier >= 0].all())
+    print(f'own block last: {own_ok}; every start on the R grid: {grid_ok}')
+    ok &= own_ok and grid_ok
