+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Per-layer embeddings (PLE) for Qwen3.8-Flash-Next (``qwen4_exp``).
+
+PLE injects a hashed n-gram lookup into the ``hc_count * hidden_size`` wide
+hyper-connection stream of layer 1 (one-indexed layer 2), before that layer's
+``attn_hyper_connection``. It is 29% of the released checkpoint: the n-gram table
+is 320,001,536 rows of 160 values -- 16 heads of 160 dims each, ``51.2B``
+parameters, 95.4 GiB in bf16 -- and the nine tensors around it (two projections,
+three grouped norms, one depthwise dilated conv, three int64 index buffers) are
+negligible next to it.
+
+Three properties of the reference implementation shape this module:
+
+* **the table lives off the device, and it is a weight.** The HF model declares it
+  in ``_no_placement_params`` ("~95 GiB ... skip from device_map") and gathers rows
+  from host memory every forward; here it is a persistent buffer of the module --
+  pinned host memory, never a device tensor -- holding this rank's rows of the
+  ``split_ngram_parts``-sharded table, the way ``VocabParallelEmbedding`` shards a
+  vocabulary. So it is a weight the bridge can map in both directions
+  (``qwen4_exp_bridge.PLENGramEmbeddingMapping``) and a checkpoint can carry, and
+  nothing that walks ``parameters()`` ever sees it: frozen by construction, which
+  is also the only option on 8 x 64 GB -- the Adam state of 51.2B parameters alone
+  is ~717 GB. That is the form :data:`PLE_CPU_OFFLOAD_ENV` turns *on*, and it is
+  the default. Turned off, the table is a device ``nn.Parameter`` row-sharded over
+  the *expert-parallel* group (:data:`PLE_TABLE_MODE_ENV` = ``device-ep``): trainable,
+  1.6 GiB per rank of the released table at ep=64, with an all-to-all lookup to the
+  rows' owners. That is the only form the full 95.4 GiB table can be trained in -- a
+  TP shard at tp=8 would be 11.9 GiB plus ~51 GiB of Adam state per die -- and the
+  one the 64-die plan uses.
+* **the n-gram hash needs the whole sequence, and so does the conv.** The hash
+  XORs the current token with the previous one and two (reset at every EOS), and
+  the short conv is a dilated depthwise ``Conv1d(kernel=4, dilation=3)`` over the
+  flattened ``hc_hidden`` axis, i.e. it reads nine tokens back. Both are therefore
+  computed on the *gathered* full sequence and the result is sliced back, exactly
+  the way the QSA indexer gathers what it needs (``layer.py``); the backward of
+  the gather delivers each rank the gradient of its own tokens, and because a
+  rank's loss only depends on its own rows, every parameter's gradient stays a
+  sum of disjoint partials -- no double counting under sequence or context
+  parallelism.
+* **a packed stream is a sequence of samples, and the reference never mixes
+  them.** The reference runs one sample per row, so a sample's first tokens hash
+  against EOS and its first conv window is zeros; a packed ``thd`` batch holds
+  all of them in one row instead, where the hash would read the sample before it
+  and the conv would read its last frames. Both windows are therefore cut at the
+  sample boundaries the batch carries (``_segment_start``, ``_sequence_lengths``),
+  which is also what makes a padded stream come out right: a sample's padding
+  trails it, so it sits inside that sample's own segment and outside every other
+  one. Note that this is *not* the same thing as resetting at EOS: the reference
+  resets at the boundary whether or not a sample ends with the hash's EOS, and
+  the samples of an SFT batch end with ``<|im_end|>``, not with
+  ``<|endoftext|>``.
+
+The math is a line-by-line port of ``transformers``'
+``Qwen4ExpTextNGramEmbedding`` / ``Qwen4ExpTextPLELayer`` (the training variant:
+no KV/conv cache -- the two context tokens are filled with EOS and the conv is
+left-padded instead), which is also what mcore-bridge's ``modules/ple.py``
+implements.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import math
+import os
+import re
+import struct
+from typing import Callable, Dict, List, Optional, Tuple
+
+import torch
+import torch.nn.functional as F
+from torch import Tensor, nn
+
+from megatron.core import tensor_parallel
+from megatron.core.dist_checkpointing.mapping import ShardedTensor
+from megatron.core.transformer.utils import (
+    ensure_metadata_has_dp_cp_group,
+    make_sharded_tensors_for_checkpoint,
+    sharded_state_dict_default,
+)
+from megatron.core.utils import get_pg_rank, make_tp_sharded_tensor_for_checkpoint
+
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.cp_split import (
+    cp_local_index,
+    padded_sample_lengths,
+)
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.linear import ReplicatedLinear
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.norms import (
+    Qwen4ExpTextGroupedRMSNorm,
+)
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.qsa.cp_utils import (
+    reconstruct_tensor_cp,
+)
+
+logger = logging.getLogger(__name__)
+
+# Directory (or single ``.safetensors`` file) the n-gram table is read from. The
+# bridge fills ``config.ple_table_dir`` from the checkpoint it was pointed at;
+# this is the escape hatch for a table that lives somewhere else.
+PLE_TABLE_ENV = 'QWEN4_EXP_PLE_TABLE_DIR'
+
+# `transformers.models.qwen4_exp.modeling_qwen4_exp`, constants of the hash.
+_SPLITMIX_GAMMA = 0x9E3779B97F4A7C15
+_SPLITMIX_M1 = 0xBF58476D1CE4E5B9
+_SPLITMIX_M2 = 0x94D049BB133111EB
+_MASK64 = (1 << 64) - 1
+_PRIME_1 = 10007
+
+_SHARD_RE = re.compile(r'ngram_embedding\.shard_(\d+)\.weight$')
+
+# Rows copied per `PinnedNGramTable.fill` step: the source is a byte window into a
+# safetensors file, so this bounds the transient of a load, not what it reads.
+_FILL_CHUNK_ROWS = 1 << 18
+
+# Tokens per lookup chunk. A lookup is a host gather plus a host-to-device transfer,
+# and one chunk of each is in flight at a time -- the same bound the GPU branch uses.
+_LOOKUP_CHUNK_TOKENS = 4096
+
+# Whether the n-gram table joins distributed checkpoints. **Off by default**, for two
+# reasons that fall out of the same fact -- the table is a frozen artifact that no step
+# changes: a checkpoint then holds the model's own tensors only (and a resume that does
+# not reload the HF checkpoint fails fast on an unloaded table instead of training on a
+# zeroed one), and the save stays cheap. On Ascend it does not: the TP owners write
+# 51.2 GiB apiece while every other rank writes ~3.7 GB, and that skew outlives the 120 s
+# HCCL rendezvous inside `AsyncCallsQueue.execute_sync`'s trailing `barrier()` (measured
+# 2026-10-15: rank 0's `__0_0.distcp` was 54.3 GB against 3.5-3.9 GB everywhere else, and
+# the run died in the save with `TransportInit ... peerrank did not send the data in
+# time`). Set the env var to `1` to take part again -- the GPU branch's behaviour, and
+# what a save->load DCP round trip would exercise.
+PLE_TABLE_IN_DCP_ENV = 'QWEN4_EXP_PLE_TABLE_IN_DCP'
+
+# Whether the n-gram table is offloaded to pinned host memory, spelled the way the GPU
+# branch spells it (`QWEN48_PLE_CPU_OFFLOAD`). **On by default**: the released table is
+# 51.2B parameters (95.4 GiB bf16) and no die holds that plus its Adam state. Turned off,
+# the table is a device `nn.Parameter`, row-sharded over the expert-parallel group and
+# trainable (see :data:`PLE_TABLE_MODE_ENV`).
+#
+# `QWEN4_EXP_PLE_TABLE_TRAINABLE` is the old negation of this switch and is still read;
+# setting both to disagreeing values raises in `_offload_setting`.
+PLE_CPU_OFFLOAD_ENV = 'QWEN4_EXP_PLE_CPU_OFFLOAD'
+PLE_TABLE_TRAINABLE_ENV = 'QWEN4_EXP_PLE_TABLE_TRAINABLE'
+
+# Escape hatch for the sequence-parallel layout: `1` runs the PLE layer on the whole
+# gathered sequence even when every rank could have kept its own chunk. Set for an A/B of
+# the two layouts (`_to_full` versus the sharded path) on one and the same step, and left
+# unset otherwise. It changes nothing outside the sharded case it applies to.
+PLE_SP_FULL_SEQUENCE_ENV = 'QWEN4_EXP_PLE_SP_FULL_SEQUENCE'
+
+# The table form, when the offload switch alone is not explicit enough:
+#
+# * ``host`` -- frozen buffer in pinned host memory, one contiguous row range per
+#   tensor-parallel rank (the default).
+# * ``device-ep`` -- device ``nn.Parameter``, trainable, rows sharded over the
+#   expert-parallel group. This is the only form in which the released 95.4 GiB table
+#   can be trained on 16-64 dies: 1.6 GiB per rank at ep=64, against the 11.9 GiB table
+#   plus Adam state a TP shard would need at tp=8. The lookup is an all-to-all round
+#   trip to the rows' owners (see :meth:`Qwen4ExpTextNGramEmbedding._route_ep_rows`).
+#
+# Unset means :data:`PLE_CPU_OFFLOAD_ENV` decides: on -> ``host``, off -> ``device-ep``.
+PLE_TABLE_MODE_ENV = 'QWEN4_EXP_PLE_TABLE_MODE'
+
+_TABLE_MODE_HOST = 'host'
+_TABLE_MODE_DEVICE_EP = 'device-ep'
+
+_TABLE_MODE_ALIASES = {
+    'host': _TABLE_MODE_HOST,
+    'offload': _TABLE_MODE_HOST,
+    'device-ep': _TABLE_MODE_DEVICE_EP,
+    'ep': _TABLE_MODE_DEVICE_EP,
+}
+
+
+def _table_mode() -> Optional[str]:
+    """The form named by :data:`PLE_TABLE_MODE_ENV`, or ``None`` when it is unset."""
+    raw = os.environ.get(PLE_TABLE_MODE_ENV)
+    if raw is None or not raw.strip():
+        return None
+    value = raw.strip().lower()
+    mode = _TABLE_MODE_ALIASES.get(value)
+    if mode is None:
+        raise ValueError(
+            f'{PLE_TABLE_MODE_ENV}={raw!r} names no table form: use '
+            f'{_TABLE_MODE_HOST!r} (frozen pinned host buffer, TP row shards) or '
+            f'{_TABLE_MODE_DEVICE_EP!r} (device parameter, EP row shards).'
+        )
+    return mode
+
+
+def _table_form() -> Tuple[str, str]:
+    """``(mode, how)``: which form to build, and the switch that said so.
+
+    Kept next to :func:`_offload_setting` because the two answer the same question when
+    :data:`PLE_TABLE_MODE_ENV` is unset. With it set, the older switch still has to agree
+    about host versus device -- a recipe that sets both, to values that contradict, is
+    told so rather than silently letting one win.
+    """
+    mode = _table_mode()
+    if mode is None:
+        offloaded, how = _offload_setting()
+        return (_TABLE_MODE_HOST if offloaded else _TABLE_MODE_DEVICE_EP), how
+    # Resolve the older switch, including its own contradiction check, before deciding
+    # whether it disagrees with the mode.
+    offloaded, how = _offload_setting()
+    offload = _env_switch(PLE_CPU_OFFLOAD_ENV)
+    trainable = _env_switch(PLE_TABLE_TRAINABLE_ENV)
+    explicit_host = offload is True or trainable is False
+    explicit_device = offload is False or trainable is True
+    if mode == _TABLE_MODE_HOST and explicit_device:
+        raise ValueError(
+            f'{PLE_TABLE_MODE_ENV}={mode} keeps the table in pinned host memory, but {how} says it is on the '
+            'device. Set one switch, or set both to agree.'
+        )
+    if mode != _TABLE_MODE_HOST and explicit_host:
+        raise ValueError(
+            f'{PLE_TABLE_MODE_ENV}={mode} puts the table on the device, but {how} says it stays on the host. '
+            'Set one switch, or set both to agree.'
+        )
+    return mode, f'{PLE_TABLE_MODE_ENV}={mode}'
+
+
+def _sp_full_sequence() -> bool:
+    """Whether the whole-sequence layout is forced (see :data:`PLE_SP_FULL_SEQUENCE_ENV`)."""
+    return os.environ.get(PLE_SP_FULL_SEQUENCE_ENV, '0').strip().lower() not in ('0', 'false', 'no', 'off')
+
+
+def _env_switch(name: str) -> Optional[bool]:
+    """A three-state switch: ``None`` when its variable is unset or empty, else what it says."""
+    raw = os.environ.get(name)
+    if raw is None or not raw.strip():
+        return None
+    return raw.strip().lower() not in ('0', 'false', 'no', 'off')
+
+
+def _offload_setting() -> Tuple[bool, str]:
+    """``(offloaded, how)``: where the n-gram table is built, and the switch that decided it.
+
+    ``offloaded`` is whether the table is the frozen pinned host buffer of
+    :data:`PLE_CPU_OFFLOAD_ENV`; ``how`` is the name and value that said so, for the log
+    line -- the two forms differ in nothing a later read of a checkpoint or a log would
+    otherwise show, so the one place that builds the table says which one it built.
+    """
+    offload = _env_switch(PLE_CPU_OFFLOAD_ENV)
+    trainable = _env_switch(PLE_TABLE_TRAINABLE_ENV)
+    if offload is not None and trainable is not None and offload == trainable:
+        raise ValueError(
+            f'{PLE_CPU_OFFLOAD_ENV}={int(offload)} and {PLE_TABLE_TRAINABLE_ENV}={int(trainable)} are the '
+            'same switch, spelled twice, and they disagree: one says the n-gram table is pinned host memory, '
+            'the other says it is a device parameter. Set one of them (or set both to agree).'
+        )
+    if offload is not None:
+        return offload, f'{PLE_CPU_OFFLOAD_ENV}={int(offload)}'
+    if trainable is not None:
+        return not trainable, f'{PLE_TABLE_TRAINABLE_ENV}={int(trainable)}'
+    return True, f'{PLE_CPU_OFFLOAD_ENV} unset (it defaults to on)'
+
+
+def _table_offloaded() -> bool:
+    """Whether the n-gram table stays on the host (see :data:`PLE_CPU_OFFLOAD_ENV`)."""
+    return _offload_setting()[0]
+
+
+def _splitmix64(value: int) -> int:
+    value = (value + _SPLITMIX_GAMMA) & _MASK64
+    value = ((value ^ (value >> 30)) * _SPLITMIX_M1) & _MASK64
+    value = ((value ^ (value >> 27)) * _SPLITMIX_M2) & _MASK64
+    return (value ^ (value >> 31)) & _MASK64
+
+
+def build_layer_multipliers(unigram_vocab_size: int, ngram_size: int, ple_layer_index: int, seed: int) -> Tensor:
+    """The odd 45-bit salts of the hash (HF ``_build_layer_multipliers``).
+
+    Bounded by ``2**63 // vocab_size`` so that ``token * multiplier`` cannot
+    overflow int64, and odd so that the low bit of the token survives the
+    multiply -- the XOR mix below would lose it otherwise.
+    """
+    multiplier_max = ((1 << 63) - 1) // max(unigram_vocab_size, 1)
+    half_bound = max(1, multiplier_max // 2)
+    base_seed = seed + _PRIME_1 * ple_layer_index
+    return torch.tensor(
+        [
+            2 * (_splitmix64((base_seed + _SPLITMIX_GAMMA * (index + 1)) & _MASK64) % half_bound) + 1
+            for index in range(ngram_size)
+        ],
+        dtype=torch.long,
+    )
+
+
+def _is_prime(value: int) -> bool:
+    if value < 2:
+        return False
+    if value % 2 == 0:
+        return value == 2
+    for divisor in range(3, math.isqrt(value) + 1, 2):
+        if value % divisor == 0:
+            return False
+    return True
+
+
+def find_nth_prime_after(start: int, count: int) -> int:
+    """The ``count``-th prime strictly greater than ``start`` (HF ``_find_nth_prime_after``).
+
+    The per-head vocabularies are primes so that ``hash % vocab`` spreads over
+    the head without a common factor to bias against.
+    """
+    prime = start
+    for _ in range(count):
+        prime += 1
+        while not _is_prime(prime):
+            prime += 1
+    return prime
+
+
+def head_vocab_sizes(ngram_vocab_size_base: int, ngram_heads: int, ple_layer_index: int) -> List[int]:
+    """Per-head prime vocabulary sizes, in the order the heads are concatenated."""
+    return [
+        find_nth_prime_after(ngram_vocab_size_base - 1, ple_layer_index * ngram_heads + head_idx + 1)
+        for head_idx in range(ngram_heads)
+    ]
+
+
+def _read_safetensors_header(path: str) -> Tuple[Dict, int]:
+    """Safetensors metadata of ``path`` and the byte offset its data section starts at."""
+    with open(path, 'rb') as handle:
+        length = struct.unpack('<Q', handle.read(8))[0]
+        header = json.loads(handle.read(length))
+    return header, 8 + length
+
+
+# The dtypes a checkpoint of this model can carry a table entry in. The table is
+# read as whatever the file says it is, never as what the caller assumed: a bf16
+# shard read as fp32 is not a wrong number, it is a different set of bytes.
+_SAFETENSORS_DTYPES = {
+    'BF16': torch.bfloat16,
+    'F16': torch.float16,
+    'F32': torch.float32,
+    'F64': torch.float64,
+}
+
+
+def _safetensors_dtype(name: str, context: str) -> torch.dtype:
+    dtype = _SAFETENSORS_DTYPES.get(name)
+    if dtype is None:
+        raise ValueError(f'{context} is stored as safetensors dtype {name!r}, which this table reader does not map.')
+    return dtype
+
+
+def _table_in_dcp() -> bool:
+    """Whether the n-gram table takes part in distributed checkpoints (see :data:`PLE_TABLE_IN_DCP_ENV`)."""
+    return os.environ.get(PLE_TABLE_IN_DCP_ENV, '0').strip().lower() not in ('0', 'false', 'no', 'off')
+
+
+class _DifferentiableAllToAll(torch.autograd.Function):
+    """Variable-split all-to-all whose backward is the mirrored exchange.
+
+    The return leg of an EP-routed lookup: the owner ranks hand the requested rows back,
+    and the gradient of those rows has to travel the same path in reverse -- owner ``i``'s
+    share of the gradient is exactly what the requesters of its rows sent. The input
+    splits of one direction are the output splits of the other, which is all the backward
+    needs (:meth:`_exchange`).
+
+    ``torch.distributed.nn.functional.all_to_all_single`` is not used for the same reason
+    as in :class:`_HaloAllGather`: its backward is a NCCL-only autograd Function and every
+    other backend takes an emulation this op cannot rely on.
+    """
+
+    @staticmethod
+    def _exchange(group, input_: Tensor, output_splits: List[int], input_splits: List[int]) -> Tensor:
+        output = input_.new_empty((sum(output_splits), *input_.shape[1:]))
+        torch.distributed.all_to_all_single(
+            output,
+            input_.contiguous(),
+            output_split_sizes=output_splits,
+            input_split_sizes=input_splits,
+            group=group,
+        )
+        return output
+
+    @staticmethod
+    def forward(ctx, group, input_: Tensor, output_splits: List[int], input_splits: List[int]) -> Tensor:
+        ctx.group = group
+        ctx.output_splits = output_splits
+        ctx.input_splits = input_splits
+        return _DifferentiableAllToAll._exchange(group, input_, output_splits, input_splits)
+
+    @staticmethod
+    def backward(ctx, grad_output: Tensor):
+        grad_input = _DifferentiableAllToAll._exchange(
+            ctx.group, grad_output, ctx.input_splits, ctx.output_splits
+        )
+        return None, grad_input, None, None
+
+
+def owned_row_span(
+    shard_index: int, rows_per_shard: int, start_row: int, rows_per_rank: int
+) -> Optional[Tuple[int, int, int, int]]:
+    """Where a shard's rows and a rank's rows overlap, in both coordinate systems.
+
+    Returns ``(shard_lo, shard_hi, local_lo, local_hi)``: the row range of the shard
+    and where those same rows sit inside the rank's buffer. ``None`` when the ranges do
+    not touch, which is the usual case for a checkpoint with more shards than ranks.
+
+    One function for all three callers -- filling a rank's buffer, and assembling a
+    shard back out of the ranks for an export -- because a disagreement between them
+    would put rows in the wrong place silently.
+    """
+    shard_start = shard_index * rows_per_shard
+    lo = max(start_row, shard_start)
+    hi = min(start_row + rows_per_rank, shard_start + rows_per_shard)
+    if hi <= lo:
+        return None
+    return lo - shard_start, hi - shard_start, lo - start_row, hi - start_row
+
+
+class PinnedNGramTable:
+    """One owner rank's row shard of the n-gram table, and what fills it.
+
+    The table is a weight like any other, only a large one: ``split_ngram_parts``
+    shards of consecutive rows in the checkpoint, one pinned host buffer per rank in
+    the model, laid out the way ``VocabParallelEmbedding`` shards a vocabulary --
+    rank ``r`` owns ``[r * rows_per_rank, (r + 1) * rows_per_rank)``, so a row's
+    owner is a division and its offset a remainder, with no index to keep.
+
+    A lookup is the vocab-parallel one too: a rank gathers the ids it owns,
+    contributes zeros for the rest, and the ranks' rows are summed. That sum is the
+    row and not an average of it -- every row has exactly one owner, and adding bf16
+    zeros is exact -- so a sharded lookup is bit-identical to gathering the whole
+    table.
+
+    Nothing of the table stays file-backed: the shards are read once, straight out of
+    their byte windows, and only the ones overlapping this rank's rows -- so the 95
+    GiB cost each rank its own share, and no page cache has to be faulted back in on
+    a later step. What the checkpoint's shard layout is *for*, then, is the load and
+    the export: the model holds a shard of the table, the file holds shards of it,
+    and both directions map one to the other.
+
+    Args:
+        table_dir: Directory holding the checkpoint (or the single ``.safetensors``
+            file that carries the whole table); ``None`` until one is known, and
+            only a :meth:`fill` then raises.
+        split_ngram_parts: Number of shards the table was written in.
+        padded_vocab_size: Number of rows, ``split_ngram_parts * rows_per_shard``.
+        head_dim: Width of one row.
+        tp_rank / tp_size: Which contiguous row range this rank owns.
+    """
+
+    def __init__(
+        self,
+        table_dir: Optional[str],
+        split_ngram_parts: int,
+        padded_vocab_size: int,
+        head_dim: int,
+        tp_rank: int = 0,
+        tp_size: int = 1,
+        owner_name: str = 'tp',
+    ) -> None:
+        if padded_vocab_size % split_ngram_parts:
+            raise ValueError(
+                f'the n-gram table has {padded_vocab_size} rows, which does not divide into '
+                f'split_ngram_parts={split_ngram_parts} shards; the run-length prefix that maps a row to its '
+                'shard is only valid when the shards tile the table exactly.'
+            )
+        if padded_vocab_size % tp_size:
+            raise ValueError(
+                f'the n-gram table has {padded_vocab_size} rows, which does not divide into tp_size={tp_size} '
+                'ranks: the row a lookup wants is mapped to its owner by division, so an uneven split would '
+                'need per-row bounds on the hot path.'
+            )
+        self.table_dir = table_dir
+        self.split_ngram_parts = split_ngram_parts
+        self.rows_per_shard = padded_vocab_size // split_ngram_parts
+        self.padded_vocab_size = padded_vocab_size
+        self.head_dim = head_dim
+        self.tp_rank = tp_rank
+        self.tp_size = tp_size
+        # Which group the row ranges above belong to, for the log lines: `tp` for the two
+        # forms sharded over the tensor-parallel group, `ep` for the expert-parallel one.
+        self.owner_name = owner_name
+        self.rows_per_rank = padded_vocab_size // tp_size
+        self.start_row = tp_rank * self.rows_per_rank
+        self._located: Optional[Dict[int, Tuple[str, int, int, List[int], torch.dtype]]] = None
+        self.dtype: Optional[torch.dtype] = None
+
+    # ------------------------------------------------------------------
+    # where the rows are, on disk and in the buffer
+    # ------------------------------------------------------------------
+    @property
+    def located(self) -> Dict[int, Tuple[str, int, int, List[int], torch.dtype]]:
+        """Byte range and dtype of every table shard, resolved once.
+
+        Lazy because the checkpoint directory is not known when the model is built
+        (the bridge fills ``config.ple_table_dir`` from the checkpoint it converts,
+        which may be after the provider was configured) -- and because a build that
+        never loads the table should not read 128 safetensors headers.
+        """
+        if self._located is None:
+            if not self.table_dir:
+                raise RuntimeError(
+                    'PLE is enabled but the n-gram table was not located: set config.ple_table_dir (the bridge '
+                    f'fills it from the checkpoint it converts) or export {PLE_TABLE_ENV}=<checkpoint dir> '
+                    'pointing at a checkpoint that carries the PLE tensors.'
+                )
+            located = _locate_shards(self.table_dir, self.split_ngram_parts)
+            dtypes = {entry[4] for entry in located.values()}
+            if len(dtypes) != 1:
+                raise ValueError(
+                    f'the n-gram table shards under {self.table_dir} are not all stored in the same dtype '
+                    f'({sorted(str(dtype) for dtype in dtypes)}): a table lookup returns one row per head, so '
+                    'they cannot be gathered into a single tensor.'
+                )
+            for index, entry in located.items():
+                if tuple(entry[3]) != (self.rows_per_shard, self.head_dim):
+                    raise ValueError(
+                        f'shard {index} of {entry[0]} is {tuple(entry[3])} while the table is '
+                        f'{self.padded_vocab_size} rows of {self.head_dim} in {self.split_ngram_parts} shards '
+                        f'({self.rows_per_shard} rows each): the shards do not tile the table, so a row would '
+                        'be read from the wrong one.'
+                    )
+            self._located = located
+            self.dtype = located[0][4]
+        return self._located
+
+    def allocate(self, dtype: torch.dtype, pin_memory: bool = True) -> Tensor:
+        """The host buffer this rank's rows live in.
+
+        Pinned because its rows leave for the device on every step: pageable memory
+        would stage each transfer through a bounce buffer of its own. Chosen by the
+        caller's dtype, i.e. the model's: the buffer *is* the weight, and the model
+        reads it without casting.
+        """
+        return torch.empty(self.rows_per_rank, self.head_dim, dtype=dtype, pin_memory=pin_memory)
+
+    def owned_span(self, shard_index: int) -> Optional[Tuple[int, int, int, int]]:
+        """This rank's overlap with shard ``shard_index`` (see :func:`owned_row_span`)."""
+        return owned_row_span(shard_index, self.rows_per_shard, self.start_row, self.rows_per_rank)
+
+    def _window(self, index: int) -> Tensor:
+        """Shard ``index`` mapped -- not read -- out of its file.
+
+        A shard is a window into a much larger safetensors file, so the file is
+        mapped as bytes and the tensor's byte range narrowed and re-viewed:
+        ``from_file`` needs an element size that divides the file, and a byte view
+        always does.
+        """
+        path, byte_offset, byte_length, shape, dtype = self.located[index]
+        itemsize = torch.empty(0, dtype=dtype).element_size()
+        if byte_offset % itemsize or byte_length % itemsize:
+            raise ValueError(
+                f'shard {index} of {path} does not align with {dtype}: the tensor starts at byte '
+                f'{byte_offset} and is {byte_length} bytes long, and both have to be multiples of '
+                f'{itemsize}. A safetensors file is written aligned, so this one was rewritten (entry '
+                'reordering, padding, an fp8 variant), and reading it as it is would hand back rows '
+                'shifted by a few bytes.'
+            )
+        raw = torch.from_file(path, shared=False, size=os.path.getsize(path), dtype=torch.uint8)
+        return raw.narrow(0, byte_offset, byte_length).view(dtype).view(tuple(shape))
+
+    # ------------------------------------------------------------------
+    # load and lookup
+    # ------------------------------------------------------------------
+    def fill(
+        self, weight: Tensor, loader: Optional[Callable[[int], Tensor]] = None, chunk_rows: int = _FILL_CHUNK_ROWS
+    ) -> None:
+        """Copy this rank's rows of every overlapping shard into ``weight``.
+
+        Args:
+            weight: The buffer to fill, this rank's rows of the table.
+            loader: ``callable(shard_index) -> Tensor``; without one the shards are
+                mapped out of the checkpoint's files. A loader is how a load that
+                already has the tensors in hand -- the HF state dict, which fetches
+                one shard per call -- hands them over without a second read.
+            chunk_rows: Rows copied per iteration, so the transient stays a chunk of
+                the rows rather than a slice of the shard.
+
+        Each shard is fetched, chunked over and dropped again, so the transient is one
+        chunk of the buffer rather than one shard of the table.
+        """
+        if tuple(weight.shape) != (self.rows_per_rank, self.head_dim):
+            raise ValueError(
+                f'the n-gram table buffer is {tuple(weight.shape)} while this rank owns '
+                f'{(self.rows_per_rank, self.head_dim)} rows of it ({self.padded_vocab_size} rows over '
+                f'tp_size={self.tp_size} ranks).'
+            )
+        if weight.dtype != self.located[0][4]:
+            logger.warning(
+                'Qwen4Exp PLE: the n-gram table is stored as %s and was cast to the model\'s %s on the way in.',
+                self.located[0][4],
+                weight.dtype,
+            )
+        first = max(0, self.start_row // self.rows_per_shard)
+        last = min(len(self.located) - 1, (self.start_row + self.rows_per_rank - 1) // self.rows_per_shard)
+        loaded = 0
+        for index in range(first, last + 1):
+            span = self.owned_span(index)
+            if span is None:
+                continue
+            shard_lo, shard_hi, local_lo, _ = span
+            shard = self._window(index) if loader is None else loader(index)
+            if tuple(shard.shape) != (self.rows_per_shard, self.head_dim):
+                raise ValueError(
+                    f'shard {index} was handed over as {tuple(shard.shape)} while the table is '
+                    f'{self.padded_vocab_size} rows of {self.head_dim} in {self.split_ngram_parts} shards '
+                    f'({self.rows_per_shard} rows each).'
+                )
+            declared = self.located[index][4]
+            if shard.dtype != declared:
+                raise ValueError(
+                    f'shard {index} was handed over as {shard.dtype} while the checkpoint declares it '
+                    f'{declared}: the shards are read as they were written -- there is no dequantization here, and '
+                    'a quantized variant (fp8 and the like) or a reader of a different checkpoint would be cast '
+                    'row by row into the table without the shape saying anything. The declared dtype names the '
+                    'only layout this reader knows.'
+                )
+            for offset in range(shard_lo, shard_hi, chunk_rows):
+                stop = min(offset + chunk_rows, shard_hi)
+                # With the offload off the destination is a leaf parameter that
+                # requires grad, and an in-place write into a view of one is an error
+                # outside `no_grad` -- the framework's own `param_weight.copy_` runs inside
+                # one for the same reason. A load is not a training step either way.
+                with torch.no_grad():
+                    weight[local_lo + offset - shard_lo : local_lo + stop - shard_lo].copy_(shard[offset:stop])
+                loaded += stop - offset
+            del shard
+        if loaded != self.rows_per_rank:
+            raise RuntimeError(
+                f'the n-gram table shards handed over {loaded} rows where this rank owns '
+                f'{self.rows_per_rank}: the shard map and the row arithmetic disagree.'
+            )
+        logger.info(
+            'Qwen4Exp PLE: loaded %d of the n-gram table\'s %d rows (%s rank %d/%d, shards %d-%d of %d) from %s',
+            loaded,
+            self.padded_vocab_size,
+            self.owner_name,
+            self.tp_rank,
+            self.tp_size,
+            first,
+            last,
+            self.split_ngram_parts,
+            self.table_dir,
+        )
+
+    def lookup_host(self, weight: Tensor, ids: Tensor) -> Tuple[Tensor, Tensor]:
+        """Unmasked rows plus the ownership mask, for the pinned-host form.
+
+        The host gather is the expensive half; masking the same ``[tokens, heads,
+        head_dim]`` block on the CPU costs another full pass over ~80M elements per
+        step. ``index_select`` already returns a valid (clamped) row for every id,
+        so the caller can zero the other ranks' entries on the device, where the
+        mask is a few microseconds, before the TP sum.
+        """
+        flat = ids.reshape(-1)
+        local = flat - self.start_row
+        owned = (local >= 0) & (local < self.rows_per_rank)
+        rows = weight.index_select(0, local.clamp_(0, self.rows_per_rank - 1)).view(*ids.shape, self.head_dim)
+        return rows, owned.view(*ids.shape)
+
+
+def _locate_shards(table_dir: str, split_ngram_parts: int) -> Dict[int, Tuple[str, int, int, List[int], torch.dtype]]:
+    """Byte range and dtype of every table shard, from the checkpoint's own index.
+
+    Reads ``model.safetensors.index.json`` when it is there (the released
+    checkpoint is sharded) and falls back to walking the header of every
+    ``*.safetensors`` file otherwise.
+    """
+    if os.path.isfile(table_dir):
+        files = [table_dir]
+    else:
+        index_path = os.path.join(table_dir, 'model.safetensors.index.json')
+        if os.path.isfile(index_path):
+            with open(index_path, 'r', encoding='utf-8') as handle:
+                weight_map = json.load(handle)['weight_map']
+            files = sorted({os.path.join(table_dir, name) for name in weight_map.values()})
+        else:
+            files = sorted(
+                os.path.join(table_dir, name) for name in os.listdir(table_dir) if name.endswith('.safetensors')
+            )
+
+    located: Dict[int, Tuple[str, int, int, List[int], torch.dtype]] = {}
+    for path in files:
+        header, data_start = _read_safetensors_header(path)
+        for name, entry in header.items():
+            match = _SHARD_RE.search(name)
+            if match is None:
+                continue
+            start, stop = entry['data_offsets']
+            located[int(match.group(1))] = (
+                path,
+                data_start + start,
+                stop - start,
+                entry['shape'],
+                _safetensors_dtype(entry['dtype'], f'{name!r} of {path}'),
+            )
+        if len(located) == split_ngram_parts:
+            break
+
+    missing = [index for index in range(split_ngram_parts) if index not in located]
+    if missing:
+        raise FileNotFoundError(
+            f'the n-gram table is incomplete: {len(missing)} of {split_ngram_parts} shards were not found under '
+            f'{table_dir} (first missing: shard_{missing[0]}.weight). Point {PLE_TABLE_ENV} at a checkpoint that '
+            'carries the PLE tensors (the truncation tool keeps them with --keep-ple).'
+        )
+    return located
+
+
+def _segment_start(lengths: Optional[List[int]], total: int, device) -> Optional[Tensor]:
+    """``[1, total]`` int64: the index the sample each position belongs to starts at.
+
+    ``None`` when the stream is one sample -- the common case, and one that must
+    not pay for a tensor.
+
+    The reference computes one sample per row, so its two cross-token windows stop
+    at the row: the hash of a sample's first token looks back at EOS rather than
+    at the sample before it, and the conv's window is zeros there rather than the
+    frames before it. A packed stream needs to be told where those boundaries
+    are, and they are the *padded* ones: that is the stream that exists, and a
+    sample's padding trails the sample, so it lands inside the sample's own
+    segment and outside every other one.
+    """
+    if lengths is None or len(lengths) <= 1:
+        return None
+    if sum(lengths) != total:
+        raise ValueError(
+            f'the packed boundaries add up to {sum(lengths)} tokens but the PLE input holds {total}: the module '
+            'is not looking at the undivided packed stream.'
+        )
+    starts = torch.empty(total, dtype=torch.long, device=device)
+    offset = 0
+    for length in lengths:
+        starts[offset : offset + length] = offset
+        offset += length
+    return starts.unsqueeze(0)
+
+
+def _keep_own_chunk(tensor: Tensor, group) -> Tensor:
+    """The rows of a gathered full-sequence ``tensor`` that belong to this rank.
+
+    A plain slice, deliberately *not* ``scatter_to_sequence_parallel_region``:
+    the two agree on the forward, and both take the rank's own contiguous chunk,
+    but their backwards differ and only this one is right here.
+
+    The gather hands every rank a replica of the whole sequence, and each rank
+    only goes on to use its own rows -- so the gradient of a row that is not this
+    rank's is zero *on this rank*, and a slice's backward zero-fills exactly that
+    way. The scatter's backward all-gathers instead, which makes every rank
+    compute the parameter gradient of the *whole* sequence, and the
+    sequence-parallel sum ``finalize_model_grads`` performs for every
+    ``sequence_parallel``-marked parameter would then count it ``tp_size`` times.
+    """
+    size = group.size()
+    if size == 1:
+        return tensor
+    if tensor.shape[0] % size:
+        raise ValueError(
+            f'a gathered sequence of {tensor.shape[0]} tokens does not divide into {size} sequence-parallel chunks.'
+        )
+    length = tensor.shape[0] // size
+    return tensor.narrow(0, torch.distributed.get_rank(group=group) * length, length)
+
+
+class _HaloAllGather(torch.autograd.Function):
+    """All-gather whose backward is the reduce-scatter of the gathered positions.
+
+    What :meth:`Qwen4ExpTextPLELayer._short_conv_halo` needs and
+    ``torch.distributed.nn.functional.all_gather`` does not do here: its backward
+    supports NCCL only -- every other backend takes a branch that emulates the
+    reduce-scatter with an all-to-all (``torch/distributed/nn/functional.py``, in
+    ``_AllGather.backward``), and that branch rejects the *non-contiguous*
+    gradients a conv hands the gathered halo, so the first sharded backward dies
+    with ``RuntimeError: Tensors must be contiguous``. Verified on two dies.
+
+    The convention is the same one, and it is the cheap end of the layout: rank
+    ``i`` contributes its ``tensor``, and every rank reads position ``i`` for rank
+    ``i``'s frames. Position ``i``'s gradient therefore belongs to rank ``i``, and
+    summing the positions is exactly ``reduce_scatter``'s list form -- each rank
+    passes its gradient for every position, and gets back the sum of the
+    contributions addressed to it. A position nobody reads back-propagates
+    nothing, which is what lets rank 0 take part on a zeroed halo.
+    """
+
+    @staticmethod
+    def forward(ctx, tensor: Tensor, group) -> Tuple[Tensor, ...]:
+        ctx.group = group
+        tensor = tensor.contiguous()
+        gathered = [torch.empty_like(tensor) for _ in range(torch.distributed.get_world_size(group=group))]
+        torch.distributed.all_gather(gathered, tensor, group=group)
+        return tuple(gathered)
+
+    @staticmethod
+    def backward(ctx, *grads: Tensor) -> Tuple[Tensor, None]:
+        group = ctx.group
+        # `reduce_scatter`'s list form: `grads[i]` is this rank's gradient for
+        # position `i`, which belongs to rank `i`; the sum of what is addressed to
+        # this rank comes back. Contiguous by force: a conv's gradient is a view.
+        local = torch.empty_like(grads[0].contiguous())
+        torch.distributed.reduce_scatter(
+            local, [grad.contiguous() for grad in grads], op=torch.distributed.ReduceOp.SUM, group=group
+        )
+        return local, None
+
+
+def _sequence_lengths(packed_seq_params) -> Optional[List[int]]:
+    """Per-sample padded lengths of the undivided packed stream, or ``None``.
+
+    :func:`~...cp_split.padded_sample_lengths` answers ``None`` for a batch that
+    arrives *already* split (the text path, where Relax cuts the sequence in the
+    data loader); the boundaries it carries are still the global ones, so this
+    reads them directly instead.
+    """
+    lengths = padded_sample_lengths(packed_seq_params)
+    if lengths is not None:
+        return lengths
+    if packed_seq_params is None or getattr(packed_seq_params, 'qkv_format', None) != 'thd':
+        return None
+    padded = getattr(packed_seq_params, 'cu_seqlens_q_padded', None)
+    if padded is None:
+        padded = getattr(packed_seq_params, 'cu_seqlens_q', None)
+    if padded is None:
+        return None
+    boundaries = [int(offset) for offset in padded.reshape(-1).tolist()]
+    return [end - start for start, end in zip(boundaries, boundaries[1:])]
+
+
+class Qwen4ExpTextNGramEmbedding(nn.Module):
+    """The hashed n-gram table lookup of one PLE layer.
+
+    Mirrors ``transformers``' ``Qwen4ExpTextNGramEmbedding``. Two pieces of that
+    class are dropped because they only exist for generation: the cache of the
+    last ``ngram_size - 1`` token ids (training left-fills with EOS instead) and
+    the cache of the conv's last nine frames (the conv is padded instead).
+
+    The table is the module's ``weight`` buffer: pinned host memory, this rank's
+    row shard of it, never a device tensor (see :class:`PinnedNGramTable`). The
+    reference also keeps its table on the host -- 95 GiB does not fit on a die --
+    but keeps all of it on every rank; the row shard, the ``_apply`` guard that
+    keeps the module transforms off it and the ``_table_loaded`` flag that gates the
+    forward are the shape the GPU branch gives the same weight
+    (``PinnedVocabParallelEmbedding``), adopted here so that the bridge can map it,
+    a checkpoint can carry it and no rank ever materializes the whole table.
+
+    The device form of the same ``weight`` -- :data:`PLE_CPU_OFFLOAD_ENV` = ``0`` --
+    is a trainable ``nn.Parameter`` row-sharded over the expert-parallel group
+    (:meth:`_route_ep_rows`), where the lookup is an all-to-all round trip to the
+    rows' owners. DDP, the optimizer and the export treat it as an ordinary weight,
+    and the parts that exist only for the host buffer stand down: the residency and
+    the ``_apply`` guard. The name, the row arithmetic, the ``_table_loaded`` gate
+    and the bridge mapping are the same in both forms, so a checkpoint does not tell
+    them apart.
+    """
+
+    def __init__(self, config, ple_layer_index: int, pg_collection=None):
+        super().__init__()
+        self.config = config
+        self.ple_layer_index = ple_layer_index
+        self.pg_collection = pg_collection
+        self.ngram_size = int(config.ngram_size)
+        self.context_len = self.ngram_size - 1
+        self.heads_per_ngram = int(config.heads_per_ngram)
+        self.ngram_heads = self.context_len * self.heads_per_ngram
+        self.unigram_vocab_size = int(config.vocab_size)
+        self.ngram_vocab_size_base = int(config.ngram_vocab_size_base)
+        # `ple_seed`, not `seed`: the latter is Megatron's RNG seed (42), not the
+        # reference's hash salt (1234), and the two are unrelated.
+        self.seed = int(getattr(config, 'ple_seed', None) or 1234)
+        # `eos_token_id` is a list in some of this family's configs; the reference
+        # takes its first entry, and so does the provider.
+        eos_token_id = config.eos_token_id
+        self.eos_token_id = int(eos_token_id[0] if isinstance(eos_token_id, (list, tuple)) else eos_token_id)
+
+        embedding_dim = int(getattr(config, 'ple_embed_dim', None) or config.hidden_size)
+        if embedding_dim % self.ngram_heads:
+            raise ValueError(
+                f'ple_embed_dim ({embedding_dim}) must be divisible by (ngram_size - 1) * heads_per_ngram '
+                f'({self.ngram_heads}).'
+            )
+        self.head_dim = embedding_dim // self.ngram_heads
+
+        sizes = head_vocab_sizes(self.ngram_vocab_size_base, self.ngram_heads, ple_layer_index)
+        offsets: List[int] = []
+        total = 0
+        for size in sizes:
+            offsets.append(total)
+            total += size
+        self.total_vocab_size = total
+        divider = int(config.make_ngram_vocab_size_divisible_by)
+        self.padded_vocab_size = math.ceil(total / divider) * divider
+        self.split_ngram_parts = int(config.split_ngram_parts)
+
+        # The three hash-index buffers are *derived* constants -- the primes after
+        # `ngram_vocab_size_base`, their prefix sums, and the splitmix64 salts of
+        # `ple_seed` -- so, like mcore's rotary `inv_freq`, they are rebuilt from
+        # the config rather than read; the checkpoint's copies of them exist to be
+        # compared with these (`tests/test_ple.py`; they are bit-identical). They
+        # are mapped anyway: with a mapping the bridge checks the checkpoint's copy
+        # instead of trusting the arithmetic, and an unmapped persistent buffer is
+        # not an option -- `build_conversion_tasks` walks the model's persistent
+        # buffers, and one without a mapping leaves a `None` task that
+        # `load_weights_hf_to_megatron` then dereferences ("megatron_module of
+        # NoneType"). They are replicated, which is what a 1-D index buffer is.
+        self.register_buffer(
+            'layer_multipliers',
+            build_layer_multipliers(self.unigram_vocab_size, self.ngram_size, ple_layer_index, self.seed),
+        )
+        self.register_buffer('ngram_heads_vocab_sizes', torch.tensor(sizes, dtype=torch.long))
+        self.register_buffer('ngram_heads_offsets', torch.tensor(offsets, dtype=torch.long))
+
+        # The table itself: this rank's row shard of it, wherever the offload switch
+        # points. It is `weight` -- the name the bridge maps and the name a
+        # `VocabParallelEmbedding` gives it -- in both forms, and it is filled by a load
+        # (HF or a distributed checkpoint) and by nothing else: `_table_loaded` is what
+        # says a forward may read it.
+        self.table_path = getattr(config, 'ple_table_dir', None) or os.environ.get(PLE_TABLE_ENV)
+        self.table_mode, how = _table_form()
+        ep_sharded = self.table_mode == _TABLE_MODE_DEVICE_EP
+        if ep_sharded:
+            # The row axis is the expert-parallel group here, not the tensor-parallel one:
+            # at tp=8/ep=16 on 16 dies the dense TP group is *inside* the EP group, so the
+            # TP shard would still be 11.9 GiB of table plus 51 GiB of Adam state on every
+            # die, while the EP shard is 6.4 GiB of table with nothing replicated.
+            owner_rank, owner_size = self._ep_coordinates()
+            owner_name = 'ep'
+        else:
+            owner_rank, owner_size = self._tp_coordinates()
+            owner_name = 'tp'
+        self.table = PinnedNGramTable(
+            self.table_path,
+            self.split_ngram_parts,
+            self.padded_vocab_size,
+            self.head_dim,
+            owner_rank,
+            owner_size,
+            owner_name,
+        )
+        # With the offload on, the table is the pinned host buffer `allocate` makes and
+        # `fill` writes into -- 47.7 GiB of it per rank at tp=2, which is why it is not
+        # on a die. With the offload off it is a device parameter row-sharded over EP,
+        # and DDP, the optimizer and the export all treat it as an ordinary weight.
+        # Zeros rather than `allocate`'s uninitialized memory: the load fills it and
+        # `_table_loaded` still gates reading it, but a rank that reads it early sums
+        # zeros instead of garbage. The reference initializes its conv the same way
+        # (`nn.Parameter(torch.zeros(...))`), and the PLE branch is bilinear in the
+        # table, so a zero table is exactly "this branch contributes nothing", which is
+        # what a step-0 loss can be compared against.
+        dtype = getattr(config, 'params_dtype', None) or torch.bfloat16
+        if ep_sharded:
+            self.register_parameter(
+                'weight',
+                nn.Parameter(torch.zeros(self.table.rows_per_rank, self.head_dim, dtype=dtype, device='cuda')),
+            )
+            # Sharded over EP, so DDP must not reduce it over the dense data-parallel
+            # group: `allreduce = False` routes it to the expert-data-parallel group,
+            # while the rows' gradients are already complete -- the all-to-all delivers
+            # every requester's share to the row's owner. It is deliberately *not*
+            # marked `sequence_parallel`: that mark makes `finalize_model_grads` sum
+            # over the TP group, and at etp=1 the TP ranks own *different* row ranges,
+            # so the sum would be of unrelated rows.
+            self.weight.allreduce = False
+            self.weight.is_engram_embedding = True
+            self.weight.is_embedding_or_output_parameter = True
+            form = (
+                f'a trainable {dtype} parameter on the device, row-sharded over the '
+                f'{self.table.tp_size}-rank expert-parallel group'
+            )
+        else:
+            self.register_buffer('weight', self.table.allocate(dtype))
+            form = 'the frozen buffer in pinned host memory, off the device'
+        # Said out loud, because the switch is an environment variable: the forms differ in
+        # nothing a load, a checkpoint or a later log line would otherwise show, so a run
+        # that meant to train the table and built the frozen buffer instead -- or the
+        # reverse, on a table too large for a die -- would look healthy.
+        logger.info(
+            'Qwen4Exp PLE: the n-gram table is %s (%d of the table\'s %d rows x %d, %s rank %d/%d); '
+            'table form %s, by %s',
+            form,
+            self.table.rows_per_rank,
+            self.table.padded_vocab_size,
+            self.head_dim,
+            owner_name,
+            self.table.tp_rank,
+            self.table.tp_size,
+            self.table_mode,
+            how,
+        )
+        self._table_loaded = False
+
+    # ------------------------------------------------------------------
+    # the table as a weight: load, and what a checkpoint does with it
+    # ------------------------------------------------------------------
+    def _tp_group(self):
+        """The tensor-parallel group, whose ranks own the table's row shards."""
+        if getattr(self.pg_collection, 'tp', None) is not None:
+            return self.pg_collection.tp
+        from megatron.core import mpu  # pylint: disable=import-outside-toplevel
+
+        return mpu.get_tensor_model_parallel_group() if mpu.model_parallel_is_initialized() else None
+
+    def _tp_coordinates(self) -> Tuple[int, int]:
+        """This rank's place in that group, ``(0, 1)`` for a model built without one."""
+        group = self._tp_group()
+        if group is None:
+            return 0, 1
+        return torch.distributed.get_rank(group=group), group.size()
+
+    def _ep_group(self):
+        """The expert-parallel group, whose ranks own the table's row shards in the EP form."""
+        if self.pg_collection is not None and self.pg_collection.ep is not None:
+            return self.pg_collection.ep
+        from megatron.core import mpu  # pylint: disable=import-outside-toplevel
+
+        return mpu.get_expert_model_parallel_group() if mpu.model_parallel_is_initialized() else None
+
+    def _ep_coordinates(self) -> Tuple[int, int]:
+        """This rank's place in the expert-parallel group, ``(0, 1)`` for a model built without one."""
+        group = self._ep_group()
+        if group is None:
+            return 0, 1
+        return torch.distributed.get_rank(group=group), group.size()
+
+    def _expt_dp_group(self):
+        """The expert-data-parallel group: the ranks whose EP row shard is the same one."""
+        if self.pg_collection is not None and getattr(self.pg_collection, 'expt_dp', None) is not None:
+            return self.pg_collection.expt_dp
+        from megatron.core import mpu  # pylint: disable=import-outside-toplevel
+
+        if not mpu.model_parallel_is_initialized():
+            return None
+        return mpu.get_expert_data_parallel_group(check_initialized=False)
+
+    @property
+    def _sp_size(self) -> int:
+        """How many ranks the sequence is sharded over (the TP size under ``sequence_parallel``)."""
+        return int(self.config.tensor_model_parallel_size) if self.config.sequence_parallel else 1
+
+    def table_owner(self) -> Tuple[Optional[object], int, int]:
+        """``(group, rank, size)``: whose ranks own the table's rows, and this rank's place.
+
+        The tensor-parallel group for the host form, the expert-parallel one for the
+        device form -- the same coordinates the table was built with. A caller that
+        reassembles the whole table out of the ranks' rows (the HF export's
+        ``PLENGramEmbeddingMapping.assemble_shard``) has to sum over this group and
+        not over the TP group unconditionally.
+        """
+        group = self._ep_group() if self.table_mode == _TABLE_MODE_DEVICE_EP else self._tp_group()
+        return group, self.table.tp_rank, self.table.tp_size
+
+    def load_table(self, loader: Optional[Callable[[int], Tensor]] = None) -> None:
+        """Fill this rank's rows of the table and mark it loaded.
+
+        Args:
+            loader: ``callable(shard_index) -> Tensor``, the reader the caller wants
+                used -- the bridge passes the HF state dict's own lazy lookup, so the
+                shards come from the checkpoint being loaded rather than from a path.
+                Without it the shards are mapped out of ``ple_table_dir``.
+
+        Either way one shard is in flight at a time and the copy lands in the buffer,
+        so a rank costs its own rows and nothing more; the table is never
+        materialized whole, on any rank.
+        """
+        self.table.fill(self.weight, loader)
+        self._table_loaded = True
+
+    # ------------------------------------------------------------------
+    # the EP-routed lookup
+    # ------------------------------------------------------------------
+    def _route_ep_rows(self, ids: Tensor) -> Tensor:
+        """Fetch ``ids`` from their owners over the expert-parallel group.
+
+        Every rank owns one contiguous row range, ``[start_row, start_row +
+        rows_per_rank)``, so the owner of a flat row is a division and its local row a
+        remainder -- no index to keep. The requests are grouped by owner with one stable
+        sort; the counts exchange yields both split vectors from a single all-to-all of
+        ``ep_size`` int64s (and one device->host transfer, the only host sync here); the
+        owner answers with one ``index_select``; and the rows come back through an
+        exchange whose backward mirrors it (:class:`_DifferentiableAllToAll`).
+
+        Returns ``[*ids.shape, head_dim]`` next to ``weight``. Unlike the TP form there
+        is no masked gather and no TP sum: a row comes back from its owner whole.
+        """
+        group = self._ep_group()
+        if group is None:
+            raise RuntimeError(
+                f'{PLE_TABLE_MODE_ENV}={self.table_mode} needs an expert-parallel group; none was built.'
+            )
+        weight = self.weight
+        shape = ids.shape
+        flat = ids.reshape(-1).to(torch.int64)
+        owners = torch.div(flat, self.table.rows_per_rank, rounding_mode='floor')
+        local_rows = flat - owners * self.table.rows_per_rank
+        # `stable` so that equal owners keep the tokens' order: the inverse permutation
+        # then puts every row back where it was asked for.
+        order = torch.argsort(owners, stable=True)
+        sorted_owners = owners.index_select(0, order)
+        requests = local_rows.index_select(0, order)
+        send_counts = torch.bincount(sorted_owners, minlength=group.size()).to(torch.int64)
+        recv_counts = torch.empty_like(send_counts)
+        torch.distributed.all_to_all_single(recv_counts, send_counts, group=group)
+        send_splits, recv_splits = torch.stack((send_counts, recv_counts)).tolist()
+        received = requests.new_empty((sum(recv_splits),))
+        torch.distributed.all_to_all_single(
+            received,
+            requests.contiguous(),
+            output_split_sizes=recv_splits,
+            input_split_sizes=send_splits,
+            group=group,
+        )
+        owner_values = F.embedding(received, weight)
+        values = _DifferentiableAllToAll.apply(group, owner_values, send_splits, recv_splits)
+        output = torch.empty_like(values)
+        output.index_copy_(0, order, values)
+        return output.view(*shape, weight.shape[-1])
+
+    def _forward_ep(self, ids: Tensor, reduce_scatter: bool) -> Tensor:
+        """The EP form of :meth:`forward`: route this rank's share of the lookup only.
+
+        The hash has already run on the whole stream (:meth:`ngram_ids` reads
+        ``ngram_size - 1`` tokens back), so the ids can be cut after it. The cut is over
+        the *tensor-parallel* group in both layouts, because that is the group whose
+        ranks hold one common stream: sequence parallelism splits it across them, and
+        the whole-sequence layout gathers it back to every one of them
+        (:meth:`Qwen4ExpTextPLELayer._to_full`). Expert-parallel ranks are different
+        *data* -- the group spans the data-parallel replicas -- so cutting the stream
+        over it would hand a rank another rank's tokens. Within a TP group every chunk
+        is routed by exactly one rank, and the owners aggregate across chunks.
+
+        * ``reduce_scatter`` -- the rows come back in the chunk layout, which is exactly
+          what this rank goes on to use: no TP collective at all.
+        * otherwise (the whole-sequence layout) every rank of the TP group needs the
+          whole result, so the lookup is split the same way and the rows are gathered
+          back. That gather's backward is a reduce-scatter, which returns each chunk to
+          the one rank that routed it -- the same "each rank differentiates its own
+          tokens" contract the lookup's reduce-scatter keeps in the TP form, and what
+          keeps a row's gradient from being summed once per rank.
+        """
+        group = self._tp_group()
+        rows = self._route_local(ids, group)
+        if not reduce_scatter and group is not None and group.size() > 1:
+            rows = tensor_parallel.gather_from_sequence_parallel_region(
+                rows.transpose(0, 1).contiguous(), group=group
+            ).transpose(0, 1)
+        return rows
+
+    def _route_local(self, ids: Tensor, slice_group) -> Tensor:
+        """Route ``1/size`` of the stream (this rank's chunk of ``slice_group``), flattened.
+
+        Both layouts need the same step -- the ids cut to a contiguous chunk, one routed
+        lookup, ``[rows, chunk, heads * head_dim]`` back -- and differ only in which group
+        the chunk is taken from and whether the rows are gathered afterwards.
+        """
+        if slice_group is not None and slice_group.size() > 1:
+            length = ids.shape[1]
+            if length % slice_group.size():
+                raise ValueError(
+                    f'the packed stream is {length} tokens, which does not divide into '
+                    f'{slice_group.size()} chunks.'
+                )
+            local = length // slice_group.size()
+            rank = torch.distributed.get_rank(group=slice_group)
+            ids = ids.narrow(1, rank * local, local)
+        return self._route_ep_rows(ids).flatten(-2)
+
+    def _apply(self, fn, recurse: bool = True):
+        """Keep the *buffer* table where it is: ``.cuda()``, ``.to(dtype)`` and ``.bfloat16()`` skip it.
+
+        Those transforms are applied to every buffer of every module, and this one is
+        47.7 GiB per rank on pinned host memory -- each of them would either move it to
+        a die or allocate a second copy of it on the host. The three index buffers do
+        travel: the ids are hashed against them on the device.
+
+        A parameter table is not a buffer and travels like every other weight, which is
+        why the guard is spelled as "is ``weight`` a buffer at all": popping the name
+        unconditionally would raise on the parameter form instead of leaving it where
+        ``.to(device)`` put it.
+        """
+        if 'weight' not in self._buffers:
+            return super()._apply(fn, recurse)
+        weight = self._buffers.pop('weight')
+        try:
+            return super()._apply(fn, recurse)
+        finally:
+            self._buffers['weight'] = weight
+
+    def sharded_state_dict(self, prefix='', sharded_offsets=(), metadata=None):
+        """The table as a sharded tensor, next to the buffers this module derived.
+
+        Taking over the state dict of the whole module (which is what defining this
+        method does) makes the three index buffers this module's to declare as well.
+        They are replicated, i.e. exactly what the default path would have produced
+        for them.
+
+        The method is only worth its gate if it is actually *called*: the traversal
+        reaches it through `sharded_state_dict_default`, and a parent without a state
+        dict of its own takes that function's `state_dict()` fallback and never asks
+        this module at all -- see :meth:`Qwen4ExpTextPLELayer.sharded_state_dict`.
+        """
+        buffers = {
+            'layer_multipliers': self.layer_multipliers,
+            'ngram_heads_vocab_sizes': self.ngram_heads_vocab_sizes,
+            'ngram_heads_offsets': self.ngram_heads_offsets,
+        }
+        if metadata is None:
+            # No group to shard against: hand the buffers over as they are, which is
+            # what a caller with no metadata gets for every other module too.
+            return {f'{prefix}{name}': buffer for name, buffer in buffers.items()}
+        keys = make_sharded_tensors_for_checkpoint(
+            buffers, prefix, {}, sharded_offsets, tp_group=self._tp_group(), dp_cp_group=metadata['dp_cp_group']
+        )
+        if not _table_in_dcp():
+            return keys
+        key = f'{prefix}weight'
+        if self.table_mode == _TABLE_MODE_DEVICE_EP:
+            keys[key] = self._ep_sharded_weight(key, sharded_offsets)
+            return keys
+        group = self._tp_group()
+        if group is None:
+            return keys
+        keys[key] = make_tp_sharded_tensor_for_checkpoint(
+            tensor=self.weight,
+            key=key,
+            allow_shape_mismatch=True,
+            prepend_offsets=sharded_offsets,
+            tp_group=group,
+            dp_cp_group=metadata['dp_cp_group'],
+        )
+        return keys
+
+    def _ep_sharded_weight(self, key: str, sharded_offsets=()) -> ShardedTensor:
+        """The EP-sharded table as one global tensor, this rank's rows at their offset.
+
+        The row axis is sharded over the *expert-parallel* group, so the usual
+        ``make_tp_sharded_tensor_for_checkpoint`` cannot describe it: it would declare
+        the rows TP-sharded, derive the global shape from the TP size, and stamp a
+        non-zero TP replica id on every rank but the first -- and DCP's save path
+        writes only tensors whose replica id is all zeros (``keep_only_main_replica``),
+        so all but one rank's rows would be dropped without a word.
+
+        What is declared instead is the row range itself: the global shape is the
+        padded table, the offset is this rank's ``start_row`` within it, and the
+        replica id carries only the expert-data-parallel rank -- the one axis along
+        which two ranks really do hold the same rows. With ``expt_dp == 1`` (the EP
+        group spanning the world) every rank is a main replica of its own disjoint
+        rows, which is what makes the save write all of them.
+        """
+        prepend_axis_num = len(sharded_offsets)
+        global_shape = [1] * prepend_axis_num + [self.table.padded_vocab_size, self.head_dim]
+        global_offset = [0] * prepend_axis_num + [self.table.start_row, 0]
+        for axis, rank_offset, axis_fragmentation in sharded_offsets:
+            global_shape[axis] = axis_fragmentation
+            global_offset[axis] = rank_offset
+        expt_dp_group = self._expt_dp_group()
+        replica_id = (0, 0, get_pg_rank(expt_dp_group) if expt_dp_group is not None else 0)
+        return ShardedTensor(
+            key=key,
+            data=self.weight,
+            dtype=self.weight.dtype,
+            local_shape=tuple(self.weight.shape),
+            global_shape=tuple(global_shape),
+            global_offset=tuple(global_offset),
+            axis_fragmentations=None,
+            replica_id=replica_id,
+            prepend_axis_num=prepend_axis_num,
+        )
+
+    def _load_from_state_dict(
+        self, state_dict, prefix, local_metadata, strict, missing_keys, unexpected_keys, error_msgs
+    ):
+        """A distributed checkpoint's copy of the table is a load of it (there is no HF preload to wait for)."""
+        super()._load_from_state_dict(
+            state_dict, prefix, local_metadata, strict, missing_keys, unexpected_keys, error_msgs
+        )
+        if f'{prefix}weight' in state_dict:
+            self._table_loaded = True
+
+    # ------------------------------------------------------------------
+    # the hash
+    # ------------------------------------------------------------------
+    def _shift_right_ignore_eos(self, token_ids: Tensor, shift: int, segment_start: Optional[Tensor] = None) -> Tensor:
+        """``token_ids`` shifted right by ``shift``, without crossing an EOS.
+
+        A sample's n-grams are its own: the shift reads within the segment that
+        starts after the last EOS at or before the target position, and fills with
+        EOS where there is no such token. ``segment_start`` (``[rows, length]``,
+        from :func:`_segment_start`) cuts the segments at the sample boundaries as
+        well, so that the tail of one sample never becomes the context of the
+        next -- position ``s`` of a segment standing for a virtual EOS at ``s - 1``
+        is what the reference's per-row computation does.
+        """
+        if shift == 0:
+            return token_ids
+        rows, length = token_ids.shape
+        positions = torch.arange(length, device=token_ids.device, dtype=torch.long).unsqueeze(0)
+        eos_positions = torch.where(token_ids == self.eos_token_id, positions, -1)
+        previous_eos_inclusive = torch.cummax(eos_positions, dim=1).values
+        previous_eos = torch.cat(
+            [eos_positions.new_full((rows, 1), -1), previous_eos_inclusive[:, :-1]],
+            dim=1,
+        )
+        if segment_start is not None:
+            previous_eos = torch.maximum(previous_eos, segment_start - 1)
+        source_positions = positions - shift
+        shifted = token_ids.gather(dim=1, index=source_positions.clamp_min(0).expand(rows, -1))
+        valid = (positions - (previous_eos + 1) >= shift) & (source_positions >= 0)
+        return torch.where(valid, shifted, token_ids.new_full((), self.eos_token_id))
+
+    def ngram_ids(self, input_ids: Tensor, segment_start: Optional[Tensor] = None) -> Tensor:
+        """``[rows, length, ngram_heads]`` table rows of every token's n-grams.
+
+        Args:
+            input_ids: ``[rows, length]`` int64, the *undivided* token stream (the
+                caller gathers it back under sequence/context parallelism, because
+                a token's n-gram depends on the tokens before it).
+            segment_start: ``[rows, length]`` int64 index of the sample each
+                position belongs to, ``None`` for a stream that is one sample.
+        """
+        input_ids = input_ids.long()
+        rows = input_ids.shape[0]
+        previous_context = input_ids.new_full((rows, self.context_len), self.eos_token_id)
+        token_history = torch.cat([previous_context, input_ids], dim=-1)
+        if segment_start is not None:
+            # The EOS block above is a segment of its own, which is also what the
+            # first sample's boundary already stands for.
+            leading = segment_start.new_zeros((rows, self.context_len))
+            segment_start = torch.cat([leading, segment_start + self.context_len], dim=-1)
+        shifted = [
+            self._shift_right_ignore_eos(token_history, shift, segment_start) for shift in range(self.ngram_size)
+        ]
+
+        blocks = []
+        for ngram in range(2, self.ngram_size + 1):
+            start = (ngram - 2) * self.heads_per_ngram
+            end = start + self.heads_per_ngram
+            mixed = shifted[0] * self.layer_multipliers[0]
+            for position in range(1, ngram):
+                mixed = torch.bitwise_xor(mixed, shifted[position] * self.layer_multipliers[position])
+            head_sizes = self.ngram_heads_vocab_sizes[start:end]
+            head_offsets = self.ngram_heads_offsets[start:end]
+            blocks.append(torch.remainder(mixed.unsqueeze(-1), head_sizes.view(1, 1, -1)) + head_offsets.view(1, 1, -1))
+        return torch.cat(blocks, dim=-1)[:, -input_ids.shape[1] :]
+
+    def forward(
+        self, input_ids: Tensor, segment_start: Optional[Tensor] = None, reduce_scatter: bool = False
+    ) -> Tensor:
+        """``[rows, length, ngram_heads * head_dim]`` embeddings of a token stream.
+
+        The host lookup sends the ids down (a few MB) and this rank's rows back up; the
+        device form (:data:`PLE_TABLE_MODE_ENV` = ``device-ep``) routes each row to its
+        EP owner instead. In the host form a rank owns part of the table, so what comes
+        back has zeros where a row belongs to another rank, and the TP group sums them:
+        the sum is the row itself, because every row has exactly one owner and those
+        zeros are bf16 zeros. A sharded lookup is therefore bit-identical to gathering
+        the whole table.
+
+        The module is handed the *undivided* sequence either way -- the PLE layer
+        gathers it before hashing, since an n-gram and the conv both read backwards --
+        so in the host form the partials are computed for the whole stream and the
+        collective only decides what comes back:
+
+        * ``reduce_scatter=True``: each rank keeps its own ``length / tp_size`` tokens
+          (:meth:`Qwen4ExpTextPLELayer._forward_sequence_parallel`). The collective sums
+          the same partials -- one owner per row -- and then hands every rank its
+          chunk instead of the whole sequence, which is what keeps the ``[length, 10240]``
+          tensors downstream in the layer at a ``tp_size``-th of their size. This is the
+          shape the reference implementation runs in, and the branch a
+          ``VocabParallelEmbedding`` takes under `sequence_parallel`.
+        * otherwise the whole sequence comes back on every rank, and the layer slices
+          its own rows out at the end. One collective per step.
+
+        The *ids* are detached -- they are integers, and nothing upstream of the lookup
+        is differentiable -- but the rows are not: with the frozen buffer table they
+        carry no gradient anyway, and with the trainable one they are the path the
+        table's gradient comes back on.
+        """
+        if not self._table_loaded:
+            raise RuntimeError(
+                'the PLE n-gram table was not loaded: every load path fills it -- the bridge maps '
+                '`decoder.layers.*.ple.ple_embedding.weight`, and a distributed checkpoint carries it only '
+                f'under {PLE_TABLE_IN_DCP_ENV}=1 -- so this rank holds a table of zeros and would train '
+                f'against them. Export {PLE_TABLE_ENV}=<checkpoint dir> and call `load_table()` to fill it from '
+                'the files.'
+            )
+        ids = self.ngram_ids(input_ids, segment_start)
+        if self.table_mode == _TABLE_MODE_DEVICE_EP:
+            # Rows are owned by the expert-parallel group, so the lookup is an all-to-all
+            # round trip rather than a masked local gather (see :meth:`_forward_ep`).
+            return self._forward_ep(ids, reduce_scatter)
+        parts: List[Tensor] = []
+        owned_parts: List[Tensor] = []
+        for chunk in ids.detach().split(_LOOKUP_CHUNK_TOKENS, 1):
+            rows_c, owned_c = self.table.lookup_host(self.weight, chunk.to('cpu'))
+            parts.append(rows_c)
+            owned_parts.append(owned_c)
+        rows = parts[0] if len(parts) == 1 else torch.cat(parts, dim=1)
+        owned = owned_parts[0] if len(owned_parts) == 1 else torch.cat(owned_parts, dim=1)
+        if self.table.tp_size > 1:
+            # Zero the other ranks' entries on the device: the host masking pass this
+            # replaces cost ~0.7 s/step on an 80M-element PLE output (see lookup_host).
+            rows = rows.to(device=input_ids.device, non_blocking=True)
+            # In place: `rows` is a fresh device copy of a frozen host buffer, so
+            # nothing aliases it; this keeps the transient peak to one buffer.
+            rows.masked_fill_(~owned.to(device=input_ids.device, non_blocking=True).unsqueeze(-1), 0)
+        out = rows.to(device=input_ids.device).flatten(-2)
+        if self.table.tp_size > 1:
+            if reduce_scatter:
+                # `[length, rows, width]` -> `[length / tp_size, rows, width]`: the
+                # reduce-scatter cuts the leading dimension, and the layer below keeps
+                # its sequence-parallel layout (`[tokens, batch, ...]`).
+                out = tensor_parallel.reduce_scatter_to_sequence_parallel_region(
+                    out.transpose(0, 1).contiguous(), group=self._tp_group()
+                ).transpose(0, 1)
+            else:
+                out = tensor_parallel.reduce_from_tensor_model_parallel_region(out, group=self._tp_group())
+        return out
+
+
+class Qwen4ExpTextPLELayer(nn.Module):
+    """The PLE injection of one decoder layer (HF ``Qwen4ExpTextPLELayer``).
+
+    Args:
+        config: Transformer config; uses ``hidden_size``, ``hc_count``,
+            ``ple_embed_dim``, ``ple_conv_kernel_size``, ``ngram_size`` (the conv
+            dilation), ``layernorm_epsilon`` and ``params_dtype``.
+        layer_number: One-based layer index, the same numbering
+            ``config.ple_layer_ids`` uses.
+        ple_layer_index: Position of this layer inside ``config.ple_layer_ids``;
+            it salts the hash, so two PLE layers would not share n-grams.
+        pg_collection: Process groups of the model, for the context-parallel
+            split (the gather is the model's own and needs none).
+    """
+
+    def __init__(self, config, layer_number: int, ple_layer_index: int, pg_collection=None):
+        super().__init__()
+        self.config = config
+        self.pg_collection = pg_collection
+        self.layer_number = layer_number
+        self.hidden_size = config.hidden_size
+        self.hc_count = config.hc_count
+        self.hc_hidden_size = self.hidden_size * self.hc_count
+        ple_embed_dim = int(getattr(config, 'ple_embed_dim', None) or config.hidden_size)
+
+        self.ple_embedding = Qwen4ExpTextNGramEmbedding(config, ple_layer_index, pg_collection)
+
+        conv_kernel_size = int(config.ple_conv_kernel_size)
+        # The dilation is the n-gram order: the conv reaches back over the same
+        # span the hash does, one frame per n-gram step.
+        conv_dilation = int(config.ngram_size)
+        self.short_conv_state_len = (conv_kernel_size - 1) * conv_dilation
+
+        self.key_proj = ReplicatedLinear(config, ple_embed_dim, self.hc_hidden_size, bias=False)
+        self.value_proj = ReplicatedLinear(config, ple_embed_dim, self.hidden_size, bias=False)
+        self.norm_key = Qwen4ExpTextGroupedRMSNorm(
+            self.hc_hidden_size,
+            group_size=self.hidden_size,
+            eps=config.layernorm_epsilon,
+            dtype=config.params_dtype,
+            sequence_parallel=config.sequence_parallel,
+        )
+        self.norm_query = Qwen4ExpTextGroupedRMSNorm(
+            self.hc_hidden_size,
+            group_size=self.hidden_size,
+            eps=config.layernorm_epsilon,
+            dtype=config.params_dtype,
+            sequence_parallel=config.sequence_parallel,
+        )
+        self.norm_conv = Qwen4ExpTextGroupedRMSNorm(
+            self.hc_hidden_size,
+            group_size=self.hidden_size,
+            eps=config.layernorm_epsilon,
+            dtype=config.params_dtype,
+            sequence_parallel=config.sequence_parallel,
+        )
+        # `dtype=` matters: `nn.Conv1d` is not a TE module, so nothing downstream
+        # casts it -- left fp32 it would meet bf16 activations at the first
+        # `F.conv1d` ("Input type (npuBFloat16Type) and weight type
+        # (npuFloatType) should be the same").
+        self.conv1d = nn.Conv1d(
+            self.hc_hidden_size,
+            self.hc_hidden_size,
+            kernel_size=conv_kernel_size,
+            groups=self.hc_hidden_size,
+            dilation=conv_dilation,
+            bias=False,
+            dtype=config.params_dtype,
+            device=torch.cuda.current_device(),
+        )
+        # The reference declares this conv as `nn.Parameter(torch.zeros(...))` and lets
+        # the checkpoint fill it; `nn.Conv1d` would start it at kaiming-uniform instead.
+        # Every run that loads a checkpoint overwrites this line's effect anyway
+        # (`ple.conv1d.weight` has a 1:1 mapping in `qwen4_exp_bridge`), so it is the
+        # from-scratch model -- and the offline alignment against the reference -- that
+        # it pins down.
+        nn.init.zeros_(self.conv1d.weight)
+        # Replicated across TP (the widths are not TP-divisible), so their grads
+        # are reduced across the TP group under sequence parallelism -- the same
+        # convention the hyper-connection mixers use.
+        for param in self.parameters():
+            if param is self.ple_embedding.weight:
+                # The n-gram table is the one weight here whose gradient must *not* be
+                # summed over the TP group. Its rows are disjoint between the ranks, and
+                # the gradient a rank computes for its own rows is already complete: the
+                # lookup's `reduce_scatter` hands every rank the whole sequence's
+                # gradient (`all_gather` in the backward), and whatever a rank computes
+                # for another rank's rows is zero -- the mask that zeroes the forward's
+                # partials zeroes their gradient too. Summing would therefore add zeros
+                # and pay a 2.56 GiB all-reduce per step for it. (`finalize_model_grads`
+                # is where the attribute is read: `sequence_parallel` on a param means
+                # ReduceOp.SUM over the TP group.)
+                continue
+            setattr(param, 'sequence_parallel', config.sequence_parallel)
+        # Which of the two layouts this forward takes is decided per call, from the
+        # parallel sizes and the escape hatch; `forward` says so once, through this.
+        self._layout_logged = False
+
+    # ------------------------------------------------------------------
+    # the checkpointing of what is below this layer
+    # ------------------------------------------------------------------
+    def sharded_state_dict(self, prefix='', sharded_offsets=(), metadata=None):
+        """Declare every submodule's own sharded state dict.
+
+        Without this method MCore's traversal finds none on this layer and takes
+        `sharded_state_dict_default`'s fallback, which enumerates the whole subtree with
+        `state_dict()`. The fallback never asks :class:`Qwen4ExpTextNGramEmbedding` for
+        *its* state dict, so the n-gram table's gate was never read -- the table went in
+        as an ordinary replicated tensor of this rank's rows, and the TP-0 owner carried
+        all 51.2 GiB of it into the checkpoint (measured 2026-10-15: rank 0's
+        `__0_0.distcp` 54.35 GB against 3.5-3.9 GB on the other seven, and the save died
+        on the 120 s HCCL link setup behind it). Walking the children is what MCore's own
+        default does, spelled out here so that the gate is consulted instead of bypassed.
+        """
+        metadata = ensure_metadata_has_dp_cp_group(metadata)
+        tp_group = self._tp_group()
+        sharded_state_dict = {}
+        # This layer's own tensors: none today, and the reason the default's first step
+        # is kept is that a buffer added to it later belongs in a checkpoint by default,
+        # not to this method's blind spot.
+        self._save_to_state_dict(sharded_state_dict, '', keep_vars=True)
+        sharded_state_dict = make_sharded_tensors_for_checkpoint(
+            sharded_state_dict, prefix, {}, sharded_offsets, tp_group=tp_group, dp_cp_group=metadata['dp_cp_group']
+        )
+        for name, module in self.named_children():
+            sharded_state_dict.update(
+                sharded_state_dict_default(module, f'{prefix}{name}.', sharded_offsets, metadata, tp_group=tp_group)
+            )
+        return sharded_state_dict
+
+    # ------------------------------------------------------------------
+    # the sequence-parallel / context-parallel layout
+    # ------------------------------------------------------------------
+    @property
+    def _sp_size(self) -> int:
+        return self.config.tensor_model_parallel_size if self.config.sequence_parallel else 1
+
+    @property
+    def _sharded_layout(self) -> bool:
+        """Whether this forward keeps the sequence sharded over the TP group.
+
+        The reference's own layout, and the one a `VocabParallelEmbedding` runs in:
+        the lookup hands each rank its own ``T_full / tp_size`` tokens and nothing
+        downstream of it ever sees the whole sequence. The one step that reaches
+        backwards, the conv, takes the frames it needs off the rank before it
+        (:meth:`_short_conv_halo`).
+
+        Not under context parallelism: its split is not the contiguous chunks the
+        sequence-parallel layout uses, so the rank before this one does not hold the
+        frames before this chunk. And not under :data:`PLE_SP_FULL_SEQUENCE_ENV`,
+        which pins the layout for an A/B.
+        """
+        return self._sp_size > 1 and self.config.context_parallel_size == 1 and not _sp_full_sequence()
+
+    def _to_full(self, tensor: Tensor, packed_seq_params, dim: int = 0) -> Tensor:
+        """This rank's slice of ``tensor``, gathered back to the whole sequence.
+
+        The inverse of what the model does on the way in (context-parallel split
+        first, then the sequence-parallel scatter), and the same gather the QSA
+        indexer performs before it selects. Its backward drops every other rank's
+        rows, so the parameter gradients each rank computes are partials over its
+        own tokens -- disjoint, which is what makes the sequence-parallel sum in
+        ``finalize_model_grads`` come out right (see :func:`_keep_own_chunk`).
+        """
+        if self._sp_size > 1:
+            tensor = tensor_parallel.gather_from_sequence_parallel_region(tensor, group=self._tp_group())
+        if self.config.context_parallel_size > 1:
+            tensor = reconstruct_tensor_cp(tensor, packed_seq_params, dim=dim)
+        return tensor
+
+    def _to_local(self, tensor: Tensor, packed_seq_params, lengths: Optional[List[int]], dim: int = 0) -> Tensor:
+        """The rows of a full-sequence ``tensor`` that belong to this rank.
+
+        The exact inverse of :meth:`_to_full`, down to the context-parallel
+        group it reads the rank off (``vl_model`` hands a *slice* of the CP group
+        to the batch, and the two must agree on which slice this rank holds).
+        """
+        if self.config.context_parallel_size > 1:
+            if lengths is None:
+                raise RuntimeError(
+                    'PLE cannot cut the sequence back to this context-parallel rank: the packed batch carries no '
+                    'per-sample boundaries. Run PLE layers on a packed (thd) batch.'
+                )
+            cp_group = getattr(packed_seq_params, 'cp_group', None) or self._default_cp_group()
+            cp_size = getattr(packed_seq_params, 'local_cp_size', None) or cp_group.size()
+            cp_rank = torch.distributed.get_rank(group=cp_group)
+            index = cp_local_index(lengths, cp_size, cp_rank, tensor.device)
+            tensor = tensor.index_select(dim, index)
+        return _keep_own_chunk(tensor, self._tp_group()) if self._sp_size > 1 else tensor
+
+    def _tp_group(self):
+        """The model's tensor-parallel group, or the global one when it was not handed down."""
+        if self.pg_collection is not None and self.pg_collection.tp is not None:
+            return self.pg_collection.tp
+        from megatron.core import mpu  # pylint: disable=import-outside-toplevel
+
+        return mpu.get_tensor_model_parallel_group()
+
+    def _default_cp_group(self):
+        """The model's context-parallel group, or the global one when it was not handed down."""
+        if self.pg_collection is not None and self.pg_collection.cp is not None:
+            return self.pg_collection.cp
+        from megatron.core import mpu  # pylint: disable=import-outside-toplevel
+
+        return mpu.get_context_parallel_group()
+
+    # ------------------------------------------------------------------
+    # forward
+    # ------------------------------------------------------------------
+    def _gated_output(self, embeddings: Tensor, hidden: Tensor) -> Tuple[Tensor, Tensor]:
+        """The gate/value chain both layouts share: ``[batch, length, ...]`` in, same out.
+
+        ``hidden`` is the layer's own input, and may be this rank's chunk or the whole
+        sequence -- every op here is pointwise over tokens, so it does not care. Returns
+        ``(gated_value, gated_value_normed)``: the two terms that meet again after the conv.
+        """
+        key_normed = self.norm_key(self.key_proj(embeddings)[0]).unflatten(-1, (self.hc_count, self.hidden_size))
+        value = self.value_proj(embeddings)[0]
+        query_normed = self.norm_query(hidden).unflatten(-1, (self.hc_count, self.hidden_size))
+        gate = (key_normed * query_normed).sum(dim=-1, keepdim=True) / math.sqrt(self.hidden_size)
+        gate = gate.abs().clamp_min(1e-6).sqrt() * gate.sign()
+        gated_value = (torch.sigmoid(gate) * value.unsqueeze(-2)).flatten(-2)
+        return gated_value, self.norm_conv(gated_value)
+
+    def _short_conv(self, hidden_states: Tensor, lengths: Optional[List[int]] = None) -> Tensor:
+        """The dilated depthwise conv, every sample left-padded by its own receptive field.
+
+        ``[batch, length, hc_hidden]`` in, same out. The reference pads and slices
+        even in the training case: with ``dilation > 1`` the conv's first output
+        lands ``state_len`` frames into the padded input, so the pad is what keeps
+        the output aligned with the token stream. It pads *one row at a time*,
+        which is why a packed stream is cut into its samples and each of them is
+        padded separately: everything else leaves a sample's first frames reading
+        the sample before it, tokens the reference's row never held.
+        """
+        batch, length, channels = hidden_states.shape
+        frames = hidden_states.transpose(1, 2).contiguous()
+        pad = self.short_conv_state_len
+        lengths = list(lengths) if lengths is not None else [length]
+        if sum(lengths) != length:
+            raise ValueError(
+                f'the per-sample lengths add up to {sum(lengths)} frames but the PLE conv was handed {length}: '
+                'the module is not looking at the undivided packed stream.'
+            )
+
+        pieces, offset = [], 0
+        for sample in lengths:
+            pieces.append(frames.new_zeros(batch, channels, pad))
+            pieces.append(frames[:, :, offset : offset + sample])
+            offset += sample
+        # One conv over all of them: the pads between the samples are exactly the
+        # per-row pads of the reference, and the outputs of a segment start where
+        # its pad does.
+        convolved = self.conv1d(torch.cat(pieces, dim=2))
+
+        pieces, offset = [], 0
+        for sample in lengths:
+            pieces.append(convolved[:, :, offset : offset + sample])
+            offset += sample + pad
+        return F.silu(torch.cat(pieces, dim=2)).transpose(1, 2)
+
+    def _short_conv_halo(self, hidden_states: Tensor, lengths: Optional[List[int]]) -> Tensor:
+        """The same dilated conv, over this rank's frames, fed by the rank before it.
+
+        ``[batch, length, hc_hidden]`` of this rank's tokens in, same out. It is
+        :meth:`_short_conv` with the frames before this rank's chunk taken off the rank
+        that holds them rather than off a pad: what the reference gets by writing
+        ``halo`` zeros in front of a sample and reading the convolution from there, this
+        gets from the previous rank's last ``halo`` frames -- the very frames the
+        full-sequence call would have read there. Same ``conv1d``, same taps, same
+        values; the arrays just differ in length.
+
+        The pads the reference does keep are kept here, at both places they matter:
+        an earlier sample than this chunk's first one is out of bounds for a window that
+        has to stop at a sample boundary (that is rank 0, and every chunk whose start
+        falls inside a sample -- i.e. anywhere but a boundary), and a sample that begins
+        *inside* this chunk still starts on its own pad. ``lengths`` are the whole
+        stream's the way :func:`_sequence_lengths` reports them, so both are plain
+        integer arithmetic on this rank's offset; nothing is read off the device.
+
+        The exchange is an all-gather, differentiable on purpose (:class:`_HaloAllGather`):
+        the taps that read the previous rank's frames have to hand their gradient back, or
+        those frames would lose what this chunk owes them and the gradient of this rank's
+        first frames would be short by ``halo`` taps. Rank 0 still takes part, on
+        ``tails[-1] * 0.0``, so the collective is symmetric.
+        """
+        halo = self.short_conv_state_len
+        batch, length, channels = hidden_states.shape
+        if length < halo:
+            raise ValueError(
+                f'this rank holds {length} frames of the packed sequence, fewer than the conv\'s {halo}-frame '
+                'receptive field, so the sharded sequence has no output to hand back: the chunks are too short to '
+                f'cut the PLE conv at a rank boundary. Run the layer on the whole sequence ({PLE_SP_FULL_SEQUENCE_ENV}=1).'
+            )
+        if batch != 1:
+            raise RuntimeError(
+                f'the sequence-parallel PLE conv got {batch} rows: the sharded layout is the reference\'s, one packed '
+                'stream per row, and a row of its own would need its own halo.'
+            )
+        full_length = length * self._sp_size
+        lengths = list(lengths) if lengths is not None else [full_length]
+        if sum(lengths) != full_length:
+            raise ValueError(
+                f'the per-sample lengths add up to {sum(lengths)} frames but the packed stream holds {full_length}: '
+                'the module is not looking at the undivided packed stream.'
+            )
+        group = self._tp_group()
+        rank = torch.distributed.get_rank(group=group)
+        starts, offset = [0], 0
+        for sample in lengths:
+            offset += sample
+            starts.append(offset)
+        base = rank * length
+        # The sample this chunk starts inside of, and the ones that begin inside it.
+        sample_start = max(start for start in starts if start <= base)
+        cuts = [start - base for start in starts if base < start < base + length]
+        # `[batch, length, channels]` -> the reference's per-sample zero pad, split across ranks.
+        tails = _HaloAllGather.apply(hidden_states[:, -halo:, :], group)
+        lead = (tails[rank - 1] if rank else tails[-1] * 0.0).transpose(1, 2)
+        heading = min(halo, base - sample_start)  # lead frames this chunk's first sample owns
+        if heading < halo:
+            lead = torch.cat([lead.new_zeros(batch, channels, halo - heading), lead[:, :, halo - heading :]], dim=2)
+
+        # `[lead | frames[:cuts[0]] | pad | frames[cuts[0]:cuts[1]] | pad | ...]`: a sample's
+        # output starts where its own pad does, so every piece but the first is preceded by
+        # `halo` zeros -- and its output columns sit `halo` further along than its frames do.
+        frames = hidden_states.transpose(1, 2).contiguous()
+        pieces, columns, cursor = [lead], [], 0
+        for piece, stop in enumerate(cuts + [length]):
+            if piece:
+                pieces.append(frames.new_zeros(batch, channels, halo))
+            pieces.append(frames[:, :, cursor:stop])
+            columns.append((cursor + piece * halo, stop - cursor))
+            cursor = stop
+        convolved = self.conv1d(torch.cat(pieces, dim=2))
+        # One slice per piece, the same `convolved[:, :, offset : offset + sample]`
+        # `_short_conv` takes -- only the offsets count the pads of the pieces here.
+        return F.silu(torch.cat([convolved[:, :, at : at + size] for at, size in columns], dim=2)).transpose(1, 2)
+
+    def forward(self, hidden_states: Tensor, ple_input_ids: Tensor, packed_seq_params=None) -> Tensor:
+        """The PLE contribution to add to the layer's input.
+
+        Two layouts, same arithmetic (see :attr:`_sharded_layout` for which one applies):
+
+        * those two steps of the chain that reach across tokens -- the n-gram hash,
+          which looks ``ngram_size - 1`` tokens back, and the dilated conv -- need the
+          *whole* sequence, so in the layout where this rank only holds its own chunk
+          the layer gathers the ids (cheap: int64) for the hash, and the conv takes the
+          frames before this rank's chunk off the rank that holds them
+          (:meth:`_short_conv_halo`);
+        * in the other layout the whole sequence is gathered up front and everything
+          runs on it, with the result cut back to this rank's rows at the end.
+
+        Either way the layer's contract is the same -- in and out in this rank's
+        sequence-parallel layout -- and both are numerically identical: the same taps,
+        and the padding the reference puts there.
+
+        Args:
+            hidden_states: ``[tokens, batch, hc_count * hidden_size]`` in this
+                rank's layout; the layer's own input, *not* its output.
+            ple_input_ids: ``[tokens, batch]`` int64 token ids in the same layout.
+            packed_seq_params: Packed batch description of the full sequence.
+
+        Returns:
+            ``[tokens, batch, hc_count * hidden_size]`` in this rank's layout.
+        """
+        lengths = _sequence_lengths(packed_seq_params)
+        # `[tokens, batch, ...]` -> the reference's `[batch, tokens, ...]`, which is
+        # also the layout its conv reads (sequence in the middle).
+        full_ids = self._to_full(ple_input_ids, packed_seq_params).transpose(0, 1)
+        if full_ids.shape[0] != 1:
+            raise RuntimeError(
+                f'PLE expects one packed stream, got {full_ids.shape[0]} rows: the module reads the samples of a '
+                'batch off a single sequence, and a padded `[batch, seq]` one would have to be flattened first.'
+            )
+
+        # Both cross-token windows stop at a sample boundary -- the hash fills with
+        # EOS there, the conv pads with zeros, exactly as the reference's own rows
+        # do. See `_segment_start` and `_short_conv`. The table is the *whole* stream's
+        # in both layouts, which is what lets the sharded one mask its halo without
+        # another collective.
+        segments = _segment_start(lengths, full_ids.shape[1], full_ids.device)
+        if not self._layout_logged:
+            # Once per layer. The two layouts are numerically equivalent, so nothing
+            # else in the log tells them apart -- and `QWEN4_EXP_PLE_SP_FULL_SEQUENCE`
+            # exists to switch between them, which an A/B cannot verify without this.
+            self._layout_logged = True
+            logger.info(
+                'Qwen4Exp PLE layer %s runs the %s layout (tp %d, sequence parallel %s, context parallel %d%s)',
+                self.layer_number,
+                'sharded' if self._sharded_layout else 'whole-sequence',
+                self.config.tensor_model_parallel_size,
+                self.config.sequence_parallel,
+                self.config.context_parallel_size,
+                f", {PLE_SP_FULL_SEQUENCE_ENV} is set" if _sp_full_sequence() else '',
+            )
+        if self._sharded_layout:
+            return self._forward_sequence_parallel(hidden_states, full_ids, segments, lengths)
+
+        full_hidden = self._to_full(hidden_states, packed_seq_params).transpose(0, 1)
+        embeddings = self.ple_embedding(full_ids, segments)
+        gated_value, gated_value_normed = self._gated_output(embeddings, full_hidden)
+
+        output = gated_value + self._short_conv(gated_value_normed, lengths)
+        return self._to_local(output.transpose(0, 1), packed_seq_params, lengths)
+
+    def _forward_sequence_parallel(
+        self, hidden_states: Tensor, full_ids: Tensor, segments: Optional[Tensor], lengths: Optional[List[int]]
+    ) -> Tensor:
+        """The sharded layout: this rank's chunk in place of the whole sequence.
+
+        The four tensors that dominate this layer -- the embeddings, the normed key,
+        the gated value and the conv's input and output -- are all ``[tokens, 10240]``,
+        and here each of them is a ``tp_size``-th of its full-sequence size. What the
+        smaller layout costs is one gather of the ids (a tenth of that in bytes) and a
+        halo exchange around the conv.
+
+        ``full_ids`` and ``segments`` stay the whole stream's here: the hash reads
+        ``ngram_size - 1`` tokens back, so the ids cannot be cut -- but they are int64
+        and a tenth of the activations in bytes, and the lookup hands back this rank's
+        rows of the full-stream result (through a reduce-scatter in the host form, by
+        construction in the EP one), which is the same row for row.
+        """
+        local_length = hidden_states.shape[0]
+        if full_ids.shape[1] != local_length * self._sp_size:
+            raise ValueError(
+                f'the packed stream is {full_ids.shape[1]} tokens, which does not divide into {self._sp_size} '
+                f'sequence-parallel chunks of the {local_length} tokens this rank holds: the ids and the hidden '
+                'states are not describing the same batch.'
+            )
+        embeddings = self.ple_embedding(full_ids, segments, reduce_scatter=True)
+        # `[tokens, batch, ...]` is already this rank's chunk of the sequence, and the
+        # lookup just handed back exactly this rank's rows of it -- no gather, no slice.
+        gated_value, gated_value_normed = self._gated_output(embeddings, hidden_states.transpose(0, 1))
+        output = gated_value + self._short_conv_halo(gated_value_normed, lengths)
+        return output.transpose(0, 1)
