+++ b/mindspeed_bridge/models/qwen4_exp/modelling_qwen4_exp/qsa/indexer.py
@@ -0,0 +1,877 @@
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""QSA (Query Sparse Attention) block selection for Qwen3.8-Flash-Next."""
+
+from __future__ import annotations
+
+import logging
+import math
+import os
+from collections import OrderedDict
+from typing import NamedTuple, Optional
+
+import torch
+from torch import Tensor, nn
+
+from ..linear import ReplicatedLinear
+from ..norms import Qwen4ExpTextRMSNorm
+
+logger = logging.getLogger(__name__)
+
+# Byte budget for the transient score tile in packed and unpacked selection: the (token, block)
+# scoring is chunked over queries to avoid OOM from the full [T, n_heads, NB] fp32 tensor.
+# Tests monkeypatch this to compare one chunk (un-chunked reference) vs many chunks.
+_QSA_INDEX_SCORE_CHUNK_BYTES = 1024 * 1024 * 1024
+
+# Packed (thd) block selection can run on CANN's LightningIndexerV2 instead of the
+# chunked torch core. The operator fuses the compressed-causal mask and the top-k and
+# is ~14x faster at production shapes (2.6 vs 34.9 ms per call at T=26k, NB=6.5k,
+# block_topk=512). It needs head_dim 128, compress_ratio in (1, 4, 128), one kv head
+# and bf16/fp16 inputs -- see ``_lightning_select_blocks_thd``.
+QSA_INDEXER_IMPL_ENV = 'QWEN4_EXP_QSA_INDEXER_IMPL'
+
+# (lightning_indexer, lightning_indexer_metadata), or False once the import failed.
+_LIGHTNING_OPS = None
+_LIGHTNING_FALLBACK_WARNED = False
+
+
+def _qsa_indexer_impl() -> str:
+    """``'auto'`` (fused op when it fits, local core otherwise), ``'lightning'`` or ``'legacy'``."""
+    raw = os.environ.get(QSA_INDEXER_IMPL_ENV, 'auto').strip().lower()
+    if raw in ('', 'auto'):
+        return 'auto'
+    if raw in ('lightning', 'cann'):
+        return 'lightning'
+    if raw in ('legacy', 'local', 'off', '0', 'false'):
+        return 'legacy'
+    logger.warning(
+        'Ignoring %s=%r (expected auto, lightning or legacy); using auto.',
+        QSA_INDEXER_IMPL_ENV,
+        raw,
+    )
+    return 'auto'
+
+
+def _lightning_indexer_ops():
+    """Import the CANN operator lazily so CPU-only tests keep importing this module."""
+    global _LIGHTNING_OPS
+    if _LIGHTNING_OPS is None:
+        try:
+            from cann_ops_transformer.ops import lightning_indexer, lightning_indexer_metadata
+        except Exception:
+            logger.info(
+                'cann_ops_transformer.lightning_indexer is unavailable; QSA selection stays on the local core.',
+                exc_info=True,
+            )
+            _LIGHTNING_OPS = False
+        else:
+            _LIGHTNING_OPS = (lightning_indexer, lightning_indexer_metadata)
+    return _LIGHTNING_OPS or None
+
+
+def _disable_lightning_after_failure(exc: Exception) -> None:
+    global _LIGHTNING_OPS, _LIGHTNING_FALLBACK_WARNED
+    _LIGHTNING_OPS = False
+    if not _LIGHTNING_FALLBACK_WARNED:
+        _LIGHTNING_FALLBACK_WARNED = True
+        logger.warning(
+            'CANN lightning_indexer failed (%s: %s); QSA selection falls back to the local core '
+            'for the rest of the process. Set %s=lightning to fail instead of falling back.',
+            type(exc).__name__,
+            exc,
+            QSA_INDEXER_IMPL_ENV,
+        )
+
+
+def _rotate_half(x: torch.Tensor) -> torch.Tensor:
+    x1 = x[..., : x.shape[-1] // 2]
+    x2 = x[..., x.shape[-1] // 2 :]
+    return torch.cat((-x2, x1), dim=-1)
+
+
+class QSASelection(NamedTuple):
+    """One QSA block selection, in Megatron's vocabulary (``qsa.QSASelection``).
+
+    ``order`` / ``picked`` / ``own_block`` keep Megatron's names and semantics: block
+    ids are document-local (they restart at every pack boundary) and the selected set
+    is ``order[picked] + [own_block]``.
+
+    ``block_start`` is this port's packed encoding of the same choice. Megatron hands
+    ``order`` plus per-document offsets to its triton kernel; the Ascend fused op
+    instead takes pack-space *token* indices, so the selection travels as the first
+    token of each selected block::
+
+        block_start[t] = [doc_start + order[t, 0] * R, ...,
+                          doc_start + order[t, k-1] * R,
+                          doc_start + own_block[t] * R]      # [T, k + 1] int32
+
+    with ``-1`` for unused slots. The last column is the query's own (frontier) block,
+    i.e. the ragged tail Megatron appends under in-kernel causal masking. Every entry
+    is ``doc_start + block * R``, so a consumer recovers document-local block ids with
+    one subtract and one shift, and the indexer needs no per-block table at all: the
+    old ``[T, k*R + R]`` token-index encoding was dominated by an int64 gather over
+    one (10.3 ms of its 15.0 ms at T=26k, k=512), while the arithmetic form costs
+    0.4 ms and is expanded to tokens only on the triton/CP path.
+
+    Attributes:
+        order: ``[..., k]`` int64 document-local block ids, best first. Meaningful
+            only where ``picked``; Megatron zeroes the dropped slots.
+        picked: ``[..., k]`` bool, whether that slot survived top-k (the causal
+            prefix holds more than ``block_topk`` blocks).
+        own_block: ``[s]`` / ``[T]`` int64 document-local id of the block holding
+            the query itself.
+        block_start: ``[T, k + 1]`` int32 packed block starts, or ``None`` for the
+            unpacked selection (which never travels in this encoding).
+    """
+
+    order: Tensor
+    picked: Tensor
+    own_block: Tensor
+    block_start: Optional[Tensor] = None
+
+    @property
+    def block_count(self) -> Tensor:
+        """Blocks each query attends: its own block plus the picked ones."""
+        return self.own_block + self.picked.sum(-1)
+
+
+def _materialize_rope(freqs: torch.Tensor, seq_len: int, dtype: torch.dtype, mscale: float):
+    """Materialize batch-aware RoPE cos/sin from mcore rotary angles.
+
+    ``[s, freq_b, 1, rot] -> [freq_b, s, rot]``. mcore stores angles rather than
+    cos/sin, so they are materialized the way ``_patch_apply_rotary_pos_emb``
+    does, keeping the indexer's RoPE identical to the attention's.
+
+    Keeping ``freq_b`` as its own dim is what makes MRoPE correct: its positions
+    differ per sample, so flattening here would fold batch into the rotary
+    feature dim and make ``rot`` come out as ``b * rot``.
+    """
+    f = freqs[:seq_len].squeeze(2).permute(1, 0, 2)
+    cos = (torch.cos(f) * mscale).to(dtype)
+    sin = (torch.sin(f) * mscale).to(dtype)
+    return cos, sin
+
+
+class _PackedLayout:
+    """Host/device tables of one packed (thd) layout: ``cu_seqlens`` and ``R``.
+
+    Nothing here depends on the hidden states or on the layer, so every QSA layer
+    of a step -- and the activation-recompute pass -- can share one instance.
+    That matters because building it takes one host read of ``cu_seqlens``
+    (``.cpu().tolist()``) plus a set of O(T) device tables; the pre-cache form
+    paid those once per QSA layer, forward and recompute.
+    """
+
+    __slots__ = (
+        'R',
+        'D',
+        'NB',
+        'doc_lens',
+        'full_blocks',
+        'max_full_blocks',
+        'max_doc_len',
+        'cu_q',
+        'cu_k',
+        'residual',
+        'token_doc',
+        'token_pos',
+        'pos_in_doc',
+        'q_nblocks',
+        'full_rows',
+        'full_block_ids',
+        'doc_start32',
+        'token_block_offset',
+        'global_block',
+        'tail_base',
+        'block_doc',
+        'block_in_doc_idx',
+        'first_pack',
+        'block_offset',
+    )
+
+
+_PACKED_LAYOUT_CACHE: 'OrderedDict[tuple, tuple]' = OrderedDict()
+_PACKED_LAYOUT_CACHE_SIZE = 4
+
+
+def _segment_ids(bounds: list, device) -> torch.Tensor:
+    """Owner id of every position in pack space: ``repeat_interleave(arange(D), lens)``.
+
+    Built as a prefix sum over the segment starts -- one O(total) pass. The
+    device-``repeats`` form of ``repeat_interleave`` sorts internally and measured
+    3.5 ms per call at T=26k on Ascend; it was paid twice per layout build.
+    A zero-length segment duplicates its boundary, which a marker cannot count,
+    so that case keeps the general form.
+    """
+    lens = [b - a for a, b in zip(bounds, bounds[1:])]
+    if all(lens):
+        ids = torch.zeros(bounds[-1], dtype=torch.int32, device=device)
+        ids.index_fill_(0, torch.tensor(bounds[1:-1], dtype=torch.long, device=device), 1)
+        return ids.cumsum_(0).long()  # int32: the int64 cumsum is ~4x slower
+    return torch.repeat_interleave(torch.arange(len(lens), device=device), torch.tensor(lens, device=device))
+
+
+def _build_packed_layout(cu_seqlens: torch.Tensor, R: int) -> _PackedLayout:
+    device = cu_seqlens.device
+    # One host read for every scalar (T, D, NB, the two maxima); the per-layer
+    # form paid one .item() drain per scalar.
+    bounds = cu_seqlens.cpu().tolist()
+    lens = [bounds[i + 1] - bounds[i] for i in range(len(bounds) - 1)]
+    blocks = [n // R for n in lens]
+    block_bounds = [0]
+    for nb in blocks:
+        block_bounds.append(block_bounds[-1] + nb)
+    T = bounds[-1]
+
+    lay = _PackedLayout()
+    lay.R = R
+    lay.D = len(lens)
+    lay.NB = block_bounds[-1]
+    lay.max_doc_len = max(lens)
+    lay.max_full_blocks = max(blocks)
+    lay.cu_q = cu_seqlens.to(torch.int32).contiguous()
+    lay.doc_lens = (cu_seqlens[1:] - cu_seqlens[:-1]).long()
+    lay.full_blocks = lay.doc_lens // R
+    lay.block_offset = torch.cumsum(lay.full_blocks, 0) - lay.full_blocks  # exclusive [D]
+    lay.cu_k = torch.cumsum(lay.full_blocks, 0).to(torch.int32)  # [D], complete blocks only
+    lay.cu_k = torch.cat([lay.cu_k.new_zeros(1), lay.cu_k])  # [D + 1]
+    lay.residual = (lay.doc_lens % R).to(torch.int32)  # per-document incomplete tail
+
+    # ---- per-token tables ----
+    lay.token_doc = _segment_ids(bounds, device)  # [T]
+    lay.token_pos = torch.arange(T, device=device)
+    # int32 pack-space index of each token's document start: the base of every
+    # block-start the selection carries, and small enough that a [T, k] block id
+    # times R fits int32 (T < 2^31 / R for any real pack).
+    lay.doc_start32 = lay.cu_q[lay.token_doc]  # [T]
+    lay.pos_in_doc = lay.token_pos - lay.doc_start32.long()  # [T]
+    lay.q_nblocks = (lay.pos_in_doc + 1) // R  # [T]
+    # Rows that sit in a complete R-block, and the global block each one feeds,
+    # both in pack order. Built on the host from the boundaries read above: the
+    # equivalent device form, ``global_block[token_in_full]``, lowers to a
+    # ``nonzero`` whose data-dependent length forces a device->host readback, and
+    # the pooling scatter needs the result on every QSA layer, forward and
+    # recompute (measured 0.5 s/step of host stalls at T=29k on Ascend).
+    lay.full_rows = torch.cat([torch.arange(b, b + (n // R) * R) for b, n in zip(bounds[:-1], lens)]).to(device)
+    lay.full_block_ids = torch.cat(
+        [torch.arange(bo, bo + n // R).repeat_interleave(R) for bo, n in zip(block_bounds[:-1], lens)]
+    ).to(device)
+    lay.token_block_offset = lay.block_offset[lay.token_doc]  # [T]
+    lay.global_block = lay.token_block_offset + lay.pos_in_doc // R  # [T]
+    lay.tail_base = (lay.doc_start32.long() + lay.q_nblocks * R).to(torch.int32)  # [T]
+
+    # ---- per-block tables (pack space) ----
+    lay.block_doc = _segment_ids(block_bounds, device)  # [NB]
+    lay.block_in_doc_idx = torch.arange(lay.NB, device=device) - lay.block_offset[lay.block_doc]  # [NB]
+    # First pack-space token of every global block -- used as the RoPE position of a
+    # pooled block key (`cos[first_pack]`, a [NB] gather).
+    lay.first_pack = lay.doc_start32[lay.block_doc].long() + lay.block_in_doc_idx * R  # [NB]
+    return lay
+
+
+def _packed_layout(cu_seqlens: torch.Tensor, R: int) -> _PackedLayout:
+    """Return the tables for ``(cu_seqlens, R)``, building them once per layout.
+
+    Keyed like gdn.py's boundary cache: ``id`` plus the version counter (so an
+    in-place edit of the boundaries misses), and the entry holds a reference to
+    ``cu_seqlens`` itself so a recycled ``id()`` cannot hit a stale entry.
+    """
+    try:
+        version = cu_seqlens._version
+    except RuntimeError:
+        # Inference tensors carry no version counter -- and are immutable outside
+        # InferenceMode, so the id alone identifies them.
+        version = None
+    key = (id(cu_seqlens), version, R)
+    entry = _PACKED_LAYOUT_CACHE.get(key)
+    if entry is not None:
+        _PACKED_LAYOUT_CACHE.move_to_end(key)
+        return entry[1]
+    layout = _build_packed_layout(cu_seqlens, R)
+    _PACKED_LAYOUT_CACHE[key] = (cu_seqlens, layout)
+    while len(_PACKED_LAYOUT_CACHE) > _PACKED_LAYOUT_CACHE_SIZE:
+        _PACKED_LAYOUT_CACHE.popitem(last=False)
+    return layout
+
+
+class QSAIndexer(nn.Module):
+    """QSA block selection: score compressed key blocks, keep the top-k per query.
+
+    refer: transformers ``Qwen4ExpTextQSAIndexer``. That reference packs scoring and
+    mask construction into one ``forward`` with a per-query Python loop; here scoring
+    is factored into :meth:`select`, whose :class:`QSASelection` the encoders share,
+    so every wire format provably describes the same key set::
+
+        select(hidden, freqs[, cu_seqlens])          the selection itself
+          |                                          -> QSASelection | None
+          +-- selection_as_mask(...)                 -> [b, 1, s, s] bool
+          +-- selection_as_token_indices(...)        -> [b, s, K] int64 token ids
+          +-- select_block_starts_thd(...)           -> [T, k+1] int32 block starts
+          +-- select_token_indices_thd(...)          -> [T, K] int32 token ids
+
+    ``select`` returns ``None`` when no query sees more than ``block_topk`` complete
+    blocks: the causal prefix is then the whole visible set and the caller keeps the
+    plain causal path (TE's fused kernel for thd, dense attention otherwise).
+
+    Which encoding the layer asks for::
+
+        sbhd, CP==1        -> selection_as_mask           -> TE `arbitrary` mask
+        sbhd, CP>1         -> selection_as_token_indices  -> triton sparse kernel
+        thd                -> select_block_starts_thd     -> fused kernels, expanded
+                                                             to token ids on demand
+
+    thd needs its own filtering path because the causal prefix is per-document
+    (``cu_seqlens``) rather than ``(arange(s) + 1) // R``, and because TE rejects an
+    ``arbitrary`` mask once ``qkv_format == 'thd'``. Indices also scale as O(s*k)
+    instead of the mask's O(s^2), which is what makes very long sequences feasible.
+    """
+
+    def __init__(self, config, tp_group=None):
+        super().__init__()
+        self.config = config
+        self.tp_group = tp_group
+        self.index_n_heads = config.indexer_n_heads
+        self.index_kv_heads = config.indexer_kv_heads
+        self.index_head_dim = config.indexer_head_dim
+        self.compress_ratio = config.indexer_compress_ratio
+        self.token_budget = config.indexer_budget
+        self.block_topk = self.token_budget // self.compress_ratio
+        self.index_qk_proj = ReplicatedLinear(
+            config,
+            config.hidden_size,
+            (self.index_n_heads + self.index_kv_heads) * self.index_head_dim,
+            bias=False,
+            skip_bias_add=True,
+        )
+        self.q_layernorm = Qwen4ExpTextRMSNorm(
+            self.index_head_dim,
+            eps=config.layernorm_epsilon,
+            dtype=config.params_dtype,
+            sequence_parallel=config.sequence_parallel,
+        )
+        self.k_layernorm = Qwen4ExpTextRMSNorm(
+            self.index_head_dim,
+            eps=config.layernorm_epsilon,
+            dtype=config.params_dtype,
+            sequence_parallel=config.sequence_parallel,
+        )
+        # The projection is replicated across TP, so its grad is reduced across TP when SP is on.
+        setattr(self.index_qk_proj.weight, 'sequence_parallel', config.sequence_parallel)
+        # QSA selection is non-differentiable and always runs without autograd.
+        # Keep its pretrained parameters out of optimizer groups and DDP buckets.
+        self.requires_grad_(False)
+
+    def forward(self, *args, **kwargs):
+        raise RuntimeError(
+            'QSAIndexer selects via select / selection_as_mask / selection_as_token_indices / '
+            'select_block_starts_thd, not forward.'
+        )
+
+    @torch.no_grad()
+    def select(
+        self, hidden_states: torch.Tensor, freqs: torch.Tensor, cu_seqlens: Optional[torch.Tensor] = None
+    ) -> Optional[QSASelection]:
+        """Run the indexer and return the block selection (Megatron's signature).
+
+        Args:
+            hidden_states: ``[s, b, h]`` pre-attention input (mcore layout), or the
+                packed ``[T, h]`` flattening the layer already holds.
+            freqs: mcore rotary angles ``[s, freq_b, 1, rot]`` for unpacked inputs,
+                per-token ``[T, ...]`` rows for packed ones (each row already encodes
+                its token's in-document position).
+            cu_seqlens: ``[D+1]`` int document boundaries for packed (thd) inputs,
+                ``None`` for the unpacked causal layout.
+
+        Returns:
+            :class:`QSASelection`, or ``None`` when the causal prefix never exceeds
+            ``block_topk`` blocks (selection is a no-op and the caller stays on the
+            plain causal path).
+        """
+        if cu_seqlens is None:
+            return self._select_unpacked(hidden_states, freqs)
+        hidden_tok = hidden_states.reshape(hidden_states.shape[0], -1)
+        return self._select_packed(hidden_tok, freqs, cu_seqlens)
+
+    @torch.no_grad()
+    def _select_unpacked(self, hidden_states: torch.Tensor, freqs: torch.Tensor) -> Optional[QSASelection]:
+        """Unpacked (sbhd) selection: the per-sample causal layout.
+
+        Args:
+            hidden_states: ``[s, b, h]`` (mcore layout), pre-attention input --
+                the same tensor the reference indexer consumes.
+            freqs: mcore rotary frequencies ``[s, freq_b, 1, rot_dim]``, where
+                ``freq_b`` is 1 for ordinary RoPE or ``b`` for batch-dependent
+                MRoPE. mcore stores angles rather than cos/sin, so they are
+                materialized here the way ``_patch_apply_rotary_pos_emb`` does
+                (``cos(freqs) * mscale``), keeping the indexer's RoPE identical
+                to the attention's.
+
+        Returns:
+            ``None`` when selection is a no-op (the causal prefix never exceeds
+            the budget), else a :class:`QSASelection` whose ``order``/``picked``
+            are ``[b, s, k]`` (``k = min(block_topk, max_blocks)``), ``own_block``
+            is ``[s]`` and ``block_start`` is ``None``.
+        """
+        s, b, _ = hidden_states.shape
+        R = self.compress_ratio
+        max_blocks = s // R
+        if max_blocks <= self.block_topk:
+            return None
+
+        device = hidden_states.device
+        # ---- project to indexer q/k ----
+        # [s, b, h] -> [s, b, (nh + nkv) * d]
+        qk = self.index_qk_proj(hidden_states)[0]
+        q, token_k = torch.split(
+            qk, [self.index_n_heads * self.index_head_dim, self.index_kv_heads * self.index_head_dim], dim=-1
+        )
+        # -> [b, s, nh, d] / [b, s, d]
+        q = q.view(s, b, self.index_n_heads, self.index_head_dim).permute(1, 0, 2, 3)
+        raw_keys = token_k.view(s, b, self.index_kv_heads, self.index_head_dim).permute(1, 0, 2, 3).squeeze(2)
+        q = self.q_layernorm(q)
+
+        # ---- materialize cos/sin from mcore freqs ----
+        # freqs is [s, freq_b, 1, rot]; mrope makes dim 1 the real batch
+        # (rope_utils.py:344), and _materialize_rope keeps it so it broadcasts.
+        mscale = self.config.attention_scaling
+        cos, sin = _materialize_rope(freqs, s, q.dtype, mscale)
+        rot = cos.shape[-1]
+
+        def apply_rope(t, cos_, sin_):
+            t_rope, t_pass = t[..., :rot], t[..., rot:]
+            t_rope = (t_rope * cos_) + (_rotate_half(t_rope) * sin_)
+            return torch.cat((t_rope, t_pass), dim=-1)
+
+        # queries rotate at their own position: cos [bf, s, rot] -> [bf, s, 1, rot]
+        q = apply_rope(q, cos.unsqueeze(2), sin.unsqueeze(2))
+
+        # ---- pool every block once (shared across queries) ----
+        usable = max_blocks * R
+        key_groups = raw_keys[:, :usable].view(b, max_blocks, R, self.index_head_dim)
+        pooled = key_groups.float().mean(dim=2).to(raw_keys.dtype)
+        pooled = self.k_layernorm(pooled)
+        # blocks rotate at their first token's position
+        starts = torch.arange(max_blocks, device=device) * R
+        block_keys = apply_rope(pooled, cos[:, starts], sin[:, starts])  # [b, nb, d]
+
+        # Bound score workspace by queries, preserving all candidate blocks.
+        chunk_size = max(1, min(s, _QSA_INDEX_SCORE_CHUNK_BYTES // max(1, b * self.index_n_heads * max_blocks * 4)))
+        n_blocks = (torch.arange(s, device=device) + 1) // R
+        block_ids = torch.arange(max_blocks, device=device)
+        k = min(self.block_topk, max_blocks)
+        order = torch.empty((b, s, k), dtype=torch.long, device=device)
+        picked = torch.empty((b, s, k), dtype=torch.bool, device=device)
+        keys_float = block_keys.float()
+        for start in range(0, s, chunk_size):
+            end = min(start + chunk_size, s)
+            scores = torch.einsum('bqhd,bkd->bqhk', q[:, start:end].float(), keys_float)
+            scores = torch.relu(scores).sum(dim=2) / math.sqrt(self.index_head_dim)
+            scores = scores.masked_fill((block_ids[None, :] >= n_blocks[start:end, None])[None], float('-inf'))
+            selected = scores.topk(k, dim=-1).indices
+            # A slot is picked iff its score was not masked to -inf; the dropped slots
+            # carry block 0, Megatron's convention (validity lives in `picked`).
+            keep = selected < n_blocks[None, start:end, None]
+            order[:, start:end] = torch.where(keep, selected, torch.zeros_like(selected))
+            picked[:, start:end] = keep
+            del scores, selected, keep
+        return QSASelection(order=order, picked=picked, own_block=n_blocks)
+
+    @torch.no_grad()
+    def selection_as_mask(self, hidden_states: torch.Tensor, freqs: torch.Tensor) -> Optional[torch.Tensor]:
+        """Encode the selection as a bool mask, or ``None`` when it is a no-op.
+
+        Returns:
+            ``[b, 1, s, s]`` bool mask where True marks a *masked-out* key (TE's
+            ``arbitrary`` convention), or ``None`` if every visible key is
+            selected -- in which case the caller keeps the plain causal path and
+            pays nothing.
+
+        Only the causal, unpacked layout is handled; callers must not invoke this
+        for packed/THD or context-parallel inputs (see the guard in the layer).
+        """
+        selection = self.select(hidden_states, freqs)
+        # when seq lengths less than budget
+        if selection is None:
+            return None
+        s, b, _ = hidden_states.shape
+        R = self.compress_ratio
+        device = hidden_states.device
+
+        # ---- top-k blocks -> token mask ----
+        tok = (selection.order.unsqueeze(-1) * R + torch.arange(R, device=device)).flatten(-2)
+        keep_tok = selection.picked.unsqueeze(-1).expand(-1, -1, -1, R).flatten(-2)
+
+        allowed = torch.zeros((b, s, s + 1), dtype=torch.bool, device=device)
+        allowed.scatter_(-1, torch.where(keep_tok, tok, torch.full_like(tok, s)).long(), True)
+        allowed = allowed[..., :s]
+        # tail: visible tokens after the last complete block are always attended
+        pos = torch.arange(s, device=device)
+        tail = (pos[None, :] >= (selection.own_block * R)[:, None]) & (pos[None, :] <= pos[:, None])
+        allowed |= tail[None]
+        # causal safety net (the block expansion never crosses it, but keep the
+        # invariant explicit so a future layout change fails loudly instead of
+        # silently attending to the future)
+        allowed &= (pos[None, :] <= pos[:, None])[None]
+        return ~allowed.unsqueeze(1)  # True == masked out
+
+    @torch.no_grad()
+    def selection_as_token_indices(self, hidden_states: torch.Tensor, freqs: torch.Tensor) -> Optional[torch.Tensor]:
+        """Encode the selection as token indices for the sparse kernel.
+
+        Returns:
+            ``[b, s, K]`` int64 (``K = block_topk*R + R``) with ``-1`` marking
+            unused slots, or ``None`` when selection is a no-op. Indices live in
+            per-sample sequence space, matching ``qsa_sparse_attention``'s sbhd
+            branch. Top-block tokens and the query's own partial-block tail are
+            disjoint, so the kernel attends each selected key exactly once.
+
+        Same layout constraints as ``selection_as_mask`` (causal, unpacked).
+        """
+        selection = self.select(hidden_states, freqs)
+        if selection is None:
+            return None
+        s, b, _ = hidden_states.shape
+        R = self.compress_ratio
+        device = hidden_states.device
+        k = selection.order.shape[-1]
+        arange_r = torch.arange(R, device=device)
+
+        # top-k blocks expanded to tokens: [b, s, k, R] -> [b, s, k*R]; dropped
+        # (-inf) slots carry -1 so the kernel skips them.
+        tok = selection.order.unsqueeze(-1) * R + arange_r
+        top_idx = tok.flatten(-2)
+        top_keep = selection.picked.unsqueeze(-1).expand(-1, -1, -1, R).reshape(b, s, k * R)
+        top_idx = torch.where(top_keep, top_idx, top_idx.new_full((), -1))
+
+        # tail: the query's own partial block, causally truncated: [b, s, R]
+        pos = torch.arange(s, device=device)
+        tail_idx = (selection.own_block * R)[:, None] + arange_r[None, :]  # [s, R]
+        tail_idx = torch.where(tail_idx <= pos[:, None], tail_idx, tail_idx.new_full((), -1))
+        tail_idx = tail_idx[None].expand(b, s, R)
+
+        return torch.cat([top_idx, tail_idx], dim=-1).to(torch.int64)
+
+    def _lightning_select_blocks_thd(self, q, block_keys, layout: _PackedLayout):
+        """Top-k blocks via CANN LightningIndexerV2, or ``None`` to use the local core.
+
+        ``q`` is already RoPE'd at each token's in-document position, ``block_keys``
+        is already pooled/normalized/RoPE'd at each block's first token. The
+        operator applies the QSA visibility rule itself: with ``cmp_ratio=R`` a
+        query at in-document position ``p`` sees blocks ``0 .. (p+1)//R - 1``,
+        exactly the complete-block prefix the local scorer masks out, and
+        ``cmp_residual_k`` carries each document's incomplete-tail length.
+
+        Returns ``(order, picked)`` with document-local block ids, the same contract
+        as the local core: the operator already reports ids per document (A2/A3 have
+        no ``output_idx_offset``), which is exactly Megatron's ``QSASelection.order``.
+        """
+        impl = _qsa_indexer_impl()
+        if impl == 'legacy':
+            return None
+
+        unsupported = None
+        if q.device.type != 'npu':
+            unsupported = f'device {q.device.type!r}'
+        elif q.dtype not in (torch.bfloat16, torch.float16):
+            unsupported = f'dtype {q.dtype}'
+        elif self.index_head_dim != 128:
+            unsupported = f'indexer_head_dim={self.index_head_dim}'
+        elif self.compress_ratio not in (1, 4, 128):
+            unsupported = f'indexer_compress_ratio={self.compress_ratio}'
+        elif self.index_kv_heads != 1:
+            unsupported = f'indexer_kv_heads={self.index_kv_heads}'
+        elif self.token_budget <= 0 or self.token_budget % self.compress_ratio != 0:
+            unsupported = f'indexer_budget={self.token_budget}'
+        elif block_keys.shape[0] < self.block_topk:
+            unsupported = f'only {block_keys.shape[0]} blocks for block_topk={self.block_topk}'
+        if unsupported is not None:
+            if impl == 'lightning':
+                raise RuntimeError(
+                    f'{QSA_INDEXER_IMPL_ENV}=lightning, but the packed selection is unsupported: {unsupported}'
+                )
+            return None
+
+        ops = _lightning_indexer_ops()
+        if ops is None:
+            if impl == 'lightning':
+                raise RuntimeError(
+                    f'{QSA_INDEXER_IMPL_ENV}=lightning, but cann_ops_transformer.lightning_indexer is unavailable'
+                )
+            return None
+        lightning_indexer, lightning_indexer_metadata = ops
+
+        R = self.compress_ratio
+        D = layout.D
+        cu_q, cu_k, residual = layout.cu_q, layout.cu_k, layout.residual
+        try:
+            metadata = lightning_indexer_metadata(
+                num_heads_q=self.index_n_heads,
+                num_heads_k=self.index_kv_heads,
+                head_dim=self.index_head_dim,
+                topk=self.block_topk,
+                cu_seqlens_q=cu_q,
+                cu_seqlens_k=cu_k,
+                cmp_residual_k=residual,
+                batch_size=D,
+                max_seqlen_q=layout.max_doc_len,
+                max_seqlen_k=layout.max_full_blocks,
+                layout_q='TND',
+                layout_k='TND',
+                mask_mode=3,
+                cmp_ratio=R,
+            )
+            weights = torch.full(
+                (q.shape[0], self.index_n_heads),
+                1.0 / math.sqrt(self.index_head_dim),
+                dtype=torch.float32,
+                device=q.device,
+            )
+            selected, _ = lightning_indexer(
+                q.contiguous(),
+                block_keys.unsqueeze(1).contiguous(),
+                weights,
+                self.block_topk,
+                cu_seqlens_q=cu_q,
+                cu_seqlens_k=cu_k,
+                cmp_residual_k=residual,
+                metadata=metadata,
+                max_seqlen_q=-1,
+                layout_q='TND',
+                layout_k='TND',
+                mask_mode=3,
+                cmp_ratio=R,
+                return_value=0,
+            )
+        except Exception as exc:
+            if impl == 'lightning':
+                raise
+            _disable_lightning_after_failure(exc)
+            return None
+
+        if selected.dim() == 3:
+            selected = selected.squeeze(1)  # [T, 1, topk] -> [T, topk]
+        picked = selected >= 0
+        # Dropped slots carry block 0 (Megatron's convention); `picked` marks them.
+        order = torch.where(picked, selected, torch.zeros((), dtype=selected.dtype, device=selected.device))
+        return order.long(), picked
+
+    # ---- packed (thd) selection ---------------------------------------------
+
+    @torch.no_grad()
+    def select_block_starts_thd(
+        self,
+        hidden_tok: torch.Tensor,
+        freqs: torch.Tensor,
+        cu_seqlens: torch.Tensor,
+        force_materialize: bool = False,
+    ) -> Optional[torch.Tensor]:
+        """Packed selection in the wire format the fused attention consumes.
+
+        Args:
+            hidden_tok: ``[T, h]`` packed tokens (the dummy batch dim squeezed out).
+            freqs: rotary angles ``[T, ...]``; each row already encodes that token's
+                *in-document* position (mcore builds them from per-doc position ids
+                under padding_free), so they are reused as-is here.
+            cu_seqlens: ``[D+1]`` int document boundaries (``cu[0] == 0``,
+                ``cu[-1] == T``).
+            force_materialize: build the (select-all) carrier even when selection is
+                a no-op. Callers pass it when the dense packed fallback is unusable,
+                i.e. thd under context parallelism: TE restricts thd+all_gather to
+                FusedAttention/FlashAttention-v3, so the no-op must stay on the
+                CP-aware sparse kernel instead of degrading to a TE path with no
+                backend.
+
+        Returns:
+            ``[T, block_topk + 1]`` int32 pack-space block starts (``-1`` unused,
+            own block last) -- see :class:`QSASelection` -- or ``None`` when the
+            selection is a no-op for every document, in which case TE's packed
+            causal kernel reproduces it exactly.
+        """
+        selection = self._select_packed(hidden_tok, freqs, cu_seqlens, force_materialize)
+        return None if selection is None else selection.block_start
+
+    @torch.no_grad()
+    def select_token_indices_thd(
+        self,
+        hidden_tok: torch.Tensor,
+        freqs: torch.Tensor,
+        cu_seqlens: torch.Tensor,
+        force_materialize: bool = False,
+    ) -> Optional[torch.Tensor]:
+        """Same selection expanded to token indices: ``[T, K]`` int32 (``K = budget+R``).
+
+        Only the triton kernel and the CP fallback need this encoding; the fused path
+        consumes :meth:`select_block_starts_thd` directly. See
+        :func:`expand_block_starts` for the expansion itself.
+        """
+        block_start = self.select_block_starts_thd(hidden_tok, freqs, cu_seqlens, force_materialize)
+        if block_start is None:
+            return None
+        return expand_block_starts(block_start, cu_seqlens, self.compress_ratio)
+
+    @torch.no_grad()
+    def _select_packed(
+        self,
+        hidden_tok: torch.Tensor,
+        freqs: torch.Tensor,
+        cu_seqlens: torch.Tensor,
+        force_materialize: bool = False,
+    ) -> Optional[QSASelection]:
+        """Packed (thd) selection: one document-scoped top-k, ids document-local."""
+        R = self.compress_ratio
+        # Every table below depends only on the packed boundaries and R, never on the
+        # hidden states, so it is built once per microbatch and shared by all QSA
+        # layers (and by the activation-recompute pass). See _PackedLayout.
+        layout = _packed_layout(cu_seqlens, R)
+        if not force_materialize and layout.max_full_blocks <= self.block_topk:
+            return None
+        q, block_keys = self._packed_q_and_block_keys(hidden_tok, freqs, layout)
+        order, picked = self._packed_topk_blocks(q, block_keys, layout)
+        own_block = layout.q_nblocks
+        return QSASelection(
+            order=order,
+            picked=picked,
+            own_block=own_block,
+            block_start=_block_start_carrier(order, picked, layout),
+        )
+
+    def _packed_q_and_block_keys(self, hidden_tok, freqs, layout: _PackedLayout):
+        """Project, RoPE and pool: indexer queries ``[T, nh, d]`` and block keys ``[NB, d]``."""
+        T = hidden_tok.shape[0]
+        R = self.compress_ratio
+        device = hidden_tok.device
+
+        # ---- project to indexer q/k ----
+        qk = self.index_qk_proj(hidden_tok)[0]
+        q, token_k = torch.split(
+            qk, [self.index_n_heads * self.index_head_dim, self.index_kv_heads * self.index_head_dim], dim=-1
+        )
+        q = q.view(T, self.index_n_heads, self.index_head_dim)
+        raw_keys = token_k.view(T, self.index_kv_heads, self.index_head_dim).squeeze(1)  # [T, d]
+        q = self.q_layernorm(q)
+
+        # ---- rope on q at its own (in-doc) position ----
+        # Deliberately not _materialize_rope: thd has no batch dim to preserve
+        # (samples are already flattened into T), so the trailing dims are folded
+        # into rot here instead of being kept separate.
+        mscale = self.config.attention_scaling
+        f = freqs.reshape(freqs.shape[0], -1)[:T]
+        cos = (torch.cos(f) * mscale).to(q.dtype)
+        sin = (torch.sin(f) * mscale).to(q.dtype)
+        rot = cos.shape[-1]
+
+        def apply_rope(t, cos_, sin_):
+            t_rope, t_pass = t[..., :rot], t[..., rot:]
+            t_rope = (t_rope * cos_) + (_rotate_half(t_rope) * sin_)
+            return torch.cat((t_rope, t_pass), dim=-1)
+
+        q = apply_rope(q, cos.unsqueeze(1), sin.unsqueeze(1))  # [T, nh, d]
+
+        # ---- pool complete blocks in pack space (shared across queries) ----
+        pooled_sum = torch.zeros(layout.NB, self.index_head_dim, device=device, dtype=torch.float32)
+        # Gather/scatter through the layout's cached row table instead of
+        # `global_block[token_in_full]` / `raw_keys[token_in_full]`: boolean-mask
+        # indexing lowers to a nonzero plus a device->host readback of its
+        # data-dependent length, and this is paid on every QSA layer, forward and
+        # recompute. `index_select` is shape-static and copies too, so the cached
+        # tables are equally safe here.
+        full_keys = raw_keys.index_select(0, layout.full_rows)
+        pooled_sum.index_add_(0, layout.full_block_ids, full_keys.float())
+        pooled = (pooled_sum / R).to(raw_keys.dtype)  # exactly R tokens per full block
+        pooled = self.k_layernorm(pooled)  # [NB, d]
+
+        # blocks rotate at their first token's in-doc position
+        first_pack = layout.first_pack
+        block_keys = apply_rope(pooled, cos[first_pack], sin[first_pack])  # [NB, d]
+        return q, block_keys
+
+    def _packed_topk_blocks(self, q, block_keys, layout: _PackedLayout):
+        """Score every (token, block) pair and keep the top-k, ids document-local."""
+        T, device = q.shape[0], q.device
+        NB = layout.NB
+        k = min(self.block_topk, NB)
+        # Two interchangeable cores with the same contract: CANN LightningIndexerV2
+        # when it is available and the shape fits, else the chunked torch core.
+        core = self._lightning_select_blocks_thd(q, block_keys, layout)
+        if core is not None:
+            return core
+        # The score -> relu -> head-sum -> mask -> top-k pipeline is row-wise independent, so it is
+        # processed in query chunks and only each row's top-k survives. This keeps peak memory at
+        # O(chunk * NB) instead of materializing the full [T, n_heads, NB] fp32 score tensor (and the
+        # [T, NB] masked copy), which is O(seq^2 / compress_ratio) and OOMs at long packed sequences.
+        # Numerically identical to the un-chunked form: every row is computed the same way.
+        scale = math.sqrt(self.index_head_dim)
+        chunk = max(1, min(T, _QSA_INDEX_SCORE_CHUNK_BYTES // max(1, self.index_n_heads * NB * 4)))
+        block_doc, block_in_doc_idx = layout.block_doc, layout.block_in_doc_idx
+        order = torch.empty(T, k, dtype=torch.long, device=device)
+        picked = torch.empty(T, k, dtype=torch.bool, device=device)
+        for start in range(0, T, chunk):
+            end = min(start + chunk, T)
+            sc = torch.einsum('thd,kd->thk', q[start:end].float(), block_keys.float())
+            sc = torch.relu(sc).sum(dim=1) / scale  # [c, NB]
+            td = layout.token_doc[start:end]
+            valid_c = (block_doc[None, :] == td[:, None]) & (
+                block_in_doc_idx[None, :] < layout.q_nblocks[start:end, None]
+            )  # [c, NB]
+            sc = sc.masked_fill(~valid_c, float('-inf'))
+            selected = sc.topk(k, dim=-1)  # [c, k] into [0, NB)
+            # A block survives selection iff its score was not masked to -inf. Read
+            # that off topk's own values instead of gathering the [c, NB] mask by
+            # the indices: aclnn's bool GatherElements is scalarized, ~28 ms per
+            # call at 9120 x 7358, while `values` is already materialized. Scores
+            # are relu outputs, so a valid entry can never be -inf itself.
+            keep = torch.isfinite(selected.values)
+            # Global ids -> document-local (Megatron's `order`); dropped slots carry 0.
+            local = selected.indices - layout.token_block_offset[start:end, None]
+            order[start:end] = torch.where(keep, local, torch.zeros_like(local))
+            picked[start:end] = keep
+            del sc, valid_c, selected, keep, local
+        return order, picked
+
+
+def _block_start_carrier(order: Tensor, picked: Tensor, layout: _PackedLayout) -> Tensor:
+    """Document-local block ids -> ``[T, k + 1]`` int32 pack-space block starts.
+
+    ``doc_start + block * R`` is the first pack-space token of that block, so the
+    carrier is one broadcast add plus a masked ``where``: 0.4 ms at T=26k, k=512,
+    against 10.3 ms for the int64 ``first_pack32[order]`` gather it replaces. The
+    own (frontier) block is appended as the last column, mirroring Megatron's
+    ``own_block`` append.
+    """
+    base = layout.doc_start32.unsqueeze(1) + order.to(torch.int32) * layout.R
+    base = torch.where(picked, base, base.new_full((), -1))
+    return torch.cat([base, layout.tail_base.unsqueeze(1)], dim=1)
+
+
+def expand_block_starts(block_start: Tensor, cu_seqlens: Tensor, R: int, rows: Optional[Tensor] = None) -> Tensor:
+    """``[N, k + 1]`` pack-space block starts -> ``[N, (k + 1) * R]`` token indices.
+
+    Every block expands to its ``R`` consecutive tokens and the frontier column is
+    clamped at the query's own position, so the result is the flat "whole blocks,
+    then a causally clipped tail" layout the triton kernel indexes by block. ``-1``
+    marks both unused slots and the frontier's future tokens.
+
+    Args:
+        block_start: ``[N, k + 1]`` int32 pack-space block starts, own block last.
+        cu_seqlens: the boundaries the selection was made against.
+        R: the indexer's ``compress_ratio``.
+        rows: pack-space row ids of ``block_start`` when it has already been
+            sliced (the CP path selects its own rows first); ``None`` when it
+            covers the whole pack.
+    """
+    layout = _packed_layout(cu_seqlens, R)
+    positions = layout.token_pos
+    if rows is not None:
+        positions = positions.index_select(0, rows)
+    if positions.numel() != block_start.shape[0]:
+        raise ValueError(
+            f'QSA block starts cover {block_start.shape[0]} rows but the layout has '
+            f'{positions.numel()}; pass `rows` when the carrier is pre-sliced.'
+        )
+    arange_r = torch.arange(R, device=block_start.device, dtype=torch.int32)
+    tokens = block_start.unsqueeze(-1) + arange_r  # [N, k + 1, R]
+    # `-1` slots stay -1, and the frontier column keeps only the tokens up to the
+    # query: one clip covers both, since every other column is a fully visible block.
+    keep = (block_start.unsqueeze(-1) >= 0) & (tokens <= positions.to(torch.int32).reshape(-1, 1, 1))
+    return torch.where(keep, tokens, tokens.new_full((), -1)).flatten(-2)
