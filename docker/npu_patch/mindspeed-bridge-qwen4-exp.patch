+    # a row whose whole top-k was dropped still expands its own frontier block,
+    # clipped at the query -- the "select-all" case of a short document
+    t = 10
+    row = torch.cat([torch.full((1, keep_blocks), -1, dtype=torch.int32), layout.tail_base[t : t + 1].unsqueeze(1)], dim=1)
+    empty = expand_block_starts(row, cu, R, rows=torch.tensor([t]))
