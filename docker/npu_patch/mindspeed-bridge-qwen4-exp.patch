+#!/usr/bin/env python
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Write a *shrunken* variant of a Qwen3.8-Flash-Next PLE checkpoint.
+
+The released n-gram table is 320,001,536 rows of 160 values -- 51.2B parameters,
+102.4 GB in bf16 -- over `split_ngram_parts=128` files. That is a table nobody can
+train: one rank's rows are 51.2 GB at tp=2, and DDP gives every parameter that
+requires grad a device grad buffer no matter where its storage is (see
+`QWEN4_EXP_PLE_CPU_OFFLOAD=0` in `ple.py`). This script writes the same
+checkpoint with **the table's geometry cut down** so that it fits on a die and can
+be an ordinary trainable parameter: only the table changes, and every other file of
+the model is a symlink to the source checkpoint's own copy.
+
+What it writes, and why each piece:
+
+1. ``config.json`` with ``text_config.ngram_vocab_size_base`` lowered. The
+   *geometry* follows the config -- the head vocabularies are the primes after that
+   base, their total is padded to ``make_ngram_vocab_size_divisible_by`` and cut
+   into ``split_ngram_parts`` shards -- so this one number is what the whole table
+   layout hangs off. Nothing else in the config is base-dependent.
+2. The 128 table shards at the new shape, **filled with zeros**. The PLE branch is
+   bilinear in the table (a projection and a gated conv read it, the gate comes
+   from the hidden states), so a zero table is exactly "this branch contributes
+   nothing" -- the same starting point the reference gives its own conv
+   (``nn.Parameter(torch.zeros(...))``). The rows are therefore not the released
+   table's values: a run on this checkpoint is not numerically comparable with one
+   on the released table, which is the price of the table being trainable at all.
+3. The two hash-index buffers ``ngram_heads_vocab_sizes`` / ``ngram_heads_offsets``
+   recomputed for the new base. They are derived constants -- the primes and their
+   prefix sums -- but they are stored, and the bridge checks the stored copy
+   against the one the module derives (``ReplicatedMapping``), so they have to be
+   rewritten or the load fails on a legitimately different table.
+   ``layer_multipliers`` does *not* change: it depends on ``vocab_size``,
+   ``ngram_size`` and ``seed``, none of which this script touches.
+4. ``model.safetensors.index.json`` remapping those 130 names to the one new file.
+   Every other entry keeps pointing at the source checkpoint's file, through a
+   symlink; the data of the file a name is not in is never read (the readers open
+   by name, `safetensors` and `Qwen4ExpTextNGramEmbedding` alike).
+
+The new file is named ``model-00000-of-00008.safetensors`` **on purpose**: the
+plugin locates the shards by walking the files the index names, in sorted order,
+and stopping as soon as it has ``split_ngram_parts`` of them (``ple._locate_shards``).
+The old shards are still physically in the symlinked files' headers, so a name that
+sorted after ``model-00001-...`` would have the locator read the *old* table and
+fail its shape check against the new geometry. Sorting first is what makes the new
+table the one that is read, and the script's last step is that check.
+
+The arithmetic here is the plugin's own (``ple.head_vocab_sizes``) on purpose: a
+re-implementation would be a second source of truth for the geometry and the two
+would drift. Importing the plugin imports the bridge, which needs the run's
+environment (and ``torch_npu`` on the path):
+
+    PYTHONPATH=<Relax>:/root/Megatron-Bridge/src:/root/MindSpeed:/root/Megatron-LM \\
+    python mindspeed_bridge/models/qwen4_exp/modelling_qwen4_exp/tests/make_ple_table_variant.py \\
+        --source "${MODEL_DIR}/Qwen3.8-Flash-Next-4L-ple" \\
+        --target "${MODEL_DIR}/Qwen3.8-Flash-Next-4L-ple-small" \\
+        --ngram-vocab-size-base 1000000
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import struct
+import sys
+from typing import Dict, List, Sequence, Tuple
+
+import torch
+
+# `...ple.ple_embedding.ngram_embedding.shard_<i>.weight`, and the two index buffers
+# next to it. The prefix is taken off the checkpoint's own keys rather than spelled
+# out, so a renamed layer does not silently get a half-rewritten table.
+_SHARD_KEY_RE = re.compile(r"^(?P<prefix>.*\.ple\.ple_embedding\.)ngram_embedding\.shard_(?P<index>\d+)\.weight$")
+_VOCAB_SIZES_SUFFIX = "ngram_heads_vocab_sizes"
+_OFFSETS_SUFFIX = "ngram_heads_offsets"
+
+# safetensors: `<u64 header length><utf-8 json header><data>`, with the header padded
+# so the data section starts 8-byte aligned -- which is what the reference writer
+# does, and one less difference to wonder about. A bfloat16 zero is all-zero bytes,
+# so a zero shard is written as a run of zeroes rather than materialized.
+_HEADER_ALIGN = 8
+_ZERO_CHUNK = 1 << 20
+_DTYPE_BYTES = {"BF16": 2, "I64": 8}
+
+# Position of the PLE layer in `ple_layer_ids`, which is what salts its hash. The
+# released checkpoints carry one PLE layer (`ple_layer_ids=[2]`, one-based).
+_PLE_LAYER_INDEX = 0
+
+
+def _ple():
+    """The plugin module, after the bootstrap its package import needs.
+
+    ``mindspeed_bridge.models.qwen4_exp`` imports the bridge, which imports
+    ``transformer_engine_torch`` -- a module that does not exist on Ascend until
+    ``torch_npu`` and MindSpeed's adaptor have installed their stand-in. So the
+    plugin is imported on first use and not at the top of the file, exactly as
+    ``test_ple.py`` does it.
+    """
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp import ple  # pylint: disable=import-outside-toplevel
+
+    return ple
+
+
+def _setup_npu() -> None:
+    """Install that stand-in: ``import torch_npu``, then MindSpeed's Megatron patches.
+
+    By name rather than ``import`` statements: the order is what matters (the
+    adaptor patches what ``torch_npu`` installed) and an import block is something a
+    sorter is free to reorder.
+    """
+    import importlib  # pylint: disable=import-outside-toplevel
+
+    for module in ("torch_npu", "mindspeed.megatron_adaptor"):
+        importlib.import_module(module)
+
+
+def _load_json(path: str) -> dict:
+    with open(path, "r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def _dump_json(path: str, payload: dict) -> None:
+    with open(path, "w", encoding="utf-8") as handle:
+        json.dump(payload, handle, indent=2)
+        handle.write("\n")
+
+
+def _shard_keys(weight_map: Dict[str, str]) -> List[str]:
+    """The checkpoint's table shards in index order (the prefix is read off them)."""
+    found: Dict[int, str] = {}
+    for key in weight_map:
+        match = _SHARD_KEY_RE.match(key)
+        if match is not None:
+            found[int(match.group("index"))] = key
+    if not found:
+        raise KeyError("the checkpoint names no `...ple.ple_embedding.ngram_embedding.shard_<i>.weight` tensor")
+    indices = sorted(found)
+    if indices != list(range(len(indices))):
+        raise ValueError(f"the table's shards are numbered {indices[0]}..{indices[-1]} with gaps: {indices}")
+    return [found[index] for index in indices]
+
+
+def _buffer_keys(weight_map: Dict[str, str], prefix: str) -> Tuple[str, str]:
+    sizes, offsets = f"{prefix}{_VOCAB_SIZES_SUFFIX}", f"{prefix}{_OFFSETS_SUFFIX}"
+    for key in (sizes, offsets):
+        if key not in weight_map:
+            raise KeyError(f"the checkpoint carries no {key!r}: its table cannot be rebuilt without it")
+    return sizes, offsets
+
+
+def _geometry(base: int, ngram_heads: int, divider: int, split_parts: int) -> Tuple[List[int], int, int]:
+    """``(head vocab sizes, padded rows, rows per shard)`` for one base, by the plugin's arithmetic."""
+    sizes = _ple().head_vocab_sizes(base, ngram_heads, _PLE_LAYER_INDEX)
+    padded = -(-sum(sizes) // divider) * divider
+    if padded % split_parts:
+        raise ValueError(
+            f"base {base} gives {sum(sizes)} rows, padding to {padded}, which does not divide into "
+            f"split_ngram_parts={split_parts} shards. Pick another base."
+        )
+    return sizes, padded, padded // split_parts
+
+
+def _on_disk_bytes(weight_map: Dict[str, str], source: str, keys: Sequence[str]) -> int:
+    """What the tensors this script replaces take up, out of the source's own headers."""
+    total = 0
+    for key in keys:
+        header, _ = _ple()._read_safetensors_header(os.path.join(source, weight_map[key]))
+        start, stop = header[key]["data_offsets"]
+        total += stop - start
+    return total
+
+
+def _write_safetensors(path: str, entries: Sequence[Tuple[str, str, Sequence[int], bytes]]) -> int:
+    """Write ``(name, dtype, shape, payload)`` entries; an empty payload means zeros."""
+    header: Dict[str, dict] = {}
+    layout: List[Tuple[str, int, bytes]] = []
+    offset = 0
+    for name, dtype, shape, payload in entries:
+        count = 1
+        for dim in shape:
+            count *= int(dim)
+        nbytes = count * _DTYPE_BYTES[dtype]
+        if payload and len(payload) != nbytes:
+            raise ValueError(f"{name}: {len(payload)} bytes for a {dtype} tensor of {nbytes}")
+        header[name] = {"dtype": dtype, "shape": [int(dim) for dim in shape], "data_offsets": [offset, offset + nbytes]}
+        layout.append((name, nbytes, payload))
+        offset += nbytes
+    raw = json.dumps(header, separators=(",", ":")).encode("utf-8")
+    raw += b" " * ((-len(raw)) % _HEADER_ALIGN)
+    zeros = b"\0" * _ZERO_CHUNK
+    with open(path, "wb") as handle:
+        handle.write(struct.pack("<Q", len(raw)))
+        handle.write(raw)
+        for _, nbytes, payload in layout:
+            if payload:
+                handle.write(payload)
+                continue
+            remaining = nbytes
+            while remaining > 0:
+                chunk = min(remaining, len(zeros))
+                handle.write(zeros[:chunk])
+                remaining -= chunk
+    return offset
+
+
+def build(source: str, target: str, new_base: int, force: bool) -> None:
+    _setup_npu()
+    config_path = os.path.join(source, "config.json")
+    index_path = os.path.join(source, "model.safetensors.index.json")
+    for path in (config_path, index_path):
+        if not os.path.isfile(path):
+            raise FileNotFoundError(f"{path} is not there: is {source} an HF checkpoint directory?")
+    if os.path.isdir(target) and os.listdir(target) and not force:
+        raise FileExistsError(f"{target} is not empty; pass --force to write into it anyway")
+
+    config = _load_json(config_path)
+    text_config = config["text_config"]
+    ngram_heads = (int(text_config["ngram_size"]) - 1) * int(text_config["heads_per_ngram"])
+    head_dim = int(text_config["ple_embed_dim"]) // ngram_heads
+    divider = int(text_config["make_ngram_vocab_size_divisible_by"])
+    split_parts = int(text_config["split_ngram_parts"])
+    old_base = int(text_config["ngram_vocab_size_base"])
+
+    index = _load_json(index_path)
+    weight_map: Dict[str, str] = dict(index["weight_map"])
+    shard_keys = _shard_keys(weight_map)
+    if len(shard_keys) != split_parts:
+        raise ValueError(
+            f"{source} declares split_ngram_parts={split_parts} but its index names {len(shard_keys)} shards"
+        )
+    prefix = _SHARD_KEY_RE.match(shard_keys[0]).group("prefix")
+    sizes_key, offsets_key = _buffer_keys(weight_map, prefix)
+
+    # Both geometries through the plugin's own arithmetic. The old base has to
+    # reproduce the shapes the checkpoint actually stores -- otherwise this is not the
+    # checkpoint its config says it is, and a load would fail on the shapes anyway.
+    _, old_padded, old_rows = _geometry(old_base, ngram_heads, divider, split_parts)
+    new_sizes, new_padded, new_rows = _geometry(new_base, ngram_heads, divider, split_parts)
+    header, _ = _ple()._read_safetensors_header(os.path.join(source, weight_map[shard_keys[0]]))
+    stored = tuple(header[shard_keys[0]]["shape"])
+    if stored != (old_rows, head_dim):
+        raise ValueError(
+            f"{source} stores its shards as {stored} while ngram_vocab_size_base={old_base} implies "
+            f"{(old_rows, head_dim)}: this is not the checkpoint its config says it is"
+        )
+    replaced_bytes = _on_disk_bytes(weight_map, source, [*shard_keys, sizes_key, offsets_key])
+
+    print(f"[variant] source      {source}")
+    print(f"[variant] base        {old_base} -> {new_base}   ({ngram_heads} heads of {head_dim} dims)")
+    print(f"[variant] table       {old_padded} -> {new_padded} rows ({split_parts} shards of {old_rows} -> {new_rows})")
+    print(
+        f"[variant] table bytes {old_padded * head_dim * 2 / 2**30:.2f} -> {new_padded * head_dim * 2 / 2**30:.2f} GiB"
+    )
+    print(f"[variant] head vocab  {new_sizes[0]}..{new_sizes[-1]}, sum {sum(new_sizes)}")
+
+    os.makedirs(target, exist_ok=True)
+    new_name = f"model-{0:05d}-of-{len(set(weight_map.values())) + 1:05d}.safetensors"
+    new_path = os.path.join(target, new_name)
+
+    offsets: List[int] = []
+    running = 0
+    for size in new_sizes:
+        offsets.append(running)
+        running += size
+    entries: List[Tuple[str, str, Sequence[int], bytes]] = [
+        (shard_keys[shard], "BF16", (new_rows, head_dim), b"") for shard in range(split_parts)
+    ]
+    entries.append((sizes_key, "I64", (len(new_sizes),), torch.tensor(new_sizes, dtype=torch.int64).numpy().tobytes()))
+    entries.append((offsets_key, "I64", (len(offsets),), torch.tensor(offsets, dtype=torch.int64).numpy().tobytes()))
+    print(f"[variant] writing     {new_path}")
+    written = _write_safetensors(new_path, entries)
+
+    for key in shard_keys:
+        weight_map[key] = new_name
+    weight_map[sizes_key] = new_name
+    weight_map[offsets_key] = new_name
+    index["weight_map"] = weight_map
+    if "metadata" in index and "total_size" in index["metadata"]:
+        index["metadata"]["total_size"] = int(index["metadata"]["total_size"]) - replaced_bytes + written
+    _dump_json(os.path.join(target, "model.safetensors.index.json"), index)
+
+    text_config["ngram_vocab_size_base"] = new_base
+    _dump_json(os.path.join(target, "config.json"), config)
+
+    linked = 0
+    for name in sorted(os.listdir(source)):
+        if name in ("config.json", "model.safetensors.index.json"):
+            continue
+        link = os.path.join(target, name)
+        if os.path.lexists(link):
+            os.remove(link)
+        os.symlink(os.path.join(os.path.abspath(source), name), link)
+        linked += 1
+    print(f"[variant] linked      {linked} files of the source")
+
+    verify(target, new_rows, head_dim, split_parts, new_sizes, offsets)
+
+
+def verify(
+    target: str, rows_per_shard: int, head_dim: int, split_parts: int, sizes: Sequence[int], offsets: Sequence[int]
+) -> None:
+    """Read the variant back the way the plugin will: discovery, shapes, contents."""
+    from safetensors import safe_open  # pylint: disable=import-outside-toplevel
+
+    # 1. the plugin's own locator, on the finished directory: it has to resolve the
+    #    *new* shards even though the old ones are still in the symlinked headers.
+    located = _ple()._locate_shards(target, split_parts)
+    shapes = {tuple(entry[3]) for entry in located.values()}
+    if shapes != {(rows_per_shard, head_dim)}:
+        raise AssertionError(f"the locator resolved the table as {shapes}, not {(rows_per_shard, head_dim)}")
+    files = sorted({entry[0] for entry in located.values()})
+    if len(files) != 1:
+        raise AssertionError(f"the locator spread the table over {len(files)} files: {files}")
+    print(
+        f"[verify] locator      {split_parts} shards of {rows_per_shard}x{head_dim} out of {os.path.basename(files[0])}"
+    )
+
+    # 2. the file itself, through the reference reader: every name it holds, its
+    #    shape and dtype, that the shards are zeros, and that the two index buffers
+    #    are the ones the geometry implies.
+    weight_map = _load_json(os.path.join(target, "model.safetensors.index.json"))["weight_map"]
+    shard_keys = _shard_keys(weight_map)
+    new_name = weight_map[shard_keys[0]]
+    expected = {key for key, path in weight_map.items() if path == new_name}
+    with safe_open(os.path.join(target, new_name), framework="pt") as handle:
+        if set(handle.keys()) != expected:
+            raise AssertionError(
+                f"{new_name} holds {len(handle.keys())} tensors while the index sends it {len(expected)}"
+            )
+        shard = handle.get_tensor(shard_keys[0])
+        if tuple(shard.shape) != (rows_per_shard, head_dim) or shard.dtype != torch.bfloat16:
+            raise AssertionError(f"a shard reads back as {tuple(shard.shape)} {shard.dtype}")
+        if int(shard.count_nonzero()) != 0:
+            raise AssertionError("the shards are supposed to start at zero")
+        stored_sizes = handle.get_tensor(next(key for key in expected if key.endswith(_VOCAB_SIZES_SUFFIX))).tolist()
+        stored_offsets = handle.get_tensor(next(key for key in expected if key.endswith(_OFFSETS_SUFFIX))).tolist()
+    if stored_sizes != list(sizes) or stored_offsets != list(offsets):
+        raise AssertionError("the index buffers read back as something other than the geometry they were built for")
+    print(f"[verify] contents     {len(expected)} tensors, shards zero, index buffers match the config's geometry")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--source", required=True, help="the checkpoint to derive from (left untouched)")
+    parser.add_argument("--target", required=True, help="the variant directory to write")
+    parser.add_argument(
+        "--ngram-vocab-size-base",
+        type=int,
+        default=1_000_000,
+        help="the new `ngram_vocab_size_base` (default: %(default)s; the release ships 20000000)",
+    )
+    parser.add_argument("--force", action="store_true", help="write into a target directory that is not empty")
+    args = parser.parse_args()
+    build(args.source, args.target, args.ngram_vocab_size_base, args.force)
+    print("[variant] done")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
