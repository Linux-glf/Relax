+"""Multimodal model for Qwen3.8-Flash-Next (``qwen4_exp``).
+
+The checkpoint is one network: a vision tower that turns images into embeddings
+and the text tower of :mod:`~mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.model`
+that consumes them. The reference implementation replaces the ``<|image_pad|>``
+placeholders of ``inputs_embeds`` with the vision embeddings and then runs the
+text model on the result, which is exactly what happens here:
+
+* ``self.visual`` (built when the stage owns the embedding) computes the vision
+  embeddings of a packed batch of patches;
+* the text *token* embeddings are looked up without the sequence-parallel
+  scatter (the provider sets ``scatter_embedding_sequence_parallel=False`` for
+  this model), the vision embeddings are written into the placeholder rows, and
+  the merged tensor is scattered once, by hand. Every layer of the text tower
+  (GDN, QSA, MTP) is written against the scattered layout, so the split has to
+  happen after the merge -- and the merge needs the *whole* sequence, which is
+  why the embedding is not allowed to scatter on its own;
+* the positions are the multimodal ones of
+  :func:`~mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.positions.get_rope_index`,
+  computed per packed sample.
+
+Under context parallelism the batch arrives *undivided* -- one padded row per
+sample, with a matching ``attention_mask`` (Relax hands a VL model unsplit
+tokens and lets it split internally, the way the bridge's ``Qwen3VLModel``
+does). This model therefore flattens that batch back into one stream, does the
+merge and the positions on it, and only then keeps its slice
+(:mod:`~mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.cp_split`).
+
+Subclassing :class:`Qwen4ExpModel` rather than wrapping it keeps the Megatron
+parameter names of the text tower unchanged (``decoder.*``, ``mtp.*``), so the
+text bridge mappings apply to this model as they are and only the ``visual.*``
+tower needs mappings of its own.
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Optional
+
+import torch
+from torch import Tensor
+
+from megatron.core import tensor_parallel
+from megatron.core.transformer.spec_utils import ModuleSpec, build_module
+
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.cp_split import (
+    cp_local_index,
+    flat_ids,
+    padded_boundaries,
+    padded_sample_lengths,
+    split_for_cp,
+)
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.model import (
+    Qwen4ExpModel,
+    undivided_boundaries,
+)
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.positions import get_rope_index
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.vision import (
+    get_qwen4_exp_vision_spec,
+)
+
+
+def _mcore_scatters_mtp_embedding() -> bool:
+    """Whether MCore's MTP layer scatters the decoder input itself.
+
+    Current MCore applies the sequence-parallel scatter in
+    ``MultiTokenPredictionLayer._get_embeddings`` *after* it compares
+    ``mtp_input_mask`` against the embedding rows. On such a tree this model must
+    not shadow ``self.embedding`` with a scattering wrapper: the mask compare
+    would then see a half-length decoder input while the mask is full-length.
+    Older trees have no such scatter, so the wrapper is still needed there.
+    """
+    try:
+        import inspect
+
+        from megatron.core.transformer.multi_token_prediction import MultiTokenPredictionLayer
+
+        return 'scatter_to_sequence_parallel_region' in inspect.getsource(
+            MultiTokenPredictionLayer._get_embeddings
+        )
+    except Exception:
+        return False
+
+
+class Qwen4ExpVLModel(Qwen4ExpModel):
+    """Qwen3.8-Flash-Next with its vision tower: the multimodal training model.
+
+    Args:
+        config: Text tower config (the provider).
+        transformer_layer_spec: Spec of one text decoder layer.
+        vocab_size: Padded vocabulary size.
+        max_sequence_length: Longest sequence the batch may hold.
+        vision_config: HF ``Qwen4ExpVisionConfig`` of the checkpoint. Required
+            when this stage builds the vision tower.
+        pre_process: Whether this stage owns the embedding (and the tower).
+        post_process: Whether this stage owns the output layer.
+        add_encoder: Build the vision tower. Only meaningful together with
+            ``pre_process``.
+        The remaining arguments are the ones of :class:`Qwen4ExpModel` and are
+        forwarded unchanged.
+    """
+
+    def __init__(
+        self,
+        config,
+        transformer_layer_spec: ModuleSpec,
+        vocab_size: int,
+        max_sequence_length: int,
+        vision_config=None,
+        pre_process: bool = True,
+        post_process: bool = True,
+        add_encoder: bool = True,
+        **kwargs,
+    ) -> None:
+        super().__init__(
+            config=config,
+            transformer_layer_spec=transformer_layer_spec,
+            vocab_size=vocab_size,
+            max_sequence_length=max_sequence_length,
+            pre_process=pre_process,
+            post_process=post_process,
+            **kwargs,
+        )
+
+        self.add_encoder = add_encoder
+        # Token ids and the merge size come from the HF config, exactly like the
+        # tokenizer that produced the batch: without them the placeholders could
+        # not be told apart from ordinary text.
+        self.image_token_id = getattr(config, 'image_token_id', 248056)
+        self.video_token_id = getattr(config, 'video_token_id', 248057)
+        self.spatial_merge_size = int(getattr(config, 'spatial_merge_size', 2))
+        assert self.spatial_merge_size > 0, 'spatial_merge_size must be positive.'
+
+        self.visual = None
+        if self.pre_process and add_encoder:
+            assert vision_config is not None, (
+                'the first stage of a Qwen4Exp VL model needs the vision config of the checkpoint.'
+            )
+            # The tower inherits this config's tensor-parallel size and dtype (see
+            # `get_qwen4_exp_vision_config`) and runs replicated across the data
+            # parallel groups, so every rank merges the same embeddings into its
+            # own copy of the sequence.
+            self.visual = build_module(
+                get_qwen4_exp_vision_spec(vision_config, megatron_config=config),
+                pg_collection=self.pg_collection,
+            )
+
+        self._install_mtp_embedding_scatter()
+
+    # ------------------------------------------------------------------
+    # Sequence-parallel embedding for the MTP head
+    # ------------------------------------------------------------------
+    def _install_mtp_embedding_scatter(self) -> None:
+        """Make the MTP head's embedding lookup hand back the scattered layout.
+
+        The MTP layers look their own (rolled) token embeddings up and project
+        them next to the backbone's hidden states, so they must see the same
+        sequence-parallel layout those states are in. The stock model gets that
+        for free -- its embedding scatters itself -- but this model needs the
+        unscattered sequence for the merge, so the scatter is missing here and
+        has to be added back for the MTP only.
+
+        The wrapper is installed in the instance ``__dict__``, which shadows the
+        attribute for every reader of ``self.embedding`` (``GPTModel._postprocess``
+        passes ``self.embedding`` to the MTP block) while leaving the module
+        registered in ``self._modules`` -- so the parameters, the state dict and
+        the checkpoint names are untouched.
+        """
+        if not (self.mtp_process and self.config.sequence_parallel):
+            return
+        embedding = self._modules.get('embedding')
+        if embedding is None:  # no embedding on this stage: the MTP cannot run either
+            return
+        if _mcore_scatters_mtp_embedding():
+            # The MTP layer scatters the decoder input itself, after the
+            # `mtp_input_mask` comparison. Leave `self.embedding` as the provider
+            # built it (`scatter_embedding_sequence_parallel=False`) so the mask and
+            # the decoder input stay full-length at that comparison.
+            return
+
+        def _sp_scatter_embedding(input_ids, position_ids):
+            out = embedding(input_ids=input_ids, position_ids=position_ids)
+            return tensor_parallel.scatter_to_sequence_parallel_region(out)
+
+        _sp_scatter_embedding.word_embeddings = embedding.word_embeddings
+        self.__dict__['embedding'] = _sp_scatter_embedding
+
+    @property
+    def _token_embedding(self):
+        """The word-embedding module behind the MTP shim (see above)."""
+        return self._modules['embedding']
+
+    # ------------------------------------------------------------------
+    # Multimodal inputs
+    # ------------------------------------------------------------------
+    # The parent's `*args` is dropped on purpose: the vision inputs of this model
+    # travel as keywords only (the processor and Relax both call it with
+    # `model(**forward_kwargs)`), and the guard below turns any other positional
+    # or keyword argument into an error instead of letting it through silently.
+    # pylint: disable=arguments-differ
+    def forward(
+        self,
+        input_ids: Tensor,
+        position_ids: Optional[Tensor] = None,
+        attention_mask: Optional[Tensor] = None,
+        decoder_input: Optional[Tensor] = None,
+        labels: Optional[Tensor] = None,
+        inference_context=None,
+        packed_seq_params=None,
+        extra_block_kwargs: Optional[dict] = None,
+        runtime_gather_output: Optional[bool] = None,
+        *,
+        inference_params=None,
+        loss_mask: Optional[Tensor] = None,
+        padding_mask: Optional[Tensor] = None,
+        mtp_kwargs: Optional[dict] = None,
+        pixel_values: Optional[Tensor] = None,
+        pixel_values_videos: Optional[Tensor] = None,
+        image_grid_thw: Optional[Tensor] = None,
+        video_grid_thw: Optional[Tensor] = None,
+        mm_token_type_ids: Optional[Tensor] = None,
+        **kwargs,
+    ):
+        """Merge the vision embeddings into the sequence and run the text tower.
+
+        ``mm_token_type_ids`` is accepted and ignored: the processor marks the
+        placeholder tokens with it, which ``input_ids`` already say (see
+        :mod:`.positions`), and it is dropped before it reaches the model.
+        """
+        del mm_token_type_ids
+        assert not kwargs, (
+            f'unexpected keyword arguments {sorted(kwargs)}: the vision inputs of this model are '
+            'pixel_values / pixel_values_videos (+ their grids), as the processor emits them.'
+        )
+
+        # A context-parallel batch arrives undivided, one padded row per sample;
+        # the merge, the positions and the loss bookkeeping are all defined on
+        # the whole sequence, so flatten it back into one stream first and keep
+        # this rank's slice only at the end of this method.
+        cp_lengths = padded_sample_lengths(packed_seq_params)
+        if cp_lengths is not None:
+            input_ids = flat_ids(input_ids, cp_lengths)
+
+        if decoder_input is None and self.pre_process:
+            decoder_input = self._combined_embeddings(
+                input_ids, pixel_values, pixel_values_videos, image_grid_thw, video_grid_thw
+            )
+        if position_ids is None:
+            position_ids = self._multimodal_position_ids(
+                input_ids,
+                image_grid_thw,
+                video_grid_thw,
+                packed_seq_params,
+                boundaries=padded_boundaries(cp_lengths) if cp_lengths is not None else None,
+            )
+
+        if cp_lengths is not None:
+            input_ids, position_ids, decoder_input = self._split_for_cp(
+                input_ids, position_ids, decoder_input, cp_lengths, packed_seq_params
+            )
+            # The per-sample packed boundaries replace the mask: the tower is
+            # back on a thd batch, just one this rank holds a slice of.
+            attention_mask = None
+
+        if decoder_input is not None and self.config.sequence_parallel:
+            decoder_input = tensor_parallel.scatter_to_sequence_parallel_region(decoder_input).contiguous()
+
+        # `mtp_kwargs` is the dd31-era way of handing MTP labels down; this tree's
+        # `GPTModel.forward` has no such parameter and grew its own derivation
+        # instead (`process_mtp_loss` rolls `input_ids` when `labels is None`).
+        # Passing it unconditionally raised
+        # `TypeError: GPTModel.forward() got an unexpected keyword argument
+        # 'mtp_kwargs'` on every step, MTP or not, because `mtp_kwargs or {}` is
+        # truthy-valued even when empty. Forward it only when there is something
+        # to forward, so the MTP-off path stays clean.
+        #
+        # `Qwen4ExpModel._prepare_mtp_loss_mask` -- one `super()` below -- is where
+        # the two label conventions are reconciled: it absorbs the argument before
+        # `GPTModel.forward` can see it, and puts the loss mask into the frame that
+        # `process_mtp_loss` reads.
+        #
+        # `mtp_input_mask` marks the tokens that may serve as MTP conditioning inputs.
+        # The image/video placeholder rows are not real tokens, so a depth whose
+        # rolled-in conditioning token is one of them is an easy/zero-CE position.
+        # The GPU stack neither builds nor passes this mask -- `process_mtp_loss`
+        # counts every position -- so it is off by default here to keep the two MTP
+        # losses comparable. Set QWEN4_EXP_MTP_INPUT_MASK=1 to re-enable it; the
+        # mask is built from the *local* `input_ids` (after the CP split) and stays
+        # in the input-id frame -- `process_mtp_loss` rolls it once per depth, unlike
+        # the predictor-frame loss mask.
+        text_kwargs = {}
+        if mtp_kwargs:
+            text_kwargs["mtp_kwargs"] = mtp_kwargs
+            if os.environ.get("QWEN4_EXP_MTP_INPUT_MASK", "0").strip().lower() not in (
+                "0",
+                "false",
+                "no",
+                "off",
+            ):
+                text_kwargs["mtp_input_mask"] = (input_ids != self.image_token_id) & (
+                    input_ids != self.video_token_id
+                )
+
+        return super().forward(
+            input_ids=input_ids,
+            position_ids=position_ids,
+            attention_mask=attention_mask,
+            decoder_input=decoder_input,
+            labels=labels,
+            inference_context=inference_context,
+            packed_seq_params=packed_seq_params,
+            extra_block_kwargs=extra_block_kwargs,
+            runtime_gather_output=runtime_gather_output,
+            inference_params=inference_params,
+            loss_mask=loss_mask,
+            padding_mask=padding_mask,
+            **text_kwargs,
+        )
+
+    def _split_for_cp(
+        self,
+        input_ids: Tensor,
+        position_ids: Optional[Tensor],
+        decoder_input: Optional[Tensor],
+        padded_lengths,
+        packed_seq_params,
+    ):
+        """Keep this rank's slice of the undivided stream (see :mod:`.cp_split`).
+
+        The positions are per token and are split together with the tokens they
+        belong to -- which is what ``rotary_pos_emb.is_thd_format`` tells the
+        rope module (otherwise it would split the frequency table a second time,
+        as it does for a ``[b, s]`` batch). The packed parameters are *not*
+        rebuilt: their global ``cu_seqlens`` are what the CP attention and the
+        GDN expect, and what the loss side re-derives from the batch.
+        """
+        cp_group = getattr(packed_seq_params, 'cp_group', None) or self.pg_collection.cp
+        cp_size = getattr(packed_seq_params, 'local_cp_size', None) or cp_group.size()
+        cp_rank = torch.distributed.get_rank(group=cp_group)
+        # Per-token positions that are already this rank's: the rope module must
+        # not split the frequency table a second time (it does that for the
+        # `[b, s]` layout, where the positions are still global).
+        self.rotary_pos_emb.is_thd_format = True
+        index = cp_local_index(padded_lengths, cp_size, cp_rank, input_ids.device)
+        # The PLE branch hashes token ids, so it gets this rank's slice of them
+        # (it gathers the whole sequence back on its own) in the layout the
+        # activations end up in.
+        self._attach_ple_input_ids(input_ids, packed_seq_params, index=index)
+        if decoder_input is not None:
+            decoder_input = split_for_cp(decoder_input, index, dim=0)
+        return (
+            split_for_cp(input_ids, index, dim=1),
+            split_for_cp(position_ids, index, dim=-1) if position_ids is not None else None,
+            decoder_input,
+        )
+
+    def _combined_embeddings(
+        self,
+        input_ids: Tensor,
+        pixel_values: Optional[Tensor],
+        pixel_values_videos: Optional[Tensor],
+        image_grid_thw: Optional[Tensor],
+        video_grid_thw: Optional[Tensor],
+    ) -> Tensor:
+        """Token embeddings of the packed sequence with the vision rows replaced.
+
+        Args:
+            input_ids: ``[1, T]`` packed (thd) or ``[b, s]``.
+            pixel_values: ``[total_patches, patch_dim]`` of every image of the batch,
+                in sequence order (what the processor emits).
+            pixel_values_videos: The same for videos.
+            image_grid_thw: ``[num_images, 3]``, ``video_grid_thw``: ``[num_videos, 3]``.
+
+        Returns:
+            ``[T, 1, H]`` (thd) or ``[s, b, H]``, still in the undivided layout:
+            the caller keeps its context-parallel slice and *then* scatters.
+        """
+        embeddings = self._token_embedding(input_ids=input_ids, position_ids=None)
+        flat_input_ids = input_ids.reshape(-1)
+        # The lookup hands back a transposed *view* of the custom autograd
+        # Function inside ``VocabParallelEmbedding``, and the scatter below writes
+        # into it in place -- which autograd forbids ("output 0 of
+        # TransposeBackward0 is a view and is being modified inplace"). Copy once,
+        # lazily: a text-only batch never pays for it. The reference clones at the
+        # same point (`Qwen3VLModel`: the embedding `.clone()` on the merge path).
+        copied = False
+
+        for token_id, values, grids, name in (
+            (self.image_token_id, pixel_values, image_grid_thw, 'image'),
+            (self.video_token_id, pixel_values_videos, video_grid_thw, 'video'),
+        ):
+            if values is None or values.numel() == 0:
+                continue
+            assert grids is not None and grids.numel() > 0 and grids.ndim == 2, (
+                f'{name} patches were passed without their [num_{name}s, 3] grid.'
+            )
+            assert self.visual is not None, (
+                f'the batch carries {name}s but this stage has no vision tower (pre_process=False).'
+            )
+            vision_embeds, _ = self.visual(hidden_states=values, grid_thw=grids)
+            if not copied:
+                embeddings = embeddings.clone()
+                copied = True
+            mask = flat_input_ids == token_id
+            count = int(mask.sum())
+            assert count == vision_embeds.shape[0], (
+                f'the batch holds {count} {name} placeholder tokens but the vision tower produced '
+                f'{vision_embeds.shape[0]} embeddings: the token ids and the grids disagree.'
+            )
+            embeddings[mask] = vision_embeds.to(embeddings.dtype).unsqueeze(1)
+
+        return embeddings
+
+    def _multimodal_position_ids(
+        self,
+        input_ids: Tensor,
+        image_grid_thw: Optional[Tensor],
+        video_grid_thw: Optional[Tensor],
+        packed_seq_params,
+        boundaries=None,
+    ) -> Tensor:
+        """Positions of a batch: multimodal when it carries images/videos, text otherwise.
+
+        ``boundaries`` are the per-sample boundaries of the packed stream when the
+        caller already read them off the batch (a CP run reads them once for the
+        whole layout); they are taken from ``packed_seq_params`` otherwise.
+        """
+        has_image = image_grid_thw is not None and image_grid_thw.numel() > 0
+        has_video = video_grid_thw is not None and video_grid_thw.numel() > 0
+        if not (has_image or has_video):
+            # A text-only batch is the common case (and the only one the text
+            # tower sees), so it keeps the cheap per-sample `arange`.
+            return self._text_position_ids(input_ids, packed_seq_params, boundaries)
+
+        cu_seqlens = None
+        if packed_seq_params is not None and packed_seq_params.qkv_format == 'thd':
+            cu_seqlens = boundaries if boundaries is not None else undivided_boundaries(packed_seq_params)
+            assert int(cu_seqlens[-1]) == input_ids.numel(), (
+                f'packed length {int(cu_seqlens[-1])} does not match the {input_ids.numel()} tokens '
+                'on this rank: multimodal positions are only defined for an undivided sequence.'
+            )
+        return get_rope_index(
+            self.spatial_merge_size,
+            input_ids,
+            self.image_token_id,
+            self.video_token_id,
+            image_grid_thw=image_grid_thw,
+            video_grid_thw=video_grid_thw,
+            cu_seqlens=cu_seqlens,
+        )
