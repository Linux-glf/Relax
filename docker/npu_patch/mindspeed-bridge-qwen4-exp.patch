+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""QSA sparse attention wrappers around the vendored tensor-core triton kernel.
+
+The kernel itself lives in ``kernels/qsa_block_sparse_attn.py``, adapted from
+miles PR #2777 (commit 0f5dff4). This file owns only the glue mcore needs:
+sbhd<->thd flattening, context parallelism, and the ``core_attention`` shim.
+
+WHY A KERNEL AT ALL (the decision this file encodes)
+    QSA needs a per-query key set, which as an attention mask is TE's
+    ``arbitrary`` type. TE refuses that under packing:
+    ``dot_product_attention.py:1347`` asserts ``"padding" in attn_mask_type``
+    whenever ``qkv_format == "thd"``, so a bool mask cannot express QSA there.
+    Context parallelism is blocked for a different reason -- block pooling needs
+    keys from other CP ranks, which the mask path never gathers.
+
+    So the layer picks by data shape, unless disabled via the ``QSA_SPARSE_KERNEL``
+    env var (then: full attention under thd/CP>1, bool mask otherwise):
+
+        thd (padding_free) or CP>1  ->  this kernel
+        sbhd and CP==1              ->  the indexer's bool mask on TE
+
+    The mask path is not a degraded fallback in that last case: both paths run
+    the same ``QSAIndexer.select`` block selection, so they are mathematically
+    equivalent there, and the mask path measures *faster* (8192: 8.4 s/it vs
+    25.9 s/it) because TE keeps the whole thing fused.
+
+    Two selection encodings reach this file through the ``attention_mask``
+    positional, and the dtype says which: ``int32`` rows are the packed block-start
+    carrier (``[T, k+1]``, see ``QSASelection``), ``int64`` rows are token indices.
+    The fused path consumes the carrier as-is; the triton and CP paths expand it to
+    tokens first (``indexer.expand_block_starts``).
+
+Ascend notes: the vendored kernel carries the NPU adaptation of
+``mcore-bridge.bc58ea9c.patch`` (int32 program ids in the forward kernel). The kernel is
+imported lazily so that importing this module -- and therefore ``qsa.qsa_sparse_supported``
+-- stays possible on a machine without triton; every entry point that needs it raises with
+the fix spelled out instead of degrading to dense attention.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+from collections import OrderedDict
+
+import torch
+
+from .cp_utils import normalize_cu_seqlens
+
+logger = logging.getLogger(__name__)
+
+QSA_SPARSE_KERNEL_ENV = 'QSA_SPARSE_KERNEL'
+# Which attention implementation runs the selection: 'auto' (native Ascend fused
+# ops when the shape fits -- see qsa_sparse_attention_thd_native) or 'triton'.
+QSA_SPARSE_IMPL_ENV = 'QSA_SPARSE_IMPL'
+
+try:  # noqa: SIM105 - import guard for the vendored kernel
+    import triton  # noqa: F401
+
+    HAVE_TRITON = True
+except Exception:  # pragma: no cover - triton absent
+    HAVE_TRITON = False
+
+# Resolved on first use; see _kernel_entry_point().
+_KERNEL_ENTRY_POINT = None
+
+
+def _kernel_entry_point():
+    """Lazily import the triton kernel entry point.
+
+    Deferred so that ``import qsa`` works without triton: the package must be importable
+    for ``qsa_sparse_supported()`` to report ``False`` and let the caller stay on the
+    dense path, which it cannot do if the import already exploded.
+    """
+    global _KERNEL_ENTRY_POINT
+    if _KERNEL_ENTRY_POINT is None:
+        from .kernels.qsa_block_sparse_attn import qsa_sparse_attention_from_indices
+
+        _KERNEL_ENTRY_POINT = qsa_sparse_attention_from_indices
+    return _KERNEL_ENTRY_POINT
+
+
+def _get_env_args(name: str, type_func, default_value):
+    """Read ``name`` from the environment, falling back to ``default_value``.
+
+    ``bool`` is parsed with ``strtobool`` semantics so ``QSA_SPARSE_KERNEL=0`` disables
+    the kernel and any other falsy spelling (``no``/``off``/``false``) works too.
+    """
+    raw = os.environ.get(name.upper())
+    if raw is None:
+        logger.debug('Setting %s: %s (override with the %s environment variable).', name, default_value, name.upper())
+        return default_value
+    if type_func is bool:
+        from transformers.utils import strtobool
+
+        value = bool(strtobool(raw))
+    else:
+        value = type_func(raw)
+    logger.debug('Using environment variable %s, setting %s: %s.', name.upper(), name, value)
+    return value
+
+
+def use_qsa_sparse_kernel() -> bool:
+    return _get_env_args(QSA_SPARSE_KERNEL_ENV, bool, True)
+
+
+def qsa_sparse_impl() -> str:
+    """``'auto'`` (native fused ops when the shape fits) or ``'triton'``."""
+    raw = os.environ.get(QSA_SPARSE_IMPL_ENV, 'auto').strip().lower()
+    if raw in ('', 'auto', 'native'):
+        return 'auto'
+    if raw in ('triton', 'triton-kernel'):
+        return 'triton'
+    logger.warning(
+        'Ignoring %s=%r (expected auto or triton); keeping the native fused ops.',
+        QSA_SPARSE_IMPL_ENV,
+        raw,
+    )
+    return 'auto'
+
+
+def qsa_sparse_supported(head_dim: int) -> bool:
+    """Whether the sparse kernel can run for this head dim.
+
+    Triton must be importable, ``head_dim`` must be a power of two (the kernel tiles
+    the head with ``tl.arange`` blocks), and the kernel must not be disabled via
+    ``QSA_SPARSE_KERNEL=0``.
+    """
+    if not use_qsa_sparse_kernel():
+        return False
+    if not HAVE_TRITON or head_dim <= 0 or (head_dim & (head_dim - 1)):
+        return False
+    # No CUDA-availability warning here: the kernel runs on the Ascend NPU backend too
+    # (triton-ascend), so a device test would only mislead. A device the kernel cannot
+    # compile for fails loudly at launch -- see qsa_sparse_attention_thd.
+    return True
+
+
+def _cp_query_global_positions(seq_len: int, cp_size: int, cp_rank: int, device) -> torch.Tensor:
+    """This CP rank's logical token positions under mcore zigzag sharding.
+
+    Matches ``split_cp_inputs`` / ``rope_utils.get_pos_emb_on_this_cp_rank``: the
+    sequence is viewed as ``2 * cp_size`` chunks and the rank owns the
+    ``cp_rank``-th front chunk plus its mirrored back chunk.
+    """
+    chunk = seq_len // (2 * cp_size)
+    front = torch.arange(cp_rank * chunk, (cp_rank + 1) * chunk, device=device, dtype=torch.int64)
+    back_chunk = 2 * cp_size - cp_rank - 1
+    back = torch.arange(back_chunk * chunk, (back_chunk + 1) * chunk, device=device, dtype=torch.int64)
+    return torch.cat((front, back), dim=0)
+
+
+def _cp_query_global_positions_thd(cu_seqlens: torch.Tensor, cp_size: int, cp_rank: int, device) -> torch.Tensor:
+    """Local packed-token positions per sample under zigzag thd CP sharding.
+
+    Each sample is padded to a multiple of ``2 * cp_size`` by the data pipeline;
+    the rank owns the ``cp_rank``-th front chunk and the mirrored back chunk of
+    every sample (the same partition ``split_cp_inputs`` applies per sample).
+    """
+    cu = cu_seqlens.to(device=device, dtype=torch.int64)
+    starts, ends = cu[:-1], cu[1:]
+    half = (ends - starts) // (2 * cp_size)  # per-sample chunk length
+    # front chunk cp_rank; back chunk (2*cp-1-cp_rank), whose start is
+    # ends - (cp_rank+1)*half since it is the (cp_rank+1)-th chunk from the end
+    seg_starts = torch.stack((starts + cp_rank * half, ends - (cp_rank + 1) * half), dim=1).reshape(-1)
+    seg_lens = torch.stack((half, half), dim=1).reshape(-1)
+    nz = seg_lens > 0
+    seg_starts, seg_lens = seg_starts[nz], seg_lens[nz]
+    seg_ids = torch.repeat_interleave(torch.arange(seg_lens.numel(), device=device), seg_lens)
+    offsets = torch.arange(int(seg_lens.sum().item()), device=device)
+    offsets = offsets - torch.repeat_interleave(torch.cumsum(seg_lens, 0) - seg_lens, seg_lens)
+    return seg_starts.index_select(0, seg_ids) + offsets
+
+
+def _cp_gathered_to_logical_order(seq_len: int, cp_size: int, device) -> torch.Tensor:
+    """Index restoring rank-major gathered chunks to logical order: applying
+    ``gathered[idx]`` yields the same layout as ``_undo_attention_load_balancing``
+    (the inverse of ``split_cp_inputs``).
+    """
+    chunk = seq_len // (2 * cp_size)
+    order = [2 * i for i in range(cp_size)] + [2 * cp_size - 2 * i - 1 for i in range(cp_size)]
+    return torch.cat([torch.arange(c * chunk, (c + 1) * chunk, device=device) for c in order])
+
+
+def qsa_sparse_attention_thd(q, k, v, indices, scale, block_size):
+    """``q`` [T, Hq, D], ``k``/``v`` [S, Hkv, D], ``indices`` [T, K] (-1 pad).
+
+    Token-space indices: works for packed (thd) inputs directly, and for any
+    pre-flattened token dimension.
+
+    ``block_size`` must be the indexer's ``compress_ratio``. The kernel tests
+    selection membership per block of that many consecutive tokens, so passing a
+    different value silently changes which keys are attended -- see the contract
+    note in kernels/qsa_block_sparse_attn.py.
+    """
+    if not HAVE_TRITON or q.device.type == 'cpu':
+        raise RuntimeError(
+            'QSA sparse attention requires triton and accelerator tensors '
+            f'(HAVE_TRITON={HAVE_TRITON}, device={q.device.type}). This path is only '
+            'selected for packing (thd) or CP>1, where no dense fallback is correct.'
+        )
+    if q.shape[-1] & (q.shape[-1] - 1):
+        raise RuntimeError(f'QSA sparse attention needs a power-of-two head dim, got {q.shape[-1]}.')
+    if q.shape[0] != k.shape[0]:
+        # The kernel takes its key bound from the query count (T, Hq, D = q.shape,
+        # then `offs_k < T`), so unequal lengths would silently drop every key past
+        # len(q). Callers must equalise first -- _forward_cp does this by scattering
+        # the local query shard into a full-length buffer.
+        raise ValueError(f'QSA sparse attention needs len(q) == len(k), got {q.shape[0]} vs {k.shape[0]}.')
+    return _kernel_entry_point()(q, k, v, indices.contiguous(), scale, block_size)
+
+
+def qsa_sparse_attention(q, k, v, indices, scale, block_size):
+    """QSA sparse attention over mcore layouts.
+
+    sbhd: ``q`` [s, b, Hq, D], ``k``/``v`` [s, b, Hkv, D], ``indices``
+        [b, s, K] in per-sample sequence space.
+    thd:  ``q`` [T, Hq, D], ``k``/``v`` [T, Hkv, D], ``indices`` [T, K] in
+        pack space (document boundaries already clamped torch-side).
+
+    Raises rather than returning ``None``: the caller only reaches here for
+    packing or CP>1, and for those a dense fallback would silently diverge from
+    sparse inference.
+    """
+    if q.dim() == 3:
+        return qsa_sparse_attention_thd(q, k, v, indices, scale, block_size)
+    if q.dim() != 4:
+        raise ValueError(f'qsa_sparse_attention expected 3D (thd) or 4D (sbhd) q, got {tuple(q.shape)}')
+    s, b, hq, d = q.shape
+    sk = k.shape[0]
+    # Flatten to token space, batch-major: token t = r * sk + p. The per-sample
+    # sequence-space indices are offset by the batch start; -1 padding stays -1.
+    # The offset is a whole multiple of sk, so block alignment survives it only
+    # when sk % block_size == 0; guard rather than corrupt the selection.
+    if sk % block_size:
+        raise ValueError(
+            f'sbhd QSA needs the kv sequence length ({sk}) to be a multiple of '
+            f'block_size ({block_size}); otherwise flattening to token space shifts '
+            'each sample off the block grid the kernel indexes by.'
+        )
+    q_f = q.permute(1, 0, 2, 3).reshape(b * s, hq, d)
+    k_f = k.permute(1, 0, 2, 3).reshape(b * sk, *k.shape[2:])
+    v_f = v.permute(1, 0, 2, 3).reshape(b * sk, *v.shape[2:])
+    off = torch.arange(b, device=q.device).view(b, 1, 1) * sk
+    idx_f = torch.where(indices >= 0, indices + off, indices.new_full((), -1)).reshape(b * s, -1)
+    out_f = qsa_sparse_attention_thd(q_f, k_f, v_f, idx_f, scale, block_size)
+    return out_f.view(b, s, hq, d).permute(1, 0, 2, 3)
+
+
+# ---- native Ascend fused path ------------------------------------------------
+# attention_mode=2 is the only sparse mode that tiles at the model's head size,
+# and it wants a single kv head against a 512-wide ``[k; v]`` latent.  Every
+# supported rank layout has exactly one kv head: with ``num_query_groups=2``,
+# tensor parallel >= 2 makes MCore hand each rank one query group.  TP=1 would
+# leave two kv heads on the rank, so it stays on the triton kernel.
+_NATIVE_LATENT_DIM = 512
+_NATIVE_ROPE_DIM = 64
+_NATIVE_MASK_DIM = 2048
+# Upper bound on the left-up causal window: the fused dense kernel clips keys
+# past it, so it must cover the longest document a pack can hold.
+_NATIVE_PRE_TOKENS = 65536
+# Largest ``gSize`` -- query heads in one sparse call -- the operator accepts.
+_NATIVE_MAX_GROUP = 128
+_NATIVE_MASK_CACHE = {}
+_NATIVE_FALLBACK_LOGGED = False
+
+
+def _warn_native_fallback(reason: str) -> None:
+    """Log once when ``auto`` cannot reach the fused ops, so a silent slowdown is visible."""
+    global _NATIVE_FALLBACK_LOGGED
+    if not _NATIVE_FALLBACK_LOGGED:
+        _NATIVE_FALLBACK_LOGGED = True
+        logger.warning('QSA fused attention not used (%s); running the triton kernel instead.', reason)
+
+
+def _native_group_size(hq: int) -> int:
+    """``gSize`` for the one sparse call: the next power of two at or above ``hq``.
+
+    ``gSize`` is restricted to powers of two, and carrying dead heads is cheaper
+    than splitting the block: a call costs ~``n * len(k)`` regardless of how many
+    heads it carries (measured: 4, 8 and 16 heads differ by <2%), because it is
+    bandwidth-bound on the selected key set. The per-rank query block is
+    24 / TP heads (12 at TP=2, 6 at TP=4, 3 at TP=8), so only the last one is padded.
+    """
+    if hq > _NATIVE_MAX_GROUP:
+        raise ValueError(f'QSA fused attention takes at most {_NATIVE_MAX_GROUP} query heads per call, got {hq}.')
+    return 1 << (hq - 1).bit_length()
+
+
+def _qsa_causal_mask(device):
+    """Compressed causal tile mask for ``npu_fusion_attention``.
+
+    The fused dense op ignores ``sparse_mode`` entirely when ``atten_mask`` is
+    None -- every mode then runs full attention -- so this mask is what selects
+    the causal variant. With ``sparse_mode=2`` (leftUpCausal) it aligns
+    top-left: query row i of a document attends keys 0..i.
+    """
+    key = str(device)
+    mask = _NATIVE_MASK_CACHE.get(key)
+    if mask is None:
+        mask = torch.triu(torch.ones(_NATIVE_MASK_DIM, _NATIVE_MASK_DIM, dtype=torch.bool, device=device), diagonal=1)
+        _NATIVE_MASK_CACHE[key] = mask
+    return mask
+
+
+def qsa_native_supported(q, k, v, block_start, compress_ratio, cu_seqlens=None) -> bool:
+    """Whether :func:`qsa_sparse_attention_thd_native` applies to these tensors.
+
+    ``block_start`` is the int32 ``[T, k+1]`` carrier; token-index rows (int64) are
+    the *other* encoding and go to the triton kernel. ``cu_seqlens`` must span
+    exactly the query rows -- the fused ops resolve the selection inside each
+    document, so a boundary list describing a different (e.g. sequence-parallel
+    gathered) token range than ``q`` would silently mis-assign documents; that
+    invariant is checked by :func:`qsa_sparse_attention_thd_native` itself.
+    """
+    if q.dim() != 3 or q.device.type != 'npu' or cu_seqlens is None:
+        return False
+    if q.dtype not in (torch.bfloat16, torch.float16):
+        return False
+    head_dim = q.shape[-1]
+    if head_dim <= 0 or head_dim > _NATIVE_LATENT_DIM // 2:
+        return False
+    if k.shape[1] != 1:
+        # attention_mode=2 takes exactly one kv head per call.  A rank holding
+        # two is the TP=1 layout, which the triton kernel still handles.
+        return False
+    if block_start.dim() != 2 or block_start.shape[0] != q.shape[0] or block_start.shape[1] < 2:
+        return False
+    if block_start.dtype != torch.int32:
+        return False
+    budget = (block_start.shape[1] - 1) * int(compress_ratio)
+    return int(compress_ratio) >= 1 and 1 <= budget <= _NATIVE_MASK_DIM
+
+
+class _NativeLayout:
+    """Per-(boundaries, R, budget, heads, dtype) tables for the fused path.
+
+    Everything the two fused calls need beyond the selection itself depends only on
+    the packed boundaries and the budget: which rows are causal prefixes, the
+    per-document query/key length lists, the zero RoPE inputs. Rebuilding them was
+    the whole host cost of the path -- three ``.tolist()`` round-trips plus a
+    ``nonzero`` per layer -- so they are built once per step and shared by every
+    QSA layer, like the indexer's ``_PackedLayout``.
+
+    The suffix rows are bucketed by residue (``(pos + 1) % R``) here rather than in
+    the attention call: the split is a property of the boundaries, and it costs
+    ``R`` masked scans a step instead of ``R`` per layer.
+    """
+
+    __slots__ = (
+        'doc_start32',
+        'pre_rows',
+        'all_prefix',
+        'pre_q_lens',
+        'kv_lens',
+        'kv_lens_t',
+        'residue_rows',
+        'residue_q_lens',
+        'residue_rope',
+        'group',
+        'zero_k_rope',
+    )
+
+
+_NATIVE_LAYOUT_CACHE: 'OrderedDict[tuple, tuple]' = OrderedDict()
+_NATIVE_LAYOUT_CACHE_SIZE = 4
+
+
+def _native_layout(cu_seqlens, R, budget, hq, dtype) -> _NativeLayout:
+    """Tables for :func:`qsa_sparse_attention_thd_native`, built once per step.
+
+    Keyed like the indexer's ``_packed_layout`` (``id`` plus the version counter, so
+    an in-place edit of the boundaries misses), and the entry holds ``cu_seqlens``
+    itself so a recycled ``id()`` cannot hit a stale entry.
+    """
+    try:
+        version = cu_seqlens._version
+    except RuntimeError:
+        # Inference tensors carry no version counter -- and are immutable outside
+        # InferenceMode, so the id alone identifies them.
+        version = None
+    key = (id(cu_seqlens), version, R, budget, hq, dtype)
+    entry = _NATIVE_LAYOUT_CACHE.get(key)
+    if entry is not None:
+        _NATIVE_LAYOUT_CACHE.move_to_end(key)
+        return entry[1]
+    layout = _build_native_layout(cu_seqlens, R, budget, hq, dtype)
+    _NATIVE_LAYOUT_CACHE[key] = (cu_seqlens, layout)
+    while len(_NATIVE_LAYOUT_CACHE) > _NATIVE_LAYOUT_CACHE_SIZE:
+        _NATIVE_LAYOUT_CACHE.popitem(last=False)
+    return layout
+
+
+def _build_native_layout(cu_seqlens, R, budget, hq, dtype) -> _NativeLayout:
+    from .indexer import _packed_layout  # noqa: PLC0415 - deferred: the indexer pulls the model deps
+
+    device = cu_seqlens.device
+    packed = _packed_layout(cu_seqlens, R)
+    lay = _NativeLayout()
+    lay.doc_start32 = packed.doc_start32
+    lay.kv_lens_t = cu_seqlens[1:].to(torch.int32).contiguous()
+    lay.kv_lens = lay.kv_lens_t.tolist()
+    doc_lens = cu_seqlens[1:] - cu_seqlens[:-1]
+    # Prefix rows are a document's first min(len, budget) rows, so the query
+    # segments the dense call resolves against are the clamped document lengths.
+    lay.pre_q_lens = doc_lens.clamp(max=budget).cumsum(0).to(torch.int32).tolist()
+
+    is_prefix = packed.pos_in_doc < budget
+    lay.pre_rows = torch.nonzero(is_prefix, as_tuple=False).squeeze(1)
+    lay.all_prefix = lay.pre_rows.numel() == packed.token_pos.numel()
+    lay.group = _native_group_size(hq)
+    lay.zero_k_rope = torch.zeros(packed.token_pos.numel(), 1, _NATIVE_ROPE_DIM, dtype=dtype, device=device)
+    if lay.all_prefix:
+        lay.residue_rows = lay.residue_q_lens = lay.residue_rope = ()
+        return lay
+    # One bucket per residue: every row of a bucket lists the same number of
+    # tokens, which is what sparse_mode=0 needs (see the caller's docstring).
+    residue = (packed.pos_in_doc + 1) % R
+    rows_by_residue, lens_by_residue, rope_by_residue = [], [], []
+    for s in range(R):
+        rows = torch.nonzero(~is_prefix & (residue == s), as_tuple=False).squeeze(1)
+        # Query rows per document; a document with no row in this bucket keeps a
+        # zero-length segment, which the op accepts (verified fwd+bwd).
+        counts = torch.bincount(packed.token_doc.index_select(0, rows), minlength=packed.D)
+        rows_by_residue.append(rows)
+        lens_by_residue.append(counts.cumsum(0).to(torch.int32))
+        rope_by_residue.append(torch.zeros(rows.numel(), lay.group, _NATIVE_ROPE_DIM, dtype=dtype, device=device))
+    lay.residue_rows = tuple(rows_by_residue)
+    lay.residue_q_lens = tuple(lens_by_residue)
+    lay.residue_rope = tuple(rope_by_residue)
+    return lay
+
+
+def qsa_sparse_attention_thd_native(q, k, v, block_start, scale, cu_seqlens, compress_ratio):
+    """QSA selection on the Ascend fused kernels (forward + backward).
+
+    Same semantics as ``qsa_sparse_attention_thd`` -- each query attends exactly the
+    keys its selection row lists -- without the triton kernel. ``block_start`` is the
+    ``[T, k+1]`` int32 carrier (see ``QSASelection``) and ``cu_seqlens`` are the
+    pack-space document boundaries the indexer selected against.
+
+    Rows split on their in-document position ``pos`` (``budget = k * R``):
+
+    * ``pos < budget`` -- always the first ``budget`` rows of the document --
+      select their whole causal prefix 0..pos, so one dense
+      ``npu_fusion_attention`` call over the full pack reproduces them exactly;
+    * the rest go to ``npu_sparse_flash_attention`` as token indices, one call per
+      residue ``s = (pos + 1) % R``. A suffix row's selection is its ``k`` whole
+      blocks plus the ``s`` visible tokens of its own frontier block, and ``s`` is
+      the only thing that differs between suffix rows. ``sparse_mode=0`` attends
+      *every* index it is handed, so rows of different width cannot share a call:
+      a short row padded to a common width would silently attend token 0 again
+      (the case the clamp-and-fill repair in
+      ``glm_moe_dsa/dsa_kvallgather_context_parallel.py`` covers for GLM).
+      Bucketing by residue keeps every listed index genuinely attended, at the
+      price of ``R`` calls whose row counts sum to the suffix's.
+
+    One ``sparse_mode=3`` call over *block* indices would be cheaper measured in
+    isolation (196 vs 318 ms fwd+bwd at T=26k) and matches this path's gradients
+    to ``cos = 1.0000`` for a single layer, but it poisons a 16-die training run:
+    with it, the B24 run logs ``grad_norm`` 6411 / 4361 / 26886 / nan over steps
+    0-3 where the triton core in the same tree logs 53.6 / 52.8, at identical
+    losses. The operator's block-index backward is therefore not usable here,
+    however exact its forward; keep the per-residue form until a CANN fix
+    reproduces those two runs' gradient norms.
+
+    Block starts are converted from pack space to the document-relative encoding
+    the fused op resolves inside each document (verified for ``q_len != kv_len``).
+    """
+    import torch_npu  # noqa: PLC0415 - NPU-only entry point
+
+    T, hq, head_dim = q.shape
+    if k.shape[1] != 1:
+        raise ValueError(
+            f'QSA fused attention expects one kv head per rank, got {k.shape[1]}; '
+            'run with tensor parallel >= num_query_groups (TP > 1 for this model).'
+        )
+    R = int(compress_ratio)
+    if block_start.dim() != 2 or block_start.shape[0] != T or block_start.shape[1] < 2:
+        raise ValueError(
+            'QSA fused attention expects one [T, k+1] block-start row per query token, '
+            f'got {tuple(block_start.shape)} for T={T}.'
+        )
+    if block_start.dtype != torch.int32:
+        block_start = block_start.to(torch.int32)
+    budget = (block_start.shape[1] - 1) * R
+    if not 1 <= budget <= _NATIVE_MASK_DIM:
+        raise ValueError(
+            f'QSA fused attention supports a selection budget of 1..{_NATIVE_MASK_DIM} tokens, got {budget}.'
+        )
+    cu = normalize_cu_seqlens(cu_seqlens, T)
+    lay = _native_layout(cu, R, budget, hq, q.dtype)
+
+    # ---- rows whose selection is exactly their causal prefix -> dense causal ----
+    pre_out = torch_npu.npu_fusion_attention(
+        q if lay.all_prefix else q.index_select(0, lay.pre_rows),
+        k,
+        v,
+        hq,
+        input_layout='TND',
+        scale=scale,
+        keep_prob=1.0,
+        atten_mask=_qsa_causal_mask(q.device),
+        pre_tockens=_NATIVE_PRE_TOKENS,
+        next_tockens=0,
+        actual_seq_qlen=lay.pre_q_lens,
+        actual_seq_kvlen=lay.kv_lens,
+        sparse_mode=2,
+    )[0]
+    if lay.all_prefix:
+        # every document fits the budget: the selection is plain causal attention
+        return pre_out
+
+    out = q.new_empty(T, hq, head_dim)
+    # Every row is written exactly once below (the prefix rows, then the residue
+    # buckets, which partition the rest), so the buffer needs no zero-fill: at
+    # T=29k this is a [T, hq, head_dim] ~0.36 GB tensor per layer call.
+    out.index_put_((lay.pre_rows,), pre_out)
+
+    # ---- rows whose selection is the fixed-width top-k -> sparse, per residue --
+    # [k; v] latent, one kv head per call (attention_mode=2).  The guard above
+    # leaves exactly one kv head on this rank.  One cat, no zero-fill: the fused
+    # op reads the first half as k and the second as v, which is the concatenation
+    # itself; the pad only fires for head_dim < 256.
+    lat = torch.cat((k, v), dim=-1)
+    if lat.shape[-1] != _NATIVE_LATENT_DIM:
+        lat = torch.nn.functional.pad(lat, (0, _NATIVE_LATENT_DIM - lat.shape[-1]))
+    arange_r = torch.arange(R, dtype=torch.int32, device=q.device)
+    for s, rows in enumerate(lay.residue_rows):
+        if rows.numel() == 0:
+            continue
+        starts = block_start.index_select(0, rows)  # [n, k+1] pack-space block starts
+        # The row's selection as token indices: the whole selected blocks, then the
+        # s tokens of the frontier block this row can see (its first `s` -- they are
+        # the offsets 0..s-1, which end at the query itself).  The carrier's last
+        # column is the frontier block (see `_block_start_carrier`).
+        blocks = starts[:, :-1].unsqueeze(-1) + arange_r  # [n, k, R]
+        frontier = starts[:, -1:] + arange_r[:s]  # [n, s], empty at s == 0
+        rel = torch.cat([blocks.flatten(1), frontier], dim=1)  # [n, budget + s]
+        # Pack space -> document space; every entry above is a visible token, so
+        # none of them is the carrier's -1 sentinel.
+        rel -= lay.doc_start32.index_select(0, rows).unsqueeze(1)
+        # gSize is restricted to a power of two; the padded heads are independent
+        # of the real ones and their output is dropped.
+        q_pad = q.new_zeros(rows.numel(), lay.group, _NATIVE_LATENT_DIM)
+        q_pad[:, :hq, :head_dim] = q.index_select(0, rows)
+        res = torch_npu.npu_sparse_flash_attention(
+            q_pad,
+            lat,
+            lat,
+            sparse_indices=rel.unsqueeze(1),
+            block_table=None,
+            actual_seq_lengths_query=lay.residue_q_lens[s],
+            actual_seq_lengths_kv=lay.kv_lens_t,
+            query_rope=lay.residue_rope[s],
+            key_rope=lay.zero_k_rope,
+            scale_value=scale,
+            sparse_block_size=1,
+            layout_query='TND',
+            layout_kv='TND',
+            sparse_mode=0,
+            attention_mode=2,
+            return_softmax_lse=True,
+        )[0]
+        out.index_put_((rows,), res[:, :hq, head_dim : 2 * head_dim])
+    return out
+
+
+class QSASparseCoreAttention(torch.nn.Module):
+    """Drop-in ``core_attention`` that runs QSA sparse attention on the NPU.
+
+    The selection rides in on the ``attention_mask`` argument -- the one positional
+    that mcore threads unchanged through both the plain and the activation-
+    checkpointed core-attention paths. Carrying it there (rather than on a module
+    attribute) means recompute under ``recompute_modules=['core_attn']`` sees the
+    same selection, and a stacked microbatch cannot overwrite it between forward
+    and its backward.
+
+    The dtype names the encoding (see ``QSASelection``): ``int32`` is the packed
+    block-start carrier ``[T, k+1]``, ``int64`` is token indices ``[T, K]``. The
+    fused path takes the carrier directly; the triton and CP paths expand it with
+    ``indexer.expand_block_starts``.
+
+    Any bool/None mask (or non-int tensor) falls through to the wrapped
+    core_attention, keeping the no-op / short-sequence path on TE's fused kernel.
+
+    Context parallelism (``cp_comm_type=all_gather``): q stays on the local CP
+    shard while k/v are gathered across the CP group and restored to logical
+    order; the full-sequence selection is sliced to this rank's query rows. The
+    gather's backward reduce-scatters dk/dv to the local shards.
+    """
+
+    def __init__(self, core_attention, config, softmax_scale=None):
+        super().__init__()
+        self.core_attention = core_attention
+        # None -> resolved to 1/sqrt(head_dim) at call time, matching TE.
+        self.softmax_scale = softmax_scale
+        self.config = config
+        # The kernel tests selection membership per block of compress_ratio
+        # consecutive tokens, so this must be the same value the indexer expanded
+        # its top-k blocks with -- see the contract in kernels/qsa_block_sparse_attn.py.
+        self.block_size = config.indexer_compress_ratio
+        if not self.block_size:
+            raise ValueError(
+                'QSASparseCoreAttention needs config.indexer_compress_ratio to size the '
+                f'kernel block grid, got {self.block_size!r}.'
+            )
+
+    def forward(
+        self,
+        query,
+        key,
+        value,
+        attention_mask,
+        attn_mask_type=None,
+        attention_bias=None,
+        packed_seq_params=None,
+        **kwargs,
+    ):
+        if attention_mask is not None and attention_mask.dtype in (torch.int32, torch.int64):
+            scale = self.softmax_scale if self.softmax_scale is not None else query.shape[-1] ** -0.5
+            cp_size = self.config.context_parallel_size
+            impl = qsa_sparse_impl()
+            if cp_size > 1:
+                # CP gathers k/v across ranks; the native split has no equivalent yet.
+                out = self._forward_cp(query, key, value, attention_mask, scale, packed_seq_params)
+            else:
+                # thd only: the sbhd+CP==1 shape never carries indices (see layer.py).
+                cu = getattr(packed_seq_params, 'cu_seqlens_q_padded', None)
+                if cu is None:
+                    cu = getattr(packed_seq_params, 'cu_seqlens_q', None)
+                if impl == 'auto' and qsa_native_supported(query, key, value, attention_mask, self.block_size, cu):
+                    out = qsa_sparse_attention_thd_native(query, key, value, attention_mask, scale, cu, self.block_size)
+                else:
+                    if impl == 'auto':
+                        _warn_native_fallback(
+                            f'query {tuple(query.shape)} on {query.device.type}, '
+                            f'cu_seqlens={None if cu is None else tuple(cu.shape)} '
+                            'does not fit the fused kernels'
+                        )
+                    indices = self._token_indices(attention_mask, cu)
+                    out = qsa_sparse_attention(query, key, value, indices, scale, self.block_size)
+            # mcore's sbhd core attention returns heads flattened ([s, b, h*d]);
+            # the kernel yields [s, b, h, d]. thd stays [t, h, d] -- mcore
+            # reshapes it itself right after (see attention.py thd branch).
+            if out.dim() == 4:
+                out = out.reshape(out.shape[0], out.shape[1], -1)
+            return out
+        return self.core_attention(
+            query,
+            key,
+            value,
+            attention_mask,
+            attn_mask_type=attn_mask_type,
+            attention_bias=attention_bias,
+            packed_seq_params=packed_seq_params,
+            **kwargs,
+        )
+
+    def _token_indices(self, selection, cu_seqlens):
+        """Selection -> token indices for the triton kernel.
+
+        ``int32`` rows are the packed block-start carrier and need the per-token
+        in-document position of the boundaries they were selected against; ``int64``
+        rows are already token indices (the sbhd selection) and pass through.
+        """
+        if selection.dtype != torch.int32:
+            return selection
+        if cu_seqlens is None:
+            raise RuntimeError('QSA block-start carrier needs cu_seqlens to expand into token indices.')
+        from .indexer import expand_block_starts  # noqa: PLC0415 - deferred: the indexer pulls the model deps
+
+        return expand_block_starts(selection, normalize_cu_seqlens(cu_seqlens, selection.shape[0]), self.block_size)
+
+    def _forward_cp(self, query, key, value, indices, scale, packed_seq_params):
+        from megatron.core import mpu
+        from megatron.core.tensor_parallel.mappings import gather_from_sequence_parallel_region
+
+        cp_size = mpu.get_context_parallel_world_size()
+        cp_rank = mpu.get_context_parallel_rank()
+        device = query.device
+        thd = query.dim() == 3
+        if thd:
+            # the gathered k/v live in the padded pack space, so the query
+            # positions must come from the padded cu as well
+            cu_q = (
+                packed_seq_params.cu_seqlens_q_padded
+                if packed_seq_params.cu_seqlens_q_padded is not None
+                else packed_seq_params.cu_seqlens_q
+            )
+            # the selection was made over the full pack, so the boundaries that
+            # describe its rows are the gathered (full-length) ones
+            cu_q = normalize_cu_seqlens(cu_q, indices.shape[0])
+            q_pos = _cp_query_global_positions_thd(cu_q, cp_size, cp_rank, device)
+            # rank-major gathered positions -> permutation back to global packed
+            # order (same construction as mcore DSA's packed kv reorder)
+            gathered_pos = torch.cat([_cp_query_global_positions_thd(cu_q, cp_size, r, device) for r in range(cp_size)])
+            kv_reorder = torch.argsort(gathered_pos)
+        else:
+            sq, b = query.shape[0], query.shape[1]
+            q_pos = _cp_query_global_positions(sq * cp_size, cp_size, cp_rank, device)
+            kv_reorder = _cp_gathered_to_logical_order(sq * cp_size, cp_size, device)
+        # gather k/v across CP with a DIFFERENTIABLE all-gather (backward is a
+        # reduce-scatter, so dk/dv reach the local shards) and undo the zigzag
+        # shard into full logical order. A raw torch.distributed.all_gather is
+        # not differentiable -- reconstruct_tensor_cp is not usable here.
+        cp_group = mpu.get_context_parallel_group()
+        kv_reorder_t = kv_reorder
+
+        def _gather_full(t):
+            g = gather_from_sequence_parallel_region(t, tensor_parallel_output_grad=True, group=cp_group)
+            return g.index_select(0, kv_reorder_t)
+
+        key_full = _gather_full(key)
+        value_full = _gather_full(value)
+        # The kernel derives the key bound from the query count (T, Hq, D = q.shape,
+        # then `offs_k < T`), so it structurally requires len(q) == len(k). Under CP
+        # the queries are a 1/cp_size shard while k/v are now full length, so scatter
+        # the local queries back into a full-length buffer, run, and take our rows
+        # out again. The padding rows carry an all-`-1` selection, which the kernel
+        # skips, so they cost tile launches but produce nothing.
+        if thd:
+            local_idx = indices[q_pos]
+            if local_idx.dtype == torch.int32:
+                # block-start carrier: expand only this rank's rows (the position
+                # table still comes from the full pack)
+                from .indexer import expand_block_starts  # noqa: PLC0415 - deferred model dependency
+
+                local_idx = expand_block_starts(local_idx, cu_q, self.block_size, rows=q_pos)
+            out_full = qsa_sparse_attention(
+                *self._scatter_q_to_full(query, key_full, value_full, local_idx, q_pos), scale, self.block_size
+            )
+            return out_full.index_select(0, q_pos)
+        # sbhd: token-space kernel on the batch-major flattening (t = r*sk + p).
+        # `b`/`sq` come from the `else` branch above, which is the only way to
+        # reach this tail (the thd branch returns); pylint cannot see through the
+        # second `if thd:` and reports them as possibly unbound.
+        # pylint: disable=possibly-used-before-assignment
+        local_idx = indices[:, q_pos]
+        sk = key_full.shape[0]
+        k_f = key_full.permute(1, 0, 2, 3).reshape(b * sk, key_full.shape[2], key_full.shape[3])
+        v_f = value_full.permute(1, 0, 2, 3).reshape(b * sk, value_full.shape[2], value_full.shape[3])
+        off = torch.arange(b, device=device).view(b, 1, 1) * sk
+        idx_f = torch.where(local_idx >= 0, local_idx + off, local_idx.new_full((), -1)).reshape(sq * b, -1)
+        q_f = query.permute(1, 0, 2, 3).reshape(sq * b, query.shape[2], query.shape[3])
+        # batch-major token ids of this rank's rows: sample r contributes q_pos + r*sk
+        rows = (q_pos[None, :] + torch.arange(b, device=device).view(b, 1) * sk).reshape(-1)
+        out_f = qsa_sparse_attention(*self._scatter_q_to_full(q_f, k_f, v_f, idx_f, rows), scale, self.block_size)
+        out_f = out_f.index_select(0, rows)
+        return out_f.view(b, sq, query.shape[2], query.shape[3]).permute(1, 0, 2, 3)
+
+    @staticmethod
+    def _scatter_q_to_full(q, k, v, indices, rows):
+        """Place ``q``/``indices`` rows at ``rows`` inside a len(k)-row buffer.
+
+        index_copy keeps this differentiable: backward gathers the same rows, so the
+        padded positions contribute no gradient.
+        """
+        n = k.shape[0]
+        q_full = q.new_zeros((n, *q.shape[1:]))
+        q_full = q_full.index_copy(0, rows, q)
+        idx_full = indices.new_full((n, indices.shape[1]), -1)
+        idx_full = idx_full.index_copy(0, rows, indices)
+        return q_full, k, v, idx_full
