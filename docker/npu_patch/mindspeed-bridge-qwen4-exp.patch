+            f"{_MG_TEXT}mtp.layers.0.mtp_model_layer.mlp_hyper_connection.input_mix_weight_up.weight": "mtp.layers.0.mlp_hyper_connection.input_mix_weight_up.weight",
+            f"{_MG_TEXT}mtp.layers.0.mtp_model_layer.mlp_hyper_connection.block_inject_weight.weight": "mtp.layers.0.mlp_hyper_connection.block_inject_weight.weight",
+            f"{_MG_TEXT}mtp.layers.0.mtp_model_layer.self_attention.linear_proj.weight": "mtp.layers.0.self_attn.o_proj.weight",
+            f"{_MG_TEXT}mtp.layers.0.mtp_model_layer.self_attention.q_layernorm.weight": "mtp.layers.0.self_attn.q_norm.weight",
+            f"{_MG_TEXT}mtp.layers.0.mtp_model_layer.self_attention.k_layernorm.weight": "mtp.layers.0.self_attn.k_norm.weight",
+            f"{_MG_TEXT}mtp.layers.0.mtp_model_layer.self_attention.indexer.index_qk_proj.weight": "mtp.layers.0.self_attn.indexer.index_qk_proj.weight",
+            f"{_MG_TEXT}mtp.layers.0.mtp_model_layer.self_attention.indexer.q_layernorm.weight": "mtp.layers.0.self_attn.indexer.q_layernorm.weight",
