+# --------------------------------------------------------------------------------------
+# the tiny geometry the numeric stages run on
+# --------------------------------------------------------------------------------------
+# 4 hyper-connection streams of 64, ngram_size=3 over 2 heads per n-gram -> 4 heads of
+# 2 dims, the four primes after 10 (11, 13, 17, 19) tiling a 60-row table padded to 64
+# and split into 4 shards of 16 rows. Small enough to keep a dense copy of the table in
+# memory and compare against, real enough to exercise every division in the module.
+SMALL = dict(
+    hidden_size=64,
+    hc_count=4,
+    ngram_size=3,
+    heads_per_ngram=2,
+    ple_embed_dim=8,
+    ple_conv_kernel_size=4,
+    ngram_vocab_size_base=11,
+    make_ngram_vocab_size_divisible_by=8,
+    split_ngram_parts=4,
+    vocab_size=100,
+    eos_token_id=7,
+    ple_seed=1234,
+)
+TABLE_ROWS = 64
+TABLE_HEAD_DIM = 2
+TABLE_SPLITS = SMALL['split_ngram_parts']
+NGRAM_HEADS = (SMALL['ngram_size'] - 1) * SMALL['heads_per_ngram']
+HC_HIDDEN = SMALL['hc_count'] * SMALL['hidden_size']
+
+# Where `--stage tensors` looks for the checkpoint when it is not told: the table
+# directory the bridge fills in is the checkpoint directory itself.
+CKPT_ENV_VARS = ('QWEN4_EXP_PLE_TABLE_DIR', 'QWEN4_EXP_CKPT')
+PLE_PREFIX = 'model.language_model.layers.1.ple.'
+
+
+def _shard_key(index: int) -> str:
+    return f'{PLE_PREFIX}ple_embedding.ngram_embedding.shard_{index}.weight'
+
+
+def _metadata_keys() -> List[str]:
+    return [
+        f'{PLE_PREFIX}ple_embedding.layer_multipliers',
+        f'{PLE_PREFIX}ple_embedding.ngram_heads_vocab_sizes',
+        f'{PLE_PREFIX}ple_embedding.ngram_heads_offsets',
+    ]
+
+
+def make_config(table_dir: Optional[str] = None, **overrides):
+    """A minimal ``TransformerConfig`` carrying the PLE geometry of :data:`SMALL`."""
+    from megatron.core.transformer import TransformerConfig
+
+    geometry = dict(SMALL)
+    geometry.update(overrides)
+    parallel = {
+        'tensor_model_parallel_size': geometry.pop('tensor_model_parallel_size', 1),
+        'context_parallel_size': geometry.pop('context_parallel_size', 1),
+        'sequence_parallel': geometry.pop('sequence_parallel', False),
+    }
+    config = TransformerConfig(
+        num_layers=1,
+        hidden_size=geometry['hidden_size'],
+        num_attention_heads=4,
+        num_query_groups=1,
+        ffn_hidden_size=geometry['hidden_size'] * 2,
+        normalization='RMSNorm',
+        activation_func=F.silu,
+        layernorm_epsilon=1e-6,
+        params_dtype=torch.float32,
+        perform_initialization=True,
+        add_bias_linear=False,
+        **parallel,
+    )
+    # Only the provider and the HF config carry these; the module reads them with
+    # `getattr`, so a plain attribute is what it expects.
+    for name in (
+        'hc_count',
+        'ngram_size',
+        'heads_per_ngram',
+        'ple_embed_dim',
+        'ple_conv_kernel_size',
+        'ngram_vocab_size_base',
+        'make_ngram_vocab_size_divisible_by',
+        'split_ngram_parts',
+        'vocab_size',
+        'eos_token_id',
+        'ple_seed',
+    ):
+        setattr(config, name, geometry[name])
+    config.ple_table_dir = table_dir
+    return config
+
+
+def build_ple_layer(config, layer_number: int = 2, ple_layer_index: int = 0, pg_collection=None):
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.ple import Qwen4ExpTextPLELayer
+
+    return Qwen4ExpTextPLELayer(
+        config, layer_number=layer_number, ple_layer_index=ple_layer_index, pg_collection=pg_collection
+    )
