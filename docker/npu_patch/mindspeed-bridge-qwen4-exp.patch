+# --------------------------------------------------------------------------------------
+# 4. the table
+# --------------------------------------------------------------------------------------
+def test_table() -> bool:
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp import ple as ple_module
+    from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.ple import PinnedNGramTable
+
+    ok = True
+    ids = torch.randint(0, TABLE_ROWS, (37, NGRAM_HEADS), generator=torch.Generator().manual_seed(11), dtype=torch.long)
+    # The shard boundaries on purpose: an off-by-one would hide anywhere else.
+    ids[0, 0] = 0
+    ids[0, 1] = TABLE_ROWS // TABLE_SPLITS - 1
+    ids[0, 2] = TABLE_ROWS // TABLE_SPLITS
+    ids[0, 3] = TABLE_ROWS - 1
+    with tempfile.TemporaryDirectory() as root:
+        for label, with_index, dtype in (
+            ('with the index file', True, torch.float32),
+            ('without the index file', False, torch.float32),
+            ('in bf16, as a checkpoint stores it', True, torch.bfloat16),
+        ):
+            folder = os.path.join(root, f'table-{int(with_index)}-{str(dtype).rsplit(".", 1)[-1]}')
+            os.makedirs(folder, exist_ok=True)
+            dense = write_synthetic_table(folder, with_index=with_index, dtype=dtype)
+            # One rank, so the buffer is the whole table. The dtype is the file's, so
+            # reading a bf16 table back as the bf16 values it holds is part of what is
+            # tested -- and so that `fill` has nothing to warn about.
+            table = PinnedNGramTable(folder, TABLE_SPLITS, TABLE_ROWS, TABLE_HEAD_DIM)
+            weight = table.allocate(dtype)
+            ok &= _check(
+                weight.is_pinned() and weight.device.type == 'cpu',
+                f'the table buffer is pinned host memory, {label}',
+                f'pinned={weight.is_pinned()} on {weight.device.type}',
+            )
+            ok &= _check(
+                tuple(weight.shape) == (TABLE_ROWS, TABLE_HEAD_DIM),
+                f'  ... holding every row of a one-rank table, {label}',
+                str(tuple(weight.shape)),
+            )
+            table.fill(weight)
+            ok &= _check(table.dtype == dtype, f'the table reads as its own dtype, {label}', str(table.dtype))
+            got = _lookup_table(table, weight, ids)
+            ok &= _check(torch.equal(got, dense[ids]), f'lookup == a dense index, {label}', str(tuple(got.shape)))
+            ok &= _check(torch.equal(_lookup_table(table, weight, ids[:1]), dense[ids[:1]]), f'  ... on a single row, {label}')
+            ok &= _check(
+                _lookup_table(table, weight, ids[:0]).shape == (0, NGRAM_HEADS, TABLE_HEAD_DIM),
+                f'  ... and on no rows, {label}',
+            )
+
+        # The loader: what the conversion hands over, one shard per call, so the
+        # shards are neither read a second time nor ever in memory at once.
+        folder = os.path.join(root, 'loader')
+        os.makedirs(folder, exist_ok=True)
+        dense = write_synthetic_table(folder)
+        table = PinnedNGramTable(folder, TABLE_SPLITS, TABLE_ROWS, TABLE_HEAD_DIM)
+        weight = table.allocate(torch.float32)
+        rows_per_shard = TABLE_ROWS // TABLE_SPLITS
+        handed = []
+
+        def loader(index: int, dense=dense, handed=handed, rows_per_shard=rows_per_shard):
+            handed.append(index)
+            return dense[index * rows_per_shard : (index + 1) * rows_per_shard].clone()
+
+        table.fill(weight, loader=loader)
+        ok &= _check(handed == list(range(TABLE_SPLITS)), 'the loader is asked for every shard once', str(handed))
+        ok &= _check(
+            torch.equal(_lookup_table(table, weight, ids), dense[ids]), 'a lookup over the handed-over shards == the dense one'
+        )
+
+        # The tensor-parallel row shard: a rank materializes its own rows and
+        # contributes zeros for the rest, which is what the TP sum turns back into
+        # the whole row -- bit for bit, since a row has one owner and bf16 zeros add
+        # exactly. tp_size=2 puts two shards in one rank's range, tp_size=4 puts one.
+        folder = os.path.join(root, 'sharded')
+        os.makedirs(folder, exist_ok=True)
+        dense = write_synthetic_table(folder, dtype=torch.bfloat16)
+        for tp_size in (2, 4):
+            rows_per_rank = TABLE_ROWS // tp_size
+            summed = torch.zeros(ids.shape + (TABLE_HEAD_DIM,), dtype=torch.bfloat16)
+            for tp_rank in range(tp_size):
+                table = PinnedNGramTable(folder, TABLE_SPLITS, TABLE_ROWS, TABLE_HEAD_DIM, tp_rank, tp_size)
+                weight = table.allocate(torch.bfloat16)
+                mine = slice(tp_rank * rows_per_rank, (tp_rank + 1) * rows_per_rank)
+                table.fill(weight)
+                ok &= _check(
+                    tuple(weight.shape) == (rows_per_rank, TABLE_HEAD_DIM) and torch.equal(weight, dense[mine]),
+                    f'rank {tp_rank}/{tp_size} materializes rows {mine.start}..{mine.stop - 1} and nothing else',
+                )
+                owned = (ids >= mine.start) & (ids < mine.stop)
+                got = _lookup_table(table, weight, ids)
+                ok &= _check(
+                    bool((got[~owned] == 0).all()) and torch.equal(got[owned], dense[ids[owned]]),
+                    '  ... and its lookup is those rows, zeros elsewhere',
+                )
+                summed += got
+            ok &= _check(torch.equal(summed, dense[ids]), f'the ranks summed == the dense lookup, tp_size={tp_size}')
+
+        # Everything the reader has to refuse: a table it cannot read straight
+        # (an unaligned window), one that is not all there, one whose shards do not
+        # tile the model's geometry, and a geometry no split can tile.
+        misaligned = os.path.join(root, 'unaligned')
+        os.makedirs(misaligned, exist_ok=True)
+        write_unaligned_table(misaligned)
+        table = PinnedNGramTable(misaligned, 1, 1, TABLE_HEAD_DIM)
+        try:
+            table.fill(table.allocate(torch.bfloat16))
+            ok &= _check(False, 'an unaligned shard is refused')
+        except ValueError as exc:
+            ok &= _check('align' in str(exc), 'an unaligned shard is refused', str(exc)[:80])
+
+        missing = os.path.join(root, 'missing')
+        os.makedirs(missing, exist_ok=True)
+        write_synthetic_table(missing, with_index=False)
+        os.remove(os.path.join(missing, 'table-00003.safetensors'))
+        table = PinnedNGramTable(missing, TABLE_SPLITS, TABLE_ROWS, TABLE_HEAD_DIM)
+        try:
+            table.located  # pylint: disable=pointless-statement
+            ok &= _check(False, 'a missing shard is refused')
+        except FileNotFoundError as exc:
+            ok &= _check('shard_3' in str(exc), 'a missing shard is refused', str(exc)[:110])
+
+        ragged = os.path.join(root, 'ragged')
+        os.makedirs(ragged, exist_ok=True)
+        write_synthetic_table(ragged, head_dim=TABLE_HEAD_DIM * 2)
+        table = PinnedNGramTable(ragged, TABLE_SPLITS, TABLE_ROWS, TABLE_HEAD_DIM)
+        try:
+            table.located  # pylint: disable=pointless-statement
+            ok &= _check(False, 'shards that do not tile the table are refused')
+        except ValueError as exc:
+            ok &= _check('do not tile' in str(exc), 'shards that do not tile the table are refused', str(exc)[:80])
+
+        # A buffer that is not this rank's rows: `fill` would write off its end.
+        folder = os.path.join(root, 'shapes')
+        os.makedirs(folder, exist_ok=True)
+        write_synthetic_table(folder)
+        table = PinnedNGramTable(folder, TABLE_SPLITS, TABLE_ROWS, TABLE_HEAD_DIM)
+        try:
+            table.fill(table.allocate(torch.float32)[:-1])
+            ok &= _check(False, 'a buffer of the wrong size is refused')
+        except ValueError as exc:
+            ok &= _check('buffer is' in str(exc), 'a buffer of the wrong size is refused', str(exc)[:80])
+
+        # A shard handed over in a dtype the checkpoint does not declare (an fp8
+        # variant, a reader of a different checkpoint): `copy_` would re-interpret
+        # its bits row by row and the shape would say nothing. The declared dtype
+        # names the only layout this reader knows, so the mismatch is refused.
+        folder = os.path.join(root, 'dtypes')
+        os.makedirs(folder, exist_ok=True)
+        dense_fp32 = write_synthetic_table(folder)
+        table = PinnedNGramTable(folder, TABLE_SPLITS, TABLE_ROWS, TABLE_HEAD_DIM)
+        weight = table.allocate(torch.float32)
+        rows_per_shard = TABLE_ROWS // TABLE_SPLITS
+
+        def shard_slice(index, dense=dense_fp32, rows_per_shard=rows_per_shard):
+            return dense[index * rows_per_shard : (index + 1) * rows_per_shard]
+
+        try:
+            table.fill(weight, loader=lambda index: shard_slice(index).to(torch.bfloat16).clone())
+            ok &= _check(False, 'a shard in a dtype the checkpoint does not declare is refused')
+        except ValueError as exc:
+            ok &= _check(
+                'was handed over as' in str(exc) and 'no dequantization' in str(exc),
+                'a shard in a dtype the checkpoint does not declare is refused',
+                str(exc)[:80],
+            )
+        # ... and the same shards in the declared dtype go in, so the check refuses
+        # the mismatch rather than the loader.
+        table.fill(weight, loader=lambda index: shard_slice(index).clone())
+        ok &= _check(
+            torch.equal(weight, dense_fp32),
+            'a shard in the declared dtype is read as it was written',
+        )
+        # The buffer's own dtype is the other half of the pair, and it stays a
+        # warning: the model casts a stored table to its own dtype on the way in.
+        with mock.patch.object(ple_module.logger, 'warning') as warned:
+            table.fill(table.allocate(torch.bfloat16))
+        ok &= _check(
+            warned.call_count == 1 and 'cast to the model' in str(warned.call_args),
+            'a table read as a different dtype than it is stored in warns instead',
+            str(warned.call_args)[:60],
+        )
+
+        # PLE enabled with no checkpoint to read the table from: the failure has to
+        # be loud, because the alternative is a step that trains against zeros.
+        try:
+            PinnedNGramTable(None, TABLE_SPLITS, TABLE_ROWS, TABLE_HEAD_DIM).fill(
+                torch.empty(TABLE_ROWS, TABLE_HEAD_DIM, dtype=torch.float32)
+            )
+            ok &= _check(False, 'a table with no directory to read is refused')
+        except RuntimeError as exc:
+            ok &= _check('not located' in str(exc), 'a table with no directory to read is refused', str(exc)[:70])
+
+        try:
+            PinnedNGramTable(root, 7, TABLE_ROWS, TABLE_HEAD_DIM)
+            ok &= _check(False, 'a row count that does not divide into the shards is refused')
+        except ValueError as exc:
+            ok &= _check('does not divide' in str(exc), 'a row count that does not divide is refused', str(exc)[:80])
+
+        try:
+            PinnedNGramTable(root, TABLE_SPLITS, TABLE_ROWS, TABLE_HEAD_DIM, 0, 3)
+            ok &= _check(False, 'a row count that does not divide into the ranks is refused')
+        except ValueError as exc:
+            ok &= _check('tp_size' in str(exc), 'a row count that does not divide into the ranks is refused')
+    return ok
+
