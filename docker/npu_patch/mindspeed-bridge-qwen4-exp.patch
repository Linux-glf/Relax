+    parts = [_thd_partitioned_indices_torch(cu, cp_size, rank, 'cpu') for rank in range(cp_size)]
+    for rank, pos in enumerate(parts):
+        print(f'   rank {rank} owns packed positions {pos.tolist()}')
+    gathered = torch.cat([global_ids[pos] for pos in parts])
+    restored = _undo_attention_load_balancing_thd_torch(gathered, cp_size, psp)
+    invertible = bool(torch.equal(restored, global_ids)) and sorted(gathered.tolist()) == global_ids.tolist()
+    print(f'   all_gather(rank order) -> undo load balancing restores original order: {invertible}')
+    ok &= invertible
+
+    # the guard rails: these must raise, never silently restore a scrambled sequence
+    try:
+        reconstruct_tensor_cp(global_ids, None, dim=0, cp_partition_mode='contiguous')
+        print('   contiguous cp_partition_mode: NO ERROR (unexpected)')
+        ok = False
+    except NotImplementedError as exc:
+        print(f'   cp_partition_mode="contiguous" rejected: {exc}')
+    try:
+        _thd_partitioned_indices_torch(torch.tensor([0, 6]), cp_size, 0, 'cpu')
+        print('   non-divisible document length: NO ERROR (unexpected)')
+        ok = False
+    except RuntimeError as exc:
+        print(f'   non-divisible document length rejected: {exc}')
+    print(f'test 4: {"PASS" if ok else "FAIL"}')
+    return ok
+
+
+# --------------------------------------------------------------------------------------
+
+
+def main(argv: Optional[list] = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--cpu-only', action='store_true', help='skip the NPU kernel test')
+    parser.add_argument('--npu-only', action='store_true', help='skip the CPU reference test')
+    args = parser.parse_args(argv)
+
+    results = []
+    for name, fn in (
+        ('import smoke', test_import_smoke),
+        ('cpu reference', None if args.npu_only else test_selection_cpu_reference),
+        ('npu sparse kernel', None if args.cpu_only else test_npu_sparse_kernel),
+        ('npu native fused path', None if args.cpu_only else test_npu_native_kernel),
+        ('npu lightning selection', None if args.cpu_only else test_npu_lightning_selection),
+        ('cp reconstruct helpers', test_cp_reconstruct_helpers),
+        ('carrier expansion', test_carrier_expansion),
+    ):
+        if fn is None:
+            continue
+        try:
+            results.append((name, fn()))
+        except Exception:
+            print(f'test "{name}" RAISED:')
+            traceback.print_exc(file=sys.stdout)
+            results.append((name, False))
+
+    print()
+    print('== summary ==')
+    for name, passed in results:
+        print(f'{name}: {"PASS" if passed else "FAIL"}')
+    return 0 if all(passed for _, passed in results) else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
