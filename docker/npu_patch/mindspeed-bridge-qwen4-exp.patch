+# Copyright (c) 2026, HUAWEI CORPORATION. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Row-sparse AdamW for an offloaded embedding table.
+
+A table parameter marked ``is_engram_embedding`` receives gradient on a small
+fraction of its rows: an n-gram lookup contributes one row per head per token,
+and the rows are routed to their owners, so even a 3.2e9-element shard only
+moves tens of thousands of rows per step.  The generic CPU-offload path does
+not know that.  It copies the whole gradient to the host, runs a dense fp32
+AdamW over the master parameter, and copies the whole parameter back.  On the
+qwen4_exp 8-layer run that is 4.9 s of host time per step for the table alone
+plus ~2 s of table-sized copies, inside an 18.7 s step.
+
+Under the distributed optimizer the parameter the step sees is not the model
+parameter but a flat shard view of it (``model_param.detach().view(-1)[start:end]``,
+see ``DistributedOptimizer._build_model_and_main_param_groups``), and the
+optimizer is rebuilt over those views.  The views are different tensor objects,
+so the marker is carried across by the patched
+``copy_optimizer_param_metadata``; a view that spans its whole parameter keeps
+the model rows, a partial shard cannot prove row alignment and stays dense.
+Everything below therefore works on ``(rows, row_width)`` recovered from the
+shard's numel, never on ``param.shape``.
+
+This feature keeps the state layout -- dense ``exp_avg``/``exp_avg_sq``, so a
+checkpoint is indistinguishable from a dense AdamW one -- and moves only the
+rows that received gradient:
+
+* device: ``torch.any(grad, dim=1)`` -> touched row ids, ``index_select`` of
+  those rows into a pinned staging buffer, asynchronous on the D2H stream;
+* host: gather the ids' slices of master/``exp_avg``/``exp_avg_sq``, run the
+  AdamW row update on them, scatter the slices back;
+* device: ``index_copy_`` of the touched rows back into the parameter.
+
+Rows that received no gradient skip the update, including the decoupled weight
+decay and the bias-correction-scaled momentum decay.  That is the semantics of
+sparse embedding optimizers (TensorFlow's ``SparseApplyAdam``, PyTorch's
+``SparseAdam``); a dense AdamW decaying untouched rows is an artifact of
+computing it densely, not a property the model relies on.
+
+``MINDSPEED_BRIDGE_SPARSE_TABLE_ADAM=0`` restores the dense path.
+``MINDSPEED_BRIDGE_SPARSE_TABLE_ADAM_CAP`` bounds the staging buffer in rows;
+a step that passes it falls back to the dense path for that step.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+
+import torch
+
+from megatron_adaptor.features_manager.mindspeed_feature import MindSpeedFeature
+
+_LOGGER = logging.getLogger(__name__)
+
+_ENABLE_ENV = "MINDSPEED_BRIDGE_SPARSE_TABLE_ADAM"
+_CAP_ENV = "MINDSPEED_BRIDGE_SPARSE_TABLE_ADAM_CAP"
+# 512K rows of fp32 staging is 320 MiB on the ranks that own a table shard and
+# is ~10x the row count an 8-layer run touches; past it the step is dense.
+_DEFAULT_CAP = 1 << 19
+_LOG_STEPS = 3
+
+
+def _enabled() -> bool:
+    return os.environ.get(_ENABLE_ENV, "1") != "0"
+
+
+def _rows_cap() -> int:
+    try:
+        return int(os.environ.get(_CAP_ENV, _DEFAULT_CAP))
+    except ValueError:
+        _LOGGER.warning("%s is not an integer; using %d rows.", _CAP_ENV, _DEFAULT_CAP)
+        return _DEFAULT_CAP
+
+
+_METADATA_PATH = "megatron.core.optimizer.optimizer.copy_optimizer_param_metadata"
+_copy_metadata_original = None
+
+
+def _is_sparse_table(gpu_param) -> bool:
+    return getattr(gpu_param, "is_engram_embedding", False)
+
+
+def _row_geometry(gpu_param):
+    """The shard's ``(rows, row_width)``, or None when it is not row-addressable."""
+    width = getattr(gpu_param, "engram_row_width", None)
+    if width is None:
+        if gpu_param.dim() != 2:
+            return None
+        width = gpu_param.shape[1]
+    width = int(width)
+    if width <= 0 or gpu_param.numel() % width != 0:
+        return None
+    return gpu_param.numel() // width, width
+
+
+def copy_table_optimizer_param_metadata(destination, source) -> None:
+    """``copy_optimizer_param_metadata`` plus the table's row geometry.
+
+    ``DistributedOptimizer`` operates on flat shard views of the model
+    parameters and rebuilds the optimizer over them.  A view is a different
+    tensor object, so the marker set on the model parameter stops there -- and
+    with it every sparse step, silently.  The view carries the same rows as its
+    parameter when it spans all of it; a partial shard has no provable row
+    alignment, so it is left to the dense path.
+    """
+    if _copy_metadata_original is not None:
+        _copy_metadata_original(destination, source)
+    if not _is_sparse_table(source):
+        return
+    destination.is_engram_embedding = True
+    width = getattr(source, "engram_row_width", None)
+    if width is None and source.dim() == 2:
+        width = source.shape[1]
+    if width and source.dim() == 2 and destination.numel() == source.numel():
+        destination.engram_row_width = int(width)
+
+
+def _grad_state(grad) -> str:
+    return "none" if grad is None else tuple(grad.shape)
+
+
+def _describe_param(host_param, gpu_param) -> str:
+    geometry = _row_geometry(gpu_param)
+    return "param=%s gpu=%s%s geo=%s grad=%s decoupled=%s" % (
+        tuple(host_param.shape),
+        tuple(gpu_param.shape),
+        " marked" if _is_sparse_table(gpu_param) else "",
+        "%dx%d" % geometry if geometry is not None else "unknown",
+        _grad_state(getattr(gpu_param, "grad", None)),
+        _grad_state(getattr(gpu_param, "decoupled_grad", None)),
+    )
+
+
+def _log_diagnostics(hdo, call: int) -> None:
+    """Report, for the first calls only, which optimizer handles the table."""
+    promoted = sum(isinstance(optimizer, SparseRowAdamW) for optimizer in hdo.cpu_optimizers)
+    table = []
+    largest = None
+    for optimizer in hdo.cpu_optimizers:
+        params = [param for group in optimizer.param_groups for param in group["params"]]
+        if len(params) != 1:
+            continue
+        gpu_param = hdo.cpu_copys_map_gpu_param.get(params[0])
+        if gpu_param is None:
+            continue
+        if largest is None or params[0].numel() > largest[0].numel():
+            largest = (params[0], gpu_param, optimizer)
+        if not _is_sparse_table(gpu_param):
+            continue
+        table.append("%s %s" % (type(optimizer).__name__, _describe_param(params[0], gpu_param)))
+    if largest is not None and not table:
+        # The table is the largest parameter on the ranks that own a shard, so
+        # name it even when the marker did not survive.
+        params, gpu_param, optimizer = largest
+        table.append("largest %s %s" % (type(optimizer).__name__, _describe_param(params, gpu_param)))
+    # The pid keeps Ray's cross-cluster log dedup from collapsing rank messages.
+    _LOGGER.info(
+        "sparse-table diag pid=%d call=%d: %d cpu optimizers, %d promoted, table=[%s]",
+        os.getpid(),
+        call,
+        len(hdo.cpu_optimizers),
+        promoted,
+        "; ".join(table) or "NOT FOUND",
+    )
+
+
+class SparseTableAdamFeature(MindSpeedFeature):
+    """Route the offloaded table's optimizer step through touched rows only."""
+
+    def __init__(self):
+        super().__init__(feature_name="sparse_table_adam", optimization_level=0)
+
+    def register_patches(self, patch_manager, args):
+        if not _enabled():
+            _LOGGER.info("%s=0; the offloaded table keeps the dense CPU AdamW.", _ENABLE_ENV)
+            return
+        global _copy_metadata_original
+        from megatron.core.optimizer import optimizer as mcore_optimizer
+
+        candidate = mcore_optimizer.copy_optimizer_param_metadata
+        if candidate is not copy_table_optimizer_param_metadata:
+            _copy_metadata_original = candidate
+        patch_manager.register_patch(
+            _METADATA_PATH,
+            copy_table_optimizer_param_metadata,
+            force_patch=True,
+        )
+        patch_manager.register_patch(
+            "megatron.core.optimizer.cpu_offloading.hybrid_optimizer."
+            "HybridDeviceOptimizer._set_sub_optimizer_grads",
+            sparse_set_sub_optimizer_grads,
+            force_patch=True,
+        )
+        patch_manager.register_patch(
+            "megatron.core.optimizer.cpu_offloading.hybrid_optimizer."
+            "HybridDeviceOptimizer._register_param_copy_back_gpu_hook",
+            sparse_register_param_copy_back_gpu_hook,
+            force_patch=True,
+        )
+
+
+def _adamw_step_unwrapped(self, closure=None):
+    """``torch.optim.AdamW.step`` without the hook wrapper it is defined with.
+
+    The outer :class:`SparseRowAdamW` step is wrapped by ``profile_hook_step``
+    when the instance is built, and that wrapper fires the pre/post hooks --
+    including the H2D copy-back.  Calling the wrapped form from inside would
+    fire them a second time.
+    """
+    step = torch.optim.AdamW.step
+    while hasattr(step, "__wrapped__"):
+        step = step.__wrapped__
+    return step(self, closure)
+
+
+class SparseRowAdamW(torch.optim.AdamW):
+    """AdamW over a table whose ``grad`` holds only the touched rows.
+
+    ``p.sparse_grad`` is ``[k, cols]`` and ``p._sparse_rows_gpu`` /
+    ``p._sparse_rows_cpu`` name the rows it belongs to, both set by the patched
+    grad sync.  When either is missing -- no gradient, or more touched rows than
+    the staging cap -- the step is the ordinary dense fused AdamW on ``p.grad``.
+    """
+
+    def step(self, closure=None):
+        params = [param for group in self.param_groups for param in group["params"]]
+        width = getattr(params[0], "_sparse_width", None) if len(params) == 1 else None
+        if width is None or getattr(params[0], "_sparse_rows_gpu", None) is None:
+            if not getattr(self, "sparse_dense_logged", False):
+                self.sparse_dense_logged = True
+                _LOGGER.info(
+                    "sparse table step: dense fallback (param %s, rows_gpu=%s, width=%s, grad=%s).",
+                    tuple(params[0].shape) if params else None,
+                    None if not params else getattr(params[0], "_sparse_rows_gpu", None),
+                    width,
+                    None if not params else _grad_state(getattr(params[0], "grad", None)),
+                )
+            return _adamw_step_unwrapped(self, closure)
+
+        param = params[0]
+        if not getattr(param, "_sparse_pending", False):
+            # Already applied once for this grad sync; nothing new to consume.
+            return None
+        param._sparse_pending = False
+
+        group = self.param_groups[0]
+        if param._sparse_rows_cpu is None:
+            # The D2H event of this optimizer was synchronized by the caller
+            # before the step, so the ids are already on the host.
+            param._sparse_rows_cpu = param._sparse_rows_gpu.to("cpu")
+        rows = param._sparse_rows_cpu
+        grad = param.sparse_grad
+        rows_total = param.numel() // width
+
+        state = self.state[param]
+        if len(state) == 0:
+            # One flat tensor per state entry, the layout a dense AdamW leaves
+            # on the shard view; only the rows that carry gradient move.
+            state["step"] = torch.tensor(0.0)
+            state["exp_avg"] = torch.zeros_like(param)
+            state["exp_avg_sq"] = torch.zeros_like(param)
+        state["step"] += 1
+        step = state["step"].item()
+
+        if rows.numel() > 0:
+            beta1, beta2 = group["betas"]
+            lr = group["lr"]
+            eps = group["eps"]
+            weight_decay = group["weight_decay"]
+            bias_correction1 = 1 - beta1**step
+            bias_correction2 = 1 - beta2**step
+
+            exp_avg_state = state["exp_avg"].view(rows_total, width)
+            exp_avg_sq_state = state["exp_avg_sq"].view(rows_total, width)
+            master = param.data.view(rows_total, width)
+
+            exp_avg = exp_avg_state.index_select(0, rows)
+            exp_avg_sq = exp_avg_sq_state.index_select(0, rows)
+            touched = master.index_select(0, rows)
+
+            exp_avg.lerp_(grad, 1 - beta1)
+            exp_avg_sq.mul_(beta2).addcmul_(grad, grad, value=1 - beta2)
+            denom = (exp_avg_sq.sqrt() / bias_correction2**0.5).add_(eps)
+            touched.mul_(1 - lr * weight_decay)
+            touched.addcdiv_(exp_avg, denom, value=-lr / bias_correction1)
+
+            exp_avg_state.index_copy_(0, rows, exp_avg)
+            exp_avg_sq_state.index_copy_(0, rows, exp_avg_sq)
+            master.index_copy_(0, rows, touched)
+        return None
+
+
+def _promote_sparse_optimizers(hdo) -> None:
+    """Swap the table's per-parameter CPU AdamW for :class:`SparseRowAdamW`."""
+    if not _enabled():
+        return
+    for index, optimizer in enumerate(hdo.cpu_optimizers):
+        if isinstance(optimizer, SparseRowAdamW):
+            continue
+        groups = optimizer.param_groups
+        params = [param for group in groups for param in group["params"]]
+        if len(params) != 1:
+            continue
+        gpu_param = hdo.cpu_copys_map_gpu_param.get(params[0])
+        if not _is_sparse_table(gpu_param):
+            continue
+        geometry = _row_geometry(gpu_param)
+        if geometry is None:
+            _LOGGER.warning(
+                "the offloaded table shard %s is not row-addressable (gpu %s, width %s); "
+                "keeping the dense CPU AdamW for it.",
+                tuple(params[0].shape),
+                tuple(gpu_param.shape),
+                getattr(gpu_param, "engram_row_width", None),
+            )
+            continue
+        group = groups[0]
+        if group.get("amsgrad") or group.get("maximize"):
+            _LOGGER.warning(
+                "the offloaded table uses amsgrad/maximize; keeping the dense CPU AdamW for it."
+            )
+            continue
+        sparse_optimizer = SparseRowAdamW(groups)
+        sparse_optimizer.state = optimizer.state
+        sparse_optimizer.sparse_rows_cap = _rows_cap()
+        sparse_optimizer.sparse_log_count = 0
+        hdo.cpu_optimizers[index] = sparse_optimizer
+        _LOGGER.info(
+            "offloaded table %s (gpu shard %s, %d rows x %d) takes the row-sparse AdamW "
+            "(cap %d rows/step).",
+            tuple(params[0].shape),
+            tuple(gpu_param.shape),
+            geometry[0],
+            geometry[1],
+            sparse_optimizer.sparse_rows_cap,
+        )
+
+
+def _staging_buffer(optimizer, width: int) -> torch.Tensor:
+    """Pinned fp32 staging for ``sparse_rows_cap`` rows of ``width``."""
+    buffer = getattr(optimizer, "sparse_staging", None)
+    if buffer is None or buffer.shape[1] != width:
+        buffer = torch.empty(
+            (optimizer.sparse_rows_cap, width), dtype=torch.float32, pin_memory=True
+        )
+        optimizer.sparse_staging = buffer
+    return buffer
+
+
+def _copy_sparse_grad(hdo, optimizer, param, gpu_param, grad) -> None:
+    """Stage only the rows of ``grad`` that carry gradient."""
+    geometry = _row_geometry(gpu_param)
+    if geometry is not None and grad.is_contiguous():
+        rows_total, width = geometry
+        rows = torch.nonzero(torch.any(grad.view(rows_total, width), dim=1)).flatten()
+        count = rows.numel()
+        if count <= optimizer.sparse_rows_cap:
+            buffer = _staging_buffer(optimizer, width)[:count]
+            buffer.copy_(
+                grad.view(rows_total, width).index_select(0, rows).to(torch.float32),
+                non_blocking=True,
+            )
+            # ``param.grad`` cannot hold fewer rows than the parameter (torch's
+            # grad setter compares shapes), so the staged rows live beside it.
+            param.sparse_grad = buffer
+            param._sparse_rows_gpu = rows
+            param._sparse_rows_cpu = None
+            param._sparse_pending = True
+            param._sparse_width = width
+            if optimizer.sparse_log_count < _LOG_STEPS:
+                optimizer.sparse_log_count += 1
+                _LOGGER.info("sparse table step: %d of %d rows carry gradient.", count, rows_total)
+            return
+
+        # More touched rows than the staging cap: this step is dense.
+        _LOGGER.warning(
+            "sparse table step touched %d rows (cap %d); using the dense path this step.",
+            count,
+            optimizer.sparse_rows_cap,
+        )
+        del rows
+    elif geometry is None:
+        _LOGGER.warning(
+            "sparse table shard %s has no row geometry; using the dense path this step.",
+            tuple(grad.shape),
+        )
+    else:
+        _LOGGER.warning(
+            "sparse table grad %s is not contiguous; using the dense path this step.",
+            tuple(grad.shape),
+        )
+
+    param._sparse_rows_gpu = None
+    param._sparse_rows_cpu = None
+    param._sparse_pending = False
+    param._sparse_width = None
+    if param not in hdo.cpu_copy_map_grad:
+        hdo.cpu_copy_map_grad[param] = torch.empty(
+            param.shape, dtype=param.dtype, pin_memory=hdo.pin_cpu_grads, device="cpu"
+        )
+    param.grad = hdo.cpu_copy_map_grad[param]
+    param.grad.data.copy_(grad, non_blocking=True)
+
+
+def _param_generator(optimizer):
+    for group in optimizer.param_groups:
+        for param in group["params"]:
+            yield param
+
+
+def _copy_back_param(param, gpu_param) -> None:
+    """Copy a host master parameter back to the device, sparse when it was sparse."""
+    rows_gpu = getattr(param, "_sparse_rows_gpu", None)
+    width = getattr(param, "_sparse_width", None)
+    if rows_gpu is None or width is None:
+        gpu_param.data.copy_(param.data, non_blocking=True)
+        return
+    rows_cpu = param._sparse_rows_cpu
+    if rows_cpu is None or rows_cpu.numel() == 0:
+        return
+    rows_total = gpu_param.numel() // width
+    source = param.data.view(rows_total, width).index_select(0, rows_cpu).to(
+        device=gpu_param.device, dtype=gpu_param.dtype
+    )
+    gpu_param.data.view(rows_total, width).index_copy_(0, rows_gpu, source)
+
+
+def sparse_set_sub_optimizer_grads(self):
+    """``HybridDeviceOptimizer._set_sub_optimizer_grads`` with the table branch.
+
+    Everything else is upstream: sync the grads of the parameters that stay on
+    the device, then copy each offloaded parameter's gradient into its pinned
+    host buffer on the D2H stream.
+    """
+    calls = getattr(self, "_sparse_diag_calls", 0)
+    if calls < _LOG_STEPS:
+        self._sparse_diag_calls = calls + 1
+        _log_diagnostics(self, calls)
+    if self.param_update_in_fp32:
+        for param in self.param_to_fp32_param:
+            if param in self.gpu_params_map_cpu_copy:
+                # Offloaded; handled below.
+                continue
+            fp32_param = self.param_to_fp32_param[param]
+            grad = getattr(param, "decoupled_grad", param.grad)
+            if grad is not None:
+                fp32_param.grad = grad.to(fp32_param.dtype)
+                fp32_param.requires_grad = True
+            else:
+                fp32_param.requires_grad = False
+
+    for optimizer in self.cpu_optimizers:
+        for param in _param_generator(optimizer):
+            gpu_param = self.cpu_copys_map_gpu_param[param]
+            grad = getattr(gpu_param, "decoupled_grad", gpu_param.grad)
+            if grad is None:
+                param.requires_grad = False
+                continue
+
+            param.requires_grad = False
+            if isinstance(optimizer, SparseRowAdamW) and _is_sparse_table(gpu_param):
+                _copy_sparse_grad(self, optimizer, param, gpu_param, grad)
+                continue
+
+            if param not in self.cpu_copy_map_grad:
+                self.cpu_copy_map_grad[param] = torch.empty(
+                    param.shape, dtype=param.dtype, pin_memory=self.pin_cpu_grads, device="cpu"
+                )
+            param.grad = self.cpu_copy_map_grad[param]
+            param.grad.data.copy_(grad, non_blocking=True)
+        self._cpu_optimizer_map_data_event[optimizer] = self._d2h_stream.record_event()
+
+
+def sparse_register_param_copy_back_gpu_hook(self):
+    """``HybridDeviceOptimizer._register_param_copy_back_gpu_hook`` with the table branch.
+
+    The table copies back only the rows its step touched; every other parameter
+    keeps the full asynchronous H2D copy.
+    """
+
+    def param_copy_back_gpu_hook_closure():
+        def param_copy_back_gpu_hook(optimizer, args, kwargs):
+            self._h2d_stream.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(self._h2d_stream):
+                for param in _param_generator(optimizer):
+                    _copy_back_param(param, self.cpu_copys_map_gpu_param[param])
+            self._h2d_stream.record_event().wait(torch.cuda.current_stream())
+
+        return param_copy_back_gpu_hook
+
+    def fp32_param_copy_back_gpu_hook_closure():
+        def fp32_param_copy_back_gpu_hook(optimizer, args, kwargs):
+            for group in self.param_groups:
+                for param in group["params"]:
+                    if param in self.gpu_params_map_cpu_copy:
+                        # Offloaded; copied back by the hook above.
+                        continue
+                    if param in self.param_to_fp32_param:
+                        fp32_param = self.param_to_fp32_param[param]
+                        param.data.copy_(fp32_param.data)
+
+        return fp32_param_copy_back_gpu_hook
+
+    # Must precede the hook registration: hooks are registered on the optimizer
+    # objects that exist now.
+    _promote_sparse_optimizers(self)
+
+    for optimizer in self.sub_optimizers:
+        if optimizer is not self.gpu_optimizer:
+            optimizer.register_step_post_hook(param_copy_back_gpu_hook_closure())
+        elif self.param_update_in_fp32:
+            optimizer.register_step_post_hook(fp32_param_copy_back_gpu_hook_closure())
+
+
+__all__ = [
+    "SparseTableAdamFeature",
+    "SparseRowAdamW",
+    "copy_table_optimizer_param_metadata",
+    "sparse_set_sub_optimizer_grads",
+    "sparse_register_param_copy_back_gpu_hook",
+]
