+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Norm layers for Qwen3.8-Flash-Next (``qwen4_exp``).
+
+Both norms are *zero-centered* (``(1 + w)`` scaling), matching the checkpoint's
+``GemmaRMSNorm``-style weights. Megatron's ``layernorm_zero_centered_gamma`` also
+implies ``(1 + w)``, but the affine is applied in fp32 here before the cast back
+to the input dtype, which is what the HF reference does -- keep that order.
+"""
+
+from __future__ import annotations
+
+import torch
+from torch import nn
+
+
+class Qwen4ExpTextRMSNorm(nn.Module):
+    """Zero-centered RMSNorm over the last dim (HF ``Qwen4ExpTextRMSNorm``)."""
+
+    def __init__(self, dim: int, eps: float = 1e-6, dtype=None, sequence_parallel: bool = False):
+        super().__init__()
+        self.eps = eps
+        self.weight = nn.Parameter(torch.zeros(dim, dtype=dtype))
+        # Replicated across TP; reduce grads across TP when SP is on.
+        setattr(self.weight, 'sequence_parallel', sequence_parallel)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        out = x.float()
+        out = out * torch.rsqrt(out.pow(2).mean(-1, keepdim=True) + self.eps)
+        return (out * (1.0 + self.weight.float())).type_as(x)
+
+
+class Qwen4ExpTextGroupedRMSNorm(nn.Module):
+    """Zero-centered RMSNorm over the last dim, computed in groups of ``group_size``.
+
+    The hyper-connection norms normalize each of the ``hc_count`` streams
+    independently even though the tensor is stored flattened, so the statistics
+    are taken per group rather than over the full ``hc_count * hidden_size``.
+    """
+
+    def __init__(self, dim: int, group_size: int, eps: float = 1e-6, dtype=None, sequence_parallel: bool = False):
+        super().__init__()
+        self.eps = eps
+        self.weight = nn.Parameter(torch.zeros(dim, dtype=dtype))
+        self.group_size = group_size
+        if dim % group_size != 0:
+            raise ValueError(f'hidden_size ({dim}) must be divisible by group_size ({group_size}).')
+        setattr(self.weight, 'sequence_parallel', sequence_parallel)
+
+    def _norm(self, x: torch.Tensor) -> torch.Tensor:
+        x = x.reshape(*x.shape[:-1], -1, self.group_size)
+        out = x * torch.rsqrt(x.pow(2).mean(-1, keepdim=True) + self.eps)
+        return out.flatten(-2)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        output = self._norm(x.float())
+        output = output * (1.0 + self.weight.float())
+        return output.type_as(x)
+
+    def extra_repr(self) -> str:
+        return f'{tuple(self.weight.shape)}, eps={self.eps}'
