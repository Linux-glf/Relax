@@ -0,0 +1,961 @@
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""HuggingFace <-> Megatron weight mapping for Qwen3.8-Flash-Next (``qwen4_exp``).
+
+The checkpoint is a vision-language model (``Qwen4ExpForConditionalGeneration``)
+whose text tower sits under ``model.language_model.`` and whose MTP head is a
+top-level ``mtp.`` module. This bridge converts the *text tower and the MTP
+head*: the vision tower is converted by the VL bridge, which reuses the
+mappings built here.
+
+Naming conventions, since every family writes them differently:
+
+* the Megatron-side parameter names are the ones of
+  :class:`~mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.model.Qwen4ExpModel`
+  -- the hyper-connection modules and the QSA indexer keep their checkpoint
+  names (``attn_hyper_connection``, ``indexer``), so most entries are 1:1;
+* the model has *no* per-layer layernorms, so there are no
+  ``input_layernorm``/``post_attention_layernorm``/``final_layernorm``
+  mappings -- the norms that do exist belong to the hyper-connections;
+* full-attention layers keep the Qwen3-VL attention layout, which the shared
+  helpers (:class:`QKVMapping`, :class:`GatedMLPMapping`) already know how to
+  interleave -- including the doubled ``q_proj`` of the output gate, selected by
+  ``provider.attention_output_gate``;
+* GDN layers use the flat ``[Q | K | V | Z | B | A]`` ``in_proj`` layout of this
+  family (four separate checkpoint tensors), mapped by
+  :class:`GDNLinearMappingSeparate`.
+"""
+
+from __future__ import annotations
+
+import logging
+import re
+from typing import Any, Dict, List, Mapping, Optional, Tuple, Union
+
+import torch
+from torch import nn
+from megatron.core import parallel_state
+
+from megatron.bridge.models.conversion.mapping_registry import MegatronMappingRegistry
+from megatron.bridge.models.conversion.model_bridge import MegatronModelBridge, WeightConversionTask
+from megatron.bridge.models.conversion.param_mapping import (
+    AutoMapping,
+    GDNConv1dMapping,
+    GatedMLPMapping,
+    MegatronParamMapping,
+    QKVMapping,
+    ReplicatedMapping,
+)
+from megatron.bridge.models.hf_pretrained.causal_lm import PreTrainedCausalLM
+from megatron.bridge.utils.common_utils import extract_expert_number_from_param
+from megatron.bridge.models.conversion.utils import get_module_and_param_from_name
+
+from megatron.bridge.models.conversion.param_mapping import GDNLinearMappingSeparate
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.model import Qwen4ExpModel
+from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp.ple import owned_row_span
+from mindspeed_bridge.models.qwen4_exp.qwen4_exp_provider import Qwen4ExpModelProvider
+
+logger = logging.getLogger(__name__)
+
+_QWEN4_EXP_HF_CLASS_NAME = "Qwen4ExpForConditionalGeneration"
+
+# The text tower of the checkpoint lives under `model.language_model.`; the
+# Megatron text model has no wrapper module, so its parameters start at the
+# model's own children (`decoder.`, `mtp.`, ...).
+_HF_TEXT = "model.language_model."
+_MG_TEXT = ""
+
+# The checkpoint's PLE table shards are ``ngram_embedding.shard_<i>.weight``; the
+# index is what says which of them :class:`PLENGramEmbeddingMapping` is handing
+# over (see :meth:`Qwen4ExpBridge._ple_shard_names`).
+_PLE_SHARD_KEY_RE = re.compile(r"shard_(\d+)$")
+
+# How much of a PLE shard an export stages on the device at a time
+# (:meth:`PLENGramEmbeddingMapping.assemble_shard`). A shard is 800 MB for this table
+# and nothing about assembling it needs more than a slice resident, so the assembly
+# walks it in pieces of about this many bytes; 16 MiB is 52428 rows of the table's
+# 160-wide bf16.
+_ASSEMBLY_CHUNK_BYTES = 16 << 20
+
+
+class PLENGramEmbeddingMapping(MegatronParamMapping[Dict[str, torch.Tensor]]):
+    """The PLE n-gram table: one rank's row shard of it <-> the checkpoint's shard files.
+
+    The checkpoint stores the table row-split into
+    ``...ple.ple_embedding.ngram_embedding.shard_<i>.weight`` tensors --
+    ``split_ngram_parts`` of them (128 in the released checkpoint), a padded range of
+    rows each -- while the model keeps one pinned host buffer per rank holding rows
+    ``[tp_rank * rows_per_rank, (tp_rank + 1) * rows_per_rank)`` of it
+    (:class:`Qwen4ExpTextNGramEmbedding`), which is how ``VocabParallelEmbedding``
+    shards a vocabulary. With the table's cpu offload off those rows are a device
+    parameter instead of a host buffer, and in the row-routed form
+    (``PLE_TABLE_MODE=device-ep``) they are split over the expert-parallel group
+    instead of the tensor-parallel one: same rows, same name, same two directions
+    here, only the group that owns them changes
+    (:meth:`Qwen4ExpTextNGramEmbedding.table_owner`).
+
+    Both directions are bounded by one shard, not by the table (95 GiB):
+
+    * import lets the module read the shards itself, one at a time, straight into its
+      buffer (:meth:`Qwen4ExpTextNGramEmbedding.load_table`); the base implementation
+      would fetch all of them and then build this rank's rows out of them in one more
+      tensor, i.e. hold two whole copies of a rank's share of the table at once --
+      47.7 GiB twice, per rank, on a node that has 382 GiB for eight of them.
+    * export assembles one HF shard per iteration, when the export loop reaches it
+      (:class:`_PLEShardExport`), out of the owning ranks' rows -- the TP ranks, or
+      the EP ones in the row-routed form.
+
+    Args:
+        megatron_param: Megatron parameter name pattern (the table buffer).
+        hf_param: ``...shard_{}.weight`` name pattern or the resolved
+            ``{"shard_<i>": name}`` dict.
+        num_shards: Number of HF shards, required with the pattern form.
+    """
+
+    def __init__(self, megatron_param: str, hf_param, num_shards: Optional[int] = None):
+        if isinstance(hf_param, str):
+            if num_shards is None:
+                raise ValueError(f"{megatron_param}: num_shards is required when hf_param is a shard-name pattern")
+            hf_param = {f"shard_{index}": hf_param.format(index) for index in range(num_shards)}
+        super().__init__(megatron_param, hf_param)
+        self.num_shards = len(hf_param)
+
+    def hf_to_megatron(self, hf_weights: Dict[str, torch.Tensor], megatron_module: nn.Module) -> torch.Tensor:
+        """Fill this rank's rows of the table and hand the buffer back.
+
+        ``hf_weights`` is the reader :meth:`Qwen4ExpBridge.maybe_modify_loaded_hf_weight`
+        left behind (``{"read": callable}``), or the resolved shard tensors when
+        something else drove the conversion.
+
+        Nothing is copied twice: the fill writes into the buffer the module owns, and
+        the framework's own ``param_weight.copy_(...)`` then copies that buffer onto
+        itself (a no-op), so the returned tensor is the buffer, not a second one.
+        """
+        if not isinstance(hf_weights, dict):
+            raise TypeError(
+                f"the PLE n-gram table is converted from its shard names, not from a {type(hf_weights).__name__}: "
+                "the bridge hands over a reader, or the shard tensors keyed by name."
+            )
+        if hf_weights.get("read") is not None:
+            megatron_module.load_table(hf_weights["read"])
+        else:
+            shards = [hf_weights[f"shard_{index}"] for index in range(self.num_shards)]
+            megatron_module.load_table(lambda index: shards[index])
+        return megatron_module.weight
+
+    def megatron_to_hf(self, megatron_weights, megatron_module) -> Mapping[str, torch.Tensor]:
+        """Re-split this rank's rows into the checkpoint's shards, one shard at a time.
+
+        A lazy mapping: the export loop asks for a name and gets the shard, so the
+        collective that assembles it runs when that shard is written and the peak is
+        one shard -- not the table. It also means every rank has to walk the shards in
+        the same order, which is what the framework does (`items()` keeps the order we
+        hand over).
+
+        Deliberately *not* `broadcast_from_pp_rank`: that helper moves a tensor of the
+        weight's own size, which here is a rank's 47.7 GiB and lands on a die. With
+        more than one pipeline stage the shard is broadcast instead, one at a time,
+        once it has been assembled (:class:`_PLEShardExport`).
+        """
+        if megatron_module is not None and not megatron_module._table_loaded:
+            raise RuntimeError(
+                "the PLE n-gram table was not loaded, so the export would write its zeros out: the load paths "
+                "are the ones that fill it (see `Qwen4ExpTextNGramEmbedding.load_table`), and a checkpoint that "
+                "leaves the table out has to be paired with an HF load."
+            )
+        return _PLEShardExport(self, megatron_weights, megatron_module)
+
+    @staticmethod
+    def _fallback_owner_coordinates():
+        """``(group, rank, size)`` of the table's row shards, for a stage that has none.
+
+        The form is spelled by the switches, which are the same on every rank, so a
+        pipeline stage without the rows can still name the group it has to sum the
+        broadcast pieces over: the expert-parallel group in the row-routed form, the
+        tensor-parallel one otherwise. With one pipeline stage every rank that exports
+        holds rows and asks the module (:meth:`Qwen4ExpTextNGramEmbedding.table_owner`).
+        """
+        from mindspeed_bridge.models.qwen4_exp.modelling_qwen4_exp import ple as ple_module
+
+        if ple_module._table_form()[0] == ple_module._TABLE_MODE_DEVICE_EP:
+            return (
+                parallel_state.get_expert_model_parallel_group(),
+                parallel_state.get_expert_model_parallel_rank(),
+                parallel_state.get_expert_model_parallel_world_size(),
+            )
+        return (
+            parallel_state.get_tensor_model_parallel_group(),
+            parallel_state.get_tensor_model_parallel_rank(),
+            parallel_state.get_tensor_model_parallel_world_size(),
+        )
+
+    def assemble_shard(
+        self,
+        shard_index: int,
+        local_rows: Optional[torch.Tensor] = None,
+        spec: Optional[Tuple] = None,
+        source_rank: Optional[int] = None,
+        pp_group=None,
+        owner_group=None,
+        owner_rank: Optional[int] = None,
+        owner_size: Optional[int] = None,
+    ) -> torch.Tensor:
+        """Assemble HF shard ``shard_index`` out of the ranks' rows, on the host.
+
+        Each rank writes the rows it owns into a zero tensor, the group that owns the
+        table's rows sums them -- exact, because a row has exactly one owner and the
+        rest are zeros -- and the result goes back to the host, which is where the table
+        lives. The sum runs on a die because a collective needs one.
+
+        A shard is 800 MB for this table and a die has no reason to hold that much at
+        once to move it, so the assembly walks it in ``_ASSEMBLY_CHUNK_BYTES`` pieces
+        instead: zeros, this rank's rows, the pipeline broadcast, the owners' sum, down
+        to the host, ``rows_per_shard`` rows at a time. The collectives multiply with the
+        chunk count (about fifty per shard), which is nothing next to the bytes they
+        carry, and every rank derives the cut from the geometry both of them already
+        have, so they walk the shards in the same order and the same pieces. An export
+        happens once per run; the device peak is what this is for.
+
+        ``source_rank``/``pp_group`` are for the pipeline-parallel case: the rank whose
+        stage holds the table broadcasts its column to the other stages first, so every
+        rank can hand the shard to the writer. A rank on such a stage has no rows, and
+        ``spec`` (``(shape, dtype[, owner size])``) is then how it knows what it is
+        assembling.
+
+        ``owner_group``/``owner_rank``/``owner_size`` are whose rows the table is
+        row-split over, and whose sum a row is: the tensor-parallel group in the two
+        host/device TP forms, the expert-parallel group in the row-routed one
+        (:meth:`Qwen4ExpTextNGramEmbedding.table_owner`). They default to this
+        mapping's own TP coordinates.
+        """
+        owner_group = self.tp_group if owner_group is None else owner_group
+        owner_rank = self.tp_rank if owner_rank is None else owner_rank
+        owner_size = self.tp_size if owner_size is None else owner_size
+        rows_per_rank, width, dtype = self._table_geometry(local_rows, spec)
+        total_rows = rows_per_rank * owner_size
+        if total_rows % self.num_shards:
+            raise ValueError(
+                f"the PLE n-gram table ({total_rows} rows over owner_size={owner_size}) does not divide into "
+                f"{self.num_shards} shards: the shard layout this export writes is not the one it read."
+            )
+        rows_per_shard = total_rows // self.num_shards
+        lo = shard_index * rows_per_shard
+        hi = lo + rows_per_shard
+        if owner_size == 1 and source_rank is None:
+            # The whole table is here: the shard is just a view of it -- of its host
+            # storage, unless the cpu offload is off (`QWEN4_EXP_PLE_CPU_OFFLOAD=0`) and
+            # it is a device parameter, which is why the copy to the host is spelled out
+            # rather than implied.
+            return local_rows[lo:hi].cpu()
+
+        shard = torch.empty(rows_per_shard, width, dtype=dtype, device="cpu")
+        span = (
+            owned_row_span(shard_index, rows_per_shard, owner_rank * rows_per_rank, rows_per_rank)
+            if local_rows is not None
+            else None
+        )
+        device = torch.cuda.current_device()
+        chunk_rows = max(1, _ASSEMBLY_CHUNK_BYTES // (width * shard.element_size()))
+        for start in range(0, rows_per_shard, chunk_rows):
+            stop = min(start + chunk_rows, rows_per_shard)
+            piece = torch.zeros(stop - start, width, dtype=dtype, device=device)
+            if span is not None:
+                shard_lo, shard_hi, local_lo, local_hi = span
+                piece_lo, piece_hi = max(shard_lo, start), min(shard_hi, stop)
+                if piece_lo < piece_hi:
+                    offset = piece_lo - shard_lo
+                    piece[piece_lo - start : piece_hi - start].copy_(
+                        local_rows[local_lo + offset : local_lo + offset + (piece_hi - piece_lo)], non_blocking=False
+                    )
+            if source_rank is not None:
+                torch.distributed.broadcast(piece, src=source_rank, group=pp_group)
+            if owner_size > 1:
+                torch.distributed.all_reduce(piece, group=owner_group)
+            shard[start:stop].copy_(piece.cpu())
+        return shard
+
+    @staticmethod
+    def _table_geometry(
+        local_rows: Optional[torch.Tensor], spec: Optional[Tuple[Tuple[int, int], torch.dtype]]
+    ) -> Tuple[int, int, torch.dtype]:
+        """``(rows per rank, head dim, dtype)`` of the table, from the rows or from a spec."""
+        if local_rows is not None:
+            return local_rows.shape[0], local_rows.shape[1], local_rows.dtype
+        if spec is None:
+            raise RuntimeError(
+                "the PLE n-gram table's geometry is unknown on this rank: assemble it where the rows are, or "
+                "pass the (shape, dtype) spec of the stage that holds them."
+            )
+        return spec[0][0], spec[0][1], spec[1]
+
+
+class _PLEShardExport(Mapping[str, torch.Tensor]):
+    """Lazy ``{hf_shard_name: tensor}`` view over a row-sharded PLE table (see ``assemble_shard``)."""
+
+    def __init__(
+        self,
+        mapping: PLENGramEmbeddingMapping,
+        local_rows: Optional[torch.Tensor],
+        module: Optional[nn.Module] = None,
+    ):
+        self._mapping = mapping
+        self._local_rows = local_rows
+        self._names = [mapping.hf_param[f"shard_{index}"] for index in range(mapping.num_shards)]
+        self._index = {name: index for index, name in enumerate(self._names)}
+        # Whose rows a shard is assembled from. The table is row-split over the
+        # tensor-parallel group by default and over the expert-parallel one in the
+        # row-routed form, and the module is what knows which -- it is the same answer
+        # its `sharded_state_dict` writes the rows under. The stage that holds no table
+        # asks the switches instead.
+        if module is not None and hasattr(module, "table_owner"):
+            self._owner_group, self._owner_rank, self._owner_size = module.table_owner()
+        else:
+            self._owner_group, self._owner_rank, self._owner_size = mapping._fallback_owner_coordinates()
+        self._spec = (
+            (tuple(local_rows.shape), local_rows.dtype, self._owner_size) if local_rows is not None else None
+        )
+        if mapping.pp_size > 1:
+            # Who holds the table: the export runs on every stage, and only the stage
+            # that has the module has rows to assemble a shard from. The spec carries
+            # the row geometry's owner count along, so every stage cuts the shards the
+            # same way and sums the broadcast pieces over the same group.
+            specs = [None] * mapping.pp_size
+            torch.distributed.all_gather_object(specs, self._spec, group=mapping.pp_group)
+            owners = [rank for rank, spec in enumerate(specs) if spec is not None]
+            if len(owners) != 1:
+                raise ValueError(f"expected one pipeline stage to hold the PLE n-gram table, found {owners}")
+            self._spec = specs[owners[0]]
+            self._owner_size = self._spec[2]
+            self._source_rank = torch.distributed.get_global_rank(mapping.pp_group, owners[0])
+            self._pp_group = mapping.pp_group
+        else:
+            if local_rows is None:
+                raise RuntimeError("this rank holds no PLE n-gram table to export")
+            self._source_rank = None
+            self._pp_group = None
+
+    def __getitem__(self, name: str) -> torch.Tensor:
+        return self._mapping.assemble_shard(
+            self._index[name],
+            self._local_rows,
+            self._spec,
+            self._source_rank,
+            self._pp_group,
+            owner_group=self._owner_group,
+            owner_rank=self._owner_rank,
+            owner_size=self._owner_size,
+        )
+
+    def __iter__(self):
+        return iter(self._names)
+
+    def __len__(self) -> int:
+        return len(self._names)
+
+
+@MegatronModelBridge.register_bridge(
+    source=_QWEN4_EXP_HF_CLASS_NAME,
+    target=Qwen4ExpModel,
+    provider=Qwen4ExpModelProvider,
+    model_type="qwen4_exp",
+)
+class Qwen4ExpBridge(MegatronModelBridge):
+    """Bridge for the Qwen3.8-Flash-Next text tower and MTP head.
+
+    Example:
+        >>> from megatron.bridge import AutoBridge
+        >>> bridge = AutoBridge.from_hf_pretrained("Qwen/Qwen3.8-Flash-Next")
+        >>> provider = bridge.to_megatron_provider()
+    """
+
+    def __init__(self):
+        super().__init__()
+        # The routed experts of the trunk and of the MTP layer, still being
+        # assembled; see `maybe_modify_converted_hf_weight`.
+        self._expert_weights_cache: Dict[str, Dict[int, torch.Tensor]] = {}
+
+    def maybe_modify_converted_hf_weight(
+        self,
+        task: WeightConversionTask,
+        converted_weights_dict: Dict[str, torch.Tensor],
+        hf_state_dict: Mapping[str, torch.Tensor],
+    ) -> Dict[str, torch.Tensor]:
+        """Assemble the checkpoint's stacked expert tensor from the local experts.
+
+        Megatron keeps the routed experts of a layer as one parameter *per local
+        expert* (``decoder.layers.0.mlp.experts.linear_fc1.weight0`` ...), so
+        every expert task of that layer converts to the *same* HF key -- the
+        checkpoint stacks all of them into one ``[num_experts, ...]`` tensor.
+        Each task also gathers its expert from every EP rank
+        (:meth:`~...param_mapping.MegatronParamMapping.gather_from_ep_ranks`), so
+        what arrives here is one ``[ep_size, ...]`` tensor whose entry ``i`` is
+        the checkpoint's expert ``local_expert + i * experts_per_rank``.
+
+        Handing those straight to the writer would keep only the last one:
+        measured, the export carried ``[4, 1280, 2560]`` (EP=4) for the ten
+        routed-expert tensors of the four layers plus the MTP layer while
+        ``config.json`` still declared ``num_experts=512`` -- a checkpoint no
+        loader can read. The slices are therefore accumulated under the expert
+        ids they belong to and the merged tensor is returned once -- and only
+        once -- all of them have been seen; every other call returns an empty
+        dict, which the export loop yields nothing for.
+
+        This is the ``save_hf_pretrained`` path only. The RL weight sync
+        (``relax/backends/megatron/weight_update/bridge_converter.py``) converts
+        the same parameters with its own per-expert splitting, so it never saw
+        the truncation.
+
+        The slices are parked on the host: one layer's merged tensor is 3.4 GB of
+        bf16, and the export has no reason to grow the NPU footprint by that much
+        at the very moment it is already holding the whole model.
+        """
+        if not converted_weights_dict or ".mlp.experts.linear_fc" not in task.param_name:
+            return converted_weights_dict
+
+        text_config = getattr(self.hf_config, "text_config", self.hf_config)
+        num_experts = getattr(text_config, "num_experts", None)
+        if not num_experts:
+            raise ValueError(
+                f"Cannot merge the routed experts of {task.param_name}: the HF config declares no "
+                "`num_experts`, so there is no way to tell a complete expert tensor from a truncated one."
+            )
+        ep_size = parallel_state.get_expert_model_parallel_world_size()
+        experts_per_rank = num_experts // ep_size
+        local_expert = extract_expert_number_from_param(task.param_name) % experts_per_rank
+
+        merged: Dict[str, torch.Tensor] = {}
+        for key, value in converted_weights_dict.items():
+            experts = self._expert_weights_cache.setdefault(key, {})
+            if ep_size == 1:
+                # Nothing was gathered, so this rank's parameter *is* the expert.
+                experts[local_expert] = value.detach().to("cpu", copy=True)
+            else:
+                if value.shape[0] != ep_size:
+                    raise ValueError(
+                        f"Expected {key} to be stacked over the {ep_size} EP ranks, got {tuple(value.shape)}."
+                    )
+                for i in range(ep_size):
+                    experts[local_expert + i * experts_per_rank] = value[i].detach().to("cpu", copy=True)
+            if len(experts) == num_experts:
+                merged[key] = torch.cat([experts[expert].unsqueeze(0) for expert in range(num_experts)], dim=0)
+                del self._expert_weights_cache[key]
+        return merged
+
+    @staticmethod
+    def _ple_shard_names(hf_param: Union[str, Dict[str, str]]) -> Optional[List[str]]:
+        """The PLE n-gram table's shard names, in shard order -- or ``None``.
+
+        Recognized by shape: a dict of ``shard_<i>`` entries is what
+        :class:`PLENGramEmbeddingMapping` declares, and no other mapping in this
+        registry is a dict. The names come back in shard order rather than in
+        whatever order the dict holds them, because the caller hands them out by
+        index.
+        """
+        if not isinstance(hf_param, dict) or not hf_param:
+            return None
+        ordered = []
+        for key, name in hf_param.items():
+            match = _PLE_SHARD_KEY_RE.fullmatch(key)
+            if match is None:
+                return None
+            ordered.append((int(match.group(1)), name))
+        ordered.sort()
+        return [name for _, name in ordered]
+
+    def maybe_modify_loaded_hf_weight(
+        self,
+        hf_param: Union[str, Dict[str, str]],
+        hf_state_dict: Mapping[str, torch.Tensor],
+    ) -> Any:
+        """Hand the PLE n-gram table over as a reader instead of as 95 GiB of tensors.
+
+        The base implementation fetches every name the mapping declares, which for
+        the table means all 128 shards (95 GiB, or 47.7 GiB per rank at TP=2) --
+        and the conversion would then build this rank's rows out of them in one
+        more tensor of that size, i.e. hold two whole per-rank shares at once.
+        Eight ranks on a node with 382 GiB do not have that.
+
+        So the module gets a callable and fetches the shards *it* overlaps, one at
+        a time, straight into the pinned buffer it keeps its rows in
+        (:meth:`Qwen4ExpTextNGramEmbedding.load_table`); the peak is one shard.
+        Lazy loading is preserved: the shards are read when the table is filled,
+        which is what the framework's own lazy state dict is for.
+        """
+        names = self._ple_shard_names(hf_param)
+        if names is None:
+            return super().maybe_modify_loaded_hf_weight(hf_param, hf_state_dict)
+        return {"read": lambda index: hf_state_dict[names[index]]}
+
+    def provider_bridge(self, hf_pretrained: PreTrainedCausalLM) -> Qwen4ExpModelProvider:
+        """Build a :class:`Qwen4ExpModelProvider` from an HF checkpoint config."""
+        hf_config = hf_pretrained.config
+        text_config = getattr(hf_config, "text_config", hf_config)
+
+        provider_kwargs = self.hf_config_to_provider_kwargs(text_config)
+        # `PROVIDER_CLASS` is the one the decorator registered; the VL bridge
+        # subclasses this one and only adds the vision fields it needs.
+        provider = self.PROVIDER_CLASS(**provider_kwargs)
+
+        # The embeddings are not tied in this family, and both the text config
+        # and the top-level config have to be consulted for that flag.
+        provider.share_embeddings_and_output_weights = getattr(
+            hf_config, "tie_word_embeddings", getattr(text_config, "tie_word_embeddings", False)
+        )
+        provider.mtp_num_layers = getattr(
+            hf_config, "mtp_num_hidden_layers", getattr(text_config, "mtp_num_hidden_layers", None)
+        )
+
+        # --- token ids ---
+        provider.bos_token_id = getattr(text_config, "bos_token_id", 248044)
+        provider.eos_token_id = getattr(text_config, "eos_token_id", 248044)
+        provider.image_token_id = getattr(hf_config, "image_token_id", 248056)
+        provider.video_token_id = getattr(hf_config, "video_token_id", 248057)
+        provider.vision_start_token_id = getattr(hf_config, "vision_start_token_id", 248053)
+        provider.vision_end_token_id = getattr(hf_config, "vision_end_token_id", 248054)
+
+        # --- gated hyper-connections ---
+        provider.hc_count = getattr(text_config, "hc_count", 4)
+        provider.hc_lowrank = getattr(text_config, "hc_lowrank", 320)
+
+        # --- hybrid attention ---
+        provider.experimental_attention_variant = "gated_delta_net"
+        provider.linear_attention_freq = getattr(text_config, "full_attention_interval", 4)
+        provider.attention_output_gate = True
+        provider.output_gate_type = getattr(text_config, "output_gate_type", "sigmoid") or "sigmoid"
+        provider.qk_layernorm = True
+        provider.kv_channels = getattr(text_config, "head_dim", 256)
+        provider.num_query_groups = getattr(text_config, "num_key_value_heads", 2)
+
+        # --- GDN ---
+        provider.linear_conv_kernel_dim = getattr(text_config, "linear_conv_kernel_dim", 4)
+        provider.linear_key_head_dim = getattr(text_config, "linear_key_head_dim", 128)
+        provider.linear_value_head_dim = getattr(text_config, "linear_value_head_dim", 128)
+        provider.linear_num_key_heads = getattr(text_config, "linear_num_key_heads", 16)
+        provider.linear_num_value_heads = getattr(text_config, "linear_num_value_heads", 48)
+
+        # --- QSA indexer ---
+        provider.indexer_n_heads = getattr(text_config, "indexer_n_heads", 4)
+        provider.indexer_kv_heads = getattr(text_config, "indexer_kv_heads", 1)
+        provider.indexer_head_dim = getattr(text_config, "indexer_head_dim", 128)
+        provider.indexer_compress_ratio = getattr(text_config, "indexer_compress_ratio", 4)
+        provider.indexer_budget = getattr(text_config, "indexer_budget", 2048)
+
+        # --- mRoPE: this family keeps its rope settings under `rope_parameters`,
+        # which the generic conversion above does not read. ---
+        rope_parameters = getattr(text_config, "rope_parameters", None) or {}
+        provider.position_embedding_type = "mrope"
+        provider.rotary_base = rope_parameters.get("rope_theta", getattr(text_config, "rope_theta", 10000000.0))
+        provider.rotary_percent = rope_parameters.get(
+            "partial_rotary_factor", getattr(text_config, "partial_rotary_factor", 0.25)
+        )
+        # Not `rotary_interleaved`: that flag selects Megatron's adjacent-pair
+        # rotary convention, while the checkpoint's `mrope_interleaved` is about
+        # how the T/H/W sections are laid out (see the provider field).
+        provider.mrope_interleaved = rope_parameters.get(
+            "mrope_interleaved", getattr(text_config, "mrope_interleaved", False)
+        )
+        provider.mrope_section = rope_parameters.get(
+            "mrope_section", getattr(text_config, "mrope_section", [11, 11, 10])
+        )
+        provider.attention_scaling = rope_parameters.get("attention_scaling", 1.0)
+
+        # --- MoE ---
+        provider.num_moe_experts = getattr(text_config, "num_experts", 512)
+        provider.moe_ffn_hidden_size = getattr(text_config, "moe_intermediate_size", 640)
+        provider.moe_router_topk = getattr(text_config, "num_experts_per_tok", 10)
+        provider.moe_shared_expert_intermediate_size = getattr(text_config, "shared_expert_intermediate_size", 640)
+        provider.moe_shared_expert_gate = True
+        provider.moe_grouped_gemm = True
+        provider.moe_router_dtype = "fp32"
+        provider.moe_router_load_balancing_type = "global_aux_loss"
+        provider.moe_router_pre_softmax = False
+        # `alltoall` is the mcore dispatcher name, not a secret: bandit's B105
+        # keys off the `token` in the attribute name.
+        provider.moe_token_dispatcher_type = "alltoall"  # nosec B105
+        provider.moe_permute_fusion = False
+        # `output_router_logits` is false in the checkpoint: routing is a plain
+        # top-k + softmax and no aux loss is trained, so the coefficient is zero
+        # even though the load-balancing type is the aux-loss one.
+        provider.moe_aux_loss_coeff = (
+            getattr(text_config, "router_aux_loss_coef", 0.0)
+            if getattr(text_config, "output_router_logits", False)
+            else 0.0
+        )
+
+        # --- PLE (per-layer embeddings) ---
+        # The n-gram branch is only as active as the checkpoint says: an empty
+        # `ple_layer_ids` (a truncation built without `--keep-ple`) means the
+        # layers carry no such module and no n-gram table is read at all. The
+        # ids are one-based, as everywhere else in this family's configs.
+        provider.ple_layer_ids = [int(layer_id) for layer_id in (getattr(text_config, "ple_layer_ids", None) or [])]
+        provider.ple_enabled = bool(provider.ple_layer_ids)
+        provider.ngram_size = int(getattr(text_config, "ngram_size", provider.ngram_size))
+        provider.heads_per_ngram = int(getattr(text_config, "heads_per_ngram", provider.heads_per_ngram))
+        provider.ple_embed_dim = int(getattr(text_config, "ple_embed_dim", provider.ple_embed_dim))
+        provider.ple_conv_kernel_size = int(getattr(text_config, "ple_conv_kernel_size", provider.ple_conv_kernel_size))
+        provider.ngram_vocab_size_base = int(
+            getattr(text_config, "ngram_vocab_size_base", provider.ngram_vocab_size_base)
+        )
+        provider.make_ngram_vocab_size_divisible_by = int(
+            getattr(text_config, "make_ngram_vocab_size_divisible_by", provider.make_ngram_vocab_size_divisible_by)
+        )
+        provider.split_ngram_parts = int(getattr(text_config, "split_ngram_parts", provider.split_ngram_parts))
+        # The n-gram hash is salted with the checkpoint's *own* `seed`, which has
+        # nothing to do with `TransformerConfig.seed` (mcore's RNG seed, 42) --
+        # hence the dedicated field, and hence the field default standing in for
+        # a checkpoint that does not name one.
+        provider.ple_seed = int(getattr(text_config, "seed", provider.ple_seed))
+        if provider.ple_enabled:
+            # Where the n-gram table's shards are read from. The table is a
+            # weight -- the module holds this rank's rows of it in a pinned
+            # buffer, and `PLENGramEmbeddingMapping` maps them in and out of the
+            # checkpoint -- but it is a weight whose 95 GiB is fetched one shard
+            # at a time out of these files, so the directory is what a load needs
+            # and not the weights themselves (`Qwen4ExpTextNGramEmbedding.load_table`).
+            # When the conversion hands the shards over, that is what is filled
+            # in; the files are the fallback for a load that has no state dict,
+            # and are what the shard layout is validated against either way.
+            provider.ple_table_dir = str(hf_pretrained.model_name_or_path)
+
+        provider.layernorm_zero_centered_gamma = True
+        provider.hetereogenous_dist_checkpoint = True
+        if provider.mtp_num_layers:
+            provider.mtp_loss_scaling_factor = 0.1
+        return provider
+
+    def _ple_table_shard_count(self) -> int:
