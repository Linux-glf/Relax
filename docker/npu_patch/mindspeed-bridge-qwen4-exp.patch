+    # Training path: the kernel is an autograd.Function, so the backward must run too.
+    try:
+        qg = q.detach().clone().requires_grad_(True)
+        kg = k.detach().clone().requires_grad_(True)
+        vg = v.detach().clone().requires_grad_(True)
+        loss = qsa_sparse_attention_thd(qg, kg, vg, indices, scale, R).float().sum()
+        loss.backward()
+        grad_ok = all(g is not None for g in (qg.grad, kg.grad, vg.grad))
+        print(
