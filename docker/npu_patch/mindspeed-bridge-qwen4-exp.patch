index 0000000..5f1ee38
--- /dev/null
+++ b/mindspeed_bridge/models/qwen4_exp/modelling_qwen4_exp/gdn.py
@@ -0,0 +1,1159 @@
+# pylint: disable=too-many-lines
+# Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+# The layer, its chunked kernels and the packed (thd) path live in one module
+# the way they do upstream (mcore ``ssm/gated_delta_net.py``).
+"""Gated DeltaNet (GDN) linear-attention layer for Qwen3.8-Flash-Next (``qwen4_exp``).
+
+The layer class is a copy of the NPU-adapted GDN used by the Qwen3.5-VL plugin
+(``mindspeed_bridge/models/qwen_vl/modelling_qwen3_vl/gated_delta_net.py``), which
+in turn follows ``megatron.core.ssm.gated_delta_net.GatedDeltaNet``. It is copied
+instead of imported because the Qwen3.5-VL *package* eagerly imports its bridge
+(``mindspeed_bridge.models.qwen_vl.__init__`` -> ``qwen35_vl_bridge`` ->
+``megatron.bridge`` / ``mcore_bridge``), so reusing one layer file would drag a
+whole unrelated model plugin -- and its optional dependencies -- into this one.
+``mindspeed_bridge/models/__init__.py`` explicitly asks model families not to
+depend on each other like that.
+
+Deviations from the copied file, all deliberate:
+
+* the gated-delta-rule kernels are taken from their canonical locations instead
+  of from the Qwen3.5-VL vendored copies: the triton chunked rule from
+  ``mindspeed_ops.api.triton`` and the pure-torch rule from ``megatron.core``
+  (the two bodies are identical; only the signature differs, see
+  :func:`_torch_gated_delta_rule`);
+* ``_apply_gated_norm`` honours ``config.output_gate_type`` (see
+  :class:`Qwen4ExpGDN`);
+* the AscendC kernel backend is imported lazily (it is the only piece that still
+  lives in the Qwen3.5-VL plugin and it needs ``fla_npu``);
+* a missing triton gated-delta-rule kernel degrades to the torch implementation
+  with a warning instead of installing ``None`` as the rule;
+* the ``in_proj`` output layout and the checkpoint-side zero-centered output norm
+  are pinned down in :class:`GatedDeltaNet` and
+  :func:`fix_gdn_out_norm_zero_centered`.
+
+``in_proj`` layout contract
+---------------------------
+``GatedDeltaNetSubmodules.in_proj`` is a *single* fused ``[hidden_size,
+in_proj_dim]`` column-parallel (TP-sharded along dim 0) projection with
+
+    in_proj_dim = qk_dim * 2 + v_dim * 2 + num_value_heads * 2
+    rows        = [Q | K | V | Z(gate) | B(beta) | A(alpha)]
+
+i.e. the four checkpoint tensors are concatenated flat, in that order
+(``qk_dim = linear_num_key_heads * linear_key_head_dim``,
+``v_dim = linear_num_value_heads * linear_value_head_dim``). The Qwen3-Next
+style head-grouped layout is *not* used here, so no decoupled
+``in_proj_qkvz`` / ``in_proj_ba`` implementation is needed. The 1-D
+``A_log`` / ``dt_bias`` parameters and the depthwise ``conv1d`` (which only
+covers the ``Q``/``K``/``V`` part, ``conv_dim = qk_dim * 2 + v_dim``) are
+TP-sharded on dim 0 as well.
+"""
+
+from __future__ import annotations
+
+import copy
+import os
+import warnings
+from collections import OrderedDict
+from typing import List, Optional, Tuple
+
+import torch
+import torch.nn.functional as F
+from torch import Tensor, nn
+
+from megatron.core.fp8_utils import get_fp8_align_size
+from megatron.core.inference.contexts import BaseInferenceContext
+from megatron.core.jit import jit_fuser
+from megatron.core.packed_seq_params import PackedSeqParams
+from megatron.core.process_groups_config import ProcessGroupCollection
+from megatron.core.ssm.gated_delta_net import (
+    GatedDeltaNetSubmodules,
+    torch_chunk_gated_delta_rule,
+)
+from megatron.core.ssm.utils import _split_tensor_factory
+from megatron.core.ssm.mamba_context_parallel import (
+    _all_to_all_cp2hp,
+    _all_to_all_hp2cp,
+    _redo_attention_load_balancing,
+    _undo_attention_load_balancing,
+)
+from megatron.core.tensor_parallel import get_cuda_rng_tracker
+from megatron.core.transformer import TransformerConfig
+from megatron.core.transformer.module import MegatronModule
+from megatron.core.transformer.spec_utils import ModuleSpec, build_module
+from megatron.core.transformer.utils import (
+    ensure_metadata_has_dp_cp_group,
+    make_sharded_tensors_for_checkpoint,
+    sharded_state_dict_default,
+)
+from megatron.core.utils import deprecate_inference_params, nvtx_range_pop, nvtx_range_push
+
+# --------------------------------------------------------------------------- #
+# Kernel backends
+# --------------------------------------------------------------------------- #
+# Causal conv1d: the fused fla kernel is used when available, otherwise the
+# layer falls back to `F.conv1d` (several Ascend builds have no working fla
+# triton conv, hence the escape hatch).
+#
+# `fla_npu` is deliberately not imported here. Its custom_aclnn_extension_lib
+# registers torch.ops.npu.* and, once loaded, every cann_ops_transformer call in
+# the same process aborts at interpreter teardown with "double free or
+# corruption (!prev)" (exit 134; reproducible with any of its ops, on CPU
+# metadata as well). The conv below is fla's triton kernel either way --
+# importing fla_npu does not patch it, verified bit-identical on a packed
+# [1, T, D] input -- and the opt-in AscendC GDN backend imports fla_npu itself.
+if os.environ.get("MINDSPEED_BRIDGE_GDN_USE_TORCH_CONV", "0") == "1":
+    causal_conv1d = None
+else:
+    try:
+        from fla.modules.convolution import causal_conv1d
+    except ImportError:
+        causal_conv1d = None
+
+# Chunked gated delta rule. `mindspeed_ops` ships the NPU (Ascend triton)
+# implementation; without it the pure-torch implementation below is used.
+try:
+    from mindspeed_ops.api.triton.chunk_gated_delta_rule import chunk_gated_delta_rule
+
+    HAVE_TRITON_GDN = True
+except ImportError:
+    chunk_gated_delta_rule = None
+    HAVE_TRITON_GDN = False
+
+
+def _torch_gated_delta_rule(
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    initial_state: Optional[torch.Tensor] = None,
+    output_final_state: bool = False,
+    use_qk_l2norm_in_kernel: bool = False,
+    cu_seqlens: Optional[torch.Tensor] = None,
+):
+    """Pure-torch gated delta rule with the signature of the fused kernels.
+
+    ``megatron.core.ssm.gated_delta_net.torch_chunk_gated_delta_rule`` has no
+    ``cu_seqlens`` argument, so packed sequences are rejected explicitly here
+    (they need a fused kernel anyway, which is what the triton/AscendC backends
+    are for).
+    """
+    assert cu_seqlens is None, "cu_seqlens is not supported by the torch gated delta rule."
+    return torch_chunk_gated_delta_rule(
+        query,
+        key,
+        value,
+        g=g,
+        beta=beta,
+        initial_state=initial_state,
+        output_final_state=output_final_state,
+        use_qk_l2norm_in_kernel=use_qk_l2norm_in_kernel,
+    )
+
+
+_PACKED_BOUNDARY_CACHE: "OrderedDict[tuple, tuple]" = OrderedDict()
+_PACKED_BOUNDARY_CACHE_SIZE = 4
+
+
+def _packed_boundaries(cu_seqlens_q: torch.Tensor, cu_seqlens_kv: torch.Tensor) -> List[int]:
+    """Read the packed-sequence boundaries to the host once per microbatch.
+
+    ``forward`` validates the boundaries in every GDN layer, and again in the
+    recompute pass. Each read of a device tensor is a pipeline drain -- the copy
+    is queued behind every kernel already issued, so it waits for all of them --
+    so a six-layer stack pays six full device syncs for a vector that does not
+    change. The cache is keyed on tensor identity plus ``_version`` (a recycled
+    ``id()`` or an in-place edit can then never return a stale list) and keeps
+    its inputs referenced for as long as the entry lives.
+    """
+    key = (id(cu_seqlens_q), cu_seqlens_q._version, id(cu_seqlens_kv), cu_seqlens_kv._version)
+    entry = _PACKED_BOUNDARY_CACHE.get(key)
+    if entry is not None:
+        _PACKED_BOUNDARY_CACHE.move_to_end(key)
+        return entry[1]
+
+    q_list = cu_seqlens_q.tolist()
+    kv_list = cu_seqlens_kv.tolist()
+    assert q_list == kv_list, (
+        "Currently only support cu_seqlens_q equals cu_seqlens_kv, "
+        f"but got {q_list=} and {kv_list=}"
+    )
+    _PACKED_BOUNDARY_CACHE[key] = ((cu_seqlens_q, cu_seqlens_kv), q_list)
+    while len(_PACKED_BOUNDARY_CACHE) > _PACKED_BOUNDARY_CACHE_SIZE:
+        _PACKED_BOUNDARY_CACHE.popitem(last=False)
+    return q_list
+
+
+def naive_l2norm(x: torch.FloatTensor, dim: int = -1, eps: float = 1e-6):
+    """This function is intended to align with the l2norm implementation in the FLA library."""
+    original_dtype = x.dtype
+    inv_norm = torch.rsqrt((x * x).sum(dim=dim, keepdim=True) + eps)
+    # Counteract verl's autocast promotion (bf16 -> fp32) by restoring original dtype
+    return (x * inv_norm).to(original_dtype)
+
+
+class GatedDeltaNet(MegatronModule):
+    """Gated Delta Net (GDN) layer class
+
+    GDN layer takes input with size [s, b, h]
+    and returns output of the same size.
+
+    Copied from ``mindspeed_bridge/models/qwen_vl/modelling_qwen3_vl/gated_delta_net.py``
+    (NPU-adapted, itself derived from ``megatron.core.ssm.gated_delta_net``).
+    Do not confuse it with ``megatron.core.ssm.gated_delta_net.GatedDeltaNet``:
+    this one adds the Ascend torch-conv fallback, the ``MINDSPEED_BRIDGE_GDN_*``
+    backend switches and the context-parallel all-to-all helpers, and it expects
+    the flat ``[Q | K | V | Z | B | A]`` ``in_proj`` layout.
+    """
+
+    def __init__(
+        self,
+        config: TransformerConfig,
+        submodules: GatedDeltaNetSubmodules,
+        layer_number: int = None,
+        bias: bool = False,
+        conv_bias: bool = False,
+        conv_init: Optional[float] = None,
+        use_qk_l2norm: bool = True,
+        A_init_range: Tuple[float, float] = (1, 16),
+        pg_collection: ProcessGroupCollection = None,
+        **kwargs,
+    ):
+        """
+        Args:
+            config: The config of the model.
+            submodules: Contains the module specs for the input and output linear layers.
+            layer_number: The layer number of this GDN layer.
+            bias: Whether to use bias in the linear layers.
+            conv_bias: Whether to use bias in the causal convolution.
+            conv_init: The initialization range for the causal convolution weights.
+            use_qk_l2norm: Whether to use L2 normalization in the kernel of the gated delta rule.
+            A_init_range: The initialization range for the attention weights.
+            pg_collection: The required process groups to use for tensor model parallel and context
+                parallel.
+        """
+
+        super().__init__(config)
+
+        # Attributes from arguments
+        self.layer_number = layer_number
+        self.bias = bias
+        self.conv_bias = conv_bias
+        self.conv_init = conv_init
+        assert A_init_range[0] >= 0 and A_init_range[1] >= A_init_range[0]
+        self.A_init_range = A_init_range
+        self.use_qk_l2norm = use_qk_l2norm
+        assert pg_collection is not None, "pg_collection must be provided for GatedDeltaNet"
+        self.pg_collection = pg_collection
+        self.cp_size = self.pg_collection.cp.size()
+        self.tp_size = self.pg_collection.tp.size()
+        self.sp_size = self.tp_size if config.sequence_parallel else 1
+
+        # Attributes from config
+        self.config = config
+        self.hidden_size = config.hidden_size
+        self.act_fn = config.activation_func
+        self.activation = self.act_fn.__name__
+        self.conv_kernel_dim = config.linear_conv_kernel_dim
+        self.key_head_dim = config.linear_key_head_dim
+        self.value_head_dim = config.linear_value_head_dim
+        self.num_key_heads = config.linear_num_key_heads
+        self.num_value_heads = config.linear_num_value_heads
+        self.qk_dim = self.key_head_dim * self.num_key_heads
+        self.v_dim = self.value_head_dim * self.num_value_heads
+        self.qk_dim_local_tp = self.qk_dim // self.tp_size
+        self.v_dim_local_tp = self.v_dim // self.tp_size
+        # Recipes set these two flags, but the backend is picked with
+        # MINDSPEED_BRIDGE_GDN_BACKEND; keep them for parity with the Qwen3.5-VL layer.
+        self.use_triton_gdn = getattr(config, "use_triton_gdn", False)
+        self.use_ascend_gdn = getattr(config, "use_ascend_gdn", False)
+
+        # Input projection (hidden_states -> q, k, v, gate, beta, alpha)
+        # Flat layout, see the module docstring: [Q | K | V | Z | B | A].
+        self.in_proj_dim = self.qk_dim * 2 + self.v_dim * 2 + self.num_value_heads * 2
+        if self.config.fp8:
+            fp8_align_size = get_fp8_align_size(self.config.fp8_recipe)
+            assert self.in_proj_dim % fp8_align_size == 0, (
+                "For FP8, the innermost dimension of the GDN layer "
+                "input projection output tensor must be a multiple of 16."
+            )
+        self.in_proj = build_module(
+            submodules.in_proj,
+            self.hidden_size,
+            self.in_proj_dim,
+            config=self.config,
+            init_method=self.config.init_method,
+            gather_output=False,
+            bias=bias,
+            skip_bias_add=False,
+            is_expert=False,
+            tp_comm_buffer_name="fc1",
+            tp_group=self.pg_collection.tp,
+        )
+
+        # Conv1d for QKV
+        self.conv_dim = self.qk_dim * 2 + self.v_dim
+        self.conv_dim_local_tp = self.conv_dim // self.tp_size
+
+        # weight shape: [conv_dim, 1, d_conv]
+        # bias shape: [conv_dim]
+        self.conv1d = nn.Conv1d(
+            in_channels=self.conv_dim_local_tp,
+            out_channels=self.conv_dim_local_tp,
+            bias=conv_bias,
+            kernel_size=self.conv_kernel_dim,
+            groups=self.conv_dim_local_tp,
+            padding=self.conv_kernel_dim - 1,
+            device=torch.cuda.current_device(),
+            dtype=config.params_dtype,
+        )
+        setattr(self.conv1d.weight, "tensor_model_parallel", True)
+        if conv_bias:
+            setattr(self.conv1d.bias, "tensor_model_parallel", True)
+
+        # Time step projection (discretization)
+        self.num_v_heads_local_tp = self.num_value_heads // self.tp_size
+        # dt_bias parameter
+        self.dt_bias = nn.Parameter(
+            torch.empty(
+                self.num_v_heads_local_tp,
+                dtype=config.params_dtype,
+                device=torch.cuda.current_device(),
+            )
+        )
+        setattr(self.dt_bias, "tensor_model_parallel", True)
+        # A_log parameter
+        self.A_log = nn.Parameter(
+            torch.empty(
+                self.num_v_heads_local_tp,
+                dtype=config.params_dtype,
+                device=torch.cuda.current_device(),
+            )
+        )
+        setattr(self.A_log, "tensor_model_parallel", True)
+
+        gdn_backend = os.environ.get("MINDSPEED_BRIDGE_GDN_BACKEND", "triton").strip().lower()
+        if gdn_backend == "triton":
+            if chunk_gated_delta_rule is None:
+                # Do not silently install a `None` rule: degrade to the torch
+                # implementation instead of crashing on the first forward.
+                warnings.warn(
+                    "MINDSPEED_BRIDGE_GDN_BACKEND=triton but the mindspeed_ops triton "
+                    "chunk_gated_delta_rule is unavailable; falling back to the torch "
+                    "implementation."
+                )
+            self.gated_delta_rule = chunk_gated_delta_rule or _torch_gated_delta_rule
+        elif gdn_backend == "ascendc":
+            # The AscendC kernel is not vendored in this package (it is the one
+            # piece that still lives in the Qwen3.5-VL plugin and it additionally
+            # needs `fla_npu`). Imported lazily so the default backend keeps no
+            # dependency on that plugin.
+            from mindspeed_bridge.models.qwen_vl.modelling_qwen3_vl.flash_gated_delta_rule import (
+                flash_gated_delta_rule,
+            )
+
+            self.gated_delta_rule = flash_gated_delta_rule
+        else:
+            self.gated_delta_rule = _torch_gated_delta_rule
+
+        # Output layernorm before projection
+        self.out_norm = build_module(
+            submodules.out_norm,
+            config=self.config,
+            hidden_size=self.value_head_dim,
+            eps=self.config.layernorm_epsilon,
+        )
+
+        self.out_proj = build_module(
+            submodules.out_proj,
+            self.v_dim,
+            self.hidden_size,
+            config=self.config,
+            init_method=self.config.output_layer_init_method,
+            bias=bias,
+            input_is_parallel=True,
+            skip_bias_add=True,
+            is_expert=False,
+            tp_comm_buffer_name="fc2",
+            tp_group=self.pg_collection.tp,
+        )
+
+        self.reset_parameters()
+
+    def reset_parameters(self):
+        """Reset the parameters."""
+        if self.config.perform_initialization:
+            with get_cuda_rng_tracker().fork():
+                # conv1d.weight
+                if self.conv_init is not None:
+                    nn.init.uniform_(self.conv1d.weight, -self.conv_init, self.conv_init)
+                # dt_bias
+                torch.ones(
+                    self.num_v_heads_local_tp,
+                    out=self.dt_bias.data,
+                    dtype=self.config.params_dtype,
+                    device=torch.cuda.current_device(),
+                )
+                # A_log
+                A = torch.empty(
+                    self.num_v_heads_local_tp,
+                    dtype=self.config.params_dtype,
+                    device=torch.cuda.current_device(),
+                ).uniform_(*self.A_init_range)
+                self.A_log.data.copy_(torch.log(A))
+
+    def forward(
+        self,
+        hidden_states: Tensor,
+        attention_mask: Tensor,
+        inference_context: Optional[BaseInferenceContext] = None,
+        packed_seq_params: Optional[PackedSeqParams] = None,
+        sequence_len_offset: Optional[int] = None,
+        *,
+        inference_params: Optional[BaseInferenceContext] = None,
+        **kwargs,
+    ):
+        """
+        Perform a forward pass through the GDN module.
+
+        Args:
+            hidden_states (Tensor): Hidden states.
+            attention_mask (Tensor): Attention mask.
+            inference_context (Optional[BaseInferenceContext]): Inference context that manages
+                KV cache.
+            packed_seq_params (Optional[PackedSeqparams]): Parameters used for THD format.
+            sequence_len_offset (Optional[int]): Sequence length offset used for
+                inference CUDA graphs.
+
+        Return:
+            (Tuple[Tensor, Tensor]) GDN output and bias.
+
+        """
+        inference_context = deprecate_inference_params(inference_context, inference_params)
+
+        seq_len, batch, _ = hidden_states.shape
+        seq_len = seq_len * self.sp_size * self.cp_size
+
+        if inference_context is not None:
+            assert inference_context.is_static_batching(), "GDN does not currently support dynamic inference batching."
+            assert not self.config.sequence_parallel
+            raise NotImplementedError("GDN does not support inference for now.")
+
+        if packed_seq_params is not None:
+            assert batch == 1, "Packed sequence expects batch dimension to be 1"
+            assert not self.config.deterministic_mode, "Packed sequence does not support deterministic mode."
+
+            # Prefer cu_seqlens_q_padded if available, otherwise use cu_seqlens_q
+            if packed_seq_params.cu_seqlens_q_padded is not None:
+                cu_seqlens_q = packed_seq_params.cu_seqlens_q_padded
+            else:
+                cu_seqlens_q = packed_seq_params.cu_seqlens_q
+            # Prefer cu_seqlens_kv_padded if available, otherwise use cu_seqlens_kv
+            if packed_seq_params.cu_seqlens_kv_padded is not None:
+                cu_seqlens_kv = packed_seq_params.cu_seqlens_kv_padded
+            else:
+                cu_seqlens_kv = packed_seq_params.cu_seqlens_kv
+            # One host round trip for the boundaries, reused by everything below.
+            # Every naive read of them is a device sync: indexing a 1-D device
+            # tensor yields a 0-dim tensor, so `int(t)`, `t[i].item()` and even
+            # using a 0-dim tensor as a slice bound all go through
+            # aten::_local_scalar_dense, and `torch.equal` is a device-side
+            # reduction whose result has to be pulled back as a bool. Reading the
+            # whole vector once with `.tolist()` costs a single sync; the loop
+            # below then splits purely on the host.
+            cu_seqlens_q_list = _packed_boundaries(cu_seqlens_q, cu_seqlens_kv)
+            num_packed_seqs = len(cu_seqlens_q_list) - 1
+            assert num_packed_seqs > 0, (
+                f"Number of packed sequences must be greater than 0, but got {cu_seqlens_q_list=} and {cu_seqlens_kv=}"
+            )
+            # `seq_len` is the length of the *unpacked* sequence, because the
+            # column-parallel `in_proj` all-gathers a sequence-parallel input
+            # back to the full pack. The packed boundaries have to agree with
+            # that, otherwise every reshape below silently reads the wrong
+            # number of heads out of a flat tensor.
+            packed_len = cu_seqlens_q_list[-1]
+            # Boundaries scaled the way the column-parallel layout needs them:
+            # the CP > 1 path splits the *scattered* sequence, so it uses
+            # cu_seqlens // cp_size. At cp_size == 1 the two are identical, which
+            # is the only configuration this recipe runs.
+            cu_seqlens_q_split = (
+                cu_seqlens_q_list
+                if self.cp_size == 1
+                else [bound // self.cp_size for bound in cu_seqlens_q_list]
+            )
+            assert seq_len == packed_len, (
+                f"GDN got {hidden_states.shape[0]} tokens on this rank, which with sp_size="
+                f"{self.sp_size} and cp_size={self.cp_size} means a {seq_len}-token sequence, but the packed "
+                f"boundaries cover {packed_len}. A sequence-parallel layer must be fed the scattered layout, "
+                "so this means the input is laid out differently from what the rest of the model assumes."
+            )
+        else:
+            cu_seqlens_q = None
+            cu_seqlens_kv = None
+
+        # Input projection
+        nvtx_range_push(suffix="in_proj")
+        qkvzba, _ = self.in_proj(hidden_states)
+        nvtx_range_pop(suffix="in_proj")
+
+        if packed_seq_params is not None:
+            unpacked_qkvzba = self._unpack_sequence(qkvzba, cu_seqlens_q_split, dim=0)
+            outputs = []
+            for qkvzba_i in unpacked_qkvzba:
+                qkvzba_i = tensor_a2a_cp2hp(
+                    qkvzba_i,
+                    seq_dim=0,
+                    head_dim=-1,
+                    cp_group=self.pg_collection.cp,
+                    split_sections=[
+                        self.qk_dim_local_tp,
+                        self.qk_dim_local_tp,
+                        self.v_dim_local_tp,
+                        self.v_dim_local_tp,
+                        self.num_value_heads // self.tp_size,
+                        self.num_value_heads // self.tp_size,
+                    ],
+                )
+                outputs.append(qkvzba_i)
+            qkvzba = torch.cat(outputs, dim=0)
+        else:
+            qkvzba = tensor_a2a_cp2hp(
+                qkvzba,
+                seq_dim=0,
+                head_dim=-1,
+                cp_group=self.pg_collection.cp,
+                split_sections=[
+                    self.qk_dim_local_tp,
+                    self.qk_dim_local_tp,
+                    self.v_dim_local_tp,
+                    self.v_dim_local_tp,
+                    self.num_value_heads // self.tp_size,
+                    self.num_value_heads // self.tp_size,
+                ],
+            )
+
+        # Transpose: s b x --> b s x
+        # From sbhd to bshd format
+        qkvzba = qkvzba.transpose(0, 1)
+
+        # Split, reorder, and reshape the tensor into q, k, v, gate, beta, alpha
+        qkv, gate, beta, alpha = torch.split(
+            qkvzba,
+            [
+                (self.qk_dim_local_tp * 2 + self.v_dim_local_tp) // self.cp_size,
+                self.v_dim_local_tp // self.cp_size,
+                self.num_value_heads // self.tp_size // self.cp_size,
+                self.num_value_heads // self.tp_size // self.cp_size,
+            ],
+            dim=-1,
+        )
+        gate = gate.reshape(batch, seq_len, -1, self.value_head_dim)
+        beta = beta.reshape(batch, seq_len, -1)
+        alpha = alpha.reshape(batch, seq_len, -1)
+
+        # Convolution on qkv
+        nvtx_range_push(suffix="conv1d")
+        seq_len = qkv.shape[1]
+        qkv_channels_split_sections = [
+            self.qk_dim_local_tp,
+            self.qk_dim_local_tp,
+            self.v_dim_local_tp,
+        ]
+        conv1d_weight = get_parameter_local_cp(
+            self.conv1d.weight,
+            dim=0,
+            cp_group=self.pg_collection.cp,
+            split_sections=qkv_channels_split_sections,
+        )
+        conv1d_bias = (
+            get_parameter_local_cp(
+                self.conv1d.bias,
+                dim=0,
+                cp_group=self.pg_collection.cp,
+                split_sections=qkv_channels_split_sections,
+            )
+            if self.conv_bias
+            else None
+        )
+
+        if (causal_conv1d is None) or self.config.deterministic_mode:
+            if packed_seq_params is not None:
+                # Packed sequence: process each sequence separately with for loop.
+                # Boundaries come from the single `.tolist()` read at the top of
+                # this method -- re-reading them here would be a second sync.
+                num_seqs = len(cu_seqlens_q_list) - 1
+                qkv_out_list = []
+
+                for i in range(num_seqs):
+                    start_idx = cu_seqlens_q_list[i]
+                    end_idx = cu_seqlens_q_list[i + 1]
+                    seq_len_i = end_idx - start_idx
+
+                    # Extract this sequence: [b, seq_len_i, d] -> [b, d, seq_len_i]
+                    qkv_i = qkv[:, start_idx:end_idx, :].transpose(1, 2).contiguous()
+
+                    # Apply conv1d
+                    conv_out_i = F.conv1d(
+                        input=qkv_i,
+                        weight=conv1d_weight,
+                        bias=conv1d_bias,
+                        stride=self.conv1d.stride,
+                        padding=self.conv1d.padding,
+                        dilation=self.conv1d.dilation,
+                        groups=self.conv_dim_local_tp // self.cp_size,
+                    )
+
+                    # Apply activation and truncate
+                    qkv_i = self.act_fn(conv_out_i[..., :seq_len_i])
+                    qkv_i = qkv_i.transpose(1, 2)  # [b, seq_len_i, d]
+                    qkv_out_list.append(qkv_i)
+
+                # Concatenate all sequences back
+                qkv = torch.cat(qkv_out_list, dim=1)
+            else:
+                qkv = qkv.transpose(1, 2).contiguous()  # b, s, d -> b, d, s
+                conv_out = F.conv1d(
+                    input=qkv,
+                    weight=conv1d_weight,
+                    bias=conv1d_bias,
+                    stride=self.conv1d.stride,
+                    padding=self.conv1d.padding,
+                    dilation=self.conv1d.dilation,
+                    groups=self.conv_dim_local_tp // self.cp_size,
+                )
+                qkv = self.act_fn(conv_out[..., :seq_len])
+                qkv = qkv.transpose(1, 2)  # b, d, s -> b, s, d
+        else:
+            assert self.activation in ["silu", "swish"]
+            qkv, _ = causal_conv1d(
+                x=qkv,  # FLA conv1d accepts [b, s, d] format input
+                weight=conv1d_weight.squeeze(1),  # d, 1, w -> d, w
+                bias=conv1d_bias,
+                activation=self.activation,
+                initial_state=None,
+                output_final_state=False,
+                cu_seqlens=cu_seqlens_q,
+            )
+        nvtx_range_pop(suffix="conv1d")
+
+        # Prepare QKV tensors (split, reshape, L2 norm, repeat_interleave, contiguous)
+        nvtx_range_push(suffix="prepare_qkv_for_gated_delta_rule")
+        query, key, value, gate, beta, alpha = self._prepare_qkv_for_gated_delta_rule(
+            qkv, gate, beta, alpha, batch, seq_len
+        )
+        nvtx_range_pop(suffix="prepare_qkv_for_gated_delta_rule")
+
+        # Calculate g and beta
+        nvtx_range_push(suffix="g_and_beta")
+        A_log_local_cp = get_parameter_local_cp(self.A_log, dim=0, cp_group=self.pg_collection.cp)
+        dt_bias_local_cp = get_parameter_local_cp(self.dt_bias, dim=0, cp_group=self.pg_collection.cp)
+        g, beta = self._compute_g_and_beta(A_log_local_cp, dt_bias_local_cp, alpha, beta)
+        nvtx_range_pop(suffix="g_and_beta")
+
+        nvtx_range_push(suffix="gated_delta_rule")
+        core_attn_out, last_recurrent_state = self.gated_delta_rule(
+            query,
+            key,
+            value,
+            g=g,
+            beta=beta,
+            initial_state=None,
+            output_final_state=False,
+            use_qk_l2norm_in_kernel=False,
+            cu_seqlens=cu_seqlens_q,
+        )
+        nvtx_range_pop(suffix="gated_delta_rule")
+
+        # RMSNorm
+        nvtx_range_push(suffix="gated_norm")
+        norm_out = self._apply_gated_norm(core_attn_out, gate)
+        nvtx_range_pop(suffix="gated_norm")
+
+        # Transpose: b s x --> s b x
+        # From bshd back to sbhd format
+        norm_out = norm_out.reshape(batch, seq_len, -1)
+        norm_out = norm_out.transpose(0, 1).contiguous()
+
+        # CP all to all: HP to CP
+        # norm_out = tensor_a2a_hp2cp(
+        #     norm_out, seq_dim=0, head_dim=-1, cp_group=self.pg_collection.cp
+        # )
+
+        if packed_seq_params is not None:
+            unpacked_norm_out = self._unpack_sequence(norm_out, cu_seqlens_q_list, dim=0)
+            outputs = []
+            for norm_out_i in unpacked_norm_out:
+                norm_out_i = tensor_a2a_hp2cp(norm_out_i, seq_dim=0, head_dim=-1, cp_group=self.pg_collection.cp)
+                outputs.append(norm_out_i)
+            norm_out = torch.cat(outputs, dim=0)
+        else:
+            norm_out = tensor_a2a_hp2cp(norm_out, seq_dim=0, head_dim=-1, cp_group=self.pg_collection.cp)
+
+        # Output projection
+        nvtx_range_push(suffix="out_proj")
+        out, out_bias = self.out_proj(norm_out)
+        nvtx_range_pop(suffix="out_proj")
+
+        return out, out_bias
+
+    def _unpack_sequence(self, x, cu_seqlens, dim=1):
+        """Split ``x`` at the packed-sequence boundaries along ``dim``.
+
+        ``cu_seqlens`` is either the boundary tensor or an already-materialised
+        sequence of Python ints. Prefer the latter: as a tensor, every boundary
+        costs a device sync (``cu_seqlens[i].item()``, twice per sequence here),
+        whereas ``forward`` reads the vector once and passes the list through.
+        """
+        if not isinstance(cu_seqlens, (list, tuple)):
+            cu_seqlens = cu_seqlens.tolist()
+        unpacked_x = []
+        for idx_start, idx_end in zip(cu_seqlens[:-1], cu_seqlens[1:]):
+            chunked_index = [slice(None)] * dim + [slice(idx_start, idx_end)]
+            unpacked_x.append(x[tuple(chunked_index)])
+        return unpacked_x
+
+    @jit_fuser
+    def _apply_gated_norm(self, x, gate):
+        # Output Norm
+        x_dtype = x.dtype
+        x = x.reshape(-1, x.shape[-1])
+        y = self.out_norm(x)
+        # Output gate
+        gate = gate.reshape(-1, gate.shape[-1])
+        y = y * self.act_fn(gate.float())
+        y = y.to(x_dtype)
+        return y
+
+    @jit_fuser
+    def _prepare_qkv_for_gated_delta_rule(self, qkv, gate, beta, alpha, batch, seq_len):
+        """
+        Prepare query, key, value, gate, beta, alpha tensors for gated delta rule.
+        Fuses split, reshape, L2 norm, repeat_interleave, and contiguous operations.
+        """
+        # Split qkv into query_key and value
+        query_key, value = torch.split(
+            qkv,
+            [
+                2 * self.qk_dim_local_tp // self.cp_size,
+                self.v_dim_local_tp // self.cp_size,
+            ],
+            dim=-1,
+        )
+
+        # Reshape query_key and value
+        query_key = query_key.reshape(batch, seq_len, -1, self.key_head_dim)
+        value = value.reshape(batch, seq_len, -1, self.value_head_dim)
+
+        # Apply L2 norm to query and key
+        if self.use_qk_l2norm:
+            query_key = naive_l2norm(query_key.contiguous())
+
+        # Split query and key
+        split_size = self.qk_dim_local_tp // self.key_head_dim // self.cp_size
+        query, key = torch.split(query_key, [split_size, split_size], dim=2)
+
+        # Expand query and key if needed (grouped query attention)
+        if self.num_value_heads // self.num_key_heads > 1:
+            repeat_factor = self.num_value_heads // self.num_key_heads
+            query = query.repeat_interleave(repeat_factor, dim=2)
+            key = key.repeat_interleave(repeat_factor, dim=2)
+
+        # Make all tensors contiguous
+        query = query.contiguous()
+        key = key.contiguous()
+        value = value.contiguous()
+        gate = gate.contiguous()
+        beta = beta.contiguous()
+        alpha = alpha.contiguous()
+
+        return query, key, value, gate, beta, alpha
+
+    @jit_fuser
+    def _compute_g_and_beta(self, A_log_local_cp, dt_bias_local_cp, alpha, beta):
+        """
+        Compute g (decay) and beta (sigmoid) for gated delta rule.
+        Fuses exp, softplus, mul, neg, and sigmoid operations.
+        """
+        g = -A_log_local_cp.exp() * F.softplus(alpha.float() + dt_bias_local_cp)  # In fp32
+        beta = beta.sigmoid()
+        return g, beta
+
+    def sharded_state_dict(self, prefix="", sharded_offsets=(), metadata=None, tp_group=None):
+        """Provide a sharded state dictionary for distributed checkpointing."""
+        # Guard for cases metadata is not provided
+        metadata = ensure_metadata_has_dp_cp_group(metadata)
+
+        sharded_state_dict = {}
+        # Parameters
+        self._save_to_state_dict(sharded_state_dict, "", keep_vars=True)
+        sharded_state_dict = make_sharded_tensors_for_checkpoint(
+            sharded_state_dict,
+            prefix,
+            tensor_parallel_layers_axis_map={
+                "A_log": 0,
+                "dt_bias": 0,
+            },  # parameters sharded across TP
+            sharded_offsets=sharded_offsets,
+            tp_group=(tp_group if tp_group is not None else self.pg_collection.tp),
+            dp_cp_group=metadata["dp_cp_group"],
+        )
+        # Submodules
+        tp_group = tp_group if tp_group is not None else self.pg_collection.tp
+        for name, module in self.named_children():
+            if name == "conv1d":
+                # Add TP sharding for Conv1d
+                module_sd = module.state_dict(prefix="", keep_vars=True)
+                tp_sharding_map = {"weight": 0}
+                if self.conv_bias:
+                    tp_sharding_map["bias"] = 0
+                module_sharded_sd = make_sharded_tensors_for_checkpoint(
+                    module_sd,
+                    f"{prefix}{name}.",
+                    tp_sharding_map,
+                    sharded_offsets,
+                    tp_group=tp_group,
+                    dp_cp_group=metadata["dp_cp_group"],
+                )
+            else:
+                module_sharded_sd = sharded_state_dict_default(
+                    module,
+                    f"{prefix}{name}.",
+                    sharded_offsets,
+                    metadata,
+                    tp_group=tp_group,
+                )
+
+            sharded_state_dict.update(module_sharded_sd)
+
+        # At this point the TP sharding is correctly defined for each tensor, but some of the
+        # tensors must be additionally split into separate parts
+        in_proj_dim_local_tp = self.in_proj_dim // self.tp_size
+        assert sharded_state_dict[f"{prefix}in_proj.weight"].data.size(0) == in_proj_dim_local_tp, (
+            in_proj_dim_local_tp,
+            sharded_state_dict[f"{prefix}in_proj.weight"],
+        )
+
+        sharded_state_dict[f"{prefix}in_proj.weight"] = _split_tensor_factory(
+            sharded_state_dict[f"{prefix}in_proj.weight"],
+            [
+                self.qk_dim_local_tp,
+                self.qk_dim_local_tp,
+                self.v_dim_local_tp,
+                self.v_dim_local_tp,
+                self.num_value_heads // self.tp_size,
+                self.num_value_heads // self.tp_size,
+            ],
+            ["query", "key", "value", "z", "beta", "alpha"],
+            0,
+        )
+
+        conv_layer_name_list = ["conv1d.weight"]
+        assert sharded_state_dict[f"{prefix}conv1d.weight"].data.size(0) == self.conv_dim_local_tp, (
+            self.conv_dim_local_tp,
+            sharded_state_dict[f"{prefix}conv1d.weight"],
+        )
+        if self.conv_bias:
+            conv_layer_name_list.append("conv1d.bias")
+            assert sharded_state_dict[f"{prefix}conv1d.bias"].data.size(0) == self.conv_dim_local_tp, (
+                self.conv_dim_local_tp,
+                sharded_state_dict[f"{prefix}conv1d.bias"],
+            )
+        for conv_layer_name in conv_layer_name_list:
+            sharded_state_dict[f"{prefix}{conv_layer_name}"] = _split_tensor_factory(
+                sharded_state_dict[f"{prefix}{conv_layer_name}"],
+                [self.qk_dim_local_tp, self.qk_dim_local_tp, self.v_dim_local_tp],
+                ["query", "key", "value"],
+                0,
+            )
+
+        return sharded_state_dict
+
+    def backward_dw(self):
+        """Execute weight gradient computation for all linear layers."""
+        self._backward_in_proj()
+        self._backward_out_proj()
+
+    def _backward_in_proj(self):
+        """Computes weight gradients of input projection layer."""
+        self.in_proj.backward_dw()
+
+    def _backward_out_proj(self):
+        """Computes weight gradients of output projection layer."""
+        self.out_proj.backward_dw()
+
+
+class Qwen4ExpGDN(GatedDeltaNet):
+    """GDN layer for Qwen3.8-Flash-Next.
+
+    The only behavioural difference from the base layer is the activation of the
+    output gate: upstream uses ``config.activation_func`` for both the conv1d
+    activation and the gated norm, but the conv1d path asserts
+    ``act_fn in ['silu', 'swish']``, so the gate has to be read from
+    ``config.output_gate_type`` (``'sigmoid'`` for this model, matching HF's
+    ``Qwen4ExpTextRMSNormGated(..., activation=config.output_gate_type or
+    config.hidden_act)``). Overriding only this method also avoids the
+    ``@jit_fuser`` decorator of the base, which is not worth compiling for a
+    two-op kernel.
+    """
+
+    def _gate_activation(self):
+        """Resolve the activation applied to the gate of the output norm."""
+        gate_type = getattr(self.config, "output_gate_type", None)
+        if not gate_type:
+            # HF: `config.output_gate_type or config.hidden_act`.
+            gate_type = getattr(self.config, "hidden_act", None) or self.activation
+        if gate_type == "sigmoid":
+            return torch.sigmoid
+        if gate_type in ("silu", "swish"):
+            return F.silu
+        raise NotImplementedError(f"Unsupported GDN output gate activation: {gate_type!r}")
+
+    def _apply_gated_norm(self, x, gate):
+        x_dtype = x.dtype
+        x = x.reshape(-1, x.shape[-1])
+        y = self.out_norm(x)
+        gate = gate.reshape(-1, gate.shape[-1])
+        gate_act = self._gate_activation()
+        y = y * gate_act(gate.float())
+        return y.to(x_dtype)
+
+
+def get_qwen4_exp_gdn_spec(config: TransformerConfig, backend=None) -> ModuleSpec:
+    """Build the module spec of the Gated Delta Net layer.
+
+    Args:
+        config: Transformer configuration.
+        backend: Backend spec provider. When ``None`` the provider for
+            ``config.transformer_impl`` is used (Megatron's
+            ``_get_backend_spec_provider``).
+
+    Returns:
+        ModuleSpec for :class:`Qwen4ExpGDN`. ``in_proj`` is a plain
+        column-parallel linear *without* a fused input layernorm
+        (``fuse_input_layernorm=False``): this model has no per-layer
+        layernorms, the hyper-connection norms replace them.
+    """
+    if backend is None:
+        # Imported lazily so that the backend provider (and through it the TE
+        # extension classes, which MindSpeed patches to Ascend implementations)
+        # is resolved when the model is built, not when this module is imported.
+        from megatron.core.models.gpt.experimental_attention_variant_module_specs import (
+            _get_backend_spec_provider,
+        )
+
+        backend = _get_backend_spec_provider(config=config)
+
+    rms_norm = config.normalization == "RMSNorm"
+    return ModuleSpec(
+        module=Qwen4ExpGDN,
+        submodules=GatedDeltaNetSubmodules(
+            in_proj=backend.column_parallel_linear(),
+            out_norm=backend.layer_norm(rms_norm=rms_norm, for_qk=False),
+            out_proj=backend.row_parallel_linear(),
+        ),
+        metainfo={"fuse_input_layernorm": False},
+    )
+
+
+def fix_gdn_out_norm_zero_centered(layers) -> int:
+    """Opt the GDN output norms out of ``layernorm_zero_centered_gamma``.
+
+    The checkpoint stores ones-style ``RMSNormGated`` weights (``w = 1``), while
+    ``layernorm_zero_centered_gamma`` computes ``(1 + w)``. On Ascend the flag is
+    read from ``out_norm.config.layernorm_zero_centered_gamma`` and that config
+    is the *shared* ``TransformerConfig``, so it must be copied before flipping
+    the flag (the hyper-connection norms of this model stay zero-centered). On a
+    TE backend the module also carries a ``zero_centered_gamma`` attribute, which
+    is set as well so checkpoint conversion sees the same value.
+
+    Args:
+        layers: Iterable of decoder layers (``model.decoder.layers``).
+
+    Returns:
+        Number of GDN layers whose output norm was patched.
+    """
+    patched = 0
+    for layer in layers:
+        self_attention = getattr(layer, "self_attention", None)
+        out_norm = getattr(self_attention, "out_norm", None)
+        if out_norm is None:
+            # Full-attention (QSA) layers have no GDN output norm.
+            continue
+        out_norm.zero_centered_gamma = False
+        config = getattr(out_norm, "config", None)
+        if config is not None:
+            # Never mutate the shared config in place.
+            out_norm.config = copy.copy(config)
+            out_norm.config.layernorm_zero_centered_gamma = False
+        patched += 1
+    return patched
+
