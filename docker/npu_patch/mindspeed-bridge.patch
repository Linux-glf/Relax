+++ b/mindspeed_bridge/features/megatron/common/gdn_packed_seq_host_cache.py
@@ -0,0 +1,111 @@
+# Copyright (c) 2026, HUAWEI CORPORATION. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Host-side caching for the GDN packed-sequence context-parallel path.
+
+``_GDNBase._resolve_cu_seqlens`` and ``_build_thd_cp_a2a_perm`` are pure
+functions of tensors that the model builds once per microbatch and then hands to
+every GDN layer.  Upstream re-runs them per layer anyway: the validation costs
+three host synchronisations per call and the permutation launches about ten tiny
+indexing kernels, which a Qwen3.5-style hybrid stack repeats 24 times per
+forward pass.  On the host-bound forward phases (log-probs, reference
+log-probs) that lands directly in the step time, so the wrappers below memoize
+both results.
+
+The caches are keyed on tensor identity together with ``Tensor._version`` and
+keep the tensors they are keyed on alive, so neither a recycled ``id()`` nor an
+in-place update can produce a stale hit, while a new microbatch (new tensors)
+always recomputes.  Cached values are handed out as-is: ``_resolve_cu_seqlens``
+returns one of its inputs, and the permutation tensors are only consumed by
+``index_select``.
+"""
+
+from __future__ import annotations
+
+from collections import OrderedDict
+from typing import Any
+
+import torch
+
+# Two keys per microbatch (cu_seqlens_q / cu_seqlens_kv) plus one for the
+# permutation; the forward pass of a layer is re-run under recompute with the
+# very same tensors, so a small cache already turns every repeat into a hit.
+_CACHE_MAXSIZE = 4
+
+
+def _identity(value: Any) -> Any:
+    """Return a hashable identity key for one argument.
+
+    Tensors are keyed by object identity plus their mutation counter; nested
+    containers are keyed element-wise.  Values that are not tensors are used
+    directly, which makes the key equal only for equal scalars.
+    """
+    if isinstance(value, torch.Tensor):
+        return (id(value), value._version)
+    if isinstance(value, (list, tuple)):
+        return tuple(_identity(item) for item in value)
+    if isinstance(value, dict):
+        return tuple((key, _identity(item)) for key, item in value.items())
+    return value
+
+
+def _remember(cache: OrderedDict, key: Any, entry: Any) -> None:
+    """Insert one entry into ``cache`` and drop the least recently used one."""
+    cache[key] = entry
+    cache.move_to_end(key)
+    while len(cache) > _CACHE_MAXSIZE:
+        cache.popitem(last=False)
+
+
+def gdn_resolve_cu_seqlens_wrapper(original):
+    """Memoize ``_GDNBase._resolve_cu_seqlens`` for the repeated packed-sequence validation.
+
+    The upstream body only checks ``cu_seqlens`` against ``total_seq_len`` and
+    ``cp_size`` and returns the tensor it was given, so caching on those
+    arguments is exact.  ``name`` is deliberately not part of the key: the
+    upstream signature (positional ``cu_seqlens_padded``, ``cu_seqlens_actual``,
+    ``total_seq_len``, ``name``, keyword ``cp_size``) uses it for the error
+    message alone, and failures are never cached.
+    """
+    cache: OrderedDict = OrderedDict()
+
+    def patched_resolve_cu_seqlens(self, cu_seqlens_padded, cu_seqlens_actual, total_seq_len, name, cp_size=1):
+        key = (_identity(cu_seqlens_padded), _identity(cu_seqlens_actual), total_seq_len, cp_size)
+        entry = cache.get(key)
+        if entry is not None:
+            cache.move_to_end(key)
+            return entry[1]
+
+        resolved = original(self, cu_seqlens_padded, cu_seqlens_actual, total_seq_len, name, cp_size)
+        # Keep both inputs referenced: identity keys are only safe while the
+        # objects they were built from cannot be collected and their id reused.
+        _remember(cache, key, ((cu_seqlens_padded, cu_seqlens_actual), resolved))
+        return resolved
+
+    return patched_resolve_cu_seqlens
+
+
+def gdn_thd_cp_a2a_perm_wrapper(original):
+    """Memoize ``_build_thd_cp_a2a_perm`` for the repeated per-layer CP permutation.
+
+    Every layer rebuilds the same sequence-dimension permutation from the same
+    ``cu_seqlens`` and re-allocates the same two index tensors.  Callers only
+    feed the result to ``index_select``, so sharing the cached pair is safe.
+    """
+    cache: OrderedDict = OrderedDict()
+
+    def patched_build_thd_cp_a2a_perm(cu_seqlens, cp_size, t_global):
+        key = (_identity(cu_seqlens), cp_size, t_global)
+        entry = cache.get(key)
+        if entry is not None:
+            cache.move_to_end(key)
+            return entry[1]
+
+        perm = original(cu_seqlens, cp_size, t_global)
+        _remember(cache, key, (cu_seqlens, perm))
+        return perm
+
+    return patched_build_thd_cp_a2a_perm
+
+
+__all__ = ["gdn_resolve_cu_seqlens_wrapper", "gdn_thd_cp_a2a_perm_wrapper"]
