index 0000000..35a95c2
--- /dev/null
+++ b/mindspeed_bridge/features/megatron/common/gdn_cp_a2a_fast_perm.py
@@ -0,0 +1,133 @@
+# Copyright (c) 2026, HUAWEI CORPORATION. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0.
+"""Apply the GDN context-parallel head permutation without a dim-2 IndexAdd.
+
+``megatron.core.ssm.gated_delta_net.common.a2a_cp_to_hp`` pre-permutes the
+in_proj output along the head dim before the CP-to-HP all-to-all::
+
+    qkvzba = qkvzba.index_select(-1, head_perm)
+
+The gather is cheap (0.10 ms on Ascend 910, bf16, ``[8096, 1, 3088]``, index
+length 3088 = the Qwen3.5 per-TP-rank ``qkvzba`` width).  Its autograd
+backward, ``aten::index_add_(dim=2)``, is not: CANN only dispatches the sorted
+``SortAiCore`` / ``InplaceIndexAddWithSorted`` kernels for ``dim == 0`` and
+otherwise falls back to a per-element kernel, whatever the index dtype is and
+even when the index is sorted::
+
+    index_add_(dim=2, head_perm)      295.99 ms    [8096, 1, 3088] bf16
+    index_add_(dim=2, arange)         295.65 ms    identity index, no better
+    index_add_(dim=0, same volume)      0.17 ms    same element count, dim 0
+    index_select(-1, head_perm)         0.10 ms    the forward gather itself
+
+Production impact (Qwen3.5-9B, TP4/CP4, 16xAscend 910, one ``actor_train``
+window of 938.98 s): 1944 calls x 238.7 ms = 464 s, i.e. 74.7 % of the 621 s of
+kernel time, all of it the autograd backward of that one ``index_select``.
+
+The same permutation written so that the reduction runs along dim 0 keeps every
+value bit for bit (checked with ``torch.equal``) and brings the forward plus
+backward pair down to 0.39 ms::
+
+    qkvzba.transpose(0, -1).index_select(0, head_perm).transpose(0, -1).contiguous()
+
+``transpose`` is a view, so the gather selects exactly the same head-permuted
+elements, while its backward becomes ``index_add_(dim=0)`` on the transposed
+grad -- identical element count, fast kernel.  ``contiguous()`` restores the
+layout upstream hands to the all-to-all.
+
+The permutation happens inside ``a2a_cp_to_hp``, so the wrapper below replays
+that function.  It mirrors the upstream body statement for statement except for
+the head-permutation expression, and resolves ``tensor_a2a_cp2hp``,
+``_build_thd_cp_a2a_perm`` and ``_build_head_perm_for_split_sections`` on
+``megatron.core.ssm.gated_delta_net.common`` at call time, so other patches on
+those entry points (the GDN host cache memoizes the sequence permutation) still
+apply.  Upstream's signature is checked when the patch is installed, and an
+unexpected one disables the wrapper rather than guessing -- the wrapper has to
+be re-checked against upstream whenever that function changes.
+"""
+
+from __future__ import annotations
+
+import inspect
+import logging
+import os
+
+import torch
+
+_LOGGER = logging.getLogger(__name__)
+
+# Set to "0" to keep the upstream implementation; lets a run be measured or
+# reverted without editing the tree.
+_ENABLE_ENV = "MINDSPEED_BRIDGE_GDN_FAST_HEAD_PERM"
+
+# Parameter names of megatron.core.ssm.gated_delta_net.common.a2a_cp_to_hp that
+# this wrapper mirrors. Checked before the patch is installed.
+_UPSTREAM_PARAMETERS = (
+    "qkvzba",
+    "in_proj_split_sections",
+    "cp_size",
+    "cp_group",
+    "cu_seqlens_q",
+    "seq_len",
+    "packed_seq_params",
+)
+
+
+def gdn_head_perm_a2a_wrapper(original):
+    """Reorder the GDN CP head permutation so its backward uses the dim-0 kernel.
+
+    The patched function is upstream's ``a2a_cp_to_hp`` with one statement
+    replaced: the head permutation runs as a dim-0 gather on the transposed
+    view instead of a dim-2 gather, which moves the autograd backward off the
+    slow ``IndexAdd`` kernel.  Calls the wrapper cannot serve -- no context
+    parallelism, a non-3-d ``qkvzba``, no autograd (there is no backward to fix,
+    so the cheaper upstream gather is kept) -- are forwarded to ``original``.
+    ``MINDSPEED_BRIDGE_GDN_FAST_HEAD_PERM=0`` disables the whole wrapper.
+    """
+    if os.environ.get(_ENABLE_ENV, "1") == "0":
+        _LOGGER.info("%s=0; keeping the upstream dim-2 head permutation.", _ENABLE_ENV)
+        return original
+
+    parameters = tuple(inspect.signature(original).parameters)
+    if parameters != _UPSTREAM_PARAMETERS:
+        _LOGGER.warning(
+            "a2a_cp_to_hp has an unexpected signature %s; keeping the upstream implementation, "
+            "whose dim-2 IndexAdd backward stays slow.",
+            parameters,
+        )
+        return original
+
+    _LOGGER.info("installing the GDN CP head permutation as a dim-0 gather (fast IndexAdd backward).")
+
+    def patched_a2a_cp_to_hp(
+        qkvzba, in_proj_split_sections, cp_size, cp_group, cu_seqlens_q, seq_len, packed_seq_params
+    ):
+        if cp_size <= 1 or qkvzba.dim() != 3 or not torch.is_grad_enabled():
+            return original(
+                qkvzba, in_proj_split_sections, cp_size, cp_group, cu_seqlens_q, seq_len, packed_seq_params
+            )
+
+        from megatron.core.ssm.gated_delta_net import common as gdn_common
+
+        head_perm = gdn_common._build_head_perm_for_split_sections(
+            in_proj_split_sections, cp_size, qkvzba.device
+        )
+        # Upstream: qkvzba = qkvzba.index_select(-1, head_perm)
+        qkvzba = qkvzba.transpose(0, -1).index_select(0, head_perm).transpose(0, -1).contiguous()
+
+        thd_cp_a2a_inv = None
+        if packed_seq_params is not None and packed_seq_params.qkv_format == "thd":
+            qkvzba = gdn_common.tensor_a2a_cp2hp(
+                qkvzba, seq_dim=0, head_dim=-1, cp_group=cp_group, undo_attention_load_balancing=False
+            )
+            thd_cp_a2a_idx, thd_cp_a2a_inv = gdn_common._build_thd_cp_a2a_perm(cu_seqlens_q, cp_size, seq_len)
+            qkvzba = qkvzba.index_select(0, thd_cp_a2a_idx)
+        else:
+            qkvzba = gdn_common.tensor_a2a_cp2hp(qkvzba, seq_dim=0, head_dim=-1, cp_group=cp_group)
+
+        return qkvzba, thd_cp_a2a_inv
+
+    return patched_a2a_cp_to_hp
+
+
+__all__ = ["gdn_head_perm_a2a_wrapper"]
