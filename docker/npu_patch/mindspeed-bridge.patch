From c62b8fd631856a9c4d0ecaa09f357d2ccfaad80d Mon Sep 17 00:00:00 2001
From: wuqiwei <wuqiwei4@huawei.com>
Date: Fri, 11 Sep 2026 15:10:45 +0800
Subject: [PATCH] lazypig base line

lazypig base line
---
 mindspeed_bridge/features/adaptor.py          | 19 +++++++++++++---
 .../flash_gated_delta_rule.py                 | 22 ++++++++++++++++++-
 .../modelling_qwen3_vl/gated_delta_net.py     |  5 ++++-
 .../models/qwen_vl/qwen35_vl_provider.py      |  4 ++--
 4 files changed, 43 insertions(+), 7 deletions(-)

diff --git a/mindspeed_bridge/features/adaptor.py b/mindspeed_bridge/features/adaptor.py
index d637ab2..309a6e5 100644
--- a/mindspeed_bridge/features/adaptor.py
+++ b/mindspeed_bridge/features/adaptor.py
@@ -276,8 +276,6 @@ class FeatureAdaptor:
     ) -> None:
         """Internal feature application with optional final validation."""
 
-        from megatron.training.global_vars import set_args
-
         # Always reinstall Bridge's authoritative feature list.
         FeaturesManager.set_features_list(_create_features_list())
 
@@ -285,7 +283,22 @@ class FeatureAdaptor:
         cls._args = args
 
         set_full_args(args)
-        set_args(args)
+
+        # Merge the feature attrs into the framework's already-published
+        # args instead of wholesale-replacing the global: a replace hides
+        # every framework arg (e.g. create_all_gather_group) from later
+        # megatron.training.global_vars.get_args() consumers. In-place
+        # mutation is enough -- the global and the framework's own reference
+        # point at the same Namespace object. When nothing was published yet
+        # (e.g. standalone Bridge usage), publish ours as before.
+        from megatron.training import global_vars as _megatron_global_vars
+
+        existing = _megatron_global_vars._GLOBAL_ARGS
+        if existing is None:
+            _megatron_global_vars.set_args(args)
+        else:
+            for key, value in vars(args).items():
+                setattr(existing, key, value)
 
         if validate:
             FeaturesManager.validate_features_args(args)
diff --git a/mindspeed_bridge/models/qwen_vl/modelling_qwen3_vl/flash_gated_delta_rule.py b/mindspeed_bridge/models/qwen_vl/modelling_qwen3_vl/flash_gated_delta_rule.py
index 8ea5da4..ee1be48 100644
--- a/mindspeed_bridge/models/qwen_vl/modelling_qwen3_vl/flash_gated_delta_rule.py
+++ b/mindspeed_bridge/models/qwen_vl/modelling_qwen3_vl/flash_gated_delta_rule.py
@@ -1,7 +1,7 @@
 # -*- coding: utf-8 -*-
 # Copyright (c) 2026, HUAWEI CORPORATION.  All rights reserved.
 import warnings
-from typing import Optional
+from typing import Any, Optional
 
 import torch
 
@@ -419,6 +419,7 @@ def flash_gated_delta_rule(
     cu_seqlens: Optional[torch.LongTensor] = None,
     chunk_size: int = 64,
     head_first: bool = False,
+    cp_context: Optional[Any] = None,
 ):
     r"""
     Args:
@@ -485,6 +486,25 @@ def flash_gated_delta_rule(
             cu_seqlens=cu_seqlens
         )
     """
+    if cp_context is not None:
+        # Chunkwise context parallelism: the AscendC flash op cannot exchange
+        # chunk states across ranks, so delegate to the FLA CP-aware kernel.
+        from fla.ops.gated_delta_rule import chunk_gated_delta_rule
+
+        return chunk_gated_delta_rule(
+            q,
+            k,
+            v,
+            g,
+            beta,
+            scale=scale,
+            initial_state=initial_state,
+            output_final_state=output_final_state,
+            use_qk_l2norm_in_kernel=use_qk_l2norm_in_kernel,
+            cu_seqlens=cu_seqlens,
+            chunk_size=chunk_size,
+            cp_context=cp_context,
+        )
     if fla_npu is None:
         raise ValueError(
             "fla_npu is not installed. "
diff --git a/mindspeed_bridge/models/qwen_vl/modelling_qwen3_vl/gated_delta_net.py b/mindspeed_bridge/models/qwen_vl/modelling_qwen3_vl/gated_delta_net.py
index 9c78a84..b162641 100644
--- a/mindspeed_bridge/models/qwen_vl/modelling_qwen3_vl/gated_delta_net.py
+++ b/mindspeed_bridge/models/qwen_vl/modelling_qwen3_vl/gated_delta_net.py
@@ -21,18 +21,21 @@ def install_ascend_gdn_patch() -> bool:
         if getattr(config, "use_ascend_gdn", False):
             # Import lazily so checkpoint conversion and non-Ascend environments
             # do not require MindSpeed-Ops or the optional fla_npu extension.
+            print(f"Using AscendC GDN")
             from mindspeed_bridge.models.qwen_vl.modelling_qwen3_vl.flash_gated_delta_rule import (
                 flash_gated_delta_rule,
             )
 
             self.gated_delta_rule = flash_gated_delta_rule
-        elif getattr(config, "use_triton_gdn", False):
+        elif getattr(config, "use_triton_gdn", True):
+            print(f"Using Triton GDN")
             from mindspeed_bridge.models.qwen_vl.modelling_qwen3_vl.chunk_gated_delta_rule import (
                 chunk_gated_delta_rule,
             )
 
             self.gated_delta_rule = chunk_gated_delta_rule
         else:
+            print(f"Using Torch GDN")
             from mindspeed_bridge.models.qwen_vl.modelling_qwen3_vl.chunk_gated_delta_rule import (
                 torch_chunk_gated_delta_rule,
             )
