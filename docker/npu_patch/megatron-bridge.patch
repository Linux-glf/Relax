--- a/src/megatron/bridge/models/conversion/utils.py
+++ b/src/megatron/bridge/models/conversion/utils.py
@@ -231,6 +231,18 @@ def remove_non_pickleables(obj, max_depth: int = 3, current_depth: int = 0):
         ):  # bound methods
             return None
 
+    # OmegaConf containers show up inside module configs (fields declared as
+    # container unions). Walking their ``__dict__`` and assigning the cleaned
+    # values back trips OmegaConf's own validation ("Unions of containers are
+    # not supported"), so hand the recursion plain containers instead.
+    try:
+        from omegaconf import DictConfig, ListConfig, OmegaConf
+
+        if isinstance(obj, (DictConfig, ListConfig)):
+            obj = OmegaConf.to_container(obj, resolve=True)
+    except ImportError:
+        pass
+
     # Handle dataclass/object with attributes
     if hasattr(obj, "__dict__"):
         # Create a copy to avoid modifying the original
@@ -243,7 +255,14 @@ def remove_non_pickleables(obj, max_depth: int = 3, current_depth: int = 0):
             cleaned_value = remove_non_pickleables(attr_value, max_depth, current_depth + 1)
 
             # Set the cleaned value (or None if it was removed)
-            setattr(cleaned_obj, attr_name, cleaned_value)
+            try:
+                setattr(cleaned_obj, attr_name, cleaned_value)
+            except (ValueError, TypeError) as exc:
+                # Structured configs validate values on assignment and can reject the
+                # cleaned container ("Unions of containers are not supported"). The copy
+                # is only broadcast for IPC, so keep the original value in that case.
+                if "Unions of containers" not in str(exc):
+                    raise
 
         return cleaned_obj
 
