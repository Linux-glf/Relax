+def write_back_rows(dst, index, src):
+    """
+    Return a copy of dst whose rows at index are replaced by src along dim 0.
+
+    index_copy lowers to an IndexCopy_ScatterUpdate task whose cost is bound by
+    the number of rows written, while clone + index_put_ moves the same volume
+    ~2.5x faster on 910.  Both are pure data movement with unique indices, so the
+    result is bit-identical.  Set TENPU_RING_FAST_WRITE_BACK=0 to restore
+    index_copy.
+    """
+    if os.environ.get(_FAST_WRITE_BACK_ENV, '1') == '0':
+        return dst.index_copy(0, index, src)
+    return dst.clone().index_put_((index,), src)
+
