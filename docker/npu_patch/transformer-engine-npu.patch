+def _reorder_thd_blocks(tensor, cu_seqlens, cp_size: int, reverse: bool = False):
+    """Reorder packed THD chunks between Ulysses gathered and natural order.
+
+    ``slice_with_cp`` stores, for every sample, chunk ``rank`` followed by
+    chunk ``2 * cp_size - 1 - rank`` on rank ``rank``.  Ulysses gathers the
+    rank-local tensors in rank order, with every sample nested inside each
+    rank; that is not the natural packed order.  ``reverse=False`` maps the
+    gathered layout to natural order before FlashAttention, and
+    ``reverse=True`` maps the natural-order attention output back to the
+    gathered layout expected by the output all-to-all.
+    """
+    if cp_size <= 1 or tensor.shape[0] == 0:
+        return tensor
+    if not isinstance(cu_seqlens, (list, tuple)):
+        cu_seqlens = cu_seqlens.tolist()
+    if tensor.shape[0] % cp_size:
+        raise ValueError(f"THD token count {tensor.shape[0]} is not divisible by cp_size={cp_size}")
+
+    local_cu = [boundary // cp_size for boundary in cu_seqlens]
+    rank_stride = tensor.shape[0] // cp_size
+    indices = []
+
+    if not reverse:
+        # Natural order (sample, chunk) -> position in the rank-major gathered tensor.
+        for sample in range(len(cu_seqlens) - 1):
+            seq_len = cu_seqlens[sample + 1] - cu_seqlens[sample]
+            if seq_len == 0:
+                continue
+            chunk_size = seq_len // (2 * cp_size)
+            if chunk_size * 2 * cp_size != seq_len:
+                raise ValueError(
+                    f"THD sequence length {seq_len} is not divisible by 2 * cp_size = {2 * cp_size}"
+                )
+            local_start = local_cu[sample]
+            for chunk_id in range(2 * cp_size):
+                if chunk_id < cp_size:
+                    rank, part = chunk_id, 0
+                else:
+                    rank, part = 2 * cp_size - 1 - chunk_id, 1
+                source = rank * rank_stride + local_start + part * chunk_size
+                indices.extend(range(source, source + chunk_size))
+    else:
+        # Rank-major gathered order -> position in the natural-order attention output.
+        for rank in range(cp_size):
+            for sample in range(len(cu_seqlens) - 1):
+                seq_len = cu_seqlens[sample + 1] - cu_seqlens[sample]
+                if seq_len == 0:
+                    continue
+                chunk_size = seq_len // (2 * cp_size)
+                if chunk_size * 2 * cp_size != seq_len:
+                    raise ValueError(
+                        f"THD sequence length {seq_len} is not divisible by 2 * cp_size = {2 * cp_size}"
+                    )
+                natural_start = cu_seqlens[sample]
+                for chunk_id in (rank, 2 * cp_size - 1 - rank):
+                    source = natural_start + chunk_id * chunk_size
+                    indices.extend(range(source, source + chunk_size))
+
+    if len(indices) != tensor.shape[0]:
+        raise ValueError(
+            f"THD reorder length mismatch: {len(indices)} indices for {tensor.shape[0]} tokens"
+        )
+    index = torch.tensor(indices, dtype=torch.long, device=tensor.device)
+    return tensor.index_select(0, index)
+
+
