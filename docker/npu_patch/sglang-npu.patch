     ) -> torch.Tensor:
-        return fused_sigmoid_gating_delta_rule_update(
+        # _gdn_decode_update 在 import 期按 env 绑定（三选一）；kwargs 签名三方
+        # 全对齐。target_verify 传扩展参数、不经过本方法，不受影响。
+        return _gdn_decode_update(
             A_log=A_log,
