+    SGLANG_MOE_FRONT_FUSION = EnvBool(False)
+    # GMM2（w2 down_proj）走 sgl_kernel_npu.moe.persistent_gmm 的 Triton
+    # persistent kernel（默认 stock npu_grouped_matmul）。仅作用于 BF16 无量化
