diff --git a/python/sglang/srt/mem_cache/mamba_radix_cache.py b/python/sglang/srt/mem_cache/mamba_radix_cache.py
index 368781d8d5..0856caae48 100644
--- a/python/sglang/srt/mem_cache/mamba_radix_cache.py
