+        vocab_size=vocab_size,
+        vocab_block_size=vocab_block_size,
+        num_vocab_blocks=num_vocab_blocks,
+    )
+    _tree_target_only_sample_kernel[(batch_size,)](
+        predicts,
+        target_probs,
+        draft_probs,
